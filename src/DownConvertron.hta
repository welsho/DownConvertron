/* riga di comando ffmpeg (tutti i percorsi gia' passati da safePath) */
function cvBuildArgs(it, inPath, outTmp) {
  var x = it.info, F = cvSpec(), fmt = $("cvFmt").value, a = [], audioOn = $("cvAudio").value !== "none" && x.audio;
  a.push("-hide_banner", "-nostdin", "-y", "-loglevel error", "-nostats", "-progress pipe:1");

  /* --- solo cambio contenitore: copio cio' che e' compatibile, ricodifico il resto --- */
  if (F.remux) {
    a = a.concat(cvInputArgs(it, inPath));
    a.push("-map 0:v:0");
    var R = REMUX_OK[F.remux], vcopy = R.v.test(x.codec) && !(F.remux === "mp4" && x.alpha), keepAlpha = false, acopy = true, k;
    var ast = x.astreams || [];
    for (k = 0; k < ast.length; k++) if (!R.a.test(ast[k].codec || "")) acopy = false;
    var lin = x.codec === "exr" ? (x.alpha ? "unpremultiply=inplace=1," : "") + "zscale=tin=linear:t=iec61966-2-1:npl=100,format=" + (x.alpha ? "gbrapf32le," : "gbrpf32le,") : "";   /* EXR lineare -> sRGB */
    if (vcopy) { a.push("-c:v copy"); if (x.codec === "hevc") a.push("-tag:v hvc1"); }
    else if (F.remux === "mov" && x.alpha) { keepAlpha = true; a.push('-vf "' + lin + 'format=yuva444p10le"', "-c:v prores_ks", "-profile:v 4444", "-vendor apl0", "-alpha_bits 16"); }
    else a.push('-vf "' + lin + (x.alpha ? "premultiply=inplace=1," : "") + 'scale=trunc(iw/2)*2:trunc(ih/2)*2,format=yuv420p"', "-c:v libx264", "-crf 18", "-preset medium");
    if (!audioOn) a.push("-an");
    else {
      a.push($("cvAllTracks").checked ? '-map "0:a?"' : '-map "0:a:0?"');
      if (acopy) a.push("-c:a copy"); else a.push("-c:a aac", "-b:a 256k");
    }
    a.push("-movflags +faststart", "-f " + F.remux, '"' + outTmp + '"');
    return { line: a.join(" "), alpha: keepAlpha || (vcopy && x.alpha), keyed: false, copied: vcopy && (acopy || !audioOn), dur: cvOutDur(it, null) };
  }

  var c = cvChain(it, F, false), vf = c.vf, alpha = c.alpha, crf = $("cvCrf").value, sp = $("cvSpeed").value;
  a = a.concat(cvInputArgs(it, inPath));
  a.push("-map 0:v:0");
  var out = { line: "", alpha: alpha, keyed: c.useKey, mem: cvMemCheck(c), dur: cvOutDur(it, c) };

  if (fmt === "gif") {
    /* immagini in sequenza: palette da TUTTI i fotogrammi (con stats_mode=diff i colori dell'ultima immagine restavano fuori) */
    vf.push("split[a][b];[a]palettegen=reserve_transparent=1:stats_mode=" + (it.kind === "seq" ? "full" : "diff") + "[p];[b][p]paletteuse=dither=bayer:alpha_threshold=128");
    /* con trasparenza: fotogrammi interi (-offsetting), altrimenti passando da opaco a trasparente resta un «fantasma» */
    a.push('-vf "' + vf.join(",") + '"');
    if (alpha) a.push("-gifflags -offsetting");
    a.push("-loop 0", "-an", "-f gif", '"' + outTmp + '"');
    out.line = a.join(" "); out.alpha = true; return out;
  }
  if (F.seq === "exr") {
    /* EXR: lineare (sRGB -> lineare) in mezza precisione, alfa premoltiplicato come da standard */
    vf.push("format=" + (alpha ? "gbrapf32le" : "gbrpf32le"), "setparams=color_trc=iec61966-2-1:color_primaries=bt709:colorspace=gbr",
            "zscale=t=linear:p=bt709:npl=100", "format=" + (alpha ? "gbrapf32le" : "gbrpf32le"));
    if (alpha) vf.push("premultiply=inplace=1");
    a.push('-vf "' + vf.join(",") + '"', "-c:v exr", "-compression zip1", "-format half", "-an", cvSingleOut(it, F) ? "-frames:v 1 -update 1 -f image2" : "-f image2 -start_number 1", '"' + outTmp + '"');
    out.line = a.join(" "); return out;
  }
  var pix = { webm: alpha ? "yuva420p" : "yuv420p", prores: alpha ? "yuva444p10le" : "yuv444p10le", prores4444xq: alpha ? "yuva444p10le" : "yuv444p10le",
              qtrle: alpha ? "argb" : "rgb24", pngmov: alpha ? "rgba" : "rgb24", vthevcalpha: alpha ? "bgra" : "yuv420p",
              cfhd: alpha ? "gbrap12le" : "yuv422p10le", hapalpha: "rgba", hapq: "rgba", hap: "rgba",
              webpanim: alpha ? "yuva420p" : "yuv420p", apng: alpha ? "rgba" : "rgb24",
              seqpng: alpha ? "rgba" : "rgb24", seqtiff: alpha ? "rgba" : "rgb24",
              imgpng: alpha ? "rgba" : "rgb24", imgtiff: alpha ? "rgba" : "rgb24", imgwebp: alpha ? "yuva420p" : "yuv420p", imgjpg: "yuvj444p" }[fmt];
  if (!pix) pix = F.prof ? "yuv422p10le" : (F.gpu && /_qsv$/.test(HW.enc[F.gpu] || "") ? "nv12" : "yuv420p");
  vf.push("format=" + pix);
  a.push('-vf "' + vf.join(",") + '"');
  if (F.still) {
    a.push({ png: "-c:v png", tiff: "-c:v tiff -compression_algo deflate", webp: "-c:v libwebp -lossless 0 -quality " + (WEBP_Q[crf] || 85), jpg: "-c:v mjpeg -q:v 2" }[F.still],
           "-frames:v 1", "-update 1", "-an", "-f image2", '"' + outTmp + '"');
    out.line = a.join(" "); return out;
  }
  if (F.seq) {
    a.push(F.seq === "png" ? "-c:v png" : "-c:v tiff -compression_algo deflate", "-an", cvSingleOut(it, F) ? "-frames:v 1 -update 1 -f image2" : "-f image2 -start_number 1", '"' + outTmp + '"');
    out.line = a.join(" "); return out;
  }
  if (fmt === "webm") {
    a.push("-c:v libvpx-vp9", "-b:v 0", "-crf " + crf, "-deadline good", "-cpu-used " + sp, "-row-mt 1");
    if (alpha) a.push("-auto-alt-ref 0");
  } else if (F.prof) {
    a.push("-c:v prores_ks", "-profile:v " + F.prof, "-vendor apl0");
    if (alpha) a.push("-alpha_bits 16");
  } else if (fmt === "qtrle" || fmt === "pngmov") a.push("-c:v " + (fmt === "qtrle" ? "qtrle" : "png"));
  else if (F.hap) a.push("-c:v hap", "-format " + F.hap, "-compressor snappy");
  else if (fmt === "cfhd") a.push("-c:v cfhd", "-quality " + (CFHD_Q[crf] || "film2"));
  else if (fmt === "webpanim") a.push("-c:v libwebp_anim", "-lossless 0", "-quality " + (WEBP_Q[crf] || 85), "-loop 0");
  else if (fmt === "apng") a.push("-c:v apng", "-plays 0");
  else if (F.gpu) a = a.concat(gpuArgs(HW.enc[F.gpu], crf));
  else if (F.vt) {
    /* chip del Mac: bitrate calcolato su risoluzione e fotogrammi di uscita; -allow_sw se manca l'hardware */
    var kb = Math.max(400, Math.round(c.w * c.h * c.fps * (VT_BPP[crf] || 0.13) / 1000));
    a.push("-c:v " + F.vt + "_videotoolbox", "-b:v " + kb + "k", "-allow_sw 1", "-tag:v " + (F.vt === "hevc" ? "hvc1" : "avc1"));
    if (fmt === "vthevcalpha" && alpha) a.push("-alpha_quality 0.75");
  } else if (fmt === "mp4h265") a.push("-c:v libx265", "-crf " + (X265_CRF[crf] || 24), "-preset " + (X26_PRESET[sp] || "medium"), "-tag:v hvc1", "-x265-params log-level=error");
  else a.push("-c:v libx264", "-crf " + (X264_CRF[crf] || 19), "-preset " + (X26_PRESET[sp] || "medium"));
  if ((F.gpu && F.gpu === "hevc") || (F.vt === "hevc")) { if (a.join(" ").indexOf("-tag:v") < 0) a.push("-tag:v hvc1"); }
  a = a.concat(cvAudioArgs(it, F, c));
  var mux = { ".webm": "webm", ".mov": "mov", ".mp4": "mp4", ".webp": "webp", ".png": "apng" }[F.ext];
  if (mux === "mp4" || mux === "mov") a.push("-movflags +faststart");
  a.push("-f " + mux, '"' + outTmp + '"');
  out.line = a.join(" ");
  return out;
}
/* durata del file di uscita, per la barra di avanzamento */
function cvOutDur(it, c) {
  if (it.kind === "img") return cvSingleOut(it, cvSpec()) ? 0 : cvStill(it) * (c ? (c.bounce ? 2 : 1) * c.loops : 1);
  var x = it.info, tr = cvTrim(), seg = ((tr.to && tr.to < x.dur ? tr.to : x.dur) || 0) - tr.from;
  if (!(seg > 0)) seg = x.dur || 0;
  if (!c) return seg;
  return seg * (c.bounce ? 2 : 1) * c.loops;
}
function cvExt() { return cvSpec().ext; }
function cvGoLabel() { return T("Converti in") + " " + TX(cvSpec().name); }
/* il pulsante grande resta su una riga anche con i nomi lunghi (es. CONVERT TO MOV PRORES 4444) */
function goFit(el) { var n = String(el.innerText || "").length; el.style.fontSize = n > 26 ? "12.5px" : n > 21 ? "14px" : ""; el.style.letterSpacing = n > 21 ? "1px" : ""; }
/* nome finale: file (o cartella per le sequenze), mai sovrascrivere nulla */
function cvFinalName(dir, it) {
  var F = cvSpec(), base = it.name || cleanName(String(it.srcTitle || (it.kind === "seq" ? (it.seq.outName || it.seq.prefix.replace(/[\s._-]+$/, "")) : fso.GetBaseName(it.path)))).replace(/%/g, "") || "video";
  var ext = cvSingleOut(it, F) ? (F.still ? F.ext : "." + F.seq) : (F.seq ? "_" + F.seq : F.ext), n = base, k = 2;
  function taken(p) { return fso.FileExists(p) || fso.FolderExists(p) || (it.path && p.toLowerCase() === String(it.path).toLowerCase()); }
  while (taken(dir + "\\" + n + ext)) n = base + " (" + k++ + ")";
  it.outBase = n;
  return dir + "\\" + n + ext;
}

/* ---------- preset con nome ---------- */
var PRESET_IDS = ["cvFmt", "cvCrf", "cvSpeed", "cvRes", "cvFps", "cvAudio", "cvSeqFps", "cvKey", "cvTol", "cvLoop", "cvCanvas", "cvCanvasMode", "cvLoud"];
var PRESET_TEXT = ["cvKeyColor", "cvCanvasW", "cvCanvasH", "cvFrom", "cvTo"];
var PRESET_CHECKS = ["cvAllTracks", "cvAlphaForce", "cvPremult", "cvBounce"];
var PRESET_BASE = { cvCrf: "24", cvSpeed: "2", cvRes: "orig", cvFps: "orig", cvSeqFps: "25", cvKey: "none", cvTol: "0.18", cvLoop: "1", cvCanvas: "", cvCanvasMode: "fit", cvLoud: "", cvFrom: "", cvTo: "",
                    cvAllTracks: "1", cvAlphaForce: "0", cvPremult: "0", cvBounce: "0" };
var PRESET_BUILTIN = [
  ["Web trasparente · WebM", { cvFmt: "webm", cvCrf: "31", cvAudio: "128k" }],
  ["Montaggio con alfa · ProRes 4444", { cvFmt: "prores", cvAudio: "pcm24" }],
  ["Live e LED · HAP Alpha", { cvFmt: "hapalpha", cvAudio: "pcm24" }],
  ["Compositing · Sequenza EXR", { cvFmt: "seqexr" }],
  ["Sequenza PNG con alfa", { cvFmt: "seqpng" }],
  ["Sticker web · WebP animato", { cvFmt: "webpanim", cvCrf: "31" }],
  ["Loop avanti-indietro · WebM", { cvFmt: "webm", cvCrf: "31", cvBounce: "1", cvAudio: "128k" }],
  ["Social verticale 1080×1920 · MP4", { cvFmt: "mp4h264", cvCanvas: "1080x1920", cvCanvasMode: "fill", cvLoud: "-14", cvAudio: "192k" }],
  ["Montaggio leggero · ProRes 422 Proxy", { cvFmt: "prores422proxy", cvAudio: "pcm24" }]
];
function cvPresetGet() {
  var p = {}, i;
  for (i = 0; i < PRESET_IDS.length; i++) p[PRESET_IDS[i]] = $(PRESET_IDS[i]).value;
  for (i = 0; i < PRESET_TEXT.length; i++) p[PRESET_TEXT[i]] = $(PRESET_TEXT[i]).value;
  for (i = 0; i < PRESET_CHECKS.length; i++) p[PRESET_CHECKS[i]] = $(PRESET_CHECKS[i]).checked ? "1" : "0";
  return p;
}
function cvPresetApply(p) {
  var all = {}, k, i;
  for (k in PRESET_BASE) if (PRESET_BASE.hasOwnProperty(k)) all[k] = PRESET_BASE[k];
  for (k in p) if (p.hasOwnProperty(k)) all[k] = p[k];
  if (all.cvFmt) { setSelect($("cvFmt"), all.cvFmt); if ($("cvFmt").value !== all.cvFmt) cv.pendingFmt = all.cvFmt; }
  cvFillAudio(all.cvAudio);
  for (i = 0; i < PRESET_IDS.length; i++) if (PRESET_IDS[i] !== "cvFmt" && PRESET_IDS[i] !== "cvAudio" && all[PRESET_IDS[i]] !== undefined) setSelect($(PRESET_IDS[i]), all[PRESET_IDS[i]]);
  for (i = 0; i < PRESET_TEXT.length; i++) if (all[PRESET_TEXT[i]] !== undefined) $(PRESET_TEXT[i]).value = all[PRESET_TEXT[i]];
  for (i = 0; i < PRESET_CHECKS.length; i++) if (all[PRESET_CHECKS[i]] !== undefined) $(PRESET_CHECKS[i]).checked = all[PRESET_CHECKS[i]] === "1";
  cvCheck();
}
function cvPresetEncode(p) { var o = [], k; for (k in p) if (p.hasOwnProperty(k)) o.push(k + ":" + encodeURIComponent(p[k])); return o.join(";"); }
function cvPresetDecode(s) { var p = {}, parts = String(s).split(";"), i; for (i = 0; i < parts.length; i++) { var q = parts[i].indexOf(":"); if (q > 0) p[parts[i].substring(0, q)] = decodeURIComponent(parts[i].substring(q + 1)); } return p; }
function cvPresetFill(keep) {
  var sel = $("cvPreset"), i, n;
  while (sel.options.length) sel.remove(0);
  function add(v, t) { var o = document.createElement("option"); o.value = v; o.text = t; sel.add(o); }
  add("", TX("Preset…"));
  for (i = 0; i < PRESET_BUILTIN.length; i++) add("b:" + i, "★ " + TX(PRESET_BUILTIN[i][0]));
  var names = []; for (n in cv.presets) if (cv.presets.hasOwnProperty(n)) names.push(n);
  names.sort();
  for (i = 0; i < names.length; i++) add("u:" + names[i], names[i]);
  setSelect(sel, keep || "");
}
function cvPresetPick() {
  var v = $("cvPreset").value;
  if (!v) return;
  if (v.indexOf("b:") === 0) cvPresetApply(PRESET_BUILTIN[+v.substring(2)][1]);
  else { var n = v.substring(2); if (cv.presets[n]) { cvPresetApply(cvPresetDecode(cv.presets[n])); $("cvPresetName").value = n; } }
  showMsg("Preset applicato: " + $("cvPreset").options[$("cvPreset").selectedIndex].text.replace("★ ", "") + ".", "info");
}
function cvPresetSave() {
  var n = String($("cvPresetName").value || "").replace(/[;=:\r\n]/g, " ").replace(/^\s+|\s+$/g, "");
  if (!n) { showMsg("Scrivi un nome per il preset (es. «Cliente X verticale»).", "err"); $("cvPresetName").focus(); return; }
  if (cv.presets[n] && !confirmT("Esiste già un preset «" + n + "»: sostituirlo con le impostazioni attuali?")) return;
  cv.presets[n] = cvPresetEncode(cvPresetGet());
  cvPresetFill("u:" + n); saveSettings();
  showMsg("Preset «" + n + "» salvato.", "ok");
}
function cvPresetDelete() {
  var v = $("cvPreset").value;
  if (v.indexOf("u:") !== 0) { showMsg("Scegli nel menu un tuo preset da eliminare (quelli con la stella sono di serie).", "err"); return; }
  var n = v.substring(2);
  if (!confirmT("Eliminare il preset «" + n + "»?")) return;
  delete cv.presets[n]; cvPresetFill(""); saveSettings();
  showMsg("Preset eliminato.", "info");
}
function cvPage(p) {
  var pages = { fmt: ["cvPaneFmt", "cvPgFmt"], alpha: ["cvPaneAlpha", "cvPgAlpha"], edit: ["cvPaneEdit", "cvPgEdit"] }, k;
  for (k in pages) if (pages.hasOwnProperty(k)) { $(pages[k][0]).style.display = k === p ? "block" : "none"; $(pages[k][1]).className = k === p ? "on" : ""; }
}

/* ---------- anteprima del risultato su scacchiera ---------- */
function cvPreview(it) {
  if (state.busy) return;
  if (!it.info || !it.info.ok) { if (it.path) cvProbe(it); cvRender(); }
  if (!it.info || !it.info.ok) { showMsg("Anteprima non disponibile: " + ((it.info && it.info.err) || "file non ancora scaricato"), "err"); return; }
  var ffmpeg = findTool("ffmpeg.exe"); if (!ffmpeg) { showMsg("ffmpeg non trovato.", "err"); return; }
  var F = cvSpec(), inP = safePath(it.kind === "seq" ? it.seq.pattern : it.path);
  if (!inP) { showMsg("Percorso non utilizzabile per l'anteprima.", "err"); return; }
  var c = cvChain(it, F, true), tr = cvTrim(), dur = it.info.dur || 0;
  var at = tr.to ? (tr.from + tr.to) / 2 : (tr.from ? tr.from + Math.min(1, Math.max(0, dur - tr.from) / 2) : dur / 3);
  if (!(at >= 0)) at = 0;
  pvCleanup();
  ensureDir(DIR_TMP);
  var png = DIR_TMP + "\\anteprima_" + newToken() + ".png", log = png + ".txt";
  var vf = c.vf.concat(["format=rgba"]);
  var args = ["-hide_banner", "-nostdin", "-y", "-v error"].concat(cvInputArgs(it, inP, it.kind === "seq" ? undefined : at));
  args.push('-vf "' + vf.join(",") + '"', "-frames:v 1", "-f image2", '"' + png + '"');
  try { sh.Run('"' + EXE_CMD + '" /d /v:off /s /c ""' + ffmpeg + '" ' + args.join(" ") + ' > "' + log + '" 2>&1"', 0, true); } catch (e) {}
  if (!fso.FileExists(png)) { var why = readTail(log, 400); tryDelete(log); showMsg("Anteprima non riuscita: " + why.replace(/\s+/g, " "), "err"); return; }
  tryDelete(log);
  cv.pvFile = png;
  var pu = png.replace(/\\/g, "/").replace(/%/g, "%25").replace(/#/g, "%23").replace(/\?/g, "%3F");
  $("pvImg").src = "file://" + (pu.charAt(0) === "/" ? "" : "/") + pu + "?" + newToken();
  $("pvTitle").innerText = T("Anteprima: {0}", (it.name || it.title) + "  →  " + TX(F.name));
  $("pvInfo").innerText = (c.alpha ? "Le zone a scacchi saranno trasparenti nel file finale." : "Il formato scelto non ha trasparenza: lo sfondo esce pieno.") +
                           (c.useKey ? " Sfondo rimosso con il chroma key." : "") + "  Fotogramma a " + fmtTime(it.kind === "seq" ? 0 : at) + ", uscita " + c.w + "×" + c.h + ".";
  $("pvBox").style.display = "block";
}
function pvCleanup() { if (cv.pvFile) { tryDelete(cv.pvFile); cv.pvFile = ""; } }
function pvClose() { $("pvBox").style.display = "none"; $("pvImg").src = PV_BLANK; pvCleanup(); }
var PV_BLANK = "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";

/* ---------- aggiunta da trascinamento / incolla ---------- */
/* espande cartelle (video e sequenze) e aggiunge tutto alla lista del convertitore */
function cvAddDropped(paths) {
  var list = [], ff = {}, i;
  for (i = 0; i < paths.length; i++) {
    /* solo gli indirizzi file:/// vanno decodificati: i percorsi del ricevitore sono gia' veri («Spot%2B.mov» resta tale) */
    var raw = String(paths[i] || ""), isUri = /^file:/i.test(raw), p = raw.replace(/^file:\/\/\/?/i, "").replace(/\//g, "\\");
    if (isUri) { try { p = decodeURIComponent(p); } catch (e) {} }
    if (window.DCVT_MAC) p = String(paths[i]);
    if (!p) continue;
    if (fso.FolderExists(p)) {
      var e2 = new Enumerator(fso.GetFolder(p).Files);
      for (; !e2.atEnd(); e2.moveNext()) if (MEDIA_EXT.test(e2.item().Name) || IMG_IN_EXT.test(e2.item().Name)) { list.push(e2.item().Path); ff[String(e2.item().Path).toLowerCase()] = 1; }
    } else list.push(p);
  }
  if (!list.length) { showMsg("Niente da convertire in quello che hai trascinato.", "err"); return; }
  if (state.tab !== "cv") showTab("cv");
  cvAddPaths(list, true, ff);
}
/* file copiati in Esplora file (Ctrl+C): PowerShell legge l'elenco completo dagli appunti */
function cvPasteFiles() {
  if (state.busy) return;
  ensureDir(DIR_TMP);
  var ps = SYSDIR + "\\WindowsPowerShell\\v1.0\\powershell.exe", out = DIR_TMP + "\\incolla_" + newToken() + ".txt";
  if (!fso.FileExists(ps)) { showMsg("PowerShell non trovato: usa + File.", "err"); return; }
  try {
    sh.Run('"' + ps + '" -NoProfile -STA -WindowStyle Hidden -Command "$l = Get-Clipboard -Format FileDropList; if ($l) { [IO.File]::WriteAllLines(\'' + out.replace(/'/g, "''") + '\', [string[]]($l | ForEach-Object { $_.FullName }), [Text.Encoding]::Unicode) }"', 0, true);
  } catch (e) { showMsg("Impossibile leggere gli appunti: " + (e.message || e), "err"); return; }
  if (!fso.FileExists(out)) { showMsg("Negli appunti non ci sono file: selezionali in Esplora file, premi Ctrl+C e poi «Incolla file».", "err"); return; }
  var l = readUtf8(out).split(/\r?\n/); tryDelete(out);
  cvAddDropped(l);
}

/* ---------- trascinamento ----------
   Windows: il controllo HTML di mshta non da' i percorsi dei file trascinati. All'avvio parte un
   piccolo ricevitore nativo (PowerShell + WinForms, gia' in Windows) che resta nascosto; quando un
   trascinamento di file entra nella finestra l'app gli scrive "show.txt" e lui si mette sopra la
   finestra, quasi invisibile: riceve tutti i file e le cartelle con il percorso completo e li passa
   all'app in "drop_*.txt". Mac: i percorsi arrivano direttamente (dropFilePaths in mac.js). */
var DROP = { active: false, kind: "", signaled: false, hot: false, anim: false, poll: null, timer: null, closing: null,
             helper: "off", dir: "", startedAt: 0, polls: 0 };
var DROP_VER = "3";
/* script del ricevitore (scritto in %APPDATA%\\DownConvertron\\trascina all'avvio) */
var DROP_PS = "# DownConvertron - ricevitore del trascinamento (designed by Welsho)\n# Copyright (C) 2026 Daniele Moretti (Welsho) - licenza GPL-3.0-or-later (vedi LICENSE)\n# Avviato dall'app all'apertura, nascosto. Compila una sola volta la parte in C# (ricevitore_N.dll),\n# poi la carica in pochi millisecondi. Si chiude da solo quando chiudi l'app.\nparam([string]$Dir, [string]$Lib, [string]$Title)\n$ErrorActionPreference = 'Stop'\ntry {\n  New-Item -ItemType Directory -Force -Path $Dir | Out-Null\n  Add-Type -AssemblyName System.Windows.Forms, System.Drawing\n  if (-not ('DcvtDrop.Ricevitore' -as [type])) {\n    if (-not (Test-Path -LiteralPath $Lib)) {\n      $src = @'\n// DownConvertron - ricevitore del trascinamento per Windows (designed by Welsho)\n// Copyright (C) 2026 Daniele Moretti (Welsho) - licenza GPL-3.0-or-later (vedi LICENSE)\n// Finestra quasi invisibile (opacita' 1%) che compare sopra l'app solo mentre trascini dei file:\n// e' una vera destinazione OLE di Windows, quindi riceve i percorsi completi di TUTTI i file e\n// cartelle (DataFormats.FileDrop), senza il controllo di Internet Explorer e senza \"Apri o salva\".\n// Comunicazione con l'HTA tramite file nella cartella di scambio:\n//   HTA -> show.txt  \"larghezzaCss altezzaCss zonaX zonaY zonaL zonaA\"  (mostra la finestra)\n//          quit.flag                                                     (chiude il ricevitore)\n//   ricevitore -> ready.flag (pronto)  in.flag (puntatore sulla botola)  leave.flag (uscito)\n//                 drop_<n>.txt  \"@x,y\" + un percorso per riga (UTF-8)  error.txt (problemi)\nusing System;\nusing System.Diagnostics;\nusing System.Drawing;\nusing System.IO;\nusing System.Runtime.InteropServices;\nusing System.Text;\nusing System.Windows.Forms;\nusing ComDataObject = System.Runtime.InteropServices.ComTypes.IDataObject;\nusing System.Runtime.InteropServices.ComTypes;\n\nnamespace DcvtDrop\n{\n    // Anteprima di Windows sotto il puntatore (miniature dei file + scritta \"Copia in DownConvertron\"),\n    // la stessa che si vede trascinando tra cartelle di Esplora file.\n    [ComImport, Guid(\"4657278B-411B-11D2-839A-00C04FD918D0\"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]\n    interface IDropTargetHelper\n    {\n        void DragEnter(IntPtr hwndTarget, ComDataObject dataObject, ref ShellPoint pt, int effect);\n        void DragLeave();\n        void DragOver(ref ShellPoint pt, int effect);\n        void Drop(ComDataObject dataObject, ref ShellPoint pt, int effect);\n        void Show(bool show);\n    }\n    [ComImport, Guid(\"4657278A-411B-11D2-839A-00C04FD918D0\")]\n    class DragDropHelper { }\n    [StructLayout(LayoutKind.Sequential)] public struct ShellPoint { public int X, Y; }\n    [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]\n    struct DropDescription\n    {\n        public int type;\n        [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 260)] public string message;\n        [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 260)] public string insert;\n    }\n\n    public class Ricevitore : Form\n    {\n        [StructLayout(LayoutKind.Sequential)] struct RECT { public int Left, Top, Right, Bottom; }\n        [StructLayout(LayoutKind.Sequential)] struct POINT { public int X, Y; }\n        delegate bool EnumProc(IntPtr h, IntPtr l);\n\n        [DllImport(\"user32.dll\")] static extern bool IsWindow(IntPtr h);\n        [DllImport(\"user32.dll\")] static extern bool IsWindowVisible(IntPtr h);\n        [DllImport(\"user32.dll\")] static extern bool IsIconic(IntPtr h);\n        [DllImport(\"user32.dll\")] static extern bool GetClientRect(IntPtr h, out RECT r);\n        [DllImport(\"user32.dll\")] static extern bool ClientToScreen(IntPtr h, ref POINT p);\n        [DllImport(\"user32.dll\")] static extern bool SetProcessDPIAware();\n        [DllImport(\"user32.dll\")] static extern bool EnumWindows(EnumProc cb, IntPtr l);\n        [DllImport(\"user32.dll\")] static extern uint GetWindowThreadProcessId(IntPtr h, out uint pid);\n        [DllImport(\"user32.dll\", CharSet = CharSet.Unicode)] static extern int GetClassName(IntPtr h, StringBuilder sb, int n);\n        [DllImport(\"user32.dll\", CharSet = CharSet.Unicode)] static extern int GetWindowText(IntPtr h, StringBuilder sb, int n);\n        [DllImport(\"user32.dll\")] static extern short GetAsyncKeyState(int vk);\n        [DllImport(\"user32.dll\")] static extern bool SetWindowPos(IntPtr h, IntPtr after, int x, int y, int cx, int cy, uint flags);\n        [DllImport(\"user32.dll\", CharSet = CharSet.Unicode)] static extern uint RegisterClipboardFormat(string name);\n        [DllImport(\"kernel32.dll\")] static extern IntPtr GlobalAlloc(uint flags, UIntPtr bytes);\n        [DllImport(\"kernel32.dll\")] static extern IntPtr GlobalLock(IntPtr h);\n        [DllImport(\"kernel32.dll\")] static extern bool GlobalUnlock(IntPtr h);\n\n        const string HTA_CLASS = \"HTML Application Host Window Class\";\n        static readonly IntPtr HWND_TOPMOST = new IntPtr(-1);\n        const uint SWP_NOACTIVATE = 0x0010, SWP_SHOWWINDOW = 0x0040, SWP_HIDEWINDOW = 0x0080;\n\n        readonly string dir;\n        readonly IntPtr target;\n        readonly Timer timer;\n        DateTime armedAt = DateTime.MinValue;\n        double ratio = 1;\n        double zx, zy, zw, zh;\n        bool inZone, armed;\n        string lang = \"it\";\n        IDropTargetHelper shell;\n        ComDataObject lastData;\n        int seq, readFails;\n\n        // ---------- avvio ----------\n        public static int Run(string dir, int parentPid, string title)\n        {\n            try { SetProcessDPIAware(); } catch (Exception) { }   // coordinate fisiche, come quelle del trascinamento\n            try { Directory.CreateDirectory(dir); } catch (Exception) { }\n            IntPtr h = IntPtr.Zero;\n            for (int i = 0; i < 60 && h == IntPtr.Zero; i++)\n            {\n                h = FindHta(parentPid, title);\n                if (h == IntPtr.Zero) System.Threading.Thread.Sleep(250);\n            }\n            if (h == IntPtr.Zero) { WriteText(Path.Combine(dir, \"error.txt\"), \"finestra dell'app non trovata (pid \" + parentPid + \")\"); return 2; }\n            Log(dir, \"avvio: pid \" + Process.GetCurrentProcess().Id + \", app pid \" + parentPid + \", finestra 0x\" + h.ToString(\"X\"));\n            Ricevitore f = new Ricevitore(dir, h);\n            IntPtr own = f.Handle;                 // crea la finestra (e la registra come destinazione OLE) senza mostrarla\n            Application.Run(new ApplicationContext());\n            return 0;\n        }\n\n        // la finestra dell'HTA che ci ha avviato: prima per processo padre, poi per titolo\n        static IntPtr FindHta(int pid, string title)\n        {\n            IntPtr byPid = IntPtr.Zero, byTitle = IntPtr.Zero;\n            EnumWindows(delegate (IntPtr h, IntPtr l)\n            {\n                if (!IsWindowVisible(h)) return true;\n                StringBuilder cls = new StringBuilder(128);\n                GetClassName(h, cls, cls.Capacity);\n                if (cls.ToString() != HTA_CLASS) return true;\n                uint p; GetWindowThreadProcessId(h, out p);\n                if (pid > 0 && p == (uint)pid && byPid == IntPtr.Zero) byPid = h;\n                if (!string.IsNullOrEmpty(title))\n                {\n                    StringBuilder t = new StringBuilder(256);\n                    GetWindowText(h, t, t.Capacity);\n                    if (t.ToString().StartsWith(title, StringComparison.OrdinalIgnoreCase) && byTitle == IntPtr.Zero) byTitle = h;\n                }\n                return true;\n            }, IntPtr.Zero);\n            return byPid != IntPtr.Zero ? byPid : byTitle;\n        }\n\n        Ricevitore(string dir, IntPtr target)\n        {\n            this.dir = dir;\n            this.target = target;\n            Text = \"DownConvertron - ricevitore\";\n            FormBorderStyle = FormBorderStyle.None;\n            ShowInTaskbar = false;\n            StartPosition = FormStartPosition.Manual;\n            BackColor = Color.Black;\n            Opacity = 0.01;                 // finestra stratificata: invisibile all'occhio, ma riceve il rilascio\n            TopMost = true;\n            AllowDrop = true;\n            Bounds = new Rectangle(-32000, -32000, 8, 8);\n            Visible = false;\n            try { shell = (IDropTargetHelper)new DragDropHelper(); } catch (Exception) { shell = null; }\n            DragEnter += OnEnter;\n            DragOver += OnDrag;\n            DragLeave += OnLeave;\n            DragDrop += OnDrop;\n            timer = new Timer();\n            timer.Interval = 30;\n            timer.Tick += OnTick;\n            timer.Start();\n            WriteText(Path.Combine(dir, \"ready.flag\"), Process.GetCurrentProcess().Id.ToString());\n        }\n\n        // mai attivata, mai in Alt+Tab\n        protected override bool ShowWithoutActivation { get { return true; } }\n        protected override CreateParams CreateParams\n        {\n            get { CreateParams cp = base.CreateParams; cp.ExStyle |= 0x08000000 /* NOACTIVATE */ | 0x00000080 /* TOOLWINDOW */; return cp; }\n        }\n\n        // ---------- ciclo ----------\n        void OnTick(object sender, EventArgs e)\n        {\n            if (!IsWindow(target)) { Log(dir, \"chiuso: la finestra dell'app non esiste piu'\"); Quit(); return; }\n            if (File.Exists(Path.Combine(dir, \"quit.flag\"))) { Log(dir, \"chiuso: richiesta dell'app\"); Quit(); return; }\n            if (!Directory.Exists(dir)) { try { Directory.CreateDirectory(dir); WriteText(Path.Combine(dir, \"ready.flag\"), \"1\"); } catch (Exception) { } }\n            string sig = Path.Combine(dir, \"show.txt\");\n            if (File.Exists(sig))\n            {\n                string t = ReadText(sig);\n                if (t == null) { if (++readFails % 30 == 1) Log(dir, \"show.txt non leggibile (\" + readFails + \" tentativi): \" + lastReadError); }\n                else\n                {\n                    readFails = 0;\n                    string why = Arm(t);\n                    Log(dir, \"richiesta \\\"\" + t.Trim() + \"\\\": \" + (why == null ? \"mostrato sopra l'app\" : why));\n                    TryDelete(sig);                  // presa (anche se scartata): l'app puo' mandarne un'altra\n                    if (File.Exists(sig)) Log(dir, \"show.txt non cancellabile\");\n                }\n            }\n            // sicurezza: tasti del mouse rilasciati senza rilascio su di noi -> mi tolgo di mezzo,\n            // cosi' l'app sotto non resta mai coperta\n            if (armed && (DateTime.Now - armedAt).TotalMilliseconds > 500 && !ButtonsDown()) Disarm(true);\n        }\n\n        static bool ButtonsDown()\n        {\n            return (GetAsyncKeyState(0x01) & 0x8000) != 0 || (GetAsyncKeyState(0x02) & 0x8000) != 0 || (GetAsyncKeyState(0x04) & 0x8000) != 0;\n        }\n\n        // null = mostrato; altrimenti il motivo (finisce nel registro)\n        string Arm(string t)\n        {\n            string[] v = t.Trim().Split(new char[] { ' ', '\\t', '\\r', '\\n' }, StringSplitOptions.RemoveEmptyEntries);\n            if (v.Length < 6) return \"scartata: \" + v.Length + \" valori invece di 6\";\n            lang = v.Length > 6 ? v[6] : \"it\";\n            double cssW, cssH;\n            if (!double.TryParse(v[0], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out cssW) || cssW <= 0) return \"scartata: larghezza non valida\";\n            double.TryParse(v[1], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out cssH);\n            double.TryParse(v[2], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out zx);\n            double.TryParse(v[3], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out zy);\n            double.TryParse(v[4], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out zw);\n            double.TryParse(v[5], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out zh);\n            // finestra ridotta o non misurabile: non mi mostro e lo dico all'app\n            string leave = Path.Combine(dir, \"leave.flag\");\n            if (IsIconic(target)) { WriteText(leave, \"1\"); return \"non mostrato: finestra ridotta a icona\"; }\n            RECT r; POINT o = new POINT();\n            if (!GetClientRect(target, out r) || !ClientToScreen(target, ref o)) { WriteText(leave, \"1\"); return \"non mostrato: misure della finestra non lette\"; }\n            int w = r.Right - r.Left, hgt = r.Bottom - r.Top;\n            if (w < 20 || hgt < 20) { WriteText(leave, \"1\"); return \"non mostrato: finestra troppo piccola\"; }\n            ratio = w / cssW;                       // pixel reali per pixel CSS (ridimensionamento di Windows)\n            inZone = false;\n            armed = true;\n            armedAt = DateTime.Now;\n            if (!SetWindowPos(Handle, HWND_TOPMOST, o.X, o.Y, w, hgt, SWP_NOACTIVATE | SWP_SHOWWINDOW)) return \"SetWindowPos fallito (errore \" + Marshal.GetLastWin32Error() + \")\";\n            return null;\n        }\n\n        void Disarm(bool left)\n        {\n            if (!armed) return;\n            armed = false;\n            SetWindowPos(Handle, HWND_TOPMOST, -32000, -32000, 8, 8, SWP_NOACTIVATE | SWP_HIDEWINDOW);\n            SetZone(false);\n            if (left) WriteText(Path.Combine(dir, \"leave.flag\"), \"1\");\n        }\n\n        void Quit()\n        {\n            timer.Stop();\n            TryDelete(Path.Combine(dir, \"ready.flag\"));\n            TryDelete(Path.Combine(dir, \"in.flag\"));\n            TryDelete(Path.Combine(dir, \"quit.flag\"));\n            Application.ExitThread();\n        }\n\n        // ---------- trascinamento ----------\n        static bool HasFiles(DragEventArgs e)\n        {\n            try { return e.Data != null && e.Data.GetDataPresent(DataFormats.FileDrop); } catch (Exception) { return false; }\n        }\n\n        // sempre COPIA: con \"sposta\" Esplora file cancellerebbe l'originale\n        static DragDropEffects Effect(DragEventArgs e)\n        {\n            if (!HasFiles(e)) return DragDropEffects.None;\n            if ((e.AllowedEffect & DragDropEffects.Copy) != 0) return DragDropEffects.Copy;\n            if ((e.AllowedEffect & DragDropEffects.Link) != 0) return DragDropEffects.Link;\n            return DragDropEffects.None;\n        }\n\n        static ShellPoint Pt(DragEventArgs e) { ShellPoint p; p.X = e.X; p.Y = e.Y; return p; }\n        string Message()\n        {\n            if (lang == \"en\") return \"Copy to %1\";\n            if (lang == \"zh\") return \"\\u590d\\u5236\\u5230 %1\";\n            return \"Copia in %1\";\n        }\n        // scritta accanto al puntatore; tipo -1 la toglie (importante quando esci, per non lasciarla a Esplora file)\n        static void Describe(ComDataObject d, int type, string msg, string ins)\n        {\n            if (d == null) return;\n            try\n            {\n                FORMATETC f = new FORMATETC();\n                f.cfFormat = unchecked((short)RegisterClipboardFormat(\"DropDescription\"));\n                f.dwAspect = DVASPECT.DVASPECT_CONTENT; f.lindex = -1; f.ptd = IntPtr.Zero; f.tymed = TYMED.TYMED_HGLOBAL;\n                DropDescription dd = new DropDescription(); dd.type = type; dd.message = msg; dd.insert = ins;\n                int size = Marshal.SizeOf(typeof(DropDescription));\n                IntPtr h = GlobalAlloc(0x0042 /* GHND */, new UIntPtr((uint)size));\n                if (h == IntPtr.Zero) return;\n                IntPtr ptr = GlobalLock(h);\n                Marshal.StructureToPtr(dd, ptr, false);\n                GlobalUnlock(h);\n                STGMEDIUM m = new STGMEDIUM(); m.tymed = TYMED.TYMED_HGLOBAL; m.unionmember = h; m.pUnkForRelease = null;\n                d.SetData(ref f, ref m, true);\n            }\n            catch (Exception) { }\n        }\n        void OnEnter(object sender, DragEventArgs e)\n        {\n            OnDrag(sender, e);\n            ComDataObject d = e.Data as ComDataObject;\n            lastData = d;\n            if (HasFiles(e)) Describe(d, 1 /* DROPIMAGE_COPY */, Message(), \"DownConvertron\");\n            if (shell != null && d != null) { try { ShellPoint p = Pt(e); shell.DragEnter(Handle, d, ref p, (int)e.Effect); } catch (Exception) { } }\n        }\n        void OnDrag(object sender, DragEventArgs e)\n        {\n            e.Effect = Effect(e);\n            armedAt = DateTime.Now;\n            Point c = Css(e.X, e.Y);\n            SetZone(c.X >= zx && c.X <= zx + zw && c.Y >= zy && c.Y <= zy + zh);\n            if (shell != null && e.Data is ComDataObject) { try { ShellPoint p = Pt(e); shell.DragOver(ref p, (int)e.Effect); } catch (Exception) { } }\n        }\n\n        void OnLeave(object sender, EventArgs e)\n        {\n            if (shell != null) { try { shell.DragLeave(); } catch (Exception) { } }\n            Describe(lastData, -1, \"\", \"\");\n            lastData = null;\n            Disarm(true);\n        }\n\n        void OnDrop(object sender, DragEventArgs e)\n        {\n            string[] files = null;\n            try { files = e.Data.GetData(DataFormats.FileDrop) as string[]; } catch (Exception) { }\n            Point c = Css(e.X, e.Y);\n            ComDataObject cd = e.Data as ComDataObject;\n            Describe(cd, -1, \"\", \"\");\n            if (shell != null && cd != null) { try { ShellPoint p = Pt(e); shell.Drop(cd, ref p, (int)e.Effect); } catch (Exception) { } }\n            if (files != null && files.Length > 0)\n            {\n                StringBuilder sb = new StringBuilder();\n                sb.Append('@').Append(c.X).Append(',').Append(c.Y).Append('\\n');\n                foreach (string f in files) if (!string.IsNullOrEmpty(f)) sb.Append(f).Append('\\n');\n                seq++;\n                string name = \"drop_\" + DateTime.Now.Ticks + \"_\" + seq + \".txt\";\n                string tmp = Path.Combine(dir, name + \".tmp\");\n                if (WriteText(tmp, sb.ToString()))\n                {\n                    try { File.Move(tmp, Path.Combine(dir, name)); } catch (Exception ex) { WriteText(Path.Combine(dir, \"error.txt\"), \"rilascio: \" + ex.Message); }\n                }\n            }\n            // nascondo dopo aver restituito il controllo a Esplora file\n            BeginInvoke(new MethodInvoker(delegate { Disarm(files == null || files.Length == 0); }));\n        }\n\n        Point Css(int sx, int sy)\n        {\n            Point p = PointToClient(new Point(sx, sy));\n            return new Point((int)Math.Round(p.X / ratio), (int)Math.Round(p.Y / ratio));\n        }\n\n        void SetZone(bool v)\n        {\n            if (v == inZone) return;\n            inZone = v;\n            string f = Path.Combine(dir, \"in.flag\");\n            if (v) WriteText(f, \"1\"); else TryDelete(f);\n        }\n\n        // ---------- file ----------\n        static bool WriteText(string path, string text)\n        {\n            for (int i = 0; i < 5; i++)\n            {\n                try { File.WriteAllText(path, text, new UTF8Encoding(false)); return true; }\n                catch (Exception) { System.Threading.Thread.Sleep(15); }\n            }\n            return false;\n        }\n        // lettura che non impedisce all'app di cancellare o sostituire il file\n        static string lastReadError = \"\";\n        static string ReadText(string path)\n        {\n            try\n            {\n                using (FileStream fs = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete))\n                using (StreamReader sr = new StreamReader(fs, Encoding.UTF8)) return sr.ReadToEnd();\n            }\n            catch (Exception e) { lastReadError = e.GetType().Name + \": \" + e.Message; return null; }\n        }\n        // registro del ricevitore (finisce nel Report debug dell'app), al massimo ~64 KB\n        static void Log(string dir, string msg)\n        {\n            try\n            {\n                string p = Path.Combine(dir, \"ricevitore.log\");\n                if (File.Exists(p) && new FileInfo(p).Length > 65536) File.Delete(p);\n                File.AppendAllText(p, DateTime.Now.ToString(\"HH:mm:ss.fff\") + \" \" + msg + \"\\r\\n\", new UTF8Encoding(false));\n            }\n            catch (Exception) { }\n        }\n        static void TryDelete(string path)\n        {\n            try { if (File.Exists(path)) File.Delete(path); } catch (Exception) { }\n        }\n    }\n}\n\n'@\n      Add-Type -TypeDefinition $src -Language CSharp -ReferencedAssemblies System.Windows.Forms, System.Drawing -OutputAssembly $Lib -OutputType Library\n    }\n    if (-not ('DcvtDrop.Ricevitore' -as [type])) { Add-Type -LiteralPath $Lib }\n  }\n  $padre = 0\n  try { $padre = [int](Get-CimInstance Win32_Process -Filter \"ProcessId=$PID\").ParentProcessId } catch {\n    try { $padre = [int](Get-WmiObject Win32_Process -Filter \"ProcessId=$PID\").ParentProcessId } catch { }\n  }\n  [void][DcvtDrop.Ricevitore]::Run($Dir, $padre, $Title)\n} catch {\n  try { [IO.File]::WriteAllText((Join-Path $Dir 'error.txt'), ($_ | Out-String)) } catch { }\n  try { if (Test-Path -LiteralPath $Lib) { Remove-Item -LiteralPath $Lib -Force } } catch { }\n}\n";
var MECHA_W = 1160, MECHA_H = 960, DROP_ZONE = [440, 590, 280, 350], DROP_MOUTH = [580, 775];

function dropTypes(ev) {
  var t = { files: false, text: false };
  try { var ty = ev.dataTransfer.types; for (var i = 0; i < ty.length; i++) { var v = String(ty[i] || ty.item(i)); if (v === "Files") t.files = true; else if (/text|url/i.test(v)) t.text = true; } } catch (e) { t.text = true; }
  return t;
}
function dropBase() { return DIR_APP + "\\trascina"; }
function dropHelperStart() {
  if (window.DCVT_MAC || DROP.helper === "starting" || DROP.helper === "ready") return;
  var ps = SYSDIR + "\\WindowsPowerShell\\v1.0\\powershell.exe";
  if (!fso.FileExists(ps)) { DROP.helper = "none"; return; }
  try {
    var base = dropBase(), script = base + "\\ricevitore_" + DROP_VER + ".ps1", lib = base + "\\ricevitore_" + DROP_VER + ".dll";
    ensureDir(base); ensureDir(DIR_TMP);
    writeAscii(script, DROP_PS);
    /* cartelle di scambio rimaste da sessioni precedenti */
    var d = new Enumerator(fso.GetFolder(DIR_TMP).SubFolders);
    for (; !d.atEnd(); d.moveNext()) { if (/^drop_SVW/.test(d.item().Name)) { try { d.item().Delete(true); } catch (y) {} } }
    DROP.dir = DIR_TMP + "\\drop_" + newToken(); ensureDir(DROP.dir);
    sh.Run('"' + ps + '" -NoProfile -NonInteractive -ExecutionPolicy Bypass -STA -WindowStyle Hidden -File "' + script + '" -Dir "' + DROP.dir + '" -Lib "' + lib + '" -Title "' + String(document.title).replace(/"/g, "") + '"', 0, false);
    DROP.helper = "starting"; DROP.startedAt = new Date().getTime();
  } catch (e) { DROP.helper = "error"; DROP.startedAt = new Date().getTime(); DEBUG_ERRORS.push("ricevitore trascinamento: " + (e.message || e)); }
}
/* pronto? controlla anche gli errori del ricevitore (finiscono nel Report debug) */
function dropHelperReady() {
  if (DROP.helper === "ready") return true;
  if (DROP.helper !== "starting" || !DROP.dir) return false;
  if (fso.FileExists(DROP.dir + "\\ready.flag")) { DROP.helper = "ready"; return true; }
  if (fso.FileExists(DROP.dir + "\\error.txt")) {
    DROP.helper = "error";
    try { DEBUG_ERRORS.push("ricevitore trascinamento: " + readUtf8(DROP.dir + "\\error.txt").substring(0, 600)); } catch (e) {}
  } else if (new Date().getTime() - DROP.startedAt > 60000) { DROP.helper = "error"; DEBUG_ERRORS.push("ricevitore trascinamento: non si e' avviato in 60 s"); }
  return false;
}
function dropHelperStop() { if (DROP.dir && DROP.helper === "ready") { try { writeAscii(DROP.dir + "\\quit.flag", "1"); } catch (e) {} } }

/* posizione del mecha nell'overlay (stessa logica di preserveAspectRatio="xMidYMid meet") */
function dropGeom() {
  var W = document.documentElement.clientWidth, H = document.documentElement.clientHeight, pad = 8;
  var w = W - 2 * pad, h = H - 2 * pad, s = Math.min(w / MECHA_W, h / MECHA_H);
  return { W: W, H: H, s: s, x: pad + (w - MECHA_W * s) / 2, y: pad + (h - MECHA_H * s) / 2 };
}
function dropText(a, b) {
  try { $("dropL1").textContent = TX(a); $("dropL2").textContent = TX(b); } catch (e) {}
}
function dropSetClass() {
  $("dropOv").className = "dropov" + (DROP.closingNow ? " out" : " turnin") + (DROP.hot ? " hot" : "") + (DROP.kind === "busy" || DROP.kind === "start" ? " wait" : "") + (DROP.gulp ? " gulp" : "");
}
function dropOpen(kind) {
  if (DROP.closing) { clearTimeout(DROP.closing); DROP.closing = null; DROP.closingNow = false; $("dropOv").style.display = "none"; DROP.active = false; }
  DROP.kind = kind;
  if (kind === "files") dropText("RILASCIA I FILE", "tra le gambe del mecha · anche cartelle e più file");
  else if (kind === "busy") dropText("ATTENDI", "c'è un lavoro in corso: trascina dopo");
  else if (kind === "start") dropText(DROP.helper === "starting" ? "UN ATTIMO..." : "NON DISPONIBILE", DROP.helper === "starting" ? "il ricevitore si sta avviando, poi rilascia" : "usa \u00ab+ File\u00bb o \u00abIncolla file\u00bb (dettagli nel Report debug)");
  else dropText("RILASCIA IL LINK", "va nella lista dei download");
  if (!DROP.active) { DROP.active = true; DROP.hot = false; DROP.gulp = false; $("dropOv").style.display = "block"; }
  dropSetClass();
}
function dropClose(now) {
  if (!DROP.active) return;
  DROP.active = false; DROP.signaled = false; DROP.hot = false;
  if (DROP.timer) { clearTimeout(DROP.timer); DROP.timer = null; }
  dropGhost(-1, -1);
  var fin = function () { DROP.closing = null; DROP.closingNow = false; DROP.gulp = false; $("dropOv").style.display = "none"; $("dropFile").style.display = "none"; dropSetClass(); };
  if (now) { fin(); return; }
  DROP.closingNow = true; dropSetClass();
  DROP.closing = setTimeout(fin, 760);   /* il mecha si rigira (0,6 s) e l'overlay sfuma */
}
/* anello luminoso sotto il puntatore: si vede subito che stai portando dei file (x < 0 = nascondi) */
function dropGhost(x, y) {
  var g = $("dropGhost");
  if (!g) return;
  if (x < 0 || DROP.signaled || DROP.anim) { g.style.display = "none"; return; }
  g.style.left = x + "px"; g.style.top = y + "px"; g.style.display = "block";
}
/* solo senza ricevitore: se il trascinamento esce dalla finestra senza rilascio */
function dropKeepAlive() {
  if (DROP.timer) clearTimeout(DROP.timer);
  DROP.timer = setTimeout(function () { DROP.timer = null; if (!DROP.signaled && !DROP.anim) dropClose(false); }, 2500);
}
/* chiede al ricevitore di mettersi sopra la finestra, con la botola in pixel CSS */
function dropSignal() {
  var g = dropGeom(), z = DROP_ZONE;
  var t = [g.W, g.H, Math.round(g.x + z[0] * g.s), Math.round(g.y + z[1] * g.s), Math.round(z[2] * g.s), Math.round(z[3] * g.s), LANG].join(" ");
  try {
    var tmp = DROP.dir + "\\show.tmp", fin = DROP.dir + "\\show.txt";
    tryDelete(DROP.dir + "\\leave.flag");
    /* la richiesta precedente non e' ancora stata presa: non la tocco (riscriverla la bloccava) */
    if (!fso.FileExists(fin)) {
      writeAscii(tmp, t); fso.MoveFile(tmp, fin);
      if (!DROP.signaled) DROP.signalAt = new Date().getTime();
    }
    DROP.signaled = true; DROP.polls = 0; dropGhost(-1, -1);
  } catch (e) { DEBUG_ERRORS.push("trascinamento show: " + (e.message || e)); }
  if (DROP.timer) { clearTimeout(DROP.timer); DROP.timer = null; }
  if (!DROP.poll) DROP.poll = setInterval(dropPoll, 50);
}
function dropPoll() {
  var d = DROP.dir;
  try {
    var got = [], e = new Enumerator(fso.GetFolder(d).Files);
    for (; !e.atEnd(); e.moveNext()) { var n = e.item().Name; if (/^drop_.*\.txt$/i.test(n)) got.push(e.item().Path); }
    got.sort();
    for (var i = 0; i < got.length; i++) {
      var txt = readUtf8(got[i]); tryDelete(got[i]);
      var lines = txt.split(/\r?\n/), x = -1, y = -1, paths = [], j;
      for (j = 0; j < lines.length; j++) {
        var l = lines[j];
        if (j === 0 && /^@-?\d+,-?\d+$/.test(l)) { x = parseInt(l.substring(1), 10); y = parseInt(l.substring(l.indexOf(",") + 1), 10); }
        else if (l) paths.push(l);
      }
      if (paths.length) dropReceive(paths, x, y);
    }
    /* il ricevitore non ha raccolto la richiesta: e' caduto, torno al funzionamento senza */
    if (DROP.signaled && fso.FileExists(d + "\\show.txt") && new Date().getTime() - DROP.signalAt > 2000) {
      tryDelete(d + "\\show.txt"); DROP.helper = "error"; DEBUG_ERRORS.push("ricevitore trascinamento: non risponde");
      DROP.signaled = false; dropClose(false);
    }
    if (fso.FileExists(d + "\\leave.flag")) { tryDelete(d + "\\leave.flag"); if (!DROP.anim) dropClose(false); }
    var hot = DROP.active && fso.FileExists(d + "\\in.flag");
    if (hot !== DROP.hot && !DROP.anim) { DROP.hot = hot; dropSetClass(); }
  } catch (x2) {}
  /* fuori dal trascinamento continuo ancora un po' (rilasci in ritardo), poi mi fermo */
  if (!DROP.active && !DROP.anim && ++DROP.polls > 40) { clearInterval(DROP.poll); DROP.poll = null; }
}
/* il file vola nella botola, la botola lampeggia, il mecha si rigira; poi i file entrano in lista */
function dropReceive(paths, x, y) {
  if (state.busy) { dropClose(false); showMsg("Attendi la fine del lavoro in corso, poi trascina di nuovo.", "err"); return; }
  if (DROP.anim) { setTimeout(function () { cvAddDropped(paths); }, 1300); return; }
  var g = dropGeom(), name = paths.length === 1 ? fso.GetFileName(String(paths[0]).replace(/[\\\/]+$/, "")) : paths.length + " elementi";
  if (!DROP.active) dropOpen("files");
  DROP.anim = true; DROP.hot = true; dropSetClass(); dropGhost(-1, -1);
  dropText("RICEVUTO", name);
  var tx = g.x + DROP_MOUTH[0] * g.s, ty = g.y + DROP_MOUTH[1] * g.s;
  if (!(x >= 0 && y >= 0 && x <= g.W && y <= g.H)) { x = tx; y = g.y + 560 * g.s; }
  var f = $("dropFile");
  $("dropFileName").innerText = name;
  f.className = "dropfile"; f.style.left = x + "px"; f.style.top = y + "px"; f.style.display = "block";
  var dummy = f.offsetWidth;   /* forza il disegno prima della transizione */
  setTimeout(function () { f.className = "dropfile fly"; f.style.left = Math.round(tx) + "px"; f.style.top = Math.round(ty) + "px"; }, 30);
  setTimeout(function () { DROP.gulp = true; dropSetClass(); }, 640);
  setTimeout(function () {
    DROP.anim = false; dropClose(false);
    setTimeout(function () { cvAddDropped(paths); }, 800);   /* dopo che il mecha si e' rigirato */
  }, 1250);
}

document.ondragenter = document.ondragover = function (e) {
  var ev = e || window.event;
  if (ev) { ev.returnValue = false; if (ev.preventDefault) ev.preventDefault(); try { ev.dataTransfer.dropEffect = "copy"; } catch (x) {} }
  if (DROP.anim) return false;
  var files = dropTypes(ev).files;
  if (files && state.busy) dropOpen("busy");
  else if (files && !window.DCVT_MAC) {
    if (dropHelperReady()) {
      if (DROP.kind !== "files" || !DROP.active) dropOpen("files");
      /* se l'HTML continua a ricevere il trascinamento il ricevitore non mi copre: richiedo (max 1 volta al secondo) */
      if (!DROP.signaled || new Date().getTime() - DROP.signalAt > 1200) dropSignal();
    }
    else {
      /* ricevitore caduto o fallito: riprovo, ma al massimo ogni 30 secondi */
      if (DROP.helper === "error" && new Date().getTime() - DROP.startedAt > 30000) DROP.helper = "off";
      if (DROP.helper === "off") dropHelperStart();
      if (!DROP.active || DROP.kind !== "start") dropOpen("start");
    }
  } else if (files) { if (!DROP.active || DROP.kind !== "files") dropOpen("files"); }
  else if (!DROP.active || DROP.kind !== "link") dropOpen("link");
  if (!DROP.signaled) dropKeepAlive();
  if (files && ev) dropGhost(ev.clientX, ev.clientY);
  return false;
};
document.ondragleave = function (e) {
  var ev = e || window.event;
  if (DROP.signaled || DROP.anim) return;     /* con il ricevitore sopra la finestra decide lui */
  if (ev && (ev.clientX <= 0 || ev.clientY <= 0 || ev.clientX >= document.documentElement.clientWidth || ev.clientY >= document.documentElement.clientHeight)) dropClose(false);
};
document.ondrop = function (e) {
  var ev = e || window.event, t = "", paths = [];
  if (ev) { ev.returnValue = false; if (ev.preventDefault) ev.preventDefault(); }
  try { paths = dropFilePaths(ev); } catch (x) {}
  if (paths.length) { dropReceive(paths, ev ? ev.clientX : -1, ev ? ev.clientY : -1); return false; }
  var files = dropTypes(ev).files;
  dropClose(false);
  if (files && state.busy) { showMsg("Attendi la fine del lavoro in corso.", "err"); return false; }
  if (files && !window.DCVT_MAC) {
    showMsg(DROP.helper === "error" || DROP.helper === "none"
      ? "Il ricevitore del trascinamento non parte su questo PC (dettagli nel Report debug): usa «+ File» oppure copia i file in Esplora file e premi «Incolla file»."
      : "Il ricevitore del trascinamento si stava avviando: trascina di nuovo i file.", "err");
    return false;
  }
  try { t = ev.dataTransfer.getData("URL") || ev.dataTransfer.getData("Text") || ""; } catch (e2) {}
  if (t && !state.busy) { if (state.tab !== "dl") showTab("dl"); parseText(t); }
  return false;
};
/* percorsi dei file rilasciati sull'HTML (Windows non li fornisce: la versione Mac sostituisce questa funzione) */
function dropFilePaths(ev) { return []; }

function cvOutDir(it) {
  if ($("cvOutMode").value === "folder" || it.kind === "link" || it.fromLink) return cv.folder;
  /* animazione di immagini: accanto agli originali (it.path e' la copia temporanea, cancellata al riavvio) */
  if (it.seq && it.seq.srcDir) return it.seq.srcDir;
  return fso.GetParentFolderName(it.path);
}

function onGoConv() { if (state.busy) { if (state.job === "convert") cancel(); } else cvStart(); }

function cvStart() {
  $("msg").style.display = "none";
  var pend = 0, i;
  for (i = 0; i < cv.items.length; i++) if (cv.items[i].status !== "ok") pend++;
  if (!cv.items.length) { showMsg("Aggiungi almeno un file o un link.", "err"); return; }
  if (!pend) { showMsg("Tutti i file in lista sono già stati convertiti.", "info"); return; }
  var ffmpeg = findTool("ffmpeg.exe");
  if (!ffmpeg || !findTool("ffprobe.exe")) { showMsg("ffmpeg non trovato: premi «Installa / aggiorna componenti» in basso.", "err"); return; }
  ensureDir(DIR_TMP);
  if (!cvEncodersOk(ffmpeg)) { showMsg("Il tuo ffmpeg non ha il codec " + encNames(missingEncoders(cvSpec().enc)) + " per " + cvSpec().name + ": premi \u00abInstalla / aggiorna componenti\u00bb.", "err"); refreshCompButton(); return; }
  if ($("cvKey").value === "custom" && !hexColor($("cvKeyColor").value)) { showMsg("Colore dello sfondo non valido: usa #RRGGBB.", "err"); return; }
  if (($("cvOutMode").value === "folder") && !fso.FolderExists(cv.folder)) { showMsg("La cartella di destinazione non esiste: scegline un'altra.", "err"); return; }
  for (i = 0; i < cv.items.length; i++) if (cv.items[i].status !== "ok") { cv.items[i].status = "wait"; cv.items[i].error = ""; }
  saveSettings();
  cleanupTmp();
  state.cancelled = false; cv.ok = 0; cv.err = 0;
  setBusy(true, "convert");
  cvRender();
  showStatus();
  cvNext();
}

function cvNext() {
  var it = null, i, done = 0;
  for (i = 0; i < cv.items.length; i++) { if (cv.items[i].status === "wait" && !it) it = cv.items[i]; if (cv.items[i].status !== "wait") done++; }
  if (!it || state.cancelled) { cvDone(); return; }
  state.current = it;
  $("overall").innerText = T("File {0} di {1}", done + 1, cv.items.length) + "  •  " + (it.name || it.title);
  $("fill").style.width = "0%"; $("pct").innerText = TX("In preparazione..."); $("spd").innerText = ""; $("file").innerText = "";
  setBadge(it, "run");
  if (it.kind === "link" && !it.path) cvRunDownload(it); else cvRunEncode(it);
}

/* fase 1 per i link (Google Drive ecc.): scarica il file ORIGINALE con yt-dlp in una cartella temporanea */
/* link diretto a un'immagine (o riconosciuto come immagine dopo «Unsupported URL»): curl, non yt-dlp */
function cvRunImageDl(it) {
  var curl = curlExe();
  if (!curl) { cvFail(it, T("curl non trovato: per scaricare le immagini serve Windows 10 (1803) o successivo.")); return; }
  var t = newToken(), SEP = window.DCVT_MAC ? "/" : "\\";
  it.tmpDir = DIR_TMP + SEP + "link_" + t; it.imgDl = true; it.isImg = true;
  state.files = { cfg: DIR_TMP + SEP + "cvimg_" + t + ".conf", urls: "", log: DIR_TMP + SEP + "cvimg_" + t + ".log" };
  var asciiUrl = String(it.url).replace(/[^\x20-\x7e]/g, function (c) { return encodeURIComponent(c); });
  var q = function (v) { return '"' + String(v).replace(/\\/g, "\\\\").replace(/"/g, '\\"') + '"'; };
  try {
    ensureDir(DIR_TMP); ensureDir(it.tmpDir);
    writeUtf8NoBom(state.files.cfg, ["url = " + q(asciiUrl), "output = " + q(it.tmpDir + SEP + "sorgente.bin"), "location", "fail", "show-error", "silent",
      "max-redirs = 10", "connect-timeout = 30", "max-time = 900", "user-agent = " + q("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Safari/537.36")].join("\r\n") + "\r\n");
  } catch (e) { cvFail(it, T("Impossibile preparare il download dell'immagine: {0}", e.message || e)); return; }
  state.cvStage = "dl"; state.lastErr = "";
  $("pct").innerText = T("Scarico l'immagine..."); state.lastHttp = "";
  state.killProc = fso.GetFileName(curl).replace(/'/g, ""); state.killTag = baseName(state.files.cfg);
  runCommand('"' + cmdPath(curl) + '" -K "' + state.files.cfg + '"');
}
function cvRunDownload(it) {
  if (it.imgLink) { cvRunImageDl(it); return; }
  var exe = ytDlpExe();
  if (!exe) { cvFail(it, "yt-dlp non trovato: premi «Installa / aggiorna componenti»."); return; }
  var t = newToken();
  it.tmpDir = DIR_TMP + "\\link_" + t;
  state.files = { cfg: DIR_TMP + "\\cvdl_" + t + ".conf", urls: DIR_TMP + "\\cvdl_" + t + "_link.txt", log: DIR_TMP + "\\cvdl_" + t + ".log" };
  try {
    ensureDir(it.tmpDir);
    var o = ["--newline", "--no-colors", "--no-playlist", "--no-mtime", "--windows-filenames",
             "-P " + cfgQuote(it.tmpDir), '-o "sorgente.%(ext)s"', '-f "source/bv*+ba/b"', "--print-to-file " + cfgQuote("%(title)s") + " " + cfgQuote(it.tmpDir + "\\titolo.txt")];
    var ff = findTool("ffmpeg.exe"); if (ff) o.push("--ffmpeg-location " + cfgQuote(ff));
    writeUtf8(state.files.cfg, o.join("\r\n") + "\r\n");
    writeAscii(state.files.urls, it.url + "\r\n");
  } catch (e) { cvFail(it, "Impossibile preparare il download: " + (e.message || e)); return; }
  state.cvStage = "dl";
  $("pct").innerText = TX("Scarico il file originale...");
  state.killProc = fso.GetFileName(exe).replace(/'/g, ""); state.killTag = baseName(state.files.cfg);
  runCommand('"' + exe + '" --ignore-config --config-locations "' + state.files.cfg + '" -a "' + state.files.urls + '"');
}

/* fase 2: conversione con ffmpeg in un file temporaneo nella cartella di destinazione, poi rinomina */
function cvRunEncode(it) {
  if (!it.info || !it.info.ok || it.kind === "seq") cvProbe(it);   /* sequenze: durata ricalcolata con gli FPS attuali */
  if (!it.info.ok) { cvRender(); cvFail(it, it.info.err || "File non leggibile da ffmpeg."); return; }
  var F = cvSpec(), dir = cvOutDir(it);
  if (!fso.FolderExists(dir)) { cvFail(it, "Cartella di destinazione inesistente: " + dir); return; }
  if ((it.kind === "img" || (it.seq && it.seq.list)) && F.remux) { cvFail(it, "Il cambio contenitore non si applica alle immagini: scegli un altro formato."); return; }
  var dirP = safePath(dir), inP;
  if (it.kind === "seq") {
    var sd = safePath(it.seq.dir);
    inP = sd && it.seq.prefix.indexOf("%") < 0 ? sd + "\\" + it.seq.pattern.substring(it.seq.pattern.lastIndexOf("\\") + 1) : "";
  } else inP = safePath(it.path);
  if (!inP || !dirP) { cvFail(it, "Il percorso contiene il simbolo %: rinomina il file o la cartella."); return; }
  var t = newToken(), outArg;
  it.outFinal = cvFinalName(dir, it);
  if (F.seq && !cvSingleOut(it, F)) {
    /* sequenza in uscita: fotogrammi in una cartella temporanea, rinominata alla fine */
    it.outTmp = dirP + "\\.cvout_" + t;
    try { fso.CreateFolder(it.outTmp); } catch (e) { cvFail(it, "Impossibile creare la cartella dei fotogrammi: " + (e.message || e)); return; }
    it.outIsDir = true;
    it.frameBase = String(it.outBase).replace(/%/g, "");
    outArg = it.outTmp + "\\" + it.frameBase + "_%05d." + F.seq;
  } else { it.outTmp = dirP + "\\.cvout_" + t + ".tmp"; it.outIsDir = false; outArg = it.outTmp; }
  var args = cvBuildArgs(it, inP, outArg);
  if (args.mem) { cvDiscard(it); cvFail(it, args.mem); return; }
  it.alphaOut = args.alpha; it.outDur = args.dur;
  state.files = { cfg: "", urls: "", log: DIR_TMP + "\\cv_" + t + ".log" };
  state.cvStage = "enc"; state.cvErr = ""; state.cvLastTime = 0;
  state.killProc = "ffmpeg.exe"; state.killTag = ".cvout_" + t;
  try { writeUtf8(DIR_APP + "\\ultimo_ffmpeg.txt", '"' + findTool("ffmpeg.exe") + '" ' + args.line); } catch (e) {}
  $("file").innerText = TX("\u2192 " + fso.GetFileName(it.outFinal) + (F.seq ? "\\" : "") + (args.alpha ? "  (con canale alfa)" : "") + (args.copied ? "  (copia senza perdita)" : ""));
  runCommand('"' + findTool("ffmpeg.exe") + '" ' + args.line);
}
/* elimina l'uscita temporanea (file o cartella di fotogrammi) */
function cvDiscard(it) {
  if (!it || !it.outTmp) return;
  if (it.outIsDir) { try { if (fso.FolderExists(it.outTmp)) fso.DeleteFolder(it.outTmp, true); } catch (e) {} }
  else tryDelete(it.outTmp);
}

function cvHandleLine(l) {
  var m = l.match(/^(\w+)=(.*)$/);
  if (!m) { if (/\S/.test(l)) state.cvErr = l.substring(0, 300); return ""; }
  var k = m[1], v = m[2], it = state.current;
  if (k === "out_time_us" || k === "out_time_ms") { var s = (parseFloat(v) || 0) / 1000000; if (s > 0) state.cvLastTime = s; }
  else if (k === "out_time") { var tm = v.match(/(\d+):(\d+):([\d.]+)/); if (tm) state.cvLastTime = (+tm[1]) * 3600 + (+tm[2]) * 60 + parseFloat(tm[3]); }
  else if (k === "speed") $("spd").innerText = v === "N/A" ? "" : T("velocità {0}", v.replace(/\s/g, ""));
  else if (k === "progress") {
    var dur = it ? (it.outDur || (it.info ? it.info.dur : 0)) : 0, pc = dur > 0 ? Math.min(100, state.cvLastTime / dur * 100) : 0;
    $("fill").style.width = (dur > 0 ? pc : 50) + "%";
    $("pct").innerText = TX(dur > 0 ? Math.floor(pc) + "%  •  " + fmtTime(state.cvLastTime) + " / " + fmtTime(dur) : fmtTime(state.cvLastTime));
  }
  return "";
}

function cvStepDone(ok) {
  var it = state.current;
  if (state.cvStage === "dl") {
    if (state.cancelled) { cvCleanItem(it); setBadge(it, "stop"); cvDone(); return; }
    var src = "";
    if (it.imgDl) {
      /* immagine scaricata con curl: estensione dal contenuto, nome dal link */
      it.imgDl = false; it.isImg = false;
      var bin = it.tmpDir + (window.DCVT_MAC ? "/" : "\\") + "sorgente.bin", ix = "";
      try { if (ok && fso.FileExists(bin) && fso.GetFile(bin).Size > 0) ix = imgSniffExt(bin); } catch (xi) {}
      if (!ix) { cvFail(it, ok ? T("Il link non porta a un'immagine (il server ha risposto con una pagina web o un file sconosciuto).") : (state.lastErr || T("Immagine non scaricata (link scaduto o protetto?)."))); return; }
      try { fso.MoveFile(bin, it.tmpDir + (window.DCVT_MAC ? "/" : "\\") + "sorgente." + ix); } catch (xm) { cvFail(it, "Impossibile salvare l'immagine: " + (xm.message || xm)); return; }
      var lp = String(it.url).split(/[?#]/)[0], ln = lp.substring(lp.lastIndexOf("/") + 1).replace(/\.[^.]*$/, "");
      try { ln = decodeURIComponent(ln); } catch (xd) {}
      it.srcTitle = cleanName(ln) || "immagine"; it.fromLink = true;
    } else if (!ok && !it.imgTried && /Unsupported URL/i.test(state.lastErr || "") && /^image\//.test(it.imgTried = urlContentType(it.url) || "")) {
      /* yt-dlp non lo conosce ma e' un'immagine (link senza estensione) */
      cvCleanItem(it); it.imgLink = true; cvRunImageDl(it); return;
    }
    try {
      var e = new Enumerator(fso.GetFolder(it.tmpDir).Files);
      for (; !e.atEnd(); e.moveNext()) { var nm = e.item().Name; if (/^sorgente\./i.test(nm) && !/\.(part|ytdl|tmp)$/i.test(nm)) src = e.item().Path; }
      if (fso.FileExists(it.tmpDir + "\\titolo.txt")) it.srcTitle = readUtf8(it.tmpDir + "\\titolo.txt").replace(/\s+$/, "");
    } catch (x) {}
    if (!ok || !src) { cvFail(it, state.lastErr || "Download non riuscito (il file è condiviso con «Chiunque abbia il link»?)"); return; }
    it.path = src; it.title = it.srcTitle || it.title;
    if (it.fromLink) { it.kind = "img"; cvProbe(it); } else it.info = probeFile(src);
    cvRender(); setBadge(it, "run");
    cvRunEncode(it);
    return;
  }
  /* fase di conversione */
  var good = false, nFrames = 0;
  try {
    if (it.outIsDir) { nFrames = fso.FolderExists(it.outTmp) ? fso.GetFolder(it.outTmp).Files.Count : 0; good = ok && nFrames > 0; }
    else good = ok && it.outTmp && fso.FileExists(it.outTmp) && fso.GetFile(it.outTmp).Size > 0;
  } catch (x0) { good = false; }
  if (state.cancelled) { cvDiscard(it); cvCleanItem(it); setBadge(it, "stop"); cvDone(); return; }
  if (!good) { cvDiscard(it); cvFail(it, "ffmpeg: " + (state.cvErr || "conversione non riuscita")); return; }
  try {
    it.outFinal = cvFinalName(fso.GetParentFolderName(it.outFinal), it);
    if (it.outIsDir) fso.MoveFolder(it.outTmp, it.outFinal); else fso.MoveFile(it.outTmp, it.outFinal);
  } catch (e2) { cvDiscard(it); cvFail(it, "Impossibile salvare il risultato: " + (e2.message || e2)); return; }
  /* la cartella ha preso un altro nome («X (2)_png»): anche i fotogrammi dentro lo seguono */
  if (it.outIsDir && it.frameBase && it.outBase !== it.frameBase) {
    try {
      /* prima l'elenco, poi MoveFile: funziona anche sul Mac (lo shim non ha il setter di Name) */
      var fe = new Enumerator(fso.GetFolder(it.outFinal).Files), nb = String(it.outBase).replace(/%/g, ""), ren = [], ri, SEPR = window.DCVT_MAC ? "/" : "\\";
      for (; !fe.atEnd(); fe.moveNext()) { var fn = fe.item().Name; if (fn.indexOf(it.frameBase + "_") === 0) ren.push(fn); }
      for (ri = 0; ri < ren.length; ri++) fso.MoveFile(it.outFinal + SEPR + ren[ri], it.outFinal + SEPR + nb + ren[ri].substring(it.frameBase.length));
    } catch (e3) { DEBUG_ERRORS.push("rinomina fotogrammi: " + (e3.message || e3)); }
  }
  cvCleanItem(it);
  setBadge(it, "ok", "Salvato: " + it.outFinal + (it.outIsDir ? " (" + nFrames + " fotogrammi)" : "") + (it.alphaOut ? " (con canale alfa)" : ""));
  cv.ok++;
  $("fill").style.width = "100%";
  setTimeout(cvNext, 50);
}
function cvCleanItem(it) {
  if ((it.kind === "link" || it.fromLink) && it.tmpDir) {
    try { if (fso.FolderExists(it.tmpDir)) fso.DeleteFolder(it.tmpDir, true); } catch (e) {}
    it.tmpDir = "";
    if (it.status !== "ok") { it.path = ""; it.info = null; if (it.fromLink) { it.kind = "link"; it.fromLink = false; } }
  }
}
function cvFail(it, why) {
  cvCleanItem(it);
  setBadge(it, "err", why);
  DEBUG_ERRORS.push("convert: " + why);
  cv.err++;
  setTimeout(cvNext, 50);
}
function cvDone() {
  if (state.timer) { clearInterval(state.timer); state.timer = null; }
  setBusy(false);
  cvRender();
  cleanupTmp();
  if (state.cancelled) { showMsg("Conversione annullata. I file non completati restano in lista.", "info"); return; }
  if (!cv.err) {
    $("pct").innerText = TX("Completato"); $("spd").innerText = "";
    showMsg("Fatto! " + cv.ok + (cv.ok === 1 ? " file creato" : " file creati") + ($("cvOutMode").value === "folder" ? " in " + cv.folder : " accanto agli originali") + ".", "ok");
  } else {
    var first = "";
    for (var i = 0; i < cv.items.length && !first; i++) if (cv.items[i].status === "err") first = "\n\nPrimo errore: " + cv.items[i].error;
    showMsg(cv.ok + " convertiti, " + cv.err + " con errori." + first, "err");
  }
}

/* ---------- UI generale ---------- */
function setBusy(b, job) {
  state.busy = b; state.job = b ? job : "";
  $("root").className = b ? "wrap locked" : "wrap";
  var els = document.getElementsByTagName("*");
  for (var i = 0; i < els.length; i++) if (/\blockable\b/.test(els[i].className) && els[i].tagName !== "DIV") els[i].disabled = b;
  var g1 = $("go"), g2 = $("goConv");
  g1.className = (b && job === "download") ? "go stop" : "go";
  g1.innerText = TX((b && job === "download") ? "Annulla" : (b && job === "setup" ? "Installazione componenti..." : "Scarica"));
  g1.disabled = b && job !== "download";
  g2.className = (b && job === "convert") ? "go stop" : "go";
  g2.innerText = TX((b && job === "convert") ? "Annulla" : (b && job === "setup" ? "Installazione componenti..." : cvGoLabel()));
  goFit(g2); goFit(g1);
  g2.disabled = b && job !== "convert";
}
function confirmT(m) { return window.confirm(TX(m)); }
function showMsg(text, kind) {
  var el = $("msg"); el.className = "msg " + kind; el.innerText = TX(text); el.style.display = "block";
  layoutRefresh();
  try { tickerNotice(text); } catch (e) {}
  try { logEvent("app", text, kind === "err" ? "err" : kind === "ok" ? "ok" : "info"); } catch (e2) {}
}

window.onbeforeunload = function () {
  if (state.busy && (state.job === "download" || state.job === "convert")) return "C'\u00e8 un lavoro in corso: chiudendo verr\u00e0 annullato.";
  if (state.busy && state.job === "setup") return "L'installazione dei componenti \u00e8 in corso: se chiudi continuer\u00e0 in background, ma non vedrai l'esito.";
};
/* chiudendo la finestra: salva le impostazioni e non lasciare download fantasma */
window.onunload = function () {
  saveSettings();
  try { ckCleanup(true, 60000); } catch (eck) {}
  dropHelperStop();
  if (state.busy && (state.job === "download" || state.job === "convert")) {
    state.cancelled = true; killJob(true);
    try { if (state.current && state.current.outTmp) cvDiscard(state.current); } catch (e) {}
    try { if (state.current && state.current.tmpDir && fso.FolderExists(state.current.tmpDir)) fso.DeleteFolder(state.current.tmpDir, true); } catch (e2) {}
  }
  cleanupTmp();
};

/* ---------- estensione Chrome: i link delle schede aperte arrivano nella lista ---------- */
/* EXT_FILES_INIZIO (generato da tools/embed.py) */
var EXT_FILES = {"icon128.png":"b64:","icon16.png":"b64:","icon32.png":"b64:","icon48.png":"b64:","lingua.js":"/* Lingua dell'estensione: la riscrive DownConvertron quando installi l'estensione o cambi lingua nell'app.\n   Copyright (C) 2026 Daniele Moretti (Welsho) - GPL-3.0-or-later */\nvar DCVT_LANG = \"it\";\n","manifest.json":"{\n  \"manifest_version\": 3,\n  \"name\": \"DownConvertron - Link Grabber\",\n  \"short_name\": \"DownConvertron\",\n  \"version\": \"7.0\",\n  \"description\": \"Collects video links of the 1700+ sites supported by yt-dlp and the images of the page, sends them to DownConvertron or downloads images right away. designed by Welsho\",\n  \"author\": \"Daniele Moretti (Welsho)\",\n  \"action\": { \"default_popup\": \"popup.html\", \"default_title\": \"DownConvertron\",\n              \"default_icon\": { \"16\": \"icon16.png\", \"32\": \"icon32.png\", \"48\": \"icon48.png\", \"128\": \"icon128.png\" } },\n  \"icons\": { \"16\": \"icon16.png\", \"32\": \"icon32.png\", \"48\": \"icon48.png\", \"128\": \"icon128.png\" },\n  \"permissions\": [\"tabs\", \"activeTab\", \"scripting\", \"clipboardWrite\", \"downloads\", \"nativeMessaging\", \"cookies\"],\n  \"host_permissions\": [\"<all_urls>\"],\n  \"key\": \"\"\n}\n","popup.css":"/* DownConvertron - estensione Chrome (designed by Welsho) - Copyright (C) 2026 Daniele Moretti (Welsho) - GPL-3.0-or-later */\nbody { width: 440px; margin: 0; padding: 10px; font: 12px \"Segoe UI\", \"Helvetica Neue\", \"Microsoft YaHei\", \"PingFang SC\", Arial, sans-serif; color: #d3dbe0;\n       background: linear-gradient(180deg, #1c2126, #0d1013); }\nheader { display: flex; align-items: center; gap: 10px; padding: 8px; border-radius: 12px; border: 1px solid #050607;\n         background: linear-gradient(180deg, #6f7883, #3a4148 55%, #262b30); box-shadow: inset 0 1px 0 #9aa3ad; }\n.logo { flex: 0 0 auto; padding: 0; border: 0; border-radius: 9px; background: none; cursor: pointer; line-height: 0; transition: transform .12s; }\n.logo img { width: 44px; height: 44px; border-radius: 9px; box-shadow: 0 0 8px rgba(57,255,106,0.5); }\n.logo:hover { transform: scale(1.08); }\n.logo:hover img { box-shadow: 0 0 14px rgba(57,255,106,0.95); }\n.lcd { flex: 1; min-width: 0; padding: 5px 9px; border-radius: 8px; background: #031006; border: 1px solid #000; box-shadow: inset 0 0 10px rgba(57,255,106,0.25);\n       color: #39ff6a; font-family: \"Lucida Console\", Consolas, Menlo, monospace; text-shadow: 0 0 5px rgba(57,255,106,0.7); }\n.lcd .tag { font-size: 9px; color: #ff8a1f; letter-spacing: 1px; }\n.lcd .ttl { font-size: 15px; font-weight: bold; letter-spacing: 2px; }\n.lcd .sub { font-size: 10.5px; color: #9dffb6; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.quick { margin-top: 9px; padding: 8px; border-radius: 10px; background: linear-gradient(180deg, #262b30, #171a1e); border: 1px solid #050607; }\n.seg { display: flex; padding: 3px; border-radius: 16px; background: #0b0d10; border: 1px solid #050607; }\n.seg button { flex: 1; height: 26px; border: 0; border-radius: 13px; cursor: pointer; font: bold 11.5px inherit; font-family: inherit; color: #c9d4e6; background: transparent; }\n.seg button.on { color: #fff; text-shadow: 0 -1px 0 #4a0610; background: linear-gradient(180deg, #ff6f80 0%, #d42a40 45%, #b3182e 55%, #7d0d1e 100%); }\n.qrow { display: flex; gap: 8px; margin-top: 7px; }\n.qrow label { flex: 1; font-size: 10px; font-weight: bold; color: #93a1aa; text-transform: uppercase; letter-spacing: 0.6px; }\n.qrow select { display: block; width: 100%; height: 26px; margin-top: 3px; border-radius: 7px; border: 1px solid #0d2a15; background: #031006; color: #c8ffd6; font: 12px inherit; font-family: inherit; text-transform: none; }\n.qnote { margin-top: 7px; font-size: 11px; color: #9aa8b0; }\n.opts { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 9px 2px 4px; font-size: 11.5px; }\n.opts input, .row input { vertical-align: middle; margin: 0 5px 0 0; accent-color: #39ff6a; }\nsection { margin-top: 8px; }\n.sh { display: flex; justify-content: space-between; align-items: center; font-weight: bold; color: #93a1aa; text-transform: uppercase; font-size: 10.5px; letter-spacing: 1px; margin-bottom: 4px; }\n.sh b { color: #f2c230; }\n.quick .sh { margin-bottom: 6px; }\n.lista { max-height: 150px; overflow-y: auto; border-radius: 8px; background: #031006; border: 1px solid #0d2a15; }\n.row { display: flex; align-items: flex-start; padding: 5px 7px; border-bottom: 1px solid #0d2a15; cursor: pointer; }\n.row:last-child { border-bottom: 0; }\n.row .t { flex: 1; min-width: 0; }\n.row .n { color: #c8ffd6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.row .u { color: #4f7a5a; font-size: 10.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.badge { flex: 0 0 auto; margin-left: 6px; padding: 1px 6px; border-radius: 8px; font-size: 9.5px; font-weight: bold; color: #0a1a0e; background: #39ff6a; }\n.vuoto { padding: 10px; color: #4f7a5a; text-align: center; }\n.mini { border: 1px solid #050607; border-radius: 10px; padding: 2px 9px; font-size: 10.5px; cursor: pointer; color: #e8eef2; background: linear-gradient(180deg, #8a939b, #3a4047); }\n.go { width: 100%; height: 40px; margin-top: 10px; border: 1px solid #050607; border-radius: 20px; cursor: pointer; font-weight: bold; font-size: 13.5px; font-family: inherit;\n      letter-spacing: 1px; color: #fff; text-shadow: 0 -1px 0 #4a0610; background: linear-gradient(180deg, #ff6f80 0%, #d42a40 45%, #b3182e 55%, #7d0d1e 100%); }\n.go:disabled { opacity: 0.5; cursor: default; }\n.gobar { display: flex; gap: 8px; margin-top: 10px; }\n.gobar .go { flex: 1; min-width: 0; margin-top: 0; padding: 0 6px; font-size: 12.5px; letter-spacing: 0.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.go.hot { color: #031006; text-shadow: none; background: linear-gradient(180deg, #b9ffcb 0%, #39ff6a 50%, #1fae45 100%); }\n.nota { margin-top: 7px; font-size: 11px; color: #9aa8b0; line-height: 1.4; }\n.nota.ok { color: #39ff6a; font-weight: bold; }\n.nota.err { color: #ff6f80; font-weight: bold; }\n.griglia { display: flex; flex-wrap: wrap; gap: 5px; max-height: 128px; overflow-y: auto; padding: 5px; border-radius: 8px; background: #031006; border: 1px solid #0d2a15; }\n.griglia .vuoto { flex: 1; }\n.thumb { position: relative; width: 62px; height: 62px; border-radius: 6px; overflow: hidden; cursor: pointer; border: 2px solid #0d2a15; background: #0b0d10; }\n.thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }\n.thumb input { position: absolute; left: 2px; top: 2px; margin: 0; accent-color: #39ff6a; }\n.thumb.on { border-color: #39ff6a; box-shadow: 0 0 6px rgba(57,255,106,0.6); }\n.thumb .dim { position: absolute; left: 0; right: 0; bottom: 0; font-size: 8.5px; text-align: center; color: #c8ffd6; background: rgba(3,16,6,0.8); }\n.mini.hot { color: #031006; background: linear-gradient(180deg, #b9ffcb, #39ff6a); }\n.mini:disabled { opacity: 0.45; cursor: default; }\n/* Chrome mostra il popup alto al massimo 600 px e fa scorrere il resto: pulsanti e nota restano fissi in basso */\n.piede { position: sticky; bottom: 0; z-index: 5; margin: 0 -10px -10px; padding: 0 10px 10px; background: linear-gradient(180deg, rgba(13,16,19,0.92), #0d1013 30%); }\n.badge.warn { color: #1a0d02; background: #ff8a1f; }\n.avviso { margin: 0 0 4px; padding: 3px 7px; border-radius: 7px; font-size: 10.5px; line-height: 1.35; color: #ffd2a8; background: #2a1606; border: 1px solid #5a2f0a; }\n.loginbox { margin-top: 8px; padding: 8px 9px; border-radius: 10px; background: #2a1606; border: 1px solid #ff8a1f; color: #ffd2a8; font-size: 11px; line-height: 1.4; }\n.loginbox .lt { font-weight: bold; color: #ffb36b; font-size: 12px; }\n.loginbox .ll { margin: 4px 0; max-height: 64px; overflow: auto; color: #e8eef2; font-size: 10.5px; word-break: break-all; }\n.loginbox .go { margin-top: 7px; height: 34px; }\n.nota.warn { color: #ff8a1f; font-weight: bold; }\n","popup.html":"<!DOCTYPE html>\n<!-- DownConvertron - estensione Chrome (designed by Welsho)\n     Copyright (C) 2026 Daniele Moretti (Welsho) - GPL-3.0-or-later -->\n<html>\n<head>\n<meta charset=\"utf-8\">\n<title>DownConvertron<\/title>\n<link rel=\"stylesheet\" href=\"popup.css\">\n<\/head>\n<body>\n<header>\n  <button id=\"logo\" class=\"logo\" data-tt=\"apri\"><img src=\"icon48.png\" alt=\"\"><\/button>\n  <div class=\"lcd\">\n    <div class=\"tag\">MECHA v7.0<\/div>\n    <div class=\"ttl\">DOWNCONVERTRON<\/div>\n    <div class=\"sub\" id=\"stato\">...<\/div>\n  <\/div>\n<\/header>\n<div class=\"loginbox\" id=\"loginBox\" hidden>\n  <div class=\"lt\" id=\"loginTesto\"><\/div>\n  <div class=\"ll\" id=\"loginLista\"><\/div>\n  <div class=\"ln\" data-t=\"loginServeNota\"><\/div>\n  <button id=\"loginRiprova\" class=\"go hot\" data-t=\"loginRiprova\"><\/button>\n<\/div>\n<section class=\"quick\">\n  <div class=\"sh\"><span data-t=\"comeScaricare\"><\/span><\/div>\n  <div class=\"seg\">\n    <button data-m=\"app\" data-t=\"mApp\"><\/button><button data-m=\"video\" data-t=\"mVideo\"><\/button><button data-m=\"audio\" data-t=\"mAudio\"><\/button>\n  <\/div>\n  <div class=\"qrow\" id=\"qVideo\">\n    <label><span data-t=\"qualita\"><\/span><select id=\"vq\">\n      <option value=\"best\" data-t=\"qBest\"><\/option><option value=\"2160\">4K (2160p)<\/option><option value=\"1080\">Full HD (1080p)<\/option><option value=\"720\">HD (720p)<\/option><\/select><\/label>\n    <label><span data-t=\"file\"><\/span><select id=\"vc\">\n      <option value=\"mp4\">MP4<\/option><option value=\"mov\" data-t=\"cMov\"><\/option><option value=\"webm\">WebM<\/option><option value=\"mkv\">MKV<\/option><\/select><\/label>\n  <\/div>\n  <div class=\"qrow\" id=\"qAudio\">\n    <label class=\"wide\"><span data-t=\"formato\"><\/span><select id=\"ap\">\n      <option value=\"mp3|c320\" data-t=\"aMp3\"><\/option><option value=\"mp3|v0\" data-t=\"aMp3v\"><\/option><option value=\"m4a|c256\" data-t=\"aM4a\"><\/option>\n      <option value=\"wav|s16\" data-t=\"aWav\"><\/option><option value=\"flac|\" data-t=\"aFlac\"><\/option><\/select><\/label>\n  <\/div>\n  <div class=\"qnote\" id=\"qApp\" data-t=\"notaApp\"><\/div>\n<\/section>\n<div class=\"opts\">\n  <label><input type=\"checkbox\" id=\"tutteFinestre\"> <span data-t=\"tutteFinestre\"><\/span><\/label>\n  <label><input type=\"checkbox\" id=\"usaTitoli\"> <span data-t=\"usaTitoli\"><\/span><\/label>\n  <label><input type=\"checkbox\" id=\"apriDopo\"> <span data-t=\"apriDopo\"><\/span><\/label>\n  <label data-tt=\"usaLoginTt\"><input type=\"checkbox\" id=\"usaLogin\"> <span data-t=\"usaLogin\"><\/span><\/label>\n<\/div>\n<section>\n  <div class=\"sh\"><span><span data-t=\"schede\"><\/span> <b id=\"nSchede\">0<\/b><\/span><button class=\"mini\" data-tutti=\"schede\" data-t=\"tuttiNessuno\"><\/button><\/div>\n  <div class=\"avviso\" id=\"avvisoSchede\" hidden><\/div>\n  <div class=\"lista\" id=\"schede\"><\/div>\n<\/section>\n<section>\n  <div class=\"sh\"><span><span data-t=\"pagina\"><\/span> <b id=\"nPagina\">0<\/b><\/span><button class=\"mini\" data-tutti=\"pagina\" data-t=\"tuttiNessuno\"><\/button><\/div>\n  <div class=\"lista\" id=\"pagina\"><\/div>\n<\/section>\n<section>\n  <div class=\"sh\"><span><span data-t=\"immagini\"><\/span> <b id=\"nImmagini\">0<\/b><\/span><span><button class=\"mini\" data-tutti=\"immagini\" data-t=\"tuttiNessuno\"><\/button> <button class=\"mini hot\" id=\"scaricaSubito\" data-t=\"salvaDownload\"><\/button><\/span><\/div>\n  <div class=\"qrow\" data-tt=\"fmtImgTt\"><label class=\"wide\"><span data-t=\"fmtImg\"><\/span><select id=\"if\">\n    <option value=\"\" data-t=\"fOrig\"><\/option><option value=\"png\">PNG<\/option><option value=\"webp\">WebP<\/option><option value=\"jpg\" data-t=\"fJpg\"><\/option><\/select><\/label><\/div>\n  <div class=\"avviso\" id=\"avvisoImmagini\" hidden><\/div>\n  <div class=\"griglia\" id=\"immagini\"><\/div>\n<\/section>\n<div class=\"piede\">\n<div class=\"gobar\"><button id=\"invia\" class=\"go\"><\/button><button id=\"avvia\" class=\"go hot\"><\/button><\/div>\n<div class=\"nota\" id=\"nota\"><\/div>\n<\/div>\n<script src=\"lingua.js\"><\/script>\n<script src=\"testi.js\"><\/script>\n<script src=\"siti.js\"><\/script>\n<script src=\"popup.js\"><\/script>\n<\/body>\n<\/html>\n","popup.js":"/* DownConvertron - estensione Chrome (designed by Welsho)\n   Copyright (C) 2026 Daniele Moretti (Welsho) - GPL-3.0-or-later\n\n   Raccoglie i link delle schede aperte e della pagina corrente, tiene solo quelli dei siti supportati\n   da yt-dlp (stesse regole di riconoscimento, generate dal suo elenco) e li copia negli appunti con\n   un'intestazione: l'app la riconosce, applica le impostazioni rapide scelte qui (video / solo audio)\n   e mette i link nella lista dei download. Il download lo avvii tu nell'app.\n   Il logo apre DownConvertron con il collegamento downconvertron:// registrato dall'app. */\n\"use strict\";\nconst VERS = \"7.0\";\nconst MARCATORE = \"#DCVT-LINKS v2\";\nconst FILE_DIRETTO = /\\.(mp4|m4v|mov|webm|mkv|avi|m3u8|mpd|mp3|m4a|aac|ogg|opus|flac|wav)(\\?|#|$)/i;\nconst FILE_IMMAGINE = /\\.(jpe?g|jfif|png|gif|webp|avif|bmp|tiff?|heic|svg)(\\?|#|$)/i;\nconst LANG = (typeof DCVT_LANG === \"string\" && DCVT_TESTI[DCVT_LANG]) ? DCVT_LANG : \"it\";\nlet REGOLE = null;\nconst voci = { schede: [], pagina: [], immagini: [] };\n\nfunction t(k) {\n  let s = (DCVT_TESTI[LANG] && DCVT_TESTI[LANG][k]) || DCVT_TESTI.it[k] || k;\n  for (let i = 1; i < arguments.length; i++) s = s.split(\"{\" + (i - 1) + \"}\").join(String(arguments[i]));\n  return s;\n}\nfunction memo(k, v) {\n  try { if (v === undefined) return localStorage.getItem(\"dcvt_\" + k); localStorage.setItem(\"dcvt_\" + k, v); } catch (e) { return null; }\n}\n/* registro dell'estensione: le voci viaggiano con il prossimo invio e finiscono nello schermo dell'app */\nfunction registra(testo) {\n  let l = [];\n  try { l = JSON.parse(memo(\"log\") || \"[]\"); } catch (e) {}\n  const d = new Date(), p = n => (n < 10 ? \"0\" : \"\") + n;\n  l.push(p(d.getHours()) + \":\" + p(d.getMinutes()) + \":\" + p(d.getSeconds()) + \" \" + String(testo).replace(/[\\r\\n]+/g, \" \"));\n  memo(\"log\", JSON.stringify(l.slice(-30)));\n}\nfunction regole() {\n  if (!REGOLE) {\n    REGOLE = [];\n    for (const [nome, src, fl] of (window.DCVT_SITES || [])) { try { REGOLE.push([nome, new RegExp(src, fl)]); } catch (e) { /* regola non valida in JS: saltata */ } }\n  }\n  return REGOLE;\n}\nconst NOMI = { youtube: \"YouTube\", vimeo: \"Vimeo\", Instagram: \"Instagram\", TikTok: \"TikTok\", twitter: \"X / Twitter\", facebook: \"Facebook\",\n               twitch: \"Twitch\", dailymotion: \"Dailymotion\", soundcloud: \"SoundCloud\", Bandcamp: \"Bandcamp\", reddit: \"Reddit\", GoogleDrive: \"Drive\" };\n/* sito supportato? restituisce il nome da mostrare, oppure \"\" */\nfunction riconosci(u) {\n  let url;\n  try { url = new URL(u); } catch (e) { return \"\"; }\n  if (!/^https?:$/.test(url.protocol)) return \"\";\n  if ((url.pathname === \"/\" || url.pathname === \"\") && !url.search) return \"\";      /* home page dei siti: non e' un video */\n  if (FILE_DIRETTO.test(url.pathname)) return \"File\";\n  /* /wiki/File:Foto.jpg e' una pagina, non un'immagine */\n  if (FILE_IMMAGINE.test(url.pathname) && !/\\/wiki\\/[^\\/]+:/i.test(url.pathname)) return t(\"img\");\n  for (const [nome, re] of regole()) if (re.test(u)) return NOMI[nome] || nome.replace(/IE$/, \"\");\n  return \"\";\n}\n/* pagine di siti video che non sono un video singolo: \"\" = video, altrimenti la chiave del tipo.\n   Partono non spuntate e con un avviso: un canale scarica tutti i suoi video, una diretta registra finche' non la fermi. */\nconst YT_PAGINE = /^\\/(feed|premium|gaming|results|podcasts|account|hashtag|channel_switcher|signin|browse|explore|library|search|reporthistory)(\\/|$)/i;\nconst YT_CANALE = /^\\/(@[^\\/]+|channel\\/[^\\/]+|c\\/[^\\/]+|user\\/[^\\/]+)(\\/([^\\/]*))?\\/?$/i;\nconst TW_PAGINE = /^\\/(settings|directory|downloads|inventory|wallet|search|moderator|popout|p|subscriptions|drops|turbo|prime|friends|messages|following|videos)(\\/?$|\\/(?!\\d))/i;\nconst TW_CANALE = /^\\/[^\\/]+\\/(videos|clips|schedule|about|collections|squad)\\/?$/i;\nfunction tipoPagina(u) {\n  let url;\n  try { url = new URL(u); } catch (e) { return \"\"; }\n  const h = url.hostname.toLowerCase(), p = url.pathname;\n  if (/(^|\\.)youtube\\.com$/.test(h)) {\n    if (YT_PAGINE.test(p)) return \"kPagina\";\n    const m = YT_CANALE.exec(p);\n    if (m) return (m[3] || \"\").toLowerCase() === \"live\" ? \"kDiretta\" : \"kCanale\";\n  }\n  if (/(^|\\.)twitch\\.tv$/.test(h) && !/^clips\\./.test(h)) {\n    if (TW_PAGINE.test(p)) return \"kPagina\";\n    if (TW_CANALE.test(p)) return \"kCanale\";\n    if (/^\\/[^\\/]+\\/?$/.test(p)) return \"kDiretta\";              /* twitch.tv/nome = il canale in diretta */\n  }\n  return \"\";\n}\nfunction pulisciNome(s) {\n  return String(s || \"\").replace(/[\\r\\n\\t|]+/g, \" \").replace(/\\s+-\\s+YouTube$/, \"\").replace(/[<>:\"\\/\\\\?*]+/g, \" \").replace(/\\s+/g, \" \").trim().slice(0, 120);\n}\n\n/* ---------- impostazioni rapide ---------- */\nlet modo = memo(\"modo\") || \"app\";\nfunction mostraModo() {\n  for (const b of document.querySelectorAll(\".seg button\")) b.className = b.dataset.m === modo ? \"on\" : \"\";\n  document.getElementById(\"qVideo\").style.display = modo === \"video\" ? \"flex\" : \"none\";\n  document.getElementById(\"qAudio\").style.display = modo === \"audio\" ? \"flex\" : \"none\";\n  document.getElementById(\"qApp\").style.display = modo === \"app\" ? \"block\" : \"none\";\n  aggiorna();\n}\nfunction testoScelto(id) { const s = document.getElementById(id); return s.options[s.selectedIndex] ? s.options[s.selectedIndex].text : s.value; }\nfunction descriviModo() {\n  if (modo === \"video\") return t(\"mVideo\") + \" \\u00b7 \" + testoScelto(\"vc\") + \" \\u00b7 \" + testoScelto(\"vq\");\n  if (modo === \"audio\") return t(\"mAudio\") + \" \\u00b7 \" + testoScelto(\"ap\");\n  return t(\"mApp\");\n}\n/* \"Scarica subito\": con i video servono le impostazioni rapide (con \"Come nell'app\" vanno solo in lista);\n   le sole immagini partono sempre, con il loro formato separato */\nfunction soloImmagini() { const s = scelti(); return s.length > 0 && s.every(v => v.img); }\nfunction puoAvviare() { return modo !== \"app\" || soloImmagini(); }\nfunction intestazioni(avvia, login) {\n  const h = [\"#ext=\" + VERS, \"#lang=\" + LANG, \"#mode=\" + modo];\n  if (avvia) h.push(\"#start=1\");                                    /* l'app avvia il download da sola */\n  if (login) h.push(\"#cookies=\" + login);                           /* solo il nome del file scritto dal ponte, mai i cookie */\n  if (scelti().some(v => v.img)) h.push(\"#imgfmt=\" + document.getElementById(\"if\").value);\n  /* pagina da cui vengono le immagini: l'app la usa come Referer (CDN che rifiutano le immagini chieste da fuori) */\n  if (paginaImmagini && voci.immagini.some(v => v.scelto)) h.push(\"#ref=\" + paginaImmagini);\n  if (modo === \"video\") h.push(\"#quality=\" + document.getElementById(\"vq\").value, \"#container=\" + document.getElementById(\"vc\").value);\n  if (modo === \"audio\") { const [f, q] = document.getElementById(\"ap\").value.split(\"|\"); h.push(\"#afmt=\" + f, \"#aq=\" + (q || \"\")); }\n  let l = [];\n  try { l = JSON.parse(memo(\"log\") || \"[]\"); } catch (e) {}\n  for (const r of l) h.push(\"#log=\" + r);\n  return h;\n}\n\n/* ---------- liste ---------- */\nfunction riga(v, lista) {\n  const r = document.createElement(\"label\"); r.className = \"row\";\n  const c = document.createElement(\"input\"); c.type = \"checkbox\"; c.checked = v.scelto;\n  c.onchange = () => { v.scelto = c.checked; aggiorna(); };\n  const tx = document.createElement(\"div\"); tx.className = \"t\";\n  const n = document.createElement(\"div\"); n.className = \"n\"; n.textContent = v.titolo || v.url;\n  const u = document.createElement(\"div\"); u.className = \"u\"; u.textContent = v.url;\n  const b = document.createElement(\"span\"); b.className = \"badge\" + (v.avviso ? \" warn\" : \"\");\n  b.textContent = v.avviso ? v.sito + \" \\u00b7 \" + t(v.avviso) : v.sito;\n  tx.append(n, u); r.append(c, tx, b); lista.appendChild(r);\n}\nfunction miniatura(v, box) {\n  const d = document.createElement(\"label\"); d.className = \"thumb\" + (v.scelto ? \" on\" : \"\"); d.title = v.url;\n  const c = document.createElement(\"input\"); c.type = \"checkbox\"; c.checked = v.scelto;\n  c.setAttribute(\"aria-label\", v.titolo || nomeImmagine(v.url, \"\").base.replace(/^DownConvertron\\//, \"\"));\n  c.onchange = () => { v.scelto = c.checked; d.className = \"thumb\" + (v.scelto ? \" on\" : \"\"); aggiorna(); };\n  const im = document.createElement(\"img\"); im.src = v.url; im.alt = v.titolo || \"\"; im.loading = \"lazy\"; im.referrerPolicy = \"no-referrer\";\n  const dm = document.createElement(\"span\"); dm.className = \"dim\"; dm.textContent = v.w && v.h ? v.w + \"\\u00d7\" + v.h : \"\";\n  d.append(im, c, dm); box.appendChild(d);\n}\nfunction disegna(chiave) {\n  const box = document.getElementById(chiave);\n  box.textContent = \"\";\n  if (!voci[chiave].length) { const e = document.createElement(\"div\"); e.className = \"vuoto\"; e.textContent = chiave === \"schede\" ? t(\"nessunaScheda\") : chiave === \"pagina\" ? t(\"nessunLink\") : t(\"nessunaImg\"); box.appendChild(e); }\n  for (const v of voci[chiave]) (chiave === \"immagini\" ? miniatura : riga)(v, box);\n  document.getElementById({ schede: \"nSchede\", pagina: \"nPagina\", immagini: \"nImmagini\" }[chiave]).textContent = voci[chiave].length;\n  const av = chiave === \"schede\" ? document.getElementById(\"avvisoSchede\") : chiave === \"immagini\" ? document.getElementById(\"avvisoImmagini\") : null;\n  if (av) {\n    const n = chiave === \"schede\" ? voci.schede.filter(v => v.avviso).length : 0;\n    av.textContent = chiave === \"schede\" ? (n ? t(\"avvisoSchede\", n) : \"\") : (totImmagini > voci.immagini.length ? t(\"avvisoImmagini\", voci.immagini.length, totImmagini) : \"\");\n    av.hidden = !av.textContent;\n  }\n}\nfunction scelti() { return voci.schede.concat(voci.pagina, voci.immagini).filter(v => v.scelto); }\nfunction aggiorna() {\n  const n = new Set(scelti().map(v => v.url)).size;\n  const b = document.getElementById(\"invia\"), a = document.getElementById(\"avvia\");\n  b.disabled = a.disabled = !n;\n  b.textContent = n ? t(\"invia\", n) : t(\"nessunoScelto\");\n  a.textContent = t(\"avvia\", n);\n  a.style.display = puoAvviare() ? \"\" : \"none\";\n  const ni = voci.immagini.filter(v => v.scelto).length, q = document.getElementById(\"scaricaSubito\");\n  q.disabled = !ni; q.textContent = t(\"salvaDownload\") + (ni ? \" (\" + ni + \")\" : \"\");\n}\nlet totImmagini = 0, paginaImmagini = \"\";\nasync function raccogli() {\n  const tutte = document.getElementById(\"tutteFinestre\").checked;\n  /* le scelte fatte restano quando la lista si aggiorna (per esempio con \"Tutte le finestre\") */\n  const prima = new Map();\n  for (const v of voci.schede.concat(voci.pagina, voci.immagini)) prima.set(v.url, v.scelto);\n  const scegli = (u, normale) => prima.has(u) ? prima.get(u) : normale;\n  const tabs = await chrome.tabs.query(tutte ? {} : { currentWindow: true });\n  const visti = new Set();\n  voci.schede = [];\n  for (const tb of tabs) {\n    const sito = riconosci(tb.url || \"\");\n    if (!sito || visti.has(tb.url)) continue;\n    visti.add(tb.url);\n    const avviso = tipoPagina(tb.url);\n    voci.schede.push({ url: tb.url, titolo: tb.title || \"\", sito, avviso, scelto: scegli(tb.url, !avviso), img: sito === t(\"img\") });\n  }\n  voci.pagina = [];\n  try {\n    const [att] = await chrome.tabs.query({ active: true, currentWindow: true });\n    paginaImmagini = att && /^https?:/.test(att.url || \"\") ? att.url : \"\";\n    if (att && /^https?:/.test(att.url || \"\")) {\n      const [res] = await chrome.scripting.executeScript({\n        target: { tabId: att.id },\n        func: () => {\n          const out = [];\n          for (const a of document.links) out.push([a.href, (a.innerText || a.title || a.getAttribute(\"aria-label\") || \"\").trim().slice(0, 140)]);\n          for (const v of document.querySelectorAll(\"video[src], video source[src]\")) out.push([v.src, document.title]);\n          /* immagini grandi (niente icone e loghi piccoli): la versione piu' grande che il browser ha scelto */\n          const img = [];\n          const add = (u, alt, w, h) => {\n            try { u = new URL(u, document.baseURI).href; } catch (e) { return; }\n            if (/^https?:/.test(u) && w >= 200 && h >= 150) img.push([u, String(alt || \"\").trim().slice(0, 120), Math.round(w), Math.round(h)]);\n          };\n          /* da un srcset la voce con il descrittore piu' grande (800w, 2x); i segnaposto data: non contano */\n          const migliore = s => {\n            /* come lo standard HTML: l'URL va fino al primo spazio (puo' contenere virgole, es. Cloudinary);\n               i descrittori finiscono alla virgola, che separa le voci anche senza spazio (\"a.jpg 1x,b.jpg 2x\") */\n            s = String(s || \"\");\n            let best = \"\", bn = -1, i = 0;\n            while (i < s.length) {\n              while (i < s.length && /[\\s,]/.test(s[i])) i++;\n              let j = i;\n              while (j < s.length && !/\\s/.test(s[j])) j++;\n              let url = s.slice(i, j), desc = \"\";\n              if (/,$/.test(url)) url = url.replace(/,+$/, \"\");\n              else { let k = j; while (k < s.length && s[k] !== \",\") k++; desc = s.slice(j, k); j = k + 1; }\n              i = j;\n              const n = parseFloat((/(\\d+(?:\\.\\d+)?)[wx]/.exec(desc) || [])[1]) || 1;\n              if (url && !/^data:/.test(url) && n > bn) { best = url; bn = n; }\n            }\n            return best;\n          };\n          /* fonte massima: la versione piu' grande dichiarata dalla pagina (srcset dell'immagine e delle <source> del <picture>),\n             non quella che il browser ha scelto per lo schermo */\n          const massima = i => {\n            const s = [i.getAttribute(\"srcset\") || \"\"];\n            if (i.parentElement && i.parentElement.tagName === \"PICTURE\") for (const so of i.parentElement.querySelectorAll(\"source[srcset]:not([media])\")) s.push(so.getAttribute(\"srcset\"));\n            return migliore(s.filter(Boolean).join(\", \"));\n          };\n          for (const i of document.images) {\n            /* immagini lazy: finche' non si caricano c'e' un segnaposto (data:, 1x1) e l'URL vero sta in data-src / data-srcset */\n            const lazy = i.getAttribute(\"data-src\") || i.getAttribute(\"data-lazy-src\") || i.getAttribute(\"data-original\") || migliore(i.getAttribute(\"data-srcset\") || i.getAttribute(\"data-lazy-srcset\"));\n            let u = massima(i) || i.currentSrc || i.src;\n            if (lazy && (!u || /^data:/.test(u) || i.naturalWidth < 50)) u = lazy;\n            /* la misura vera se c'e', altrimenti quella a schermo (o negli attributi) */\n            const w = Math.max(i.naturalWidth || 0, i.width || 0, parseInt(i.getAttribute(\"width\"), 10) || 0);\n            const h = Math.max(i.naturalHeight || 0, i.height || 0, parseInt(i.getAttribute(\"height\"), 10) || 0);\n            if (u) add(u, i.alt || i.title, w, h);\n          }\n          /* immagini di sfondo nello stile della pagina (gallerie, copertine) */\n          let nb = 0;\n          for (const el of document.querySelectorAll(\"[style*='background']\")) {\n            if (++nb > 2000) break;\n            const m = /url\\(\\s*['\"]?([^'\")]+)['\"]?\\s*\\)/.exec(el.style.backgroundImage || \"\");\n            if (!m || /^data:/.test(m[1])) continue;\n            const r = el.getBoundingClientRect();\n            add(m[1], el.getAttribute(\"aria-label\") || el.title, r.width, r.height);\n          }\n          return { link: out, img: img };\n        }\n      });\n      const ris = (res && res.result) || { link: [], img: [] };\n      voci.immagini = [];\n      const vistiImg = new Set();\n      for (const [u, testo, w, h] of ris.img) {\n        if (vistiImg.has(u)) continue;\n        vistiImg.add(u);\n        if (voci.immagini.length < 200) voci.immagini.push({ url: u, titolo: testo, sito: t(\"img\"), scelto: scegli(u, false), w, h, img: true });\n      }\n      totImmagini = vistiImg.size;\n      for (const [u, testo] of ris.link) {\n        const pulito = String(u).split(\"#\")[0];\n        const sito = riconosci(pulito);\n        if (!sito || visti.has(pulito) || /^blob:/.test(u)) continue;\n        visti.add(pulito);\n        voci.pagina.push({ url: pulito, titolo: testo, sito, avviso: tipoPagina(pulito), scelto: scegli(pulito, false), img: sito === t(\"img\") });\n        if (voci.pagina.length >= 300) break;\n      }\n    }\n  } catch (e) { registra(t(\"logPagina\", e.message || e)); }\n  disegna(\"schede\"); disegna(\"pagina\"); disegna(\"immagini\"); aggiorna();\n  document.getElementById(\"stato\").textContent = t(\"trovati\", voci.schede.length + voci.pagina.length + voci.immagini.length, regole().length);\n  return [voci.schede.length, voci.pagina.length + voci.immagini.length];\n}\n\n/* ---------- apertura dell'app (logo o dopo l'invio) ----------\n   Prima il ponte native messaging: avvia l'app o la porta in primo piano, senza la domanda di Chrome.\n   Il collegamento downconvertron:// resta solo come riserva (ponte assente o app vecchia): Chrome lo blocca\n   se dal clic e' passato troppo tempo e Windows non lascia all'app venire davanti. true = aperta dal ponte */\nasync function apriApp(motivo) {\n  const url = \"downconvertron://\" + motivo + \"?ext=\" + VERS;\n  registra(t(\"logApri\"));\n  try {\n    const r = await chrome.runtime.sendNativeMessage(PONTE, { op: \"open\", url });\n    if (r && r.ok) { registra(t(r.how === \"front\" ? \"logDavanti\" : \"logAvviata\") + (r.front === false ? \" (\" + t(\"logNonDavanti\") + \")\" : \"\")); return true; }\n    throw new Error((r && r.err) || \"?\");\n  } catch (e) { registra(t(\"logRiserva\", e.message || e)); }\n  try {\n    const [att] = await chrome.tabs.query({ active: true, currentWindow: true });\n    /* sulla scheda attuale la pagina resta dov'e': Chrome chiede solo se aprire l'app */\n    if (att && /^https?:/.test(att.url || \"\")) await chrome.tabs.update(att.id, { url });\n    else await chrome.tabs.create({ url });\n  } catch (e) { try { await chrome.tabs.create({ url }); } catch (e2) {} }\n  return false;\n}\n\n/* download rapido: le immagini scelte vanno subito nella cartella Download/DownConvertron (senza passare dall'app) */\nconst EST_IMG = /\\.(jpe?g|jfif|png|gif|webp|avif|bmp|tiff?|heic|svg)$/i;\n/* nome valido su Windows e Mac: niente caratteri vietati, ~ (Chrome lo rifiuta), caratteri invisibili, punti e spazi ai bordi */\nfunction nomeFile(s) {\n  return String(s || \"\").replace(/\\p{Cf}/gu, \"\").replace(/[<>:\"\\/\\\\|?*~\\x00-\\x1f]+/g, \" \").replace(/\\s+/g, \" \").replace(/^[\\s.]+|[\\s.]+$/g, \"\");\n}\nfunction nomeImmagine(u, titolo) {\n  let n = \"\";\n  try { n = new URL(u).pathname.split(\"/\").pop() || \"\"; } catch (e) {}\n  try { n = decodeURIComponent(n); } catch (e) {}\n  n = nomeFile(n);\n  const m = n.match(EST_IMG), est = m ? m[0].toLowerCase() : \"\";        /* senza estensione nell'URL: la decide il tipo del file */\n  let base = nomeFile(m ? n.slice(0, -m[0].length) : (pulisciNome(titolo) || n.replace(/\\.\\w{1,5}$/, \"\"))).slice(0, 100);\n  base = base.replace(/[\\s.]+$/, \"\") || t(\"nomeImg\");\n  if (/^(con|prn|aux|nul|com\\d|lpt\\d)$/i.test(base)) base = \"_\" + base;  /* nomi riservati di Windows */\n  return { base: \"DownConvertron/\" + base, est };\n}\n/* estensione dal tipo che il server dichiara: un WebP senza estensione nell'URL non diventa .jpg */\nconst EST_MIME = { \"image/jpeg\": \".jpg\", \"image/jpg\": \".jpg\", \"image/pjpeg\": \".jpg\", \"image/png\": \".png\", \"image/apng\": \".png\", \"image/gif\": \".gif\", \"image/webp\": \".webp\",\n  \"image/avif\": \".avif\", \"image/bmp\": \".bmp\", \"image/tiff\": \".tif\", \"image/svg+xml\": \".svg\", \"image/heic\": \".heic\", \"image/heif\": \".heic\" };\nconst nomiInAttesa = new Map();   /* url -> { base, est } dei download rapidi partiti da qui */\nchrome.downloads.onDeterminingFilename.addListener((item, suggest) => {\n  const n = nomiInAttesa.get(item.url) || nomiInAttesa.get(item.finalUrl);\n  if (!n) { suggest(); return; }\n  nomiInAttesa.delete(item.url); nomiInAttesa.delete(item.finalUrl);\n  /* il server ha mandato una pagina (protezione hotlink, login): non la salvo come immagine */\n  if (/^(text\\/html|application\\/xhtml)/i.test(String(item.mime || \"\"))) {\n    suggest(); chrome.downloads.cancel(item.id);\n    const nota = document.getElementById(\"nota\"); nota.className = \"nota warn\"; nota.textContent = n.base.replace(/^DownConvertron\\//, \"\") + \": \" + t(\"nonImmagine\");\n    return;\n  }\n  const est = EST_MIME[String(item.mime || \"\").toLowerCase()] || n.est || \".jpg\";\n  suggest({ filename: n.base + est, conflictAction: \"uniquify\" });\n});\nasync function scaricaSubito() {\n  const sel = voci.immagini.filter(v => v.scelto), nota = document.getElementById(\"nota\");\n  let ok = 0, ko = 0, errore = \"\";\n  for (const v of sel) {\n    const n = nomeImmagine(v.url, v.titolo);\n    nomiInAttesa.set(v.url, n);\n    /* il nome passato qui vale solo se il popup si chiude prima che Chrome conosca il tipo del file */\n    try { await chrome.downloads.download({ url: v.url, filename: n.base + (n.est || \".jpg\"), conflictAction: \"uniquify\", saveAs: false }); ok++; }\n    catch (e) { ko++; errore = e.message || String(e); nomiInAttesa.delete(v.url); }\n  }\n  registra(t(\"logScaricate\", ok) + (ko ? \" / \" + ko + \" KO: \" + errore : \"\"));\n  nota.className = \"nota \" + (ko ? (ok ? \"warn\" : \"err\") : \"ok\");\n  nota.textContent = (ok ? t(\"scaricate\", ok) + \" \" : \"\") + (ko ? t(\"nonRiuscite\", ko, errore) : \"\");\n}\n/* ---------- \"Usa il mio login\" ----------\n   Per i video con limite di eta', privati o per abbonati. Con l'interruttore acceso, a ogni invio leggo i cookie di Chrome\n   dei siti inviati e li passo al ponte native messaging dell'app (registrato da DownConvertron, accetta solo questa\n   estensione), che li scrive in un file della cartella dati; negli appunti viaggia solo il nome del file (token casuale).\n   L'app li usa solo se il sito chiede l'accesso e li cancella a fine lavoro. I permessi (cookie, ponte, tutti i siti) sono\n   fissi nel manifest: la richiesta facoltativa di Chrome chiudeva il popup e il login non partiva. Acceso di base. */\nconst PONTE = \"com.welsho.downconvertron\";\n/* permessi del login: fissi; se mancano, in Chrome e' ancora caricato il manifest vecchio (va ricaricata) */\nconst PERMESSI_LOGIN = { permissions: [\"cookies\"], origins: [\"<all_urls>\"] };\n/* dominio da cui leggere i cookie: www.youtube.com e youtu.be -> youtube.com, foo.bbc.co.uk -> bbc.co.uk */\nfunction dominioBase(u) {\n  let h;\n  try { h = new URL(u).hostname.toLowerCase(); } catch (e) { return \"\"; }\n  if (!h || /^[\\d.]+$/.test(h) || h.indexOf(\".\") < 0) return h;\n  if (h === \"youtu.be\" || /(^|\\.)youtube-nocookie\\.com$/.test(h)) return \"youtube.com\";\n  const p = h.split(\".\");\n  const n = p.length > 2 && p[p.length - 1].length === 2 && /^(co|com|net|org|gov|edu|ac|ne|or)$/.test(p[p.length - 2]) ? 3 : 2;\n  return p.slice(-n).join(\".\");\n}\n/* cookie in formato Netscape (quello di yt-dlp --cookies e di curl) */\nfunction rigaNetscape(c) {\n  const pulito = v => String(v).replace(/[\\t\\r\\n]/g, \"\");\n  const dom = (c.hostOnly ? c.domain.replace(/^\\./, \"\") : (c.domain.charAt(0) === \".\" ? c.domain : \".\" + c.domain));\n  return (c.httpOnly ? \"#HttpOnly_\" : \"\") + pulito(dom) + \"\\t\" + (c.hostOnly ? \"FALSE\" : \"TRUE\") + \"\\t\" + pulito(c.path || \"/\") + \"\\t\" +\n    (c.secure ? \"TRUE\" : \"FALSE\") + \"\\t\" + (c.session || !c.expirationDate ? 0 : Math.floor(c.expirationDate)) + \"\\t\" + pulito(c.name) + \"\\t\" + pulito(c.value);\n}\n/* \"\" = niente login (spento, nessun cookie, ponte assente: in quel caso lo dico nella nota e nel registro) */\nasync function preparaLogin(urls) {\n  if (!document.getElementById(\"usaLogin\").checked) return \"\";\n  if (!(await chrome.permissions.contains(PERMESSI_LOGIN).catch(() => false))) { registra(t(\"loginNegato\")); return { errore: t(\"loginNegato\") }; }\n  return mandaCookie(urls);\n}\n/* cookie di Chrome dei siti di questi link -> ponte -> token; \"\" se Chrome non ha cookie, { errore } se il ponte non risponde */\nasync function mandaCookie(urls) {\n  const domini = [...new Set(urls.map(dominioBase).filter(Boolean))], visti = new Set(), righe = [];\n  for (const d of domini) {\n    for (const c of await chrome.cookies.getAll({ domain: d }).catch(() => [])) {\n      const k = c.domain + \"|\" + c.path + \"|\" + c.name;\n      if (!visti.has(k)) { visti.add(k); righe.push(rigaNetscape(c)); }\n    }\n  }\n  if (!righe.length) { registra(t(\"loginNessuno\")); return \"\"; }\n  const b = new Uint8Array(16); crypto.getRandomValues(b);\n  const token = Array.from(b, x => (x < 16 ? \"0\" : \"\") + x.toString(16)).join(\"\");\n  const dati = \"# Netscape HTTP Cookie File\\n# DownConvertron: login di Chrome, valido solo per questo invio\\n\" + righe.join(\"\\n\") + \"\\n\";\n  try {\n    const r = await chrome.runtime.sendNativeMessage(PONTE, { op: \"cookies\", token, data: dati });\n    if (!r || !r.ok) throw new Error((r && r.err) || \"?\");\n  } catch (e) {\n    const msg = t(\"loginNoApp\", e.message || e);\n    registra(msg);\n    return { errore: msg };\n  }\n  registra(t(\"loginInviato\", domini.length, righe.length));\n  return token;\n}\n\n/* ---------- \"Riprova con il mio login\" ----------\n   L'app scrive i link finiti in errore perche' il sito chiede l'accesso; qui li chiedo al ponte all'apertura e,\n   se ci sono, mostro il riquadro. Il pulsante rimanda quei link all'app con il login, da usare subito, e il\n   download riparte da solo (anche con l'interruttore spento: il clic sul pulsante vale come scelta). */\nlet richieste = [];\nasync function controllaRichieste() {\n  try {\n    const r = await chrome.runtime.sendNativeMessage(PONTE, { op: \"richieste\" });\n    richieste = r && r.ok && Array.isArray(r.links) ? r.links.filter(l => /^https?:\\/\\//i.test(l.url || \"\")) : [];\n  } catch (e) { richieste = []; return; }      /* app non ancora aperta con questa versione: niente riquadro */\n  const box = document.getElementById(\"loginBox\");\n  box.hidden = !richieste.length;\n  if (!richieste.length) return;\n  document.getElementById(\"loginTesto\").textContent = t(\"loginServe\", richieste.length);\n  const ll = document.getElementById(\"loginLista\"); ll.textContent = \"\";\n  for (const l of richieste) { const d = document.createElement(\"div\"); d.textContent = \"\\u2022 \" + (l.nome || l.url); d.title = l.url; ll.appendChild(d); }\n}\nasync function riprovaConLogin() {\n  const nota = document.getElementById(\"nota\"), b = document.getElementById(\"loginRiprova\");\n  const urls = richieste.map(l => l.url);\n  if (!urls.length) return;\n  b.disabled = true;\n  try {\n    let login = \"\";\n    try { login = (await chrome.permissions.contains(PERMESSI_LOGIN).catch(() => false)) ? await mandaCookie(urls) : { errore: t(\"loginNegato\") }; } catch (e) { login = { errore: t(\"loginNoApp\", e.message || e) }; }\n    if (!login || login.errore) { nota.className = \"nota err\"; nota.textContent = login && login.errore ? login.errore : t(\"loginNessunoNota\"); return; }\n    const h = [\"#ext=\" + VERS, \"#lang=\" + LANG, \"#mode=app\", \"#cookies=\" + login, \"#login=retry\"];\n    let lg = [];\n    try { lg = JSON.parse(memo(\"log\") || \"[]\"); } catch (e) {}\n    for (const r of lg) h.push(\"#log=\" + r);\n    const righe = richieste.map(l => { const nome = pulisciNome(l.nome), r = nome ? l.url + \" | \" + nome : l.url; return l.t === \"img\" ? \"#img=\" + r : r; });\n    registra(t(\"loginRiprovato\", righe.length));\n    await navigator.clipboard.writeText(MARCATORE + \"\\n\" + h.join(\"\\n\") + \"\\n\" + righe.join(\"\\n\") + \"\\n\");\n    memo(\"log\", \"[]\");\n    nota.className = \"nota ok\"; nota.textContent = t(\"loginRiprovato\", righe.length);\n    document.getElementById(\"loginBox\").hidden = true; richieste = [];\n    apriApp(\"send\");                               /* l'app viene davanti e riparte da sola */\n  } catch (e) { nota.className = \"nota err\"; nota.textContent = t(\"erroreAppunti\", e.message || e); }\n  finally { b.disabled = false; }\n}\ndocument.getElementById(\"loginRiprova\").onclick = riprovaConLogin;\n\n/* avvia = true: \"Scarica subito\" (l'app mette in lista e avvia il download); false: \"Metti in lista\" */\nasync function invia(avvia) {\n  const usaTitoli = document.getElementById(\"usaTitoli\").checked;\n  const visti = new Set(), righe = [];\n  for (const v of scelti()) {\n    if (visti.has(v.url)) continue;\n    visti.add(v.url);\n    const nome = usaTitoli ? pulisciNome(v.titolo) : \"\";\n    const riga = nome ? v.url + \" | \" + nome : v.url;\n    /* le immagini viaggiano marcate: l'app le scarica come immagini anche se l'URL non ha estensione */\n    righe.push(v.img ? \"#img=\" + riga : riga);\n  }\n  const nota = document.getElementById(\"nota\");\n  avvia = avvia === true && puoAvviare();\n  /* se il login non passa, i link partono lo stesso (senza) e la nota lo dice */\n  let login = \"\";\n  try { login = await preparaLogin([...visti]); } catch (e) { login = { errore: t(\"loginNoApp\", e.message || e) }; }\n  const erroreLogin = login && login.errore ? login.errore : \"\";\n  if (erroreLogin) login = \"\";\n  registra(t(\"logInviati\", righe.length, descriviModo()) + (avvia ? \" +start\" : \"\") + (login ? \" +login\" : \"\"));\n  try {\n    await navigator.clipboard.writeText(MARCATORE + \"\\n\" + intestazioni(avvia, login).join(\"\\n\") + \"\\n\" + righe.join(\"\\n\") + \"\\n\");\n    memo(\"log\", \"[]\");\n    nota.className = erroreLogin ? \"nota warn\" : \"nota ok\";\n    nota.textContent = t(avvia ? \"avviati\" : \"inviati\", righe.length, descriviModo()) + (login ? t(\"conLogin\") : \"\") + (erroreLogin ? \" \" + erroreLogin : \"\");\n    if (document.getElementById(\"apriDopo\").checked) apriApp(\"send\");\n  } catch (e) {\n    nota.className = \"nota err\";\n    nota.textContent = t(\"erroreAppunti\", e.message || e);\n  }\n}\n\n/* ---------- avvio ---------- */\ndocument.documentElement.lang = LANG === \"zh\" ? \"zh-CN\" : LANG;\nfor (const el of document.querySelectorAll(\"[data-t]\")) el.textContent = t(el.dataset.t);\nfor (const el of document.querySelectorAll(\"[data-tt]\")) el.title = t(el.dataset.tt);\ndocument.getElementById(\"nota\").textContent = t(\"notaInizio\");\nfor (const b of document.querySelectorAll(\".seg button\")) b.onclick = () => { modo = b.dataset.m; memo(\"modo\", modo); mostraModo(); };\nfor (const id of [\"vq\", \"vc\", \"ap\", \"if\"]) {\n  const el = document.getElementById(id), v = memo(id);\n  if (v) el.value = v;\n  el.onchange = () => memo(id, el.value);\n}\nfor (const id of [\"tutteFinestre\", \"usaTitoli\", \"apriDopo\"]) {\n  const el = document.getElementById(id), v = memo(id);\n  el.checked = v === null ? id === \"apriDopo\" : v === \"1\";\n  el.onchange = () => { memo(id, el.checked ? \"1\" : \"0\"); if (id === \"tutteFinestre\") raccogli(); };\n}\n/* interruttore del login: acceso di base (chiave nuova: il vecchio \"spento\" veniva spesso dal popup chiuso dalla richiesta dei permessi) */\n{\n  const el = document.getElementById(\"usaLogin\");\n  el.checked = memo(\"usaLogin2\") !== \"0\";