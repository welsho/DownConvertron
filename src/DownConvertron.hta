/* memoria per avanti-indietro e ripetizioni: i fotogrammi restano in RAM */
function cvMemCheck(c) {
  if (!c.bounce && c.loops < 2) return "";
  if (c.frames > 32000) return "Clip troppo lunga per ripetizioni o avanti-indietro (max circa 32.000 fotogrammi): accorciala con il taglio.";
  var gb = c.frames * c.w * c.h * 4 / 1073741824;
  if (gb > 3) return "Avanti-indietro e ripetizioni tengono in memoria tutta la clip (circa " + Math.round(gb) + " GB a questa risoluzione): accorciala con il taglio o riduci la risoluzione.";
  return "";
}

/* ---------- argomenti di ingresso: decoder, sequenza, taglio ---------- */
function cvInputArgs(it, inPath, seekTo) {
  var x = it.info, a = [], tr = cvTrim();
  if (it.kind === "img") {
    /* AVIF e GIF: -loop non esiste per loro, la ripetizione la fa la catena (cvLoopByFilter) */
    if (!cvSingleOut(it, cvSpec()) && !cvLoopByFilter(it)) a.push("-loop 1", "-framerate " + $("cvSeqFps").value, "-t " + cvStill(it));
    a.push('-i "' + inPath + '"');
    return a;
  }
  if (it.kind === "seq") {
    a.push("-framerate " + cvRate(it), "-start_number " + it.seq.start);
    /* immagini di misure diverse: la catena non si ricrea a ogni cambio (la GIF perderebbe i fotogrammi), scala e bordi le uniformano */
    a.push("-reinit_filter 0");
    /* EXR lineare -> sRGB: lo fa la catena (zscale), -apply_trc non esiste piu' in ffmpeg */
  } else if (x.dec) a.push("-c:v " + x.dec);                               /* decoder che legge l'alfa dei WebM */
  if (seekTo !== undefined) a.push("-ss " + seekTo.toFixed(3));
  else { if (tr.from) a.push("-ss " + tr.from); if (tr.to) a.push("-to " + tr.to); }
  a.push('-i "' + inPath + '"');
  return a;
}

/* ---------- audio: tutte le tracce, canali originali, PCM 24 bit, loudness, loop ---------- */
function cvAudioArgs(it, F, c) {
  var x = it.info, sel = $("cvAudio").value, fam = cvAudFamily(F), a = [];
  if (fam === "none" || sel === "none" || !x.audio || it.kind === "seq") return ["-an"];
  var all = $("cvAllTracks").checked, tracks = all ? (x.astreams || [{ ch: 0 }]) : [(x.astreams || [{ ch: 0 }])[0]];
  a.push(all ? '-map "0:a?"' : '-map "0:a:0?"');
  /* filtri comuni a tutte le tracce: avanti-indietro, ripetizioni, volume */
  var af = [];
  /* come il video: andata e ritorno senza il primo fotogramma di ciascuna (stessa durata del video) */
  var d1 = (1 / (c.fps || 25)).toFixed(6);
  if (c.bounce) af.push("asplit[daa][dab];[daa]atrim=start=" + d1 + ",asetpts=PTS-STARTPTS[daf];[dab]areverse,atrim=start=" + d1 + ",asetpts=PTS-STARTPTS[dar];[daf][dar]concat=n=2:v=0:a=1");
  if (c.loops > 1) af.push("aresample=48000", "aloop=loop=" + (c.loops - 1) + ":size=" + Math.ceil(c.seg * (c.bounce ? 2 : 1) * 48000 + 48000));
  var loud = $("cvLoud").value;
  if (loud) af.push("loudnorm=I=" + loud + ":TP=" + (loud === "-23" ? "-1" : "-1.5") + ":LRA=" + (loud === "-23" ? "7" : "11"));
  var base = parseInt(sel, 10) || 192, i, opus = F.aud === "opus";
  for (i = 0; i < tracks.length; i++) {
    var ch = tracks[i].ch || 2, chain = [];
    /* tracce multicanale senza disposizione dichiarata: AAC e Opus le rifiutano, assegno quella standard */
    if (ch > 2 && ch <= 8 && (!tracks[i].layout || /unknown|channels/i.test(tracks[i].layout))) {
      var lay = { 3: "3.0", 4: "quad", 5: "5.0", 6: "5.1", 7: "6.1", 8: "7.1" }[ch], pm = [];
      for (var q = 0; q < ch; q++) pm.push("c" + q + "=c" + q);
      chain.push("pan=" + lay + "|" + pm.join("|"));
    }
    chain = chain.concat(af);
    if (chain.length) a.push("-filter:a:" + i + ' "' + chain.join(",") + '"');
    if (fam === "pcm") a.push("-c:a:" + i + " " + (sel === "pcm16" ? "pcm_s16le" : "pcm_s24le"));
    else {
      var kb = Math.min(Math.round(base * Math.max(1, ch / 2)), opus ? 510 : 640);
      a.push("-c:a:" + i + " " + (opus ? "libopus" : "aac"), "-b:a:" + i + " " + kb + "k");
      if (opus && ch > 2) a.push("-mapping_family:a:" + i + " 1");
