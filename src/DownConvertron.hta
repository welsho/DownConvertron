<script>
/* =====================================================================
   DownConvertron v7.0  -  designed by Welsho
   Copyright (C) 2026 Daniele Moretti (Welsho)
   Licenza GPL-3.0-or-later: puoi ridistribuirlo e modificarlo secondo la
   GNU General Public License v3 o successiva (file LICENSE). Senza garanzia.

   Interfaccia HTA per yt-dlp e ffmpeg. Nessun dato dell'utente passa dalla riga
   di comando: link e opzioni vengono scritti in file temporanei che
   yt-dlp legge con -a e --config-locations.
   ===================================================================== */

/* ---------- debug: nessun errore resta silenzioso ---------- */
var DEBUG_ERRORS = [];
window.onerror = function (msg, url, line, col) {
  DEBUG_ERRORS.push("riga " + line + (col ? ":" + col : "") + "  " + msg);
  try { showMsg("Errore interno (riga " + line + "): " + msg + "\nPremi «Report debug» in basso e incolla il report a chi ti assiste.", "err"); } catch (e) {}
  try { if (typeof state !== "undefined") { if (state.timer) { clearInterval(state.timer); state.timer = null; } if (state.busy) { if (state.job === "download" || state.job === "convert") { state.cancelled = true; killJob(); } setBusy(false); } } } catch (e2) {}
  return true;
};

var MAX_ITEMS = 1000, MAX_URL_LEN = 2048, MAX_NAME_LEN = 120, POLL_MS = 400;

var APP_VER = "7.0";
var MIN_YTDLP = "2024.07.01";      /* corregge CVE-2024-38519 e CVE-2023-35934 */
var JS_RUNTIME_SINCE = "2025.11.12"; /* da qui yt-dlp accetta --js-runtimes */
var START_TIMEOUT_MS = 20000;

var sh = new ActiveXObject("WScript.Shell");
var fso = new ActiveXObject("Scripting.FileSystemObject");
function env(v) { return sh.ExpandEnvironmentStrings(v); }
function $(id) { return document.getElementById(id); }

/* Percorsi assoluti: niente viene cercato nella cartella corrente (anti binary planting) */
var SYS = env("%SystemRoot%");
/* Windows apre spesso gli .hta con mshta a 32 bit (SysWOW64): in quel caso uso i programmi
   di sistema a 64 bit tramite Sysnative, cos&igrave; tutto gira come nel Terminale. */
var SYSDIR = (function () { try { if (fso.FileExists(SYS + "\\Sysnative\\cmd.exe")) return SYS + "\\Sysnative"; } catch (e) {} return SYS + "\\System32"; })();
var EXE_CMD = SYSDIR + "\\cmd.exe";
var EXE_EXPLORER = SYS + "\\explorer.exe";
var EXE_TASKKILL = SYSDIR + "\\taskkill.exe";
function progFiles() { var v = env("%ProgramW6432%"); return v.indexOf("%") >= 0 ? env("%ProgramFiles%") : v; }
var EXE_WINGET = (function () {
  var a = env("%LOCALAPPDATA%") + "\\Microsoft\\WindowsApps\\winget.exe", b = env("%LOCALAPPDATA%") + "\\Microsoft\\WindowsApps\\Microsoft.DesktopAppInstaller_8wekyb3d8bbwe\\winget.exe";
  try { if (!fso.FileExists(a) && fso.FileExists(b)) return b; } catch (e) {}
  return a;
})();
var LINK_DIRS = [env("%LOCALAPPDATA%") + "\\Microsoft\\WinGet\\Links", progFiles() + "\\WinGet\\Links"];

var DIR_APP = env("%APPDATA%") + "\\DownConvertron";
/* versioni precedenti (DownLTransFMecchazzi 5, Mecchazzi 4, Scarica Video): impostazioni e archivio vengono ripresi */
var DIR_APP_OLD = env("%APPDATA%") + "\\DownLTransF" + "Mecchazzi", DIR_APP_OLDER = env("%APPDATA%") + "\\Mecchazzi", DIR_APP_OLDEST = env("%APPDATA%") + "\\ScaricaVideo";
var DIR_TMP = env("%TEMP%") + "\\DownConvertron";
var FILE_SETTINGS = DIR_APP + "\\impostazioni.ini";
var FILE_ARCHIVE = DIR_APP + "\\archivio.txt";

var state = {
  mode: "video", folder: env("%USERPROFILE%") + "\\Downloads",
  items: [], nextId: 1,
  busy: false, job: "", cancelled: false, current: null, token: "",
  files: null, timer: null, offset: 0, partial: "", startedAt: 0,
  itemErrors: 0, itemDone: 0, lastErr: "", okCount: 0, errCount: 0, partCount: 0,
  version: ""
};

/* ---------- file helpers ---------- */
function ensureDir(p) { try { if (!fso.FolderExists(p)) fso.CreateFolder(p); } catch (e) {} }
/* Scrittura testo: UTF-16 con BOM tramite FileSystemObject (yt-dlp riconosce il BOM).
   Niente ADODB.Stream in scrittura: Windows spesso blocca SaveToFile negli .hta. */
function writeUtf8(path, text) {
  var f = fso.CreateTextFile(path, true, true); f.Write(text); f.Close();
}
/* Lettura: UTF-8 (anche senza BOM) via ADODB se disponibile, altrimenti FSO con rilevamento BOM */
function readUtf8(path) {
  try {
    var s = new ActiveXObject("ADODB.Stream");
    s.Type = 2; s.Charset = "utf-8"; s.Open(); s.LoadFromFile(path);
    var t = s.ReadText(); s.Close();
    if (t.charCodeAt(0) === 0xFFFD || /\u0000/.test(t.substring(0, 200))) throw new Error("non utf-8");
    return t.replace(/^\uFEFF/, "");
  } catch (e) {
    var f = fso.OpenTextFile(path, 1, false, -2), r = f.AtEndOfStream ? "" : f.ReadAll(); f.Close();
    return r.replace(/^\uFEFF/, "");
  }
}
function writeAscii(path, text) { var f = fso.CreateTextFile(path, true, false); f.Write(text); f.Close(); }
/* UTF-8 senza BOM: per i file di configurazione di curl (-K), che curl su Windows legge in UTF-8. In ANSI un %TEMP%
   con accenti o caratteri cinesi nel nome utente rompeva i percorsi (o FSO falliva gia' in scrittura). Mac: gia' UTF-8 */
function writeUtf8NoBom(path, text) {
  if (window.DCVT_MAC) { writeAscii(path, text); return; }
  var s = new ActiveXObject("ADODB.Stream"), b = new ActiveXObject("ADODB.Stream");
  s.Type = 2; s.Charset = "utf-8"; s.Open(); s.WriteText(text);
  s.Position = 3; b.Type = 1; b.Open(); s.CopyTo(b); s.Close();   /* salta i 3 byte del BOM */
  b.SaveToFile(path, 2); b.Close();
}
function tryDelete(p) { try { if (fso.FileExists(p)) fso.DeleteFile(p, true); } catch (e) {} }
function cleanupTmp() {
  try {
    var e = new Enumerator(fso.GetFolder(DIR_TMP).Files);
    for (; !e.atEnd(); e.moveNext()) { try { e.item().Delete(true); } catch (x) {} }
    var d = new Enumerator(fso.GetFolder(DIR_TMP).SubFolders);
    for (; !d.atEnd(); d.moveNext()) { if (/^link_SVW/.test(d.item().Name)) { try { d.item().Delete(true); } catch (y) {} } }
  } catch (e2) {}
}

/* Trova un eseguibile installato. Ordine:
   1) collegamenti di winget  2) cartelle del PATH lette dal registro (aggiornate anche se mshta
   ha un PATH vecchio), solo percorsi assoluti: mai la cartella corrente  3) cartelle dei pacchetti winget.
   Restituisce "" se non lo trova. */
var toolCache = {};
function isAbsDir(d) { return /^[a-z]:\\/i.test(d) || /^\\\\[^\\]+\\/.test(d); }
function pathDirs() {
  var raw = [], out = [], seen = {}, i;
  try { raw.push(sh.RegRead("HKCU\\Environment\\Path")); } catch (e) {}
  try { raw.push(sh.RegRead("HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment\\Path")); } catch (e) {}
  raw.push(env("%PATH%"));
  var parts = env(raw.join(";")).split(";");
  for (i = 0; i < parts.length; i++) {
    var d = parts[i].replace(/^\s+|\s+$/g, "").replace(/^"|"$/g, "").replace(/\\+$/, "");
    if (!d || !isAbsDir(d) || seen[d.toLowerCase()]) continue;
    seen[d.toLowerCase()] = 1; out.push(d);
  }
  return out;
}
function searchTree(dir, name, depth) {
  try {
    var p = dir + "\\" + name;
    if (fso.FileExists(p)) return p;
    if (depth <= 0) return "";
    var e = new Enumerator(fso.GetFolder(dir).SubFolders);
    for (; !e.atEnd(); e.moveNext()) { var r = searchTree(e.item().Path, name, depth - 1); if (r) return r; }
  } catch (x) {}
  return "";
}
function findTool(name) {
  if (toolCache[name] && fso.FileExists(toolCache[name])) return toolCache[name];
  var i, p = "", dirs = pathDirs();
  /* prima le copie gestite da winget (Links, poi Packages), poi il resto del PATH */
  for (i = 0; i < LINK_DIRS.length && !p; i++) if (fso.FileExists(LINK_DIRS[i] + "\\" + name)) p = LINK_DIRS[i] + "\\" + name;
  if (!p) {
    var pk = [env("%LOCALAPPDATA%") + "\\Microsoft\\WinGet\\Packages", progFiles() + "\\WinGet\\Packages"];
    for (i = 0; i < pk.length && !p; i++) if (fso.FolderExists(pk[i])) p = searchTree(pk[i], name, 4);
  }
  for (i = 0; i < dirs.length && !p; i++) if (fso.FileExists(dirs[i] + "\\" + name)) p = dirs[i] + "\\" + name;
  if (p) toolCache[name] = p;
  return p;
}
function ytDlpExe() { return findTool("yt-dlp.exe"); }

/* legge la versione di yt-dlp in modo sincrono.
   Metodo 1: cmd nascosto con output su file.  Metodo 2 (se il primo fallisce): WScript.Shell.Exec.
   Lascia in state.versionInfo il dettaglio per la diagnosi. */
function readVersion(exe) {
  var out = DIR_TMP + "\\ver_" + newToken() + ".txt", v = "", info = [], raw = "", m;
  ensureDir(DIR_TMP);
  try {
    var code = sh.Run('"' + EXE_CMD + '" /d /v:off /s /c ""' + exe + '" --version > "' + out + '" 2>&1"', 0, true);
    info.push("metodo1 uscita=" + code + " file=" + fso.FileExists(out));
    if (fso.FileExists(out)) {
      var f = fso.OpenTextFile(out, 1, false, 0); raw = f.AtEndOfStream ? "" : f.ReadAll(); f.Close();
      info.push("output=[" + raw.replace(/\s+$/, "").substring(0, 300) + "]");
      m = raw.match(/\d{4}\.\d{2}\.\d{2}/); if (m) v = m[0];
    }
  } catch (e) { info.push("metodo1 eccezione: " + (e.message || e)); }
  tryDelete(out);
  if (!v) {
    try {
      var ex = sh.Exec('"' + exe + '" --version'), t0 = new Date().getTime();
      var so = ex.StdOut.ReadAll(), se = ex.StdErr.ReadAll();
      while (ex.Status === 0 && new Date().getTime() - t0 < 15000) { /* attesa breve */ }
      info.push("metodo2 uscita=" + ex.ExitCode + " output=[" + (so + se).replace(/\s+$/, "").substring(0, 300) + "]");
      m = (so + se).match(/\d{4}\.\d{2}\.\d{2}/); if (m) v = m[0];
    } catch (e2) { info.push("metodo2 eccezione: " + (e2.message || e2)); }
  }
  state.versionInfo = "yt-dlp: " + exe + " | cmd: " + EXE_CMD + " | " + info.join(" | ");
  DEBUG_ERRORS.push("readVersion -> " + (v || "FALLITO") + " :: " + state.versionInfo);
  return v;
}
function newToken() {
  var t = "", c = "abcdefghijklmnopqrstuvwxyz0123456789";
  for (var i = 0; i < 16; i++) t += c.charAt(Math.floor(Math.random() * c.length));
  return "SVW" + t;
}

/* ---------- sanitizzazione ---------- */
function cleanUrl(u) {
  u = String(u).replace(/[\x00-\x20\x7f"<>`]/g, "");
  /* punteggiatura di fine frase; la ) finale solo se non chiude una ( dell'URL (es. foto.jpg?v=(2)) */
  for (;;) {
    var c = u.charAt(u.length - 1);
    if (/[,.;:!?\]'|]/.test(c) && u.length) u = u.substring(0, u.length - 1);
    else if (c === ")" && u.split(")").length > u.split("(").length) u = u.substring(0, u.length - 1);
    else break;
  }
  u = u.replace(/[^\x21-\x7e]/g, function (ch) { try { return encodeURIComponent(ch); } catch (e) { return ""; } });
  if (!/^https?:\/\/[^\/\s]+/i.test(u) || u.length > MAX_URL_LEN) return "";
  return u;
}
var RESERVED = /^(con|prn|aux|nul|com[0-9]|lpt[0-9])(\..*)?$/i;
function cleanName(n) {
  n = String(n || "").replace(/[\x00-\x1f\x7f<>:"\/\\|?*]/g, " ").replace(/\s+/g, " ");
  n = n.replace(/^[\s.]+|[\s.]+$/g, "");
  if (n.length > MAX_NAME_LEN) n = n.substring(0, MAX_NAME_LEN).replace(/[\s.]+$/, "");
  if (RESERVED.test(n)) n = "_" + n;
  return n;
}
/* il nome finisce in un template di output di yt-dlp: % va raddoppiato */
function tplEscape(n) { return n.replace(/%/g, "%%").replace(/\$/g, "\uFF04"); }   /* $ viene espanso da yt-dlp: uso il $ a larghezza piena */
/* valore tra virgolette per il file di configurazione (parsing stile shell) */
function cfgQuote(s) { return '"' + String(s).replace(/\\/g, "/").replace(/"/g, "") + '"'; }

/* ---------- coda ---------- */
/* asImg: link di immagini (marcati dall'estensione): si scaricano con curl anche se l'URL non ha estensione */
/* quiet: nessun messaggio (lo fa chi chiama, es. un solo riepilogo per l'invio dell'estensione).
   Ritorna { added, skipped, pending }: pending = link gia' in lista ma non ancora scaricati (per \u00abScarica subito\u00bb) */
var IMG_REF = "";   /* Referer per le immagini che parseText sta aggiungendo (lo imposta extPoll) */
var EXT_CK = "";    /* login mandato dall'estensione per i link che parseText sta aggiungendo (lo imposta extPoll) */
var EXT_CKNOW = false;   /* «Riprova con il mio login»: il login si usa subito, senza aspettare un altro errore */

/* ---------- «Usa il mio login» dell'estensione Chrome ----------
   L'estensione legge i cookie dei siti inviati (solo con l'interruttore acceso) e li passa al ponte native messaging,
   che li scrive in DIR_APP\cookies\<token>.txt; negli appunti viaggia solo il token. L'app li usa SOLO se il sito
   chiede l'accesso (riprova una volta con --cookies) e li cancella a fine lavoro: valgono solo per quell'invio. */
var EXT_ID = "pebnkaehmjjlhikgbcidlhkjjgonagei", NMH_NAME = "com.welsho.downconvertron";
/* LOGIN_ASK: il sito dice davvero che serve l'accesso (solo questo fa proporre «Riprova con il mio login»).
   LOGIN_ERR: in piu' i 401/403 generici, che bastano per UN tentativo automatico con il login gia' mandato ma non
   per dire all'utente che serve l'accesso: un 403 e' spesso yt-dlp vecchio o una protezione del sito */
var LOGIN_ASK = /Sign in to confirm|not a bot|confirm your age|age[- ]restricted|inappropriate for some users|--cookies|login required|log ?in (?:required|to (?:view|watch|access|continue))|requires? (?:authentication|login|an account)|members[- ]only|Private video/i;
var LOGIN_ERR = new RegExp(LOGIN_ASK.source + "|HTTP Error 40[13]", "i");
function ckDir() { return DIR_APP + (window.DCVT_MAC ? "/" : "\\") + "cookies"; }
function ckFile(it) { return it && it.ck ? ckDir() + (window.DCVT_MAC ? "/" : "\\") + it.ck + ".txt" : ""; }
/* login disponibile e non ancora usato per questa riga, e l'errore dice che serve l'accesso */
function ckWanted(it, err) {
  try { return !!(it && it.ck && !it.ckUse && LOGIN_ERR.test(err || "") && fso.FileExists(ckFile(it))); } catch (e) { return false; }
}
/* Quanto vive un login su disco:
   - CK_ORPHAN_MS: file che nessuna riga usa (l'invio dell'estensione deve ancora arrivare dagli appunti); se invece il
     suo token e' gia' arrivato all'app (CK_SEEN) e nessuna riga lo usa piu', sparisce subito;
   - CK_IDLE_MS: file di righe ferme in lista senza un download in corso. I link restano: se il sito chiede l'accesso,
     l'estensione propone «Riprova con il mio login».
   Finche' l'app ha login in uso aggiorna cookies/in_uso (CK_TICK_MS): il ponte, se quel file manca o e' fermo,
   sa che nessuno li usa e li toglie da solo (windows/dcvt_host.ps1, mac/src/dcvt_host.js). */
var CK_SEEN = {}, CK_ORPHAN_MS = 600000, CK_IDLE_MS = 1800000, CK_TICK_MS = 60000, CK_LAST = 0;
function ckAlive() { return ckDir() + (window.DCVT_MAC ? "/" : "\\") + "in_uso"; }
/* via i login delle righe in lista (fine lavoro, chiusura); all = anche quelli rimasti da prima (piu' vecchi di orphanMs) */
function ckCleanup(all, orphanMs) {
  var i, n = 0;
  for (i = 0; i < state.items.length; i++) { var it = state.items[i]; if (it.ck) { tryDelete(ckFile(it)); delete CK_SEEN[it.ck]; it.ck = ""; it.ckUse = false; n++; } }
  if (all) {
    try {
      var e = new Enumerator(fso.GetFolder(ckDir()).Files), now = new Date().getTime(), old = [];
      for (; !e.atEnd(); e.moveNext()) { var f = e.item(); if (/\.txt$/i.test(f.Name) && now - new Date(f.DateLastModified).getTime() > (orphanMs === undefined ? CK_ORPHAN_MS : orphanMs)) old.push(String(f.Path)); }
      for (i = 0; i < old.length; i++) { tryDelete(old[i]); n++; }
    } catch (x) {}
    tryDelete(ckAlive());
  }
  return n;
}
/* token ancora utili: righe non scaricate che li portano, e invii dell'estensione presi dagli appunti ma non ancora in lista */
function ckRefs() {
  var r = {}, i, m, pend = (typeof EXTST === "object" && EXTST && EXTST.pending) || [];
  for (i = 0; i < state.items.length; i++) if (state.items[i].ck && state.items[i].status !== "ok") r[state.items[i].ck] = true;
  for (i = 0; i < pend.length; i++) { m = /(?:^|\n)#cookies=([a-z0-9]{16,64})\r?(?:\n|$)/.exec(String(pend[i])); if (m) r[m[1]] = true; }
  return r;
}
/* toglie i login che non servono piu' (vedi sopra) e tiene aggiornato cookies/in_uso. Ritorna quanti ne ha tolti.
   La chiamano: la riga tolta, «Svuota lista», l'arrivo di un invio dell'estensione e il controllo periodico (ckTick) */
function ckSweep() {
  var n = 0, held = false, i;
  try {
    if (!fso.FolderExists(ckDir())) return 0;
    var refs = ckRefs(), now = new Date().getTime(), e = new Enumerator(fso.GetFolder(ckDir()).Files), del = [];
    for (; !e.atEnd(); e.moveNext()) {
      var f = e.item(), nm = String(f.Name);
      if (!/\.txt$/i.test(nm)) continue;
      var tok = nm.replace(/\.txt$/i, ""), age = now - new Date(f.DateLastModified).getTime();
      if (refs[tok] ? (!state.busy && age > CK_IDLE_MS) : (CK_SEEN[tok] || age > CK_ORPHAN_MS)) del.push([String(f.Path), tok]);
      else if (refs[tok]) held = true;
    }
    for (i = 0; i < del.length; i++) { tryDelete(del[i][0]); delete CK_SEEN[del[i][1]]; n++; }
    /* righe rimaste senza il loro file: non hanno piu' un login */
    for (i = 0; i < state.items.length; i++) { var it = state.items[i]; if (it.ck && !fso.FileExists(ckFile(it))) { it.ck = ""; it.ckUse = false; } }
    if (held) writeUtf8NoBom(ckAlive(), "1"); else tryDelete(ckAlive());
  } catch (x) { if (!ckSweep.failed) { ckSweep.failed = true; DEBUG_ERRORS.push("login: " + (x.message || x)); } }
  return n;
}
function ckTick() {
  var now = new Date().getTime();
  if (now - CK_LAST < CK_TICK_MS && now >= CK_LAST) return;
  CK_LAST = now;
  if (ckSweep()) logEvent("app", T("Login di Chrome non più usato: cancellato."));
}
/* link finiti in errore perche' il sito chiede l'accesso: il ponte li passa all'estensione, che mostra
   «Riprova con il mio login». Righe "vid|img <TAB> url <TAB> nome"; il file sparisce quando non ce ne sono */
function loginFile() { return DIR_APP + (window.DCVT_MAC ? "/" : "\\") + "login_richiesto.txt"; }
function loginListWrite() {
  var i, out = [], cl = function (v) { return String(v || "").replace(/[\t\r\n]+/g, " "); };
  for (i = 0; i < state.items.length && out.length < 50; i++) {
    var it = state.items[i];
    if (it.status === "err" && it.loginErr && /^https?:\/\//i.test(it.url || "")) out.push((isImageItem(it) ? "img" : "vid") + "\t" + cl(it.url) + "\t" + cl(it.name));
  }
  try { if (out.length) { ensureDir(DIR_APP); writeUtf8NoBom(loginFile(), out.join("\n") + "\n"); } else tryDelete(loginFile()); } catch (e) { DEBUG_ERRORS.push("login_richiesto: " + (e.message || e)); }
  return out.length;
}
/* ponte registrato per il tuo utente (HKCU, niente amministratore) a ogni avvio, come il protocollo: segue l'app se la sposti */
var NMH_PS = "# DownConvertron - ponte native messaging per l'estensione Chrome (Windows)\n# Copyright (C) 2026 Daniele Moretti (Welsho) - GPL-3.0-or-later\n# Chrome lo avvia (tramite dcvt_host.bat) SOLO per l'estensione DownConvertron (allowed_origins nel manifest).\n# Riceve il login del sito (cookie in formato Netscape) scelto con \"Usa il mio login\" e lo scrive in\n# %APPDATA%\\DownConvertron\\cookies\\<token>.txt: l'app lo usa solo se il sito chiede l'accesso e lo cancella a fine lavoro.\n# Protocollo di Chrome: 4 byte di lunghezza (little endian) + JSON in UTF-8, in entrambe le direzioni.\n# Niente deve uscire su stdout oltre alla risposta.\n$ErrorActionPreference = 'Stop'\nfunction Reply($obj) {\n  $b = [Text.Encoding]::UTF8.GetBytes((ConvertTo-Json $obj -Compress -Depth 5))\n  $out = [Console]::OpenStandardOutput()\n  $out.Write([BitConverter]::GetBytes([int]$b.Length), 0, 4); $out.Write($b, 0, $b.Length); $out.Flush()\n}\nfunction ReadExact($s, $n) {\n  $buf = New-Object byte[] $n; $got = 0\n  while ($got -lt $n) { $r = $s.Read($buf, $got, $n - $got); if ($r -le 0) { break }; $got += $r }\n  if ($got -ne $n) { throw 'messaggio incompleto' }\n  return ,$buf\n}\ntry {\n  $in = [Console]::OpenStandardInput()\n  $len = [BitConverter]::ToInt32((ReadExact $in 4), 0)\n  if ($len -le 0 -or $len -gt 1572864) { throw 'messaggio troppo grande' }\n  $msg = [Text.Encoding]::UTF8.GetString((ReadExact $in $len)) | ConvertFrom-Json\n  $dir = Join-Path $env:APPDATA 'DownConvertron\\cookies'\n  # login rimasti su disco senza nessuno che li usi, a ogni chiamata (anche la semplice apertura del popup):\n  # l'app, finche' ne ha in uso, aggiorna cookies\\in_uso ogni minuto. Se quel file manca o e' fermo da 5 minuti\n  # l'app e' chiusa o non li usa piu': via i login piu' vecchi di 10 minuti. In ogni caso, via dopo 6 ore.\n  try {\n    if (Test-Path -LiteralPath $dir) {\n      $viva = Join-Path $dir 'in_uso'; $lim = (Get-Date).AddHours(-6)\n      if (-not ((Test-Path -LiteralPath $viva) -and (Get-Item -LiteralPath $viva).LastWriteTime -gt (Get-Date).AddMinutes(-5))) { $lim = (Get-Date).AddMinutes(-10) }\n      Get-ChildItem -LiteralPath $dir -Filter '*.txt' -ErrorAction SilentlyContinue | Where-Object { $_.LastWriteTime -lt $lim } | Remove-Item -Force -ErrorAction SilentlyContinue\n    }\n  } catch {}\n  if ($msg.op -eq 'ping') { Reply @{ ok = $true; v = 2 }; exit 0 }\n  # link che hanno chiesto l'accesso (li scrive l'app a fine lavoro): l'estensione mostra \"Riprova con il mio login\"\n  if ($msg.op -eq 'richieste') {\n    $f = Join-Path $env:APPDATA 'DownConvertron\\login_richiesto.txt'; $l = New-Object System.Collections.ArrayList\n    if ((Test-Path -LiteralPath $f) -and (Get-Item -LiteralPath $f).LastWriteTime -gt (Get-Date).AddHours(-24)) {\n      foreach ($r in [IO.File]::ReadAllLines($f, (New-Object Text.UTF8Encoding $false))) {\n        $p = $r.Split([char]9)\n        if ($p.Length -ge 2 -and $p[1] -match '^https?://') { $n = ''; if ($p.Length -ge 3) { $n = $p[2] }; [void]$l.Add(@{ t = $p[0]; url = $p[1]; nome = $n }) }\n        if ($l.Count -ge 50) { break }\n      }\n    }\n    Reply @{ ok = $true; links = @($l) }; exit 0\n  }\n  # logo e invio dell'estensione: avvia l'app o la porta in primo piano (senza passare da downconvertron://,\n  # che Chrome blocca se tra il clic e l'apertura passa troppo tempo e che non puo' portare l'app davanti)\n  if ($msg.op -eq 'open') {\n    $link = [string]$msg.url\n    if ($link -notmatch '^downconvertron://[A-Za-z0-9_./?=&%-]*$') { $link = 'downconvertron://open' }\n    $app = Get-CimInstance Win32_Process -Filter \"Name = 'mshta.exe'\" -ErrorAction SilentlyContinue |\n      Where-Object { [string]$_.CommandLine -match '[\\\\/\"]DownConvertron[^\\\\/\"]*\\.hta' } | Select-Object -First 1\n    $how = 'front'; $wait = 2\n    if ($app) { $appId = $app.ProcessId }\n    else {\n      # percorso dell'app: lo scrive DownConvertron a ogni avvio (app.txt accanto a questo script)\n      $hta = ''; $cfg = Join-Path $PSScriptRoot 'app.txt'\n      if (Test-Path -LiteralPath $cfg) { $hta = ([IO.File]::ReadAllText($cfg, (New-Object Text.UTF8Encoding $false))).Trim() }\n      if (-not $hta -or -not (Test-Path -LiteralPath $hta)) { throw 'app non trovata' }\n      # avvio con WMI: il processo nasce fuori dal gruppo di processi del ponte, che Chrome chiude a fine messaggio\n      $cmd = '\"' + (Join-Path $env:SystemRoot 'System32\\mshta.exe') + '\" \"' + $hta + '\" \"' + $link + '\"'\n      $r = Invoke-CimMethod -ClassName Win32_Process -MethodName Create -Arguments @{ CommandLine = $cmd }\n      if ($r.ReturnValue -ne 0) { throw ('avvio non riuscito (' + $r.ReturnValue + ')') }\n      $appId = $r.ProcessId; $how = 'start'; $wait = 20\n    }\n    $win = [IntPtr]::Zero; $end = (Get-Date).AddSeconds($wait)\n    do {\n      $pr = Get-Process -Id $appId -ErrorAction SilentlyContinue\n      if ($pr -and $pr.MainWindowHandle -ne [IntPtr]::Zero) { $win = $pr.MainWindowHandle; break }\n      Start-Sleep -Milliseconds 200\n    } while ((Get-Date) -lt $end)\n    $front = $false\n    if ($win -ne [IntPtr]::Zero) {\n      $u = Add-Type -Name W -Namespace DCVT -PassThru -MemberDefinition @'\n[DllImport(\"user32.dll\")] public static extern bool IsIconic(IntPtr h);\n[DllImport(\"user32.dll\")] public static extern bool ShowWindowAsync(IntPtr h, int c);\n[DllImport(\"user32.dll\")] public static extern bool SetForegroundWindow(IntPtr h);\n[DllImport(\"user32.dll\")] public static extern bool BringWindowToTop(IntPtr h);\n[DllImport(\"user32.dll\")] public static extern IntPtr GetForegroundWindow();\n[DllImport(\"user32.dll\")] public static extern void keybd_event(byte vk, byte scan, uint flags, UIntPtr extra);\n'@\n      if ($u::IsIconic($win)) { [void]$u::ShowWindowAsync($win, 9) }\n      # Windows non lascia cambiare il primo piano a un programma in secondo piano, ma lo permette con Alt premuto:\n      # Alt giu', primo piano, Alt su (il rilascio arriva gia' all'app, quindi Chrome non apre il suo menu)\n      for ($k = 0; $k -lt 3 -and -not $front; $k++) {\n        $u::keybd_event(0x12, 0, 0, [UIntPtr]::Zero)\n        [void]$u::SetForegroundWindow($win)\n        $u::keybd_event(0x12, 0, 2, [UIntPtr]::Zero)\n        [void]$u::BringWindowToTop($win)\n        Start-Sleep -Milliseconds 150\n        $front = ($u::GetForegroundWindow() -eq $win)\n      }\n    }\n    Reply @{ ok = $true; how = $how; front = $front }; exit 0\n  }\n  if ($msg.op -ne 'cookies') { throw 'operazione sconosciuta' }\n  $tok = [string]$msg.token; $data = [string]$msg.data\n  # solo minuscole e cifre, senza a-capo finale (-cnotmatch distingue le maiuscole, \\z non accetta l'a-capo)\n  if ($tok -cnotmatch '\\A[a-z0-9]{16,64}\\z') { throw 'token non valido' }\n  if (-not $data.StartsWith('# Netscape HTTP Cookie File')) { throw 'dati non validi' }\n  if (-not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }\n  [IO.File]::WriteAllText((Join-Path $dir ($tok + '.txt')), $data, (New-Object Text.UTF8Encoding $false))\n  Reply @{ ok = $true }\n} catch {\n  try { Reply @{ ok = $false; err = [string]$_.Exception.Message } } catch {}\n  exit 1\n}\n";
function nmhRegister() {
  if (window.DCVT_MAC) return;
  var dir = DIR_APP + "\\nmhost", man = dir + "\\" + NMH_NAME + ".json";
  ensureDir(DIR_APP); ensureDir(dir);
  writeAscii(dir + "\\dcvt_host.ps1", NMH_PS);
  /* percorso di questa app: il ponte la avvia da qui quando premi il logo dell'estensione (op "open") */
  var hta = htaPath();
  if (hta) writeUtf8NoBom(dir + "\\app.txt", hta);
  writeAscii(dir + "\\dcvt_host.bat", '@echo off\r\n"%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "%~dp0dcvt_host.ps1"\r\n');
  var js = function (v) { return '"' + String(v).replace(/\\/g, "\\\\").replace(/"/g, '\\"') + '"'; };
  writeUtf8NoBom(man, '{\n "name": ' + js(NMH_NAME) + ',\n "description": "DownConvertron",\n "path": ' + js(dir + "\\dcvt_host.bat") +
    ',\n "type": "stdio",\n "allowed_origins": ["chrome-extension://' + EXT_ID + '/"]\n}\n');
  sh.RegWrite("HKCU\\Software\\Google\\Chrome\\NativeMessagingHosts\\" + NMH_NAME + "\\", man, "REG_SZ");
}
function parseText(text, asImg, quiet) {
  var lines = String(text).split(/\r?\n/), added = 0, skipped = 0, pending = 0, seen = {}, i, j;
  for (i = 0; i < state.items.length; i++) seen[state.items[i].url] = state.items[i];
  for (i = 0; i < lines.length; i++) {
    /* ' e | possono stare negli URL (Chrome non li codifica): il nome dall'estensione arriva dopo " | " */
    var line = lines[i], m, found = [], re = /https?:\/\/[^\s"<>`]+/gi;
    while ((m = re.exec(line)) !== null) found.push(m[0]);
    if (!found.length) continue;
    var name = "";
    if (found.length === 1) {
      var bar = line.indexOf(" | ", line.indexOf(found[0]) + found[0].length - 1);
      if (bar < 0 && /\|$/.test(found[0])) bar = line.indexOf(found[0]) + found[0].length - 1;   /* "url| nome" */
      if (bar >= 0) { name = cleanName(line.substring(bar).replace(/^\s*\|/, "")); found[0] = found[0].replace(/\|$/, ""); }
    }
    /* senza " | ": "url|nome" scritto a mano e "url|url" vanno divisi; "|" resta nell'URL se dopo sembra ancora un URL (/ ? = & %) */
    if (!name) {
      var parts2 = [], k, p, cur;
      for (j = 0; j < found.length; j++) {
        p = found[j].split("|"); cur = p[0];
        for (k = 1; k < p.length; k++) {
          if (/^https?:\/\//i.test(p[k])) { parts2.push(cur); cur = p[k]; }
          else if (found.length === 1 && p[k] && !/[\/?=&%]/.test(p[k])) {
            name = cleanName(p.slice(k).join("|") + line.substring(line.indexOf(found[j]) + found[j].length));
            break;
          }
          else cur += "|" + p[k];
        }
        parts2.push(cur);
      }
      found = parts2;
    }
    for (j = 0; j < found.length; j++) {
      var u = cleanUrl(found[j]);
      if (!u || seen[u]) {
        skipped++;
        if (u && seen[u] && seen[u].status !== "ok") { pending++; if (EXT_CK) { seen[u].ck = EXT_CK; seen[u].ckUse = EXT_CKNOW; } }
        continue;
      }
      if (state.items.length >= MAX_ITEMS) { skipped++; continue; }
      var item = asImg ? { id: state.nextId++, url: u, name: name, status: "wait", img: true } : { id: state.nextId++, url: u, name: name, status: "wait" };
      if (isImageItem(item)) item.imgFmt = $("imgDef").value;   /* formato del riquadro Immagini, cambiabile poi nella riga */
      if (asImg && IMG_REF) item.ref = IMG_REF;                  /* pagina da cui vengono (Referer) */
      if (EXT_CK) { item.ck = EXT_CK; item.ckUse = EXT_CKNOW; }  /* login del sito: solo se serve, o subito con «Riprova» */
      seen[u] = item;
      state.items.push(item);
      added++;
    }
  }
  renderQueue();
  if (!quiet) {
    if (added) showMsg((added === 1 ? T("1 link aggiunto") : T("{0} link aggiunti", added)) + (skipped ? T(" ({0} doppi o non validi ignorati)", skipped) : "") + ".", "info");
    else showMsg(T("Nessun link valido trovato") + (skipped ? T(" ({0} gi\u00e0 in lista o non validi)", skipped) : "") + ".", "err");
  }
  return { added: added, skipped: skipped, pending: pending };
}

function addFromInput() { if (state.busy) return; parseText($("urlIn").value); $("urlIn").value = ""; }
function addFromClipboard() {
  if (state.busy) return;
  var t = "";
  try { t = window.clipboardData.getData("Text") || ""; } catch (e) {}
  if (!t) { showMsg("Gli appunti sono vuoti o non contengono testo.", "err"); return; }
  parseText(t);
}
function importTxt() { if (state.busy) return; var f = $("fileIn"); f.value = ""; f.click(); }
function onFilePicked(el) {
  var p = el.value;
  if (!p || !fso.FileExists(p)) { showMsg("Impossibile leggere il file scelto.", "err"); return; }
  try {
    if (fso.GetFile(p).Size > 5 * 1024 * 1024) { showMsg("File troppo grande (massimo 5 MB).", "err"); return; }
    parseText(readUtf8(p));
  } catch (e) { showMsg("Impossibile leggere il file scelto.", "err"); }
}
function onExePicked(el) {
  var p = el.value;
  if (!p || !fso.FileExists(p) || !/\\yt-dlp[^\\]*\.exe$/i.test(p)) { showMsg("Seleziona il file yt-dlp.exe.", "err"); return; }
  toolCache["yt-dlp.exe"] = p;
  saveSettings();
  showMsg("yt-dlp impostato: " + p + ". Ora premi Scarica.", "ok");
}
function clearQueue() {
  if (state.busy) return;
  var i, hadLogin = false;
  for (i = 0; i < state.items.length; i++) if (state.items[i].loginErr) hadLogin = true;
  state.items = []; renderQueue(); $("msg").style.display = "none";
  ckSweep();                              /* i login delle righe tolte non servono piu' */
  if (hadLogin) loginListWrite();         /* e l'estensione non deve piu' proporre «Riprova» per link che non ci sono */
}
function removeItem(id) {
  if (state.busy) return;
  var hadLogin = false;
  for (var i = 0; i < state.items.length; i++) if (state.items[i].id === id) { hadLogin = !!state.items[i].loginErr; state.items.splice(i, 1); break; }
  renderQueue();
  ckSweep();
  if (hadLogin) loginListWrite();
}
function numberAll() {
  if (state.busy || !state.items.length) return;
  var base = cleanName($("baseName").value);
  if (!base) { showMsg("Scrivi prima un nome comune (es. Vacanze).", "err"); return; }
  var w = String(state.items.length).length < 2 ? 2 : String(state.items.length).length;
  for (var i = 0; i < state.items.length; i++) {
    var n = String(i + 1); while (n.length < w) n = "0" + n;
    state.items[i].name = state.items.length === 1 ? base : base + " " + n;
  }
  renderQueue();
}

var BADGE = { wait: ["In attesa", ""], run: ["In corso", "run"], ok: ["Fatto", "ok"], part: ["Parziale", "part"], err: ["Errore", "err"], stop: ["Annullato", "err"] };
function renderQueue() {
  var box = $("queue");
  while (box.firstChild) box.removeChild(box.firstChild);
  if (!state.items.length) {
    var e = document.createElement("div"); e.className = "empty";
    e.innerText = TX("Nessun link. Incollane uno sopra o importa una lista.");
    box.appendChild(e);
  }
  var vids = 0;
  for (var i = 0; i < state.items.length; i++) { box.appendChild(buildRow(state.items[i], i)); if (!isImageItem(state.items[i])) vids++; }
  var n = state.items.length;
  /* solo immagini in lista: il pannello Video e audio non si applica, lo attenuo */
  $("fmtCard").className = n && !vids ? "card dim" : "card";
  $("qcount").innerText = T("{0} link", n);
}
function buildRow(it, idx) {
  var row = document.createElement("div"); row.className = "item";
  var num = document.createElement("div"); num.className = "num"; num.innerText = idx + 1;
  var body = document.createElement("div"); body.className = "body";
  var url = document.createElement("div"); url.className = "url"; url.innerText = it.url; url.title = it.url;
  var name = document.createElement("input"); name.className = "name lockable"; name.type = "text";
  name.placeholder = "Nome file (vuoto = titolo originale)"; name.value = it.name; name.maxLength = MAX_NAME_LEN;
  name.disabled = state.busy;
  name.onchange = function () { it.name = cleanName(this.value); this.value = it.name; };
  body.appendChild(url); body.appendChild(name);
  var b = BADGE[it.status] || BADGE.wait;
  var badge = document.createElement("span"); badge.className = "badge " + b[1]; badge.innerText = T(b[0]);
  if (it.error) badge.title = TX(it.error);
  var del = document.createElement("button"); del.className = "del lockable"; del.innerHTML = "&times;"; del.title = TX("Rimuovi");
  del.disabled = state.busy;
  del.onclick = function () { removeItem(it.id); };
  row.appendChild(num); row.appendChild(body);
  /* immagini: si sceglie per riga se salvarle cosi' come sono (byte identici) o convertirle con ffmpeg */
  if (isImageItem(it)) {
    var fmt = document.createElement("select"), fo = IMG_DL_FMT, fi;
    fmt.className = "ifmt lockable"; fmt.title = TX("Formato dell'immagine: Originale salva il file così com'è sul server, senza ricodifica.");
    for (fi = 0; fi < fo.length; fi++) { var op = document.createElement("option"); op.value = fo[fi][0]; op.text = TX(fo[fi][1]); fmt.options.add(op); if (fo[fi][0] === (it.imgFmt || "")) op.selected = true; }
    fmt.disabled = state.busy || qDone(it);
    fmt.onchange = function () { it.imgFmt = this.value; };
    row.appendChild(fmt);
  }
  row.appendChild(badge); row.appendChild(del);
  it.badgeEl = badge;
  return row;
}
function setBadge(it, status, err) {
  if (it.status !== status || (err && err !== it.error)) {
    var who = it.name || it.title || (it.path ? baseName(it.path) : "") || it.url || "";
    if (status !== "wait") logEvent("app", T({ run: "Avvio", ok: "Completato", err: "Errore", part: "Parziale", stop: "Annullato" }[status] || status) + ": " + who + (err ? " \u2014 " + err : ""),
                                    status === "err" ? "err" : status === "ok" ? "ok" : status === "part" ? "warn" : "info", status === "ok" || status === "err");
  }
  it.status = status; it.error = err || "";
  if (it.badgeEl) { var b = BADGE[status]; it.badgeEl.className = "badge " + b[1]; it.badgeEl.innerText = T(b[0]); it.badgeEl.title = TX(it.error); }
}

/* ---------- opzioni ---------- */
function setMode(m) {
  if (state.busy) return;
  state.mode = m;
  $("bVideo").className = m === "video" ? "on lockable" : "lockable";
  $("bAudio").className = m === "audio" ? "on lockable" : "lockable";
  $("videoOpts").style.display = m === "video" ? "block" : "none";
  $("audioOpts").style.display = m === "audio" ? "block" : "none";
  checkCombo();
}
/* ---------- download video: codec e audio compatibili con ogni contenitore ---------- */
var VCODECS = {
  mp4: [["auto", "Automatico (migliore)"], ["h264", "H.264 (massima compatibilit\u00e0)"], ["vp9", "VP9"], ["av1", "AV1"]],
  mkv: [["auto", "Automatico (migliore)"], ["h264", "H.264 (massima compatibilit\u00e0)"], ["vp9", "VP9"], ["av1", "AV1"]],
  webm: [["auto", "Automatico (VP9)"], ["vp9", "VP9"], ["av1", "AV1"]],
  mov: [["h264", "H.264 (copiato senza perdita)"]],
  avi: [["h264", "H.264 (copiato senza perdita)"]],
  gif: [["gif", "GIF (solo immagini)"]]
};
var VAUDIO = {
  mp4: [["auto", "Migliore (automatico)"], ["aac", "AAC (massima compatibilit\u00e0)"], ["opus", "Opus (pi\u00f9 leggero)"], ["none", "Nessun audio (video muto)"]],
  mkv: [["auto", "Migliore (automatico)"], ["aac", "AAC (massima compatibilit\u00e0)"], ["opus", "Opus (pi\u00f9 leggero)"], ["none", "Nessun audio (video muto)"]],
  webm: [["auto", "Opus (automatico)"], ["none", "Nessun audio (video muto)"]],
  mov: [["auto", "AAC"], ["none", "Nessun audio (video muto)"]],
  avi: [["auto", "MP3 (lo standard dell'AVI)"], ["none", "Nessun audio (video muto)"]],
  gif: [["none", "Nessun audio (la GIF non ha audio)"]]
};
var FMT_NOTE = {
  mov: "MOV: H.264 + AAC copiati senza perdita (su YouTube l'H.264 arriva al massimo a 1080p). Se un video non esiste in H.264 viene convertito (pi\u00f9 lento). I sottotitoli restano file a parte.",
  avi: "AVI: formato vecchio, per lettori e programmi datati. Video H.264 copiato senza perdita (fino a 1080p su YouTube), audio convertito in MP3. Niente copertina; i sottotitoli restano file a parte.",
  gif: "GIF: solo immagini, a 15 fotogrammi al secondo, senza audio. Adatta a clip brevi: oltre 480p diventa enorme."
};
function fillVideoSelects(keepCodec, keepVA) {
  var c = $("container").value;
  /* uscendo dalla GIF (che non ha audio) torno all'audio automatico invece di restare muto */
  if (keepVA === undefined && state.lastCont === "gif" && c !== "gif") keepVA = "auto";
  if (keepCodec === undefined && state.lastCont === "gif" && c !== "gif") keepCodec = "auto";
  state.lastCont = c;
  fillSelect($("codec"), VCODECS[c] || VCODECS.mp4, keepCodec);
  fillSelect($("vAudio"), VAUDIO[c] || VAUDIO.mp4, keepVA);
}

/* ---------- scelte audio: tutte le combinazioni sensate per ogni codificatore ---------- */
function kbpsList(a) { var o = [], i; for (i = 0; i < a.length; i++) o.push(["c" + a[i], a[i] + " kbps (costante)"]); return o; }
var AQ = {
  mp3: [["", "Automatica (VBR migliore)"], ["v0", "VBR V0 (~245 kbps)"], ["v1", "VBR V1 (~225 kbps)"], ["v2", "VBR V2 (~190 kbps)"], ["v3", "VBR V3 (~175 kbps)"], ["v4", "VBR V4 (~165 kbps)"],
        ["v5", "VBR V5 (~130 kbps)"], ["v6", "VBR V6 (~115 kbps)"], ["v7", "VBR V7 (~100 kbps)"], ["v8", "VBR V8 (~85 kbps)"], ["v9", "VBR V9 (~65 kbps)"]].concat(kbpsList([320, 256, 224, 192, 160, 128, 112, 96, 80, 64, 56, 48, 40, 32])),
  m4a: [["", "Automatica (originale se gi\u00e0 AAC)"]].concat(kbpsList([256, 224, 192, 160, 128, 112, 96, 80, 64, 48, 32])),   /* l'AAC di ffmpeg non va oltre ~256 kbps reali: verificato */
  opus: [["", "Automatica (originale se gi\u00e0 Opus)"]].concat(kbpsList([510, 448, 384, 320, 256, 192, 160, 128, 112, 96, 80, 64, 48, 32, 24, 16, 12, 8, 6])),
  vorbis: [["", "Automatica (qualit\u00e0 alta)"], ["q10", "VBR q10 (~500 kbps)"], ["q9", "VBR q9 (~320 kbps)"], ["q8", "VBR q8 (~256 kbps)"], ["q7", "VBR q7 (~224 kbps)"], ["q6", "VBR q6 (~192 kbps)"],
           ["q5", "VBR q5 (~160 kbps)"], ["q4", "VBR q4 (~128 kbps)"], ["q3", "VBR q3 (~112 kbps)"], ["q2", "VBR q2 (~96 kbps)"], ["q1", "VBR q1 (~80 kbps)"], ["q0", "VBR q0 (~64 kbps)"], ["q-1", "VBR q-1 (~45 kbps)"]],
  /* Vorbis: solo qualit\u00e0 variabile, l'unica che funziona a ogni frequenza (il bitrate fisso fallisce agli estremi: verificato) */
  flac: [["", "Automatica (16 bit)"], ["s16", "16 bit"], ["s24", "24 bit"]],
  wav: [["", "Automatica (16 bit)"], ["s16", "16 bit"], ["s24", "24 bit"], ["s32", "32 bit"], ["f32", "32 bit virgola mobile"]]
};
var RATES = {
  mp3: [8000, 11025, 12000, 16000, 22050, 24000, 32000, 44100, 48000],
  m4a: [8000, 11025, 12000, 16000, 22050, 24000, 32000, 44100, 48000, 64000, 88200, 96000],
  opus: [8000, 12000, 16000, 24000, 48000],
  vorbis: [8000, 11025, 16000, 22050, 32000, 44100, 48000, 88200, 96000, 176400, 192000],
  flac: [8000, 11025, 16000, 22050, 32000, 44100, 48000, 88200, 96000, 176400, 192000, 352800, 384000],
  wav: [8000, 11025, 16000, 22050, 32000, 44100, 48000, 88200, 96000, 176400, 192000, 352800, 384000]
};
var ENC_FOR = { mp3: "libmp3lame", m4a: "aac", opus: "libopus", vorbis: "libvorbis", flac: "flac", wav: "pcm_s16le" };
var ENC_NAME = { libwebp: "WebP", mjpeg: "JPG", libwebp_anim: "WebP animato", apng: "APNG", hap: "HAP", cfhd: "CineForm", tiff: "TIFF", exr: "EXR", h264_videotoolbox: "H.264 del chip Mac", hevc_videotoolbox: "HEVC del chip Mac", libx264: "H.264", libx265: "H.265", qtrle: "Animazione", png: "PNG", gif: "GIF", libmp3lame: "MP3", aac: "AAC", libopus: "Opus", libvorbis: "Vorbis", flac: "FLAC", pcm_s16le: "WAV", pcm_s24le: "WAV 24 bit", pcm_s32le: "WAV 32 bit", pcm_f32le: "WAV virgola mobile", "libvpx-vp9": "VP9", prores_ks: "ProRes" };
var ENC_ALL = ["libmp3lame", "aac", "libopus", "libvorbis", "flac", "pcm_s16le", "pcm_s24le", "libvpx-vp9", "prores_ks", "libx264", "libx265", "qtrle", "png", "gif"];
function rateLabel(r) { var k = r / 1000; return (k === Math.floor(k) ? k : String(k).replace(".", ",")) + " kHz"; }
function fillSelect(sel, items, keep) {
  var want = keep !== undefined ? keep : sel.value, found = false, i;
  while (sel.options.length) sel.remove(0);
  for (i = 0; i < items.length; i++) { var op = document.createElement("option"); op.value = items[i][0]; op.text = TX(items[i][1]); sel.add(op); if (items[i][0] === want) found = true; }
  sel.value = found ? want : items[0][0];
}
/* riempie bitrate e frequenze in base al formato scelto (mantiene la scelta se ancora valida) */
function fillAudioSelects(keepQ, keepRate) {
  var a = $("afmt").value, i, rates = [["", "Originale"]];
  fillSelect($("aq"), AQ[a] || [["", "Originale"]], keepQ);
  var rl = RATES[a] || [];
  for (i = rl.length - 1; i >= 0; i--) rates.push([String(rl[i]), rateLabel(rl[i])]);
  fillSelect($("aRate"), rates, keepRate);
  $("aqLbl").innerText = TX((a === "flac" || a === "wav") ? "Profondit\u00e0 di bit" : "Bitrate / qualit\u00e0");
}

/* codificatori presenti in ffmpeg (letti una volta; azzerati dopo l'installazione dei componenti) */
var encCache = null;
function ffmpegEncoders() {
  if (encCache) return encCache;
  var ff = findTool("ffmpeg.exe"); if (!ff) return null;
  ensureDir(DIR_TMP);
  var out = DIR_TMP + "\\enc_" + newToken() + ".txt", t = "";
  try {
    sh.Run('"' + EXE_CMD + '" /d /v:off /s /c ""' + ff + '" -hide_banner -encoders > "' + out + '" 2>&1"', 0, true);
    if (fso.FileExists(out)) { var f = fso.OpenTextFile(out, 1, false, 0); t = f.AtEndOfStream ? "" : f.ReadAll(); f.Close(); }
  } catch (e) {}
  tryDelete(out);
  var map = {}, n = 0, lines = t.split(/\r?\n/), i, m;
  for (i = 0; i < lines.length; i++) { m = lines[i].match(/^\s[VAS][.A-Z]{5}\s+(\S+)/); if (m) { map[m[1]] = 1; n++; } }
  if (!n) return null;                    /* lettura fallita: non blocco nulla */
  encCache = map;
  return map;
}
function missingEncoders(list) {
  var e = ffmpegEncoders(), out = [], i;
  if (!e) return out;
  for (i = 0; i < list.length; i++) if (!e[list[i]]) out.push(list[i]);
  return out;
}
function encNames(list) { var o = [], i; for (i = 0; i < list.length; i++) o.push(ENC_NAME[list[i]] || list[i]); return o.join(", "); }

/* ricodifica completa: estrazione senza perdite (WAV a virgola mobile) e poi codificatore con i parametri esatti.
   Serve perch\u00e9 yt-dlp altrimenti copia l'audio quando il codec coincide e ignora bitrate/frequenza (verificato). */
/* tetto reale del bitrate per formato e frequenza (MP3: MPEG-2 fino a 24 kHz max 160, MPEG-2.5 fino a 12 kHz max 64) */
function maxKbps(a, rate) {
  var r = parseInt(rate, 10) || 0;
  if (a === "mp3" && r) return r <= 12000 ? 64 : (r <= 24000 ? 160 : 320);
  if (a === "m4a") return 256;
  return 0;
}
function audioRecode(a) {
  if (!ENC_FOR[a]) return null;
  var q = $("aq").value, rate = $("aRate").value, ch = $("aChan").value, norm = $("optNorm").checked;
  if (!q && !rate && !ch && !norm) return null;
  var enc = ENC_FOR[a], x = [];
  if (a === "wav" && q) enc = { s16: "pcm_s16le", s24: "pcm_s24le", s32: "pcm_s32le", f32: "pcm_f32le" }[q] || "pcm_s16le";
  x.push("-c:a " + enc);
  if (a === "flac") x.push(q === "s24" ? "-sample_fmt s32 -bits_per_raw_sample 24" : "-sample_fmt s16");
  if (q.charAt(0) === "c") {
    var kb = parseInt(q.substring(1), 10);
    if (a === "opus" && kb > 256) { if (ch === "1") kb = 256; else if (!ch) x.push("-ac 2"); }   /* Opus: max 256 kbps per canale */
    var cap = maxKbps(a, rate);
    if (cap && kb > cap) kb = cap;
    x.push("-b:a " + kb + "k");
    if (a === "opus") x.push("-vbr off");                      /* "costante" davvero (libopus di serie e' VBR) */
  }
  else if (q.charAt(0) === "v" && a === "mp3") x.push("-q:a " + q.substring(1));
  else if (q.charAt(0) === "q" && a === "vorbis") x.push("-q:a " + q.substring(1));
  else if (!q) x.push({ mp3: "-q:a 0", m4a: "-b:a 256k", opus: "-b:a 160k", vorbis: "-q:a 6", flac: "", wav: "" }[a]);
  if (norm) x.push("-af " + (ch ? "aformat=channel_layouts=" + (ch === "1" ? "mono" : "stereo") + "," : "") + "loudnorm=I=-16:TP=-1.5:LRA=11");
  if (rate) x.push("-ar " + rate); else if (norm) x.push("-ar 48000");   /* loudnorm altrimenti esce a 192 kHz */
  if (ch) x.push("-ac " + ch);
  var args = [], k;
  for (k = 0; k < x.length; k++) if (x[k]) args.push(x[k]);
  return { target: a === "vorbis" ? "ogg" : a, args: args.join(" "), enc: enc, direct: a === "wav" };
}

function checkCombo() {
  var q = $("quality").value;
  var webm = $("container").value === "webm";
  $("comboWarn").style.display = (state.mode === "video" && !webm && $("container").value !== "mov" && $("container").value !== "avi" && $("codec").value === "h264" && (q === "best" || parseInt(q, 10) > 1080)) ? "block" : "none";
  $("webmWarn").style.display = (state.mode === "video" && webm) ? "block" : "none";
  var af = $("afmt").value, am = state.mode === "audio";
  /* bitrate/frequenza/canali/volume: per tutti i formati che si possono ricodificare */
  var proc = am && !!ENC_FOR[af];
  $("aqCol").style.visibility = proc ? "visible" : "hidden";
  $("aProcRow").style.display = proc ? "" : "none";
  $("aProcNote").style.display = am && !proc ? "block" : "none";
  $("normLbl").style.display = proc ? "" : "none";
  var rc = proc ? audioRecode(af) : null;
  if (rc) {
    var parts = [$("afmt").options[$("afmt").selectedIndex].text.replace(/ \(.*\)$/, "")], sq = $("aq"), sr = $("aRate"), sc = $("aChan");
    if (sq.value) { var capK = maxKbps(af, sr.value), qk = sq.value.charAt(0) === "c" ? parseInt(sq.value.substring(1), 10) : 0; parts.push(capK && qk > capK ? capK + " kbps (massimo possibile a questa frequenza)" : sq.options[sq.selectedIndex].text.replace(" (costante)", "")); }
    if (sr.value) parts.push(sr.options[sr.selectedIndex].text);
    if (sc.value) parts.push(sc.options[sc.selectedIndex].text);
    if ($("optNorm").checked) parts.push("volume uniforme");
    $("aModeNote").innerText = TX("Ricodifica completa: " + parts.join(" \u00b7 "));
  } else $("aModeNote").innerText = "";
  $("aModeNote").style.display = rc ? "block" : "none";
  /* codec audio necessari: avviso come per i codec video */
  var need = am && ENC_FOR[af] ? [rc ? rc.enc : ENC_FOR[af]] : [];
  var missA = need.length ? missingEncoders(need) : [];
  $("aEncWarn").innerText = TX(missA.length ? "Il tuo ffmpeg non ha il codec " + encNames(missA) + ": premi \u00abInstalla / aggiorna componenti\u00bb (installa la versione completa)." : "");
  $("aEncWarn").style.display = missA.length ? "block" : "none";
  $("vAudioCol").style.display = am ? "none" : "";
  var ct = $("container").value;
  var vNeed = { webm: ["libvpx-vp9", "libopus"], mov: ["libx264", "aac"], avi: ["libx264", "libmp3lame"], gif: ["gif"] }[ct] || [];
  var missV = am ? [] : missingEncoders(vNeed), fw = (FMT_NOTE[ct] || "") + (missV.length ? (FMT_NOTE[ct] ? "\n" : "") + "Il tuo ffmpeg non ha il codec " + encNames(missV) + ": premi \u00abInstalla / aggiorna componenti\u00bb." : "");
  $("fmtWarn").innerText = fw; $("fmtWarn").style.display = (!am && fw) ? "block" : "none";
  $("codecCol").style.visibility = ct === "gif" ? "hidden" : "visible";
  $("cookieWarn").style.display = $("optCookies").checked ? "block" : "none";
}
function pickFolder() {
  if (state.busy) return;
  try {
    var f = new ActiveXObject("Shell.Application").BrowseForFolder(0, TX("Scegli dove salvare i file"), 0x51, 0);
    if (f && f.Self && f.Self.Path && fso.FolderExists(f.Self.Path)) { state.folder = f.Self.Path; $("folderPath").innerText = state.folder; saveSettings(); }
  } catch (e) {}
}
function openFolder() { if (fso.FolderExists(state.folder)) sh.Run('"' + EXE_EXPLORER + '" "' + state.folder + '"', 1, false); }

var SETTING_IDS = ["imgDef", "quality", "codec", "container", "afmt", "aq", "vAudio", "aLang", "aRate", "aChan", "cvFmt", "cvCrf", "cvSpeed", "cvRes", "cvFps", "cvAudio", "cvKey", "cvTol", "cvOutMode",
                   "cvSeqFps", "cvLoop", "cvCanvas", "cvCanvasMode", "cvLoud"];
var TEXT_IDS = ["cvCanvasW", "cvCanvasH"];
/* optCookies volutamente NON salvato: il login di Firefox va riattivato ogni volta */
var CHECK_IDS = ["optPlaylist", "optSubs", "optThumb", "optMeta", "optArchive", "optChapters", "optNorm", "cvAlphaForce", "cvPremult", "cvAllTracks", "cvBounce"];
function saveSettings() {
  try {
    var out = ["lang=" + LANG, "mode=" + state.mode, "folder=" + state.folder, "ytdlp=" + (toolCache["yt-dlp.exe"] || ""), "cvfolder=" + cv.folder, "cvKeyColor=" + (hexColor($("cvKeyColor").value) || "00FF00"), "tab=" + (state.tab || "dl")], i;
    for (i = 0; i < SETTING_IDS.length; i++) out.push(SETTING_IDS[i] + "=" + $(SETTING_IDS[i]).value);
    for (i = 0; i < CHECK_IDS.length; i++) out.push(CHECK_IDS[i] + "=" + ($(CHECK_IDS[i]).checked ? "1" : "0"));
    for (i = 0; i < TEXT_IDS.length; i++) out.push(TEXT_IDS[i] + "=" + String($(TEXT_IDS[i]).value).replace(/\D/g, "").substring(0, 5));
    if (cv.pendingFmt) for (i = 0; i < out.length; i++) if (out[i].indexOf("cvFmt=") === 0) out[i] = "cvFmt=" + cv.pendingFmt;
    for (var pn in cv.presets) if (cv.presets.hasOwnProperty(pn)) out.push("preset." + encodeURIComponent(pn) + "=" + cv.presets[pn]);
    var hws = hwSerialize(); if (hws) out.push("hw=" + hws);
    writeUtf8(FILE_SETTINGS, out.join("\r\n"));
  } catch (e) {}
}
function loadSettings() {
  try {
    if (!fso.FileExists(FILE_SETTINGS)) return;
    var lines = readUtf8(FILE_SETTINGS).split(/\r?\n/), kv = {}, i;
    for (i = 0; i < lines.length; i++) { var p = lines[i].indexOf("="); if (p > 0) kv[lines[i].substring(0, p)] = lines[i].substring(p + 1); }
    if (kv.folder && fso.FolderExists(kv.folder)) state.folder = kv.folder;
    if (kv.cvfolder && fso.FolderExists(kv.cvfolder)) cv.folder = kv.cvfolder;
    if (kv.cvKeyColor && hexColor(kv.cvKeyColor)) $("cvKeyColor").value = "#" + hexColor(kv.cvKeyColor);
    if (kv.tab === "cv") state.tab = "cv";
    if (kv.lang === "it" || kv.lang === "en" || kv.lang === "zh") LANG = kv.lang;
    if (kv.ytdlp && /^[a-z]:\\.*\\yt-dlp[^\\]*\.exe$/i.test(kv.ytdlp) && fso.FileExists(kv.ytdlp)) toolCache["yt-dlp.exe"] = kv.ytdlp;
    for (i = 0; i < SETTING_IDS.length; i++) setSelect($(SETTING_IDS[i]), kv[SETTING_IDS[i]]);
    for (i = 0; i < CHECK_IDS.length; i++) if (kv[CHECK_IDS[i]] !== undefined) $(CHECK_IDS[i]).checked = kv[CHECK_IDS[i]] === "1";
    for (i = 0; i < TEXT_IDS.length; i++) if (kv[TEXT_IDS[i]] !== undefined && /^\d{0,5}$/.test(kv[TEXT_IDS[i]])) $(TEXT_IDS[i]).value = kv[TEXT_IDS[i]];
    if (kv.cvFmt && $("cvFmt").value !== kv.cvFmt) cv.pendingFmt = kv.cvFmt;   /* formato GPU: compare dopo il rilevamento */
    cvFillAudio(kv.cvAudio);
    for (var pk in kv) if (kv.hasOwnProperty(pk) && pk.indexOf("preset.") === 0) { try { cv.presets[decodeURIComponent(pk.substring(7))] = kv[pk]; } catch (x) {} }
    if (kv.hw) cv.hwSaved = hwUnserialize(kv.hw);
    fillAudioSelects(kv.aq, kv.aRate);
    fillVideoSelects(kv.codec, kv.vAudio);
    if (kv.mode === "audio") setMode("audio");
  } catch (e) {}
}
function setSelect(sel, v) {
  if (v === undefined) return;
  for (var i = 0; i < sel.options.length; i++) if (sel.options[i].value === v) { sel.selectedIndex = i; return; }
}

/* opzioni comuni a tutti i download (una riga per opzione) */
function commonOptions() {
  var o = ["--newline", "--no-colors", "--ignore-errors", "--no-mtime", "--windows-filenames",
           "--concurrent-fragments 4", "-P " + cfgQuote(state.folder)];
  o.push($("optPlaylist").checked ? "--yes-playlist" : "--no-playlist");
  /* ffmpeg e deno con percorso assoluto: il PATH di mshta pu&ograve; essere vecchio dopo winget */
  var ff = findTool("ffmpeg.exe");
  if (ff) o.push("--ffmpeg-location " + cfgQuote(ff));
  var deno = findTool("deno.exe");
  if (deno && state.version >= JS_RUNTIME_SINCE) o.push("--js-runtimes " + cfgQuote("deno:" + deno));
  if (state.mode === "video") {
    var q = $("quality").value, c = $("codec").value, cont = $("container").value, S = [];
    if (cont === "webm" && c === "h264") c = "auto";   /* H.264 non entra in un WebM */
    /* ordinamento per risoluzione (lato corto) invece di filtrare: funziona anche con video verticali */
    if (c === "h264") S.push("vcodec:h264");
    S.push(q === "best" ? "res" : "res:" + q);
    if (c === "vp9") S.push("vcodec:vp9"); else if (c === "av1") S.push("vcodec:av01");
    var vA = $("vAudio").value, lang = $("aLang").value, BL = lang ? "[language^=" + lang + "]" : "";
    if (cont === "webm" && vA === "aac") vA = "auto";        /* AAC non entra in un WebM */
    /* preferenza di codec audio: una sola voce acodec nell'ordinamento */
    var ac = vA === "aac" ? "aac" : (vA === "opus" ? "opus" : (c === "h264" ? "aac" : ""));
    if (cont === "gif") {
      /* GIF: solo immagini; ritaglio la risoluzione (480p se \u00abmassima\u00bb) e converto con tavolozza ottimizzata */
      o.push('-f "bv*/b"', '-S "' + (q === "best" ? "res:480" : "res:" + q) + '"', "--recode-video gif",
             '--postprocessor-args "VideoConvertor+ffmpeg_o:-vf fps=15,split[a][b];[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=bayer -loop 0 -an"');
    } else if (cont === "mov" || cont === "avi") {
      /* MOV/AVI accettano solo H.264 (+ AAC/MP3): H.264 + AAC vengono uniti in MP4 e poi solo
         spostati nel contenitore (veloce, senza perdita); tutto il resto finisce in MKV e viene convertito */
      var mute = vA === "none", avi = cont === "avi";
      var S2 = ["vcodec:h264", q === "best" ? "res" : "res:" + q, "acodec:aac"];
      if (mute) o.push('-f "bv*[vcodec^=avc1]/bv*/b"');
      else o.push('-f "' + (BL ? "bv*[vcodec^=avc1]+ba[acodec^=mp4a]" + BL + "/" : "") + 'bv*[vcodec^=avc1]+ba[acodec^=mp4a]/b[vcodec^=avc1]/bv*+ba[acodec!^=mp4a]/bv*+ba/b"');
      o.push('-S "' + S2.join(",") + '"', "--merge-output-format mp4/mkv",
             '--remux-video "mp4>' + cont + '"',
             '--use-postprocessor "FFmpegVideoConvertor:preferedformat=mp4>mp4/' + cont + '>' + cont + '/' + cont + '"',
             '--postprocessor-args "VideoRemuxer+ffmpeg_o:' + (mute ? "-an " : "") + (avi ? "-tag:v H264 -bsf:v h264_mp4toannexb" + (mute ? "" : " -c:a libmp3lame -b:a 192k") : "-movflags +faststart") + '"',
             '--postprocessor-args "VideoConvertor+ffmpeg_o:-c:v libx264 -crf 20 -preset medium -pix_fmt yuv420p ' + (mute ? "-an" : avi ? "-c:a libmp3lame -b:a 192k" : "-c:a aac -b:a 192k") + (avi ? " -vtag H264" : " -movflags +faststart") + '"');
    } else if (cont === "webm") {
      /* 1) VP9/AV1 + Opus/Vorbis uniti senza conversione  2) un file gi&agrave; WebM
         3) ultimo recupero: qualsiasi formato, poi convertito in WebM da ffmpeg (VP9 + Opus) */
      if (c === "auto") S.push("vcodec:vp9");
      S.push("acodec:opus");
      var V = "bv*[vcodec~='^(vp0?9|av0?1)']", A = "ba[acodec~='^(opus|vorbis)']";
      var fsel = vA === "none" ? V + "/b[ext=webm]/bv*/b" : (BL ? V + "+" + A + BL + "/" : "") + V + "+" + A + "/b[ext=webm]/bv*+ba/b";
      o.push('-f "' + fsel + '"', '-S "' + S.join(",") + '"');
      o.push("--merge-output-format webm/mkv", "--recode-video webm");
    } else {
      if (ac) S.push("acodec:" + ac);
      var fsel2 = vA === "none" ? "bv/bv*/b" : (BL ? "bv+ba" + BL + "/bv*+ba" + BL + "/" : "") + "bv+ba/bv*+ba/b";
      o.push('-f "' + fsel2 + '"', '-S "' + S.join(",") + '"');
      o.push("--merge-output-format " + cont, "--remux-video " + cont);
      if (vA === "none") o.push("--use-postprocessor FFmpegCopyStream", '--postprocessor-args "CopyStream:-an"');
    }
    if ($("optSubs").checked && cont !== "gif") o.push('--write-subs --write-auto-subs --sub-langs "it,en"' + (cont === "mov" || cont === "avi" ? "" : " --embed-subs --compat-options no-keep-subs"));   /* MOV/AVI: sottotitoli come file a parte */
  } else {
    var a = $("afmt").value, lng = $("aLang").value, L = lng ? "[language^=" + lng + "]" : "";
    if (a === "webm") o.push('-f "' + (L ? "ba[ext=webm]" + L + "/" : "") + 'ba[ext=webm]/ba[acodec=opus]/ba/b"');   /* traccia Opus originale di YouTube */
    else {
      var pref = a === "m4a" ? "[acodec^=mp4a]" : (a === "opus" ? "[acodec=opus]" : "");
      o.push('-f "' + (L ? (pref ? "ba" + pref + L + "/" : "") + "ba" + L + "/" : "") + (pref ? "ba" + pref + "/" : "") + 'ba/b"');
      var rc = audioRecode(a);
      if (rc && rc.direct) {
        /* WAV: l'estrazione converte sempre, quindi i parametri si applicano direttamente */
        o.push("-x", "--audio-format wav", '--postprocessor-args "ExtractAudio+ffmpeg_o:' + rc.args + '"');
      } else if (rc) {
        /* percorso completo: WAV a 32 bit virgola mobile senza perdite, poi il codificatore scelto con i parametri esatti */
        o.push("-x", "--audio-format wav", '--postprocessor-args "ExtractAudio+ffmpeg_o:-c:a pcm_f32le"',
               "--recode-video " + rc.target, '--postprocessor-args "VideoConvertor+ffmpeg_o:' + rc.args + '"');
      } else {
        /* percorso veloce: copia l'originale quando il codec coincide */
        o.push("-x", "--audio-format " + a);
        if (a === "flac") o.push('--postprocessor-args "ExtractAudio+ffmpeg_o:-sample_fmt s16"');
        if (/^(mp3|m4a|opus|vorbis)$/.test(a)) o.push("--audio-quality 0");
      }
    }
  }
  /* la copertina non si pu&ograve; inserire in WAV e WebM */
  var noThumb = (state.mode === "audio" && ($("afmt").value === "wav" || $("afmt").value === "webm")) || (state.mode === "video" && /^(webm|avi|gif)$/.test($("container").value));
  if ($("optThumb").checked && !noThumb) o.push("--embed-thumbnail");
  if ($("optMeta").checked && !(state.mode === "video" && /^(avi|gif)$/.test($("container").value))) o.push("--embed-metadata");
  if ($("optArchive").checked) o.push("--download-archive " + cfgQuote(FILE_ARCHIVE));
  if ($("optCookies").checked) o.push("--cookies-from-browser firefox");
  return o;
}
function outputTemplate(it) {
  if (!it.name) return "%(title).150B [%(id)s].%(ext)s";
  var n = tplEscape(it.name);
  return n + "%(playlist_index& - {}|)s.%(ext)s";
}

/* ---------- esecuzione ---------- */
function runCommand(inner) {
  state.token = newToken();
  state.offset = 0; state.partial = ""; state.itemErrors = 0; state.itemDone = 0; state.lastErr = ""; state.lastHint = "";
  state.itemSkipped = 0; state.itemNew = false; state.plTotal = 0;
  tryDelete(state.files.log);
  var cmd = '"' + EXE_CMD + '" /d /v:off /s /c " (' + inner + ' && echo ' + state.token + '_OK || echo ' + state.token + '_ERR) > "' + state.files.log + '" 2>&1 "';
  try { sh.Run(cmd, 0, false); }
  catch (e) { state.lastErr = "Impossibile avviare il processo."; stepDone(false); return; }
  state.startedAt = new Date().getTime();
  if (state.timer) clearInterval(state.timer);
  /* in mshta un timer fermato dentro il suo stesso giro, se poi nello stesso giro parte un comando che aspetta
     (probeFile prima di convertire un'immagine, controllo del Content-Type...), riparte da solo: 20 s dopo la fine
     segnava come errore l'ultimo elemento e continuava all'infinito (provato). Ogni timer controlla di essere quello attivo */
  var id = setInterval(function () { if (state.timer !== id) { clearInterval(id); return; } poll(); }, POLL_MS);
  state.timer = id;
}
function jobFiles(tag) {
  var t = newToken();
  return { cfg: DIR_TMP + "\\" + tag + "_" + t + ".conf", urls: DIR_TMP + "\\" + tag + "_" + t + "_link.txt", log: DIR_TMP + "\\" + tag + "_" + t + ".log" };
}

function onGo() { if (state.busy) cancel(); else startQueue(); }

/* ---------- immagini: i link diretti a un'immagine si scaricano con curl (yt-dlp e' per video e audio) ----------
   Link e percorso vanno in un file di configurazione di curl, mai nella riga di comando. */
var IMG_URL = /\.(jpe?g|jfif|png|gif|webp|avif|bmp|tiff?|heic|svg)$/i;
function isImageUrl(u) { return IMG_URL.test(String(u || "").split(/[?#]/)[0]); }
function isImageItem(it) { return !!(it && (it.img || isImageUrl(it.url))); }
/* primi n byte di un file come stringa (un carattere per byte): binario letto con ADODB e convertito
   in esadecimale con MSXML, cosi' anche i byte 0 e 0x80-0x9F restano esatti. Sul Mac: mac.js */
function fileHead(path, n) {
  var st, b, out = "", i, c, ts, s;
  /* file grandi (dirette di ore, oltre 2 GB): ADODB.Stream li caricherebbe interi ("Out of memory" a 32 bit).
     FSO in modalita' Unicode legge solo le coppie di byte richieste, senza conversioni (provato su tutti i 256 valori). */
  if (fso.GetFile(path).Size > 8388608) {
    ts = fso.OpenTextFile(path, 1, false, -1); s = ts.Read(Math.ceil(n / 2)); ts.Close();
    for (i = 0; i < s.length; i++) { c = s.charCodeAt(i); out += String.fromCharCode(c & 255, c >> 8); }
    return out.substring(0, n);
  }
  st = new ActiveXObject("ADODB.Stream");
  st.Type = 1; st.Open(); st.LoadFromFile(path); b = st.Read(n); st.Close();
  var el = new ActiveXObject("MSXML2.DOMDocument").createElement("h");
  el.dataType = "bin.hex"; el.nodeTypedValue = b;
  var hex = String(el.text || "");
  for (i = 0; i + 1 < hex.length; i += 2) out += String.fromCharCode(parseInt(hex.substring(i, i + 2), 16));
  return out;
}
/* formato vero dell'immagine scaricata, dai primi byte: "" se non e' un'immagine riconosciuta */
function imgSniffExt(path) {
  var h = "";
  try { h = fileHead(path, 512); } catch (e) { return ""; }
  if (h.charCodeAt(0) === 0xFF && h.charCodeAt(1) === 0xD8) return "jpg";
  if (h.substring(1, 4) === "PNG") return "png";
  if (h.substring(0, 4) === "GIF8") return "gif";
  if (h.substring(0, 4) === "RIFF" && h.substring(8, 12) === "WEBP") return "webp";
  if (h.substring(4, 8) === "ftyp") {
    var br = h.substring(8, 12).toLowerCase();
    if (br === "avif" || br === "avis") return "avif";
    if (/^(heic|heix|hevc|heim|heis|mif1|msf1)$/.test(br)) return "heic";
  }
  if (h.substring(0, 2) === "BM") return "bmp";
  if (h.substring(0, 4) === "II*\u0000" || h.substring(0, 4) === "MM\u0000*") return "tif";
  if (/<svg[\s>]/i.test(h) && !/<html[\s>]/i.test(h)) return "svg";
  return "";
}
/* il file scaricato e' testo (HTML, XML, JSON...) e non un'immagine? Solo byte stampabili nei primi 512 e un inizio tipico */
function looksLikeText(path) {
  var h = "";
  try { h = fileHead(path, 512); } catch (e) { return false; }
  if (/^\s*(<|\{|\[)/.test(h) || /<(!doctype|html|head|body)[\s>]/i.test(h)) return true;
  return h.length > 0 && !/[\x00-\x08\x0e-\x1f]/.test(h);
}
/* Content-Type di un link (richiesta GET di 1 byte con curl, al massimo 8 secondi): serve quando yt-dlp
   risponde «Unsupported URL», per capire se il link e' un'immagine senza estensione. Sul Mac: mac.js */
function urlContentType(url) {
  var curl = curlExe();
  if (!curl) return "";
  var tok = newToken(), cfg = DIR_TMP + "\\head_" + tok + ".cfg", hdr = DIR_TMP + "\\head_" + tok + ".txt", ct = "";
  var asciiUrl = String(url).replace(/[^\x20-\x7e]/g, function (c) { return encodeURIComponent(c); });
  var q = function (v) { return '"' + String(v).replace(/\\/g, "\\\\").replace(/"/g, '\\"') + '"'; };
  try {
    ensureDir(DIR_TMP);
    /* GET del solo primo byte invece di HEAD: molti server (CDN, siti di immagini) rispondono 403/405 alla HEAD */
    writeUtf8NoBom(cfg, ["url = " + q(asciiUrl), "range = 0-0", "max-filesize = 2000000", "output = " + q(DIR_TMP + "\\head_" + tok + ".bin"), "location", "silent", "max-redirs = 10", "connect-timeout = 5", "max-time = 8",
      "dump-header = " + q(hdr), "user-agent = " + q("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Safari/537.36")].join("\r\n") + "\r\n");
    sh.Run('"' + curl + '" -K "' + cfg + '"', 0, true);
    if (fso.FileExists(hdr)) {
      var lines = readUtf8(hdr).split(/\r?\n/), i, m;
      for (i = 0; i < lines.length; i++) if ((m = /^content-type:\s*([^;\s]+)/i.exec(lines[i]))) ct = m[1].toLowerCase();   /* l'ultima vince (dopo i redirect) */
    }
  } catch (e) { DEBUG_ERRORS.push("urlContentType: " + (e.message || e)); }
  tryDelete(cfg); tryDelete(hdr); tryDelete(DIR_TMP + "\\head_" + tok + ".bin");
  return ct;
}
/* percorso da usare DENTRO cmd: l'HTA gira spesso in mshta a 32 bit (SysWOW64) e allora SYSDIR e' Sysnative,
   ma EXE_CMD e' il cmd a 64 bit, che Sysnative non lo vede ("Impossibile trovare il percorso specificato") */
function cmdPath(p) { return String(p).replace(/\\Sysnative\\/i, "\\System32\\"); }
function curlExe() {
  if (window.DCVT_MAC) return findTool("curl") || "/usr/bin/curl";
  var c = SYSDIR + "\\curl.exe";
  return fso.FileExists(c) ? c : "";
}
/* Referer delle immagini arrivate dall'estensione (pagina in #ref), come lo manda Chrome di base
   (strict-origin-when-cross-origin): l'indirizzo intero se l'immagine e' sullo stesso sito, altrimenti solo il dominio.
   Serve per le CDN che rifiutano le immagini chieste da fuori dalla pagina (protezione hotlink) */
function imgReferer(it) {
  var p = /^(https?:\/\/[^\/?#]+)/i.exec(String(it.ref || "")), u = /^(https?:\/\/[^\/?#]+)/i.exec(String(it.url || ""));
  if (!p) return "";
  var https = /^https:/i.test(p[1]);
  if (https && !/^https:/i.test(String(it.url || ""))) return "";        /* da https a http il browser non lo manda */
  return u && u[1].toLowerCase() === p[1].toLowerCase() ? String(it.ref).replace(/#.*$/, "") : p[1] + "/";
}
function runImage(it) {
  var curl = curlExe(), SEP = window.DCVT_MAC ? "/" : "\\";
  if (!curl) { state.lastErr = T("curl non trovato: per scaricare le immagini serve Windows 10 (1803) o successivo."); stepDone(false); return; }
  it.isImg = true;
  it.imgTmp = DIR_TMP + SEP + "img_" + newToken() + ".part";
  var asciiUrl = String(it.url).replace(/[^\x20-\x7e]/g, function (c) { return encodeURIComponent(c); });
  var q = function (v) { return '"' + String(v).replace(/\\/g, "\\\\").replace(/"/g, '\\"') + '"'; };
  try {
    ensureDir(DIR_TMP);
    var conf = ["url = " + q(asciiUrl), "output = " + q(it.imgTmp), "location", "fail", "show-error", "silent",
      "max-redirs = 10", "connect-timeout = 30", "max-time = 900", "user-agent = " + q("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Safari/537.36")];
    var ref = imgReferer(it);
    if (ref) conf.push("referer = " + q(ref));
    if (it.ckUse && fso.FileExists(ckFile(it))) conf.push("cookie = " + q(ckFile(it)));
    writeUtf8NoBom(state.files.cfg, conf.join("\r\n") + "\r\n");
  } catch (e) { state.lastErr = T("Impossibile preparare il download dell'immagine: {0}", e.message || e); stepDone(false); return; }
  $("pct").innerText = T("Scarico l'immagine..."); state.lastHttp = "";
  state.killProc = fso.GetFileName(curl).replace(/'/g, ""); state.killTag = baseName(state.files.cfg);
  runCommand('"' + cmdPath(curl) + '" -K "' + state.files.cfg + '"');
}
function imgStepDone(it, ok) {
  var SEP = window.DCVT_MAC ? "/" : "\\", good = false;
  try { good = ok && fso.FileExists(it.imgTmp) && fso.GetFile(it.imgTmp).Size > 0; } catch (e0) {}
  if (it.imgConv) { imgConvDone(it, ok); return; }
  if (state.cancelled) { tryDelete(it.imgTmp); setBadge(it, "stop"); queueDone(); return; }
  if (!good && !state.cancelled && it.ck && !it.ckUse && /^40[13]$/.test(state.lastHttp || "") && fso.FileExists(ckFile(it))) {
    tryDelete(it.imgTmp); it.ckUse = true; it.status = "wait";
    logEvent("app", T("{0}: il sito chiede l'accesso, riprovo con il login di Chrome mandato dall'estensione.", it.name || it.url), "info", true);
    setTimeout(runNext, 50); return;
  }
  if (!good) {
    tryDelete(it.imgTmp);
    it.loginErr = !it.ckUse && /^40[13]$/.test(state.lastHttp || "");   /* gia' provato con il login: non e' quello (es. protezione anti-hotlink) */
    setBadge(it, "err", state.lastErr || T("Immagine non scaricata (link scaduto o protetto?)."));
    state.errCount++; setTimeout(runNext, 50); return;
  }
  /* l'estensione la decide il contenuto (un .jpg puo' essere un WebP); senza riconoscimento, quella dell'URL */
  var path = String(it.url).split(/[?#]/)[0], m = IMG_URL.exec(path), sn = imgSniffExt(it.imgTmp);
  /* pagina web o testo al posto dell'immagine (Wikipedia «File:...jpg», protezione hotlink, login): mai salvata come .jpg */
  if (!sn && looksLikeText(it.imgTmp)) m = null;
  if (!sn && !m) {
    tryDelete(it.imgTmp);
    setBadge(it, "err", T("Il link non porta a un'immagine (il server ha risposto con una pagina web o un file sconosciuto)."));
    state.errCount++; setTimeout(runNext, 50); return;
  }
  var ext = "." + (sn || m[1].toLowerCase().replace("jpeg", "jpg").replace("tiff", "tif"));
  var file = path.substring(path.lastIndexOf("/") + 1);
  try { file = decodeURIComponent(file); } catch (e1) {}
  var base = cleanName(it.name || file.replace(/\.[^.]*$/, "")) || "immagine";
  it.imgBase = base; it.imgSrcExt = ext;
  /* formato scelto nella riga: diverso dall'originale -> conversione con ffmpeg (stesso formato = file originale, intatto) */
  var want = it.imgFmt || "";
  if (want && "." + want !== ext) { imgConvert(it); return; }
  imgSaveOriginal(it, "ok", "");
}
/* riquadro Immagini: il formato scelto vale per le immagini in lista non ancora scaricate e per quelle nuove */
function imgDefChanged() {
  if (state.busy) return;
  var v = $("imgDef").value, i;
  for (i = 0; i < state.items.length; i++) if (isImageItem(state.items[i]) && !qDone(state.items[i])) state.items[i].imgFmt = v;
  renderQueue(); saveSettings();
}
/* formati del menu di ogni riga di immagine: [valore, testo]. "" = originale, byte identici */
var IMG_DL_FMT = [["", "Originale"], ["png", "PNG"], ["webp", "WebP"], ["jpg", "JPG"]];
function imgFinalPath(base, ext) {
  var SEP = window.DCVT_MAC ? "/" : "\\", fin = state.folder + SEP + base + ext, k = 2;
  while (fso.FileExists(fin)) fin = state.folder + SEP + base + " (" + (k++) + ")" + ext;
  return fin;
}
/* salva il file scaricato cosi' com'e'; status "part" + nota quando una conversione richiesta non e' riuscita */
function imgSaveOriginal(it, status, note) {
  var fin = imgFinalPath(it.imgBase, it.imgSrcExt);
  try { fso.MoveFile(it.imgTmp, fin); }
  catch (e2) { tryDelete(it.imgTmp); setBadge(it, "err", T("Impossibile salvare l'immagine: {0}", e2.message || e2)); state.errCount++; setTimeout(runNext, 50); return; }
  if (status === "part") { setBadge(it, "part", note + " " + T("Salvata l'immagine originale: {0}", fin)); state.partCount++; }
  else { setBadge(it, "ok", T("Salvata: {0}", fin)); state.okCount++; }
  $("fill").style.width = "100%";
  setTimeout(runNext, 50);
}
/* conversione dell'immagine scaricata nel formato della riga. Ingresso e uscita in DIR_TMP con nomi senza
   caratteri speciali; alla fine l'uscita si sposta nella cartella. Se ffmpeg manca o fallisce resta l'originale. */
function imgConvert(it) {
  var SEP = window.DCVT_MAC ? "/" : "\\", want = it.imgFmt, up = want.toUpperCase(), ff = findTool("ffmpeg.exe");
  if (!ff) { imgSaveOriginal(it, "part", T("ffmpeg non trovato: immagine non convertita in {0}.", up)); return; }
  if (want === "webp" && missingEncoders(["libwebp"]).length) { imgSaveOriginal(it, "part", T("Il tuo ffmpeg non ha il codec WebP: immagine non convertita.")); return; }
  var info = probeFile(it.imgTmp);
  if (!info.ok) { imgSaveOriginal(it, "part", T("ffmpeg non riesce a leggere questa immagine: non convertita in {0}.", up)); return; }
  var anim = (info.codec === "gif" && info.frames > 1) || info.codec === "apng", alpha = info.alpha || info.avifAlpha;
  var a = ["-hide_banner", "-nostdin", "-y", "-i", '"' + it.imgTmp + '"'], chain = [];
  /* SVG: il decoder di ffmpeg (librsvg) da' i colori premoltiplicati per l'alfa, quindi semitrasparenze e bordi sfumati
     diventano piu' scuri; li riporto ai colori veri (colore * 255 / alfa). Il filtro unpremultiply qui non ha effetto */
  if (info.codec === "svg") chain.push("format=rgba", "geq=r='if(alpha(X,Y),min(255,r(X,Y)*255/alpha(X,Y)),0)':g='if(alpha(X,Y),min(255,g(X,Y)*255/alpha(X,Y)),0)':b='if(alpha(X,Y),min(255,b(X,Y)*255/alpha(X,Y)),0)':a='alpha(X,Y)'");
  /* JPG non ha l'alfa: le parti trasparenti diventano bianche (fusione esatta: 255 - (255 - c) * alfa) */
  if (want === "jpg" && alpha) chain.push("format=rgba", "negate", "premultiply=inplace=1", "negate");
  /* AVIF trasparente: l'alfa arriva come secondo flusso e va riunito, altrimenti lo sfondo diventa nero */
  if (info.avifAlpha) a.push('-filter_complex "[0:v:0][0:v:1]alphamerge' + (chain.length ? "," + chain.join(",") : "") + '[o]"', '-map "[o]"');
  else if (chain.length) a.push('-vf "' + chain.join(",") + '"');
  if (want === "png") a.push("-frames:v 1", "-c:v png");
  else if (want === "webp") {
    /* GIF o APNG animati -> WebP animata; da JPG con perdita (qualita' 90), dagli altri formati senza perdita. L'alfa resta */
    if (anim) a.push("-c:v libwebp_anim", "-lossless 1", "-loop 0");
    else a.push("-frames:v 1", "-c:v libwebp", it.imgSrcExt === ".jpg" ? "-lossless 0 -quality 90" : "-lossless 1");
  } else a.push("-frames:v 1", "-c:v mjpeg", "-q:v 2", "-pix_fmt yuvj444p");
  it.imgAlphaLost = want === "jpg" && alpha;
  /* PNG e JPG sono immagini ferme: di una GIF o di un APNG animati resta il primo fotogramma (lo dico nel registro) */
  it.imgAnimLost = anim && want !== "webp";
  it.imgOut = DIR_TMP + SEP + "imgout_" + newToken() + "." + want;
  a.push('"' + it.imgOut + '"');
  it.imgConv = true;
  $("pct").innerText = T("Converto l'immagine in {0}...", up);
  state.files = jobFiles("imgcv");
  state.killProc = fso.GetFileName(ff).replace(/'/g, ""); state.killTag = baseName(it.imgOut);
  runCommand('"' + cmdPath(ff) + '" ' + a.join(" "));
}
function imgConvDone(it, ok) {
  it.imgConv = false;
  if (state.cancelled) { tryDelete(it.imgTmp); tryDelete(it.imgOut); setBadge(it, "stop"); queueDone(); return; }
  var good = false;
  try { good = ok && fso.FileExists(it.imgOut) && fso.GetFile(it.imgOut).Size > 0; } catch (e0) {}
  if (!good) { tryDelete(it.imgOut); imgSaveOriginal(it, "part", T("Conversione in {0} non riuscita ({1}).", it.imgFmt.toUpperCase(), state.lastErr || "ffmpeg")); return; }
  var fin = imgFinalPath(it.imgBase, "." + it.imgFmt);
  try { fso.MoveFile(it.imgOut, fin); }
  catch (e1) { tryDelete(it.imgOut); imgSaveOriginal(it, "part", T("Impossibile salvare l'immagine: {0}", e1.message || e1)); return; }
  tryDelete(it.imgTmp);
  setBadge(it, "ok", T("Salvata: {0}", fin)); state.okCount++;
  if (it.imgAlphaLost) logEvent("app", T("Avviso: il JPG non ha trasparenza, le parti trasparenti di {0} sono diventate bianche.", fso.GetFileName(fin)), "warn", true);
  if (it.imgAnimLost) logEvent("app", T("Avviso: {0} era un'immagine animata; in {1} resta solo il primo fotogramma (per tenerla animata scegli WebP o Originale).", fso.GetFileName(fin), it.imgFmt.toUpperCase()), "warn", true);
  $("fill").style.width = "100%";
  setTimeout(runNext, 50);
}

/* elemento gia' fatto: scaricato, oppure immagine "Parziale" (originale salvato, conversione non riuscita) */
function qDone(it) { return it.status === "ok" || (it.status === "part" && isImageItem(it)); }
function startQueue() {
  $("msg").style.display = "none";
  var pend = 0, i;
  for (i = 0; i < state.items.length; i++) if (!qDone(state.items[i])) pend++;
  if (!state.items.length) { showMsg("Aggiungi almeno un link.", "err"); return; }
  if (!pend) { showMsg("Tutti i link in lista sono gi\u00e0 stati scaricati.", "info"); return; }
  if (!fso.FolderExists(state.folder)) { showMsg("La cartella di destinazione non esiste pi\u00f9: scegline un'altra.", "err"); return; }

  /* solo link di immagini: yt-dlp e ffmpeg non servono */
  var vids = 0;
  for (i = 0; i < state.items.length; i++) if (!qDone(state.items[i]) && !isImageItem(state.items[i])) vids++;
  if (!vids) {
    for (i = 0; i < state.items.length; i++) if (!qDone(state.items[i])) state.items[i].status = "wait";
    ensureDir(DIR_TMP); saveSettings(); cleanupTmp();
    state.cancelled = false; state.okCount = 0; state.errCount = 0; state.partCount = 0; state.skipCount = 0;
    setBusy(true, "download"); renderQueue(); showStatus(); runNext(); return;
  }
  /* yt-dlp presente e abbastanza recente? */
  var exe = ytDlpExe();
  if (!exe) {
    /* una sola domanda: se rifiuti l'installazione, puoi indicare tu yt-dlp.exe */
    if (!installComponents() && !state.busy && fso.FileExists(EXE_WINGET) && confirmT("Vuoi invece indicare tu dove si trova yt-dlp.exe?")) { var x = $("exeIn"); x.value = ""; x.click(); }
    return;
  }
  ensureDir(DIR_TMP);
  state.version = readVersion(exe);
  /* versione illeggibile: non blocco, il download stesso mostrer&agrave; l'eventuale errore reale */
  if (state.version && state.version < MIN_YTDLP) { showMsg(T("yt-dlp {0} \u00e8 troppo vecchio e ha falle di sicurezza note. Premi \u00abInstalla / aggiorna componenti\u00bb.", state.version), "err"); return; }

  if (state.mode === "audio" && ENC_FOR[$("afmt").value]) {
    var rcx = audioRecode($("afmt").value), missX = missingEncoders([rcx ? rcx.enc : ENC_FOR[$("afmt").value]]);
    if (missX.length) { showMsg("Il tuo ffmpeg non ha il codec " + encNames(missX) + ". Premi \u00abInstalla / aggiorna componenti\u00bb, poi riprova.", "err"); refreshCompButton(); return; }
  }

  /* nomi doppi (in lista o gi\u00e0 presenti nella cartella) -> aggiungo (2), (3)... */
  var used = {}, disk = {};
  try {
    var fe = new Enumerator(fso.GetFolder(state.folder).Files);
    for (; !fe.atEnd(); fe.moveNext()) { var dn = fe.item().Name.toLowerCase().replace(/\.[^.]+$/, ""); disk[dn] = 1; disk[dn.replace(/ - \d+$/, "")] = 1; }
  } catch (e) {}
  for (i = 0; i < state.items.length; i++) {
    var it = state.items[i]; if (!it.name || it.status === "ok") continue;
    var key = it.name.toLowerCase(), n = it.name, k = 2;
    while (used[key] || disk[key]) { n = it.name + " (" + k++ + ")"; key = n.toLowerCase(); }
    used[key] = 1; it.name = n;
  }
  for (i = 0; i < state.items.length; i++) if (!qDone(state.items[i])) state.items[i].status = "wait";

  saveSettings();
  cleanupTmp();
  state.cancelled = false; state.okCount = 0; state.errCount = 0; state.partCount = 0; state.skipCount = 0;
  setBusy(true, "download");
  renderQueue();
  showStatus();
  runNext();
}

function runNext() {
  var it = null, i, done = 0, total = 0;
  for (i = 0; i < state.items.length; i++) { if (state.items[i].status === "wait" && !it) it = state.items[i]; }
  for (i = 0; i < state.items.length; i++) { total++; if (state.items[i].status !== "wait") done++; }
  if (!it || state.cancelled) { queueDone(); return; }

  state.current = it;
  state.files = jobFiles("job");
  setBadge(it, "run");
  $("overall").innerText = T("Elemento {0} di {1}", done + 1, total) + (it.name ? "  \u2022  " + it.name : "");
  $("fill").style.width = "0%"; $("pct").innerText = TX("In preparazione..."); $("spd").innerText = ""; $("file").innerText = "";
  if (isImageItem(it)) { runImage(it); return; }

  var stage = "opzioni";
  try {
    ensureDir(DIR_TMP);
    var opts = commonOptions();
    if (it.ckUse && fso.FileExists(ckFile(it))) {
      var o2 = [], oi;
      for (oi = 0; oi < opts.length; oi++) if (!/^--cookies-from-browser/.test(opts[oi])) o2.push(opts[oi]);
      opts = o2; opts.push("--cookies " + cfgQuote(ckFile(it)));
    }
    stage = "nome file";
    opts.push("-o " + cfgQuote(outputTemplate(it)));
    if ($("optChapters").checked) opts.push("--split-chapters", "-o " + cfgQuote("chapter:" + (it.name ? tplEscape(it.name) : "%(title).100B") + " - %(section_number)02d - %(section_title).80B.%(ext)s"));
    if ($("optChapters").checked && state.mode === "audio" && /^(opus|vorbis|best)$/.test($("afmt").value)) opts.push('--postprocessor-args "SplitChapters+ffmpeg_o:-map -0:v"');
    if ($("aLang").value && !(state.mode === "video" && $("vAudio").value === "none")) opts.push('--print-to-file "after_move:%(requested_formats.-1.language,language|)s" ' + cfgQuote(state.files.log + ".lang"));
    /* diretta? (se la fermi, il file .part in MPEG-TS si puo' tenere: vedi keepLivePart) */
    opts.push('--print-to-file "pre_process:%(is_live)s" ' + cfgQuote(state.files.log + ".live"));
    stage = "scrittura config";
    writeUtf8(state.files.cfg, opts.join("\r\n") + "\r\n");
    stage = "scrittura link";
    writeAscii(state.files.urls, it.url + "\r\n");
  } catch (e) {
    var why = "Impossibile preparare i file temporanei (" + stage + "): " + (e.message || e) + "  [" + state.files.cfg + "]";
    DEBUG_ERRORS.push(why);
    setBadge(it, "err", why);
    showMsg(why, "err");
    state.errCount++;
    setTimeout(runNext, 10);
    return;
  }
  var exe = ytDlpExe();
  if (!exe) { state.lastErr = "yt-dlp non trovato."; stepDone(false); return; }
  state.killProc = fso.GetFileName(exe).replace(/'/g, ""); state.killTag = baseName(state.files.cfg);
  runCommand('"' + exe + '" --ignore-config --config-locations "' + state.files.cfg + '" -a "' + state.files.urls + '"');
}

/* annulla solo il processo di QUESTO job (yt-dlp o ffmpeg), riconosciuto da un nome file univoco
   presente nella sua riga di comando (state.killProc / state.killTag) */
function killJob(wait) {
  if (!state.killProc || !state.killTag) return;
  var tag = state.killTag.replace(/_/g, "[_]"), n = 0;
  try {
    /* GetObject non esiste in modalit&agrave; IE11: si passa da SWbemLocator */
    var wmi = new ActiveXObject("WbemScripting.SWbemLocator").ConnectServer(".", "root\\cimv2");
    var e = new Enumerator(wmi.ExecQuery(
      "SELECT ProcessId FROM Win32_Process WHERE Name='" + state.killProc + "' AND CommandLine LIKE '%" + tag + "%'"));
    for (; !e.atEnd(); e.moveNext(), n++) sh.Run('"' + EXE_TASKKILL + '" /f /t /pid ' + e.item().ProcessId, 0, !!wait);
  } catch (x) { DEBUG_ERRORS.push("killJob WMI: " + (x.message || x)); }
  var tagNow = state.killTag;
  if (!wait && !n && state.busy && state.cancelled && (state.killTries = (state.killTries || 0) + 1) < 40)
    setTimeout(function () { if (state.cancelled && state.busy && state.killTag === tagNow) killJob(); }, 500);
}

function cancel() {
  if (!state.busy || state.cancelled || (state.job !== "download" && state.job !== "convert" && state.job !== "setup")) return;
  state.cancelled = true; state.killTries = 0;
  $(state.job === "convert" ? "goConv" : (state.job === "setup" ? "compBtn" : "go")).innerText = TX("Annullamento...");
  if (state.job === "setup") {
    /* qui si termina il cmd con il suo albero (winget): il segnale di fine non arriver\u00e0, chiudo io il lavoro */
    killJob(true);
    stepDone(false);
    return;
  }
  killJob();
}

/* ---------- lettura del log ---------- */
function readNew() {
  var p = state.files.log;
  if (!fso.FileExists(p)) return "";
  var size = fso.GetFile(p).Size;
  if (size <= state.offset) return "";
  var f = fso.OpenTextFile(p, 1, false, 0);
  try { if (state.offset > 0) f.Skip(state.offset); var chunk = f.Read(size - state.offset); } finally { f.Close(); }
  state.offset = size;
  return chunk;
}

function poll() {
  var chunk;
  /* installazione componenti bloccata (es. "in attesa di un'altra installazione"): dopo 15 minuti la interrompo */
  if (state.job === "setup" && new Date().getTime() - state.startedAt > 15 * 60 * 1000) {
    state.setupTimeout = true; state.cancelled = true; killJob(true); stepDone(false); return;
  }
  /* watchdog: il processo non ha mai creato il log */
  if (!fso.FileExists(state.files.log) && new Date().getTime() - state.startedAt > START_TIMEOUT_MS) {
    state.lastErr = "Il processo non è partito (bloccato da antivirus o criteri di sistema?).";
    stepDone(false); return;
  }
  try { chunk = readNew(); } catch (e) { return; }
  if (!chunk) return;
  var lines = (state.partial + chunk).split(/\r?\n/);
  state.partial = lines.pop();
  for (var i = 0; i < lines.length; i++) {
    var res = handleLine(lines[i]);
    if (res) { stepDone(res === "ok"); return; }
  }
}

/* errore di curl in parole semplici (la riga originale resta nel registro, scheda STRUMENTI) */
function imgCurlErr(l) {
  var m = /^curl:\s*\((\d+)\)(.*)$/.exec(l), code = m ? +m[1] : 0, http = m ? /error:?\s*(\d{3})/i.exec(m[2]) : null;
  state.lastHttp = http ? http[1] : "";
  if (code === 22 && http && http[1] === "404") return T("Immagine non trovata (errore 404): il link è scaduto o sbagliato.");
  if (code === 22 && http && /^40[13]$/.test(http[1])) return T("Accesso negato (errore {0}): il sito non lascia scaricare l'immagine da fuori. Prova a mandarla con l'estensione Chrome dalla pagina in cui si trova.", http[1]);
  if (code === 22 && http) return T("Il server ha risposto con l'errore {0}.", http[1]);
  if (code === 6 || code === 7) return T("Sito non raggiungibile: controlla l'indirizzo e la connessione.");
  if (code === 28) return T("Il server non risponde (tempo scaduto).");
  if (code === 35 || code === 60) return T("Connessione sicura non riuscita (certificato del sito non valido).");
  return l.replace(/^curl:\s*/, "curl: ");
}
function baseName(p) { p = p.replace(/^"+|"+$/g, ""); var i = Math.max(p.lastIndexOf("\\"), p.lastIndexOf("/")); return i >= 0 ? p.substring(i + 1) : p; }

function handleLine(l) {
  try { logToolLine(l); } catch (e) {}
  if (l.indexOf(state.token + "_OK") === 0) return "ok";
  if (l.indexOf(state.token + "_ERR") === 0) return "err";
  if (state.job === "convert" && state.cvStage === "enc") return cvHandleLine(l);
  if (state.job === "setup") return setupLine(l);
  if (state.current && state.current.isImg) {
    if (state.current.imgConv) { if (/error|invalid|unable|could not|not supported|no such/i.test(l)) state.lastErr = l.replace(/^\[[^\]]*\]\s*/, "").substring(0, 200); }
    else if (/^curl:/.test(l)) state.lastErr = imgCurlErr(l);
    return "";
  }
  var m = l.match(/^\[download\]\s+([\d.]+)%(?:\s+of\s+~?\s*(\S+))?(?:\s+at\s+(\S+))?(?:\s+ETA\s+(\S+))?/);
  if (m) {
    var pc = Math.min(100, parseFloat(m[1]) || 0);
    $("fill").style.width = pc + "%";
    $("pct").innerText = m[1] + "%" + (m[2] ? T("  di {0}", m[2]) : "");
    $("spd").innerText = TX((m[3] && m[3] !== "Unknown" ? m[3] : "") + (m[4] && m[4] !== "Unknown" ? "  \u2022  " + m[4] : ""));
    return "";
  }
  m = l.match(/^\[download\] Downloading item (\d+) of (\d+)/);
  if (m) { state.plTotal = +m[2]; $("pct").innerText = T("Playlist: {0} di {1}", m[1], m[2]); return ""; }
  m = l.match(/^\[download\]\s+(.+?) has already been downloaded/);
  if (m) { state.itemDone++; state.itemSkipped++; $("file").innerText = T("Gi\u00e0 presente: {0}", baseName(m[1])); return ""; }
  m = l.match(/Destination:\s*(.+)$/) || l.match(/Merging formats into\s+(.+)$/);
  if (m) { state.itemDone++; state.itemNew = true; $("file").innerText = baseName(m[1]); return ""; }
  if (/has already been recorded in the archive/.test(l)) { state.itemDone++; state.itemSkipped++; $("file").innerText = TX("Gi\u00e0 scaricato in precedenza: saltato"); return ""; }
  if (/^ERROR:/.test(l) || /^\S*yt-dlp[^:]*: error: /i.test(l)) {
    state.itemErrors++; state.lastErr = l.replace(/^ERROR:\s*/, "").substring(0, 240);
    state.lastErr += errorHint(l);
    return "";
  }
  /* anche alcuni WARNING spiegano un errore che arriva dopo */
  if (/^WARNING:/.test(l) && !state.lastHint) { var h = errorHint(l); if (h) state.lastHint = h; }
  return "";
}

/* conserva config e log dell'ultimo lavoro per il report di debug */
function keepLastJob() {
  try {
    if (!state.files) return;
    if (fso.FileExists(state.files.cfg)) fso.CopyFile(state.files.cfg, DIR_APP + "\\ultimo_job.conf", true);
    if (fso.FileExists(state.files.log)) fso.CopyFile(state.files.log, DIR_APP + "\\ultimo_job.log", true);
  } catch (e) {}
}

function readTail(path, maxChars) {
  try {
    if (!fso.FileExists(path)) return "(assente)";
    var f = fso.OpenTextFile(path, 1, false, -2), t = f.AtEndOfStream ? "" : f.ReadAll(); f.Close();
    return t.length > maxChars ? "...\r\n" + t.substring(t.length - maxChars) : t;
  } catch (e) { return "(non leggibile: " + e.message + ")"; }
}

function debugReport() {
  var r = [], i, v = "";
  r.push("##### REPORT DEBUG DOWNCONVERTRON v7.0 #####");
  r.push("Data: " + new Date().toString());
  try { r.push("documentMode: " + document.documentMode + "   userAgent: " + navigator.userAgent); } catch (e) {}
  r.push("TEMP app: " + DIR_TMP + "   esiste: " + fso.FolderExists(DIR_TMP));
  r.push("Cartella destinazione: " + state.folder + "   esiste: " + fso.FolderExists(state.folder));
  var names = ["yt-dlp.exe", "ffmpeg.exe", "deno.exe"];
  for (i = 0; i < names.length; i++) { var p = ""; try { p = findTool(names[i]); } catch (e) { p = "ERRORE " + e.message; } r.push(names[i] + ": " + (p || "NON TROVATO")); }
  r.push("winget.exe: " + (fso.FileExists(EXE_WINGET) ? EXE_WINGET : "NON TROVATO"));
  try { var cs = componentState(); for (i = 0; i < cs.length; i++) r.push("componente " + cs[i].c.id + ": " + (cs[i].path || "MANCANTE")); } catch (e) {}
  if (state.setupLast) for (var sk in state.setupLast) r.push("ultima riga winget passo " + sk + ": " + state.setupLast[sk] + "  esito=" + ((state.setupRes || {})[sk] || "?"));
  try { var exe = ytDlpExe(); if (exe) v = readVersion(exe); } catch (e) { v = "ERRORE " + e.message; }
  r.push("Versione yt-dlp: " + (v || "non leggibile"));
  r.push("Dettaglio versione: " + (state.versionInfo || "-"));
  r.push("cmd usato: " + EXE_CMD);
  r.push("Modalità: " + state.mode + "   occupato: " + state.busy + " (" + state.job + ")");
  r.push("Elementi in lista: " + state.items.length);
  for (i = 0; i < state.items.length && i < 20; i++) r.push("  " + (i + 1) + ". [" + state.items[i].status + "] " + state.items[i].url + (state.items[i].name ? "  -> " + state.items[i].name : "") + (state.items[i].error ? "   ERRORE: " + state.items[i].error : ""));
  r.push("Zoom adattamento: " + ZOOM + " (minimo " + MIN_ZOOM + ", DPI x" + dpiRatio() + ")   area interna: " + (document.documentElement.clientWidth || 0) + "x" + (document.documentElement.clientHeight || 0) + "   schermo: " + screen.availWidth + "x" + screen.availHeight);
  try {
    if (DROP.dir && fso.FolderExists(DROP.dir)) {
      var dl = [], de = new Enumerator(fso.GetFolder(DROP.dir).Files);
      for (; !de.atEnd(); de.moveNext()) dl.push(de.item().Name);
      r.push("File di scambio del ricevitore: " + (dl.join(", ") || "(nessuno)"));
      if (fso.FileExists(DROP.dir + "\\ricevitore.log")) r.push("--- registro del ricevitore ---", readTail(DROP.dir + "\\ricevitore.log", 3000));
    }
  } catch (xr) {}
  try { dropHelperReady(); r.push("Ricevitore trascinamento: " + DROP.helper + "   scambio: " + (DROP.dir || "-") + (DROP.dir && fso.FileExists(DROP.dir + "\\error.txt") ? "   ERRORE: " + readUtf8(DROP.dir + "\\error.txt").substring(0, 400) : "")); } catch (e) {}
  r.push("--- convertitore ---");
  r.push("ffmpeg: " + (findTool("ffmpeg.exe") || "NON TROVATO") + "   ffprobe: " + (findTool("ffprobe.exe") || "NON TROVATO") + "   VP9/Opus: " + cv.encOk);
  for (i = 0; i < cv.items.length && i < 20; i++) { var ci = cv.items[i]; r.push("  " + (i + 1) + ". [" + ci.status + "] " + (ci.path || ci.url) + " | " + (ci.info ? (ci.info.ok ? ci.info.codec + " " + ci.info.pix + " " + ci.info.w + "x" + ci.info.h + " alfa=" + ci.info.alpha : "ERR " + ci.info.err) : "-") + (ci.error ? "  ERRORE: " + ci.error : "")); }
  r.push("--- ultimo comando ffmpeg ---"); r.push(readTail(DIR_APP + "\\ultimo_ffmpeg.txt", 2000));
  r.push("Errori di script: " + (DEBUG_ERRORS.length ? "" : "nessuno"));
  for (i = 0; i < DEBUG_ERRORS.length; i++) r.push("  " + DEBUG_ERRORS[i]);
  try { r.push("--- opzioni correnti ---"); r.push(commonOptions().join("\r\n")); } catch (e) { r.push("commonOptions ERRORE: " + e.message); }
  r.push("--- ultimo_job.conf ---"); r.push(readTail(DIR_APP + "\\ultimo_job.conf", 3000));
  r.push("--- ultimo_job.log ---"); r.push(readTail(DIR_APP + "\\ultimo_job.log", 6000));
  r.push("##### FINE #####");
  var text = r.join("\r\n"), user = env("%USERNAME%"), out = DIR_APP + "\\debug_report.txt";
  if (user.length >= 3) text = text.split(user).join("<utente>");
  try { writeUtf8(out, text); } catch (e) {}
  try { window.clipboardData.setData("Text", text); } catch (e) {}
  try { sh.Run('"' + SYS + '\\notepad.exe" "' + out + '"', 1, false); } catch (e) {}
  showMsg("Report di debug salvato e copiato negli appunti: incollalo nella chat con Ctrl+V.", "info");
}

/* suggerimento in italiano per gli errori pi&ugrave; comuni */
function errorHint(l) {
  if (/JavaScript runtime|js-runtimes|n challenge|nsig|Requested format is not available|Only images are available/i.test(l))
    return "  → Premi «Installa / aggiorna componenti» (installa Deno e aggiorna yt-dlp), poi riprova.";
  if (/Sign in to confirm|not a bot|age-restricted|confirm your age/i.test(l))
    return "  → Il sito chiede l'accesso: entra nel sito con Chrome, apri l'estensione DownConvertron e premi «Riprova con il mio login» (oppure entra con Firefox e attiva «Usa login di Firefox»).";
  if (/ffmpeg|ffprobe/i.test(l) && /not found|not installed|could not find/i.test(l))
    return "  → Manca ffmpeg: premi «Installa / aggiorna componenti», poi riprova.";
  if (/HTTP Error 403|Forbidden/i.test(l)) {
    /* il sito lo dice la riga di yt-dlp ([twitch:vod] ...) o il link in corso */
    var hu = ""; try { hu = String((state.current && state.current.url) || ""); } catch (eu) {}
    if (/\[twitch/i.test(l) || /twitch\.tv/i.test(hu)) return "  → Accesso negato da Twitch: VOD riservato agli abbonati, privato o rimosso. Se sei abbonato, entra su Twitch con Chrome e rimanda il link dall'estensione DownConvertron (oppure entra con Firefox e attiva «Usa login di Firefox»).";
    if (/\[youtube/i.test(l) || /youtube\.com|youtu\.be/i.test(hu)) return "  → Accesso negato da YouTube: premi «Installa / aggiorna componenti» e riprova.";
    return "  → Accesso negato dal sito (403): il contenuto potrebbe essere privato o richiedere l'accesso. Entra nel sito con Chrome e rimanda il link dall'estensione DownConvertron, oppure premi «Installa / aggiorna componenti».";
  }
  if (/Unsupported URL/i.test(l)) return "  → Sito o link non supportato.";
  if (/Conversion failed|Error opening output files|Postprocessing/i.test(l)) return "  → ffmpeg non \u00e8 riuscito a creare questo formato con queste impostazioni: prova qualit\u00e0/codec \u00abAutomatico\u00bb o un altro formato. Se si ripete premi \u00abReport debug\u00bb.";
  if (/does not have any (audio|video)|no (audio|video) (stream|track)/i.test(l)) return "  → Il video non contiene la traccia richiesta.";
  if (/no such option|error: unrecognized/i.test(l)) return "  → yt-dlp troppo vecchio per queste opzioni: premi «Installa / aggiorna componenti».";
  return "";
}

/* diretta fermata con Annulla: yt-dlp registra le dirette in MPEG-TS, che resta leggibile anche interrotto.
   Il .part diventa «titolo (interrotta).ts». Solo per le dirette: per i video normali il .part serve a riprendere. */
function keepLivePart() {
  var lv = state.files.log + ".live", live = false, SEP = window.DCVT_MAC ? "/" : "\\", best = null;
  try { live = /True/.test(readTail(lv, 200)); } catch (e0) {}
  tryDelete(lv);
  if (!live) return "";
  try {
    var e = new Enumerator(fso.GetFolder(state.folder).Files), since = (state.startedAt || 0) - 5000;
    for (; !e.atEnd(); e.moveNext()) {
      var f = e.item();
      if (/\.part$/i.test(f.Name) && f.Size > 0 && +new Date(f.DateLastModified) >= since && (!best || f.Size > best.Size)) best = f;
    }
  } catch (e1) {}
  if (!best) return T("Diretta fermata: nessun file registrato.");
  var h = "", name = best.Name;
  try { h = fileHead(best.Path, 377); } catch (e2) {}
  if (!(h.charCodeAt(0) === 0x47 && h.charCodeAt(188) === 0x47)) return T("Diretta fermata: il file incompleto «{0}» resta nella cartella.", name);
  var base = name.replace(/\.part$/i, "").replace(/\.[^.]*$/, ""), fin = state.folder + SEP + base + " (interrotta).ts", k = 2;
  while (fso.FileExists(fin)) fin = state.folder + SEP + base + " (interrotta " + (k++) + ").ts";
  try { fso.MoveFile(best.Path, fin); } catch (e3) { return T("Diretta fermata: il file incompleto «{0}» resta nella cartella.", name); }
  return T("Diretta fermata: salvato «{0}» (si apre con VLC; per montarlo convertilo nel Convertitore).", fso.GetFileName(fin));
}
function stepDone(ok) {
  if (state.timer) { clearInterval(state.timer); state.timer = null; }
  keepLastJob();
  if (state.lastHint && state.lastErr.indexOf("→") < 0) state.lastErr += state.lastHint;
  if (state.job === "convert") { cvStepDone(ok); return; }
  if (state.job === "setup") { setupDone(); return; }
  var it = state.current;
  if (it && it.isImg) { imgStepDone(it, ok); return; }
  if (state.cancelled) { setBadge(it, "stop", keepLivePart()); queueDone(); return; }
  tryDelete(state.files.log + ".live");
  var wantL = $("aLang").value, langBad = 0;
  if (ok && !state.itemErrors && wantL) {
    var lg = readTail(state.files.log + ".lang", 4000);
    if (lg !== "(assente)") { var ll = lg.replace(/\s+$/, "").split(/\r?\n/), j; for (j = 0; j < ll.length; j++) if (ll[j].indexOf(wantL) !== 0) langBad++; }
    tryDelete(state.files.log + ".lang");
  }
  if (ok && !state.itemErrors && !state.itemDone) { setBadge(it, "err", "Nessun file scaricato (playlist vuota o senza video disponibili)."); state.errCount++; }
  else if (ok && !state.itemErrors && langBad) { setBadge(it, "part", "Lingua audio \u00ab" + wantL + "\u00bb non disponibile: \u00e8 stata scaricata la traccia originale."); state.partCount++; }
  else if (ok && !state.itemErrors && state.itemSkipped && !state.itemNew) { setBadge(it, "ok", "Gi\u00e0 presente nella cartella (o nell'archivio): non riscaricato. Per rifarlo con altre impostazioni sposta o rinomina il file vecchio."); state.okCount++; state.skipCount++; }
  else if (ok && !state.itemErrors) { setBadge(it, "ok"); state.okCount++; $("fill").style.width = "100%"; }
  else if (!ok && !state.cancelled && !state.itemDone && ckWanted(it, state.lastErr)) {
    it.ckUse = true; it.status = "wait";
    logEvent("app", T("{0}: il sito chiede l'accesso, riprovo con il login di Chrome mandato dall'estensione.", it.name || it.url), "info", true);
    setTimeout(runNext, 50); return;
  }
  else if (!ok && !state.cancelled && !it.imgTried && /Unsupported URL/i.test(state.lastErr || "") && /^image\//.test(it.imgTried = urlContentType(it.url) || "")) {
    /* yt-dlp non lo conosce ma il server dice che e' un'immagine (link senza estensione): la scarico con curl */
    logEvent("app", T("Link non supportato da yt-dlp ma e' un'immagine ({0}): la scarico direttamente.", it.imgTried));
    it.img = true; if (it.imgFmt === undefined) it.imgFmt = $("imgDef").value;
    renderQueue(); state.files = jobFiles("job"); runImage(it); return;
  }
  else if (state.itemDone && state.plTotal > 1) { setBadge(it, "part", "Alcuni elementi della playlist non sono stati scaricati: " + (state.lastErr || "")); state.partCount++; }
  else { it.loginErr = LOGIN_ASK.test(state.lastErr || ""); setBadge(it, "err", state.lastErr || ("Errore sconosciuto. Ultime righe: " + readTail(state.files.log, 400).replace(/\s+/g, " ") + (state.version ? "" : "  || " + (state.versionInfo || "")))); state.errCount++; }
  setTimeout(runNext, 50);
}

function queueDone() {
  if (state.timer) { clearInterval(state.timer); state.timer = null; }
  setBusy(false);
  if (ckCleanup(false)) logEvent("app", T("Login di Chrome cancellato a fine lavoro."));
  var nLogin = state.cancelled ? 0 : loginListWrite();
  renderQueue();
  cleanupTmp();
  if (state.cancelled) {
    showMsg("Download annullato. I link non completati restano in lista: premi Scarica per riprendere. Eventuali file .part nella cartella sono parziali.", "info");
  } else if (!state.errCount && !state.partCount) {
    $("pct").innerText = TX("Completato"); $("spd").innerText = "";
    var nNew = state.okCount - (state.skipCount || 0);
    showMsg("Fatto! " + nNew + (nNew === 1 ? " elemento scaricato" : " elementi scaricati") + " in " + state.folder +
            (state.skipCount ? "\n" + state.skipCount + (state.skipCount === 1 ? " era gi\u00e0 presente e non \u00e8 stato riscaricato" : " erano gi\u00e0 presenti e non sono stati riscaricati") + " (per rifarli con altre impostazioni sposta o rinomina i file vecchi)." : ""), "ok");
  } else {
    var firstErr = "";
    for (var q = 0; q < state.items.length && !firstErr; q++) if (state.items[q].status === "err" && state.items[q].error) firstErr = "\n\nPrimo errore: " + state.items[q].error;
    showMsg(state.okCount + " completati" + (state.partCount ? ", " + state.partCount + " parziali" : "") + ", " + state.errCount + " con errori. Passa il mouse sull'etichetta per il dettaglio." +
            (nLogin ? "\n\n" + T("{0} link chiedono l'accesso al sito: entra nel sito con Chrome, apri l'estensione DownConvertron e premi «Riprova con il mio login».", nLogin) : "") + firstErr, "err");
  }
}

/* =====================================================================
   CONVERTITORE IN WEBM (VP9 + canale alfa)
   Regola d'oro: se il file originale ha la trasparenza, NON si perde mai
   (alfa forzato, chroma key ignorato perch&eacute; cancellerebbe l'alfa originale).
   ===================================================================== */
var MEDIA_EXT = /\.(mp4|m4v|mov|qt|mkv|webm|avi|wmv|flv|mpg|mpeg|m2ts|mts|ts|3gp|ogv|gif|apng|png|mxf|dv|vob|f4v|asf|y4m|nut|hevc|h264|264|265)$/i;
var ALPHA_PIX = /^(yuva|rgba|bgra|argb|abgr|ya|gbrap|pal8|rgb32|bgr32)/i;
var KEY_COLORS = { green: "00FF00", blue: "0000FF", black: "000000", white: "FFFFFF" };
var cv = { items: [], nextId: 1, folder: env("%USERPROFILE%") + "\\Downloads", total: 0, ok: 0, err: 0, encOk: null, presets: {}, pendingFmt: "", hwSaved: null, pvFile: "" };

function showTab(t) {
  $("tabDl").style.display = t === "dl" ? "flex" : "none";
  $("tabCv").style.display = t === "cv" ? "flex" : "none";
  $("tabBtnDl").className = t === "dl" ? "tab on" : "tab";
  $("tabBtnCv").className = t === "cv" ? "tab on" : "tab";
  state.tab = t;
  try { logLayout(); } catch (e) {}
}

/* percorso utilizzabile tra virgolette in cmd: il simbolo % verrebbe espanso, quindi uso il nome corto 8.3 */
function safePath(p) {
  if (p.indexOf("%") < 0) return p;
  try {
    var sp = fso.FileExists(p) ? fso.GetFile(p).ShortPath : fso.GetFolder(p).ShortPath;
    if (sp && sp.indexOf("%") < 0) return sp;
  } catch (e) {}
  return "";
}
function fmtTime(s) {
  if (!(s > 0)) return "?";
  s = Math.round(s); var h = Math.floor(s / 3600), m = Math.floor(s / 60) % 60, x = s % 60;
  return (h ? h + ":" + (m < 10 ? "0" : "") : "") + m + ":" + (x < 10 ? "0" : "") + x;
}
function hexColor(v) { var m = String(v).replace(/\s/g, "").match(/^#?([0-9a-f]{6})$/i); return m ? m[1].toUpperCase() : ""; }

/* ---------- analisi con ffprobe ---------- */
function probeFile(p) {
  var info = { ok: false, alpha: false, audio: false, dec: "", w: 0, h: 0, dur: 0, codec: "", pix: "" };
  var ffprobe = findTool("ffprobe.exe");
  if (!ffprobe) { info.err = "ffprobe non trovato: premi «Installa / aggiorna componenti»"; return info; }
  var sp = safePath(p);
  if (!sp) { info.err = "Il percorso contiene il simbolo %: rinomina il file o la cartella."; return info; }
  ensureDir(DIR_TMP);
  var out = DIR_TMP + "\\probe_" + newToken() + ".txt", raw = "";
  try {
    sh.Run('"' + EXE_CMD + '" /d /v:off /s /c ""' + ffprobe + '" -v error -show_entries stream=codec_type,codec_name,width,height,pix_fmt,color_transfer,avg_frame_rate,channels,channel_layout:stream_side_data=rotation:stream_tags=alpha_mode,rotate:format=duration -of compact=p=0:nk=0 "' + sp + '" > "' + out + '" 2>&1"', 0, true);
    if (fso.FileExists(out)) { var f = fso.OpenTextFile(out, 1, false, 0); raw = f.AtEndOfStream ? "" : f.ReadAll(); f.Close(); }
  } catch (e) { info.err = "ffprobe: " + (e.message || e); }
  tryDelete(out);
  var lines = raw.split(/\r?\n/), i, j, seenVideo = false;
  for (i = 0; i < lines.length; i++) {
    var kv = {}, parts = lines[i].split("|");
    for (j = 0; j < parts.length; j++) { var q = parts[j].indexOf("="); if (q > 0) kv[parts[j].substring(0, q).toLowerCase()] = parts[j].substring(q + 1); }
    if (kv.codec_type === "video" && seenVideo && /^gray/.test(kv.pix_fmt || "")) info.video2Gray = true;
    if (kv.codec_type === "video" && !seenVideo) {
      seenVideo = true;
      info.codec = kv.codec_name || ""; info.pix = kv.pix_fmt || "";
      info.w = parseInt(kv.width, 10) || 0; info.h = parseInt(kv.height, 10) || 0;
      var fr = String(kv.avg_frame_rate || "").split("/"); info.fps = fr.length === 2 && +fr[1] ? +fr[0] / +fr[1] : 0;
      if (kv["tag:alpha_mode"] === "1") { info.alpha = true; info.dec = info.codec === "vp8" ? "libvpx" : "libvpx-vp9"; }
      if (ALPHA_PIX.test(info.pix)) info.alpha = true;
      info.hdr = /smpte2084|arib-std-b67/i.test(kv.color_transfer || "");
      for (var key in kv) { if (/rotat/.test(key) && Math.abs(parseInt(kv[key], 10)) % 180 === 90) { var tw = info.w; info.w = info.h; info.h = tw; info.rotated = true; } }
    } else if (kv.codec_type === "audio") {
      if (!info.audio) info.acodec = kv.codec_name || "";
      info.audio = true;
      (info.astreams = info.astreams || []).push({ codec: kv.codec_name || "", ch: parseInt(kv.channels, 10) || 0, layout: kv.channel_layout || "" });
    }
    else if (kv.duration && !kv.codec_type) info.dur = parseFloat(kv.duration) || 0;
  }
  if (seenVideo) info.ok = true;
  /* AVIF con trasparenza: ffmpeg legge l'alfa come secondo flusso video in grigio (va unito con alphamerge) */
  if (info.ok && info.codec === "av1" && info.video2Gray) info.avifAlpha = true;
  /* GIF e immagini a tavolozza risultano sempre "con alfa": verifico se c'e' davvero un pixel trasparente */
  if (info.ok && info.alpha && (info.codec === "gif" || /^pal8/.test(info.pix))) info.alpha = hasRealAlpha(sp);
  /* HEVC con alfa (Apple): ffprobe dice yuv420p, ma il livello alfa c'e' e ffmpeg lo decodifica */
  else if (info.ok && !info.alpha && info.codec === "hevc" && hasRealAlpha(sp, true)) { info.alpha = true; info.hevcAlpha = true; }
  else if (!seenVideo && !info.err) info.err = "Nessuna traccia video leggibile" + (raw ? ": " + raw.replace(/\s+/g, " ").substring(0, 160) : "");
  /* GIF: un fotogramma solo = immagine ferma (la durata non basta: dipende dal ritardo scritto nel file) */
  if (info.ok && info.codec === "gif") info.frames = probePackets(sp);
  return info;
}
/* numero di fotogrammi (pacchetti) della prima traccia video: 0 se non si riesce a leggerlo */
function probePackets(sp) {
  var ffprobe = findTool("ffprobe.exe"); if (!ffprobe) return 0;
  var o = DIR_TMP + "\\pkt_" + newToken() + ".txt", t = "";
  try {
    sh.Run('"' + EXE_CMD + '" /d /v:off /s /c ""' + ffprobe + '" -v error -count_packets -select_streams v:0 -show_entries stream=nb_read_packets -of csv=p=0 "' + sp + '" > "' + o + '" 2>&1"', 0, true);
    if (fso.FileExists(o)) { var f = fso.OpenTextFile(o, 1, false, 0); t = f.AtEndOfStream ? "" : f.ReadAll(); f.Close(); }
  } catch (e) {}
  tryDelete(o);
  return parseInt(t, 10) || 0;
}
/* strict: nel dubbio NON c'e' alfa (HEVC normale); senza strict nel dubbio si conserva (GIF, tavolozze) */
/* strict (HEVC): 2 fotogrammi rimpiccioliti, veloce anche sui video 4K dell'iPhone; nFrames: quante immagini guardare */
function hasRealAlpha(sp, strict, nFrames) {
  var ffmpeg = findTool("ffmpeg.exe"); if (!ffmpeg) return !strict;
  var o2 = DIR_TMP + "\\alpha_" + newToken() + ".txt", t2 = "";
  var n = nFrames || (strict ? 2 : 60), vf = (strict ? "scale=256:-2," : "") + "format=rgba,alphaextract,signalstats,metadata=print:key=lavfi.signalstats.YMIN";
  try {
    sh.Run('"' + EXE_CMD + '" /d /v:off /s /c ""' + ffmpeg + '" -hide_banner -nostats -nostdin -i "' + sp + '" -frames:v ' + n + ' -vf "' + vf + '" -f null - > "' + o2 + '" 2>&1"', 0, true);
    if (fso.FileExists(o2)) { var f2 = fso.OpenTextFile(o2, 1, false, 0); t2 = f2.AtEndOfStream ? "" : f2.ReadAll(); f2.Close(); }
  } catch (e) {}
  tryDelete(o2);
  if (!/YMIN=/.test(t2)) return !strict;       /* nel dubbio: trasparenza conservata (tranne strict) */
  return /YMIN=(?!255\b)\d+/.test(t2);
}
function infoText(it) {
  if (it.kind === "link" && !it.path) return "Da scaricare dal link, poi convertire";
  var x = it.info;
  if (!x) return "Verrà analizzato alla conversione";
  if (!x.ok) return "⚠ " + (x.err || "File non leggibile");
  var na = x.astreams ? x.astreams.length : 0;
  if (it.kind === "img") return x.w + "\u00d7" + x.h + " \u00b7 " + T("immagine {0}", String(x.codec || fso.GetExtensionName(it.path)).toUpperCase().replace("MJPEG", "JPG"));
  var t = x.w + "×" + x.h + " · " + (it.kind === "seq" ? "sequenza " + x.codec.toUpperCase() + " · " + it.seq.count + " fotogrammi" + (it.seq.total > it.seq.count ? " (interrotta: " + (it.seq.total - it.seq.count) + " mancanti dopo il n. " + (it.seq.start + it.seq.count - 1) + ")" : "") : x.codec) +
          " · " + fmtTime(x.dur) + (x.audio ? " · audio" + (na > 1 ? " (" + na + " tracce)" : "") : "");
  if (x.codec === "hevc" && !x.alpha) t += " · (HEVC: se era «HEVC con alfa» Apple la trasparenza potrebbe non essere letta: esporta in ProRes 4444)";
  if (x.hdr) t += " · HDR: i colori potrebbero risultare più spenti";
  return t;
}

/* ---------- lista ---------- */
/* disco locale fisso? (Google Drive G:, rete, chiavette: analisi rimandata alla conversione) */
function isLocalFixed(p) { try { var d = fso.GetDrive(fso.GetDriveName(p)); return d.DriveType === 2 && !/google/i.test(d.VolumeName || ""); } catch (e) { return false; } }
/* ---------- immagini singole in ordine -> video o GIF (un fotogramma per immagine) ----------
   Le immagini vengono copiate (o, se di formati diversi, convertite in PNG) in una cartella temporanea
   con nomi numerati: da li' in poi sono una sequenza come le altre. Ordine: per nome del file. */
function natCmp(a, b) {
  var x = String(a).toLowerCase().match(/\d+|\D+/g) || [], y = String(b).toLowerCase().match(/\d+|\D+/g) || [], i;
  for (i = 0; i < x.length && i < y.length; i++) {
    if (x[i] === y[i]) continue;
    var nx = /^\d/.test(x[i]), ny = /^\d/.test(y[i]);
    if (nx && ny) return parseInt(x[i], 10) - parseInt(y[i], 10) || x[i].length - y[i].length;
    return x[i] < y[i] ? -1 : 1;
  }
  return x.length - y.length;
}
/* formati che il lettore di sequenze di ffmpeg (image2) legge cosi' come sono: gli altri (AVIF, GIF...) diventano PNG */
var IMG2_EXT = /^(png|tif|exr|jpg|dpx|tga|bmp|webp)$/;
/* formati che possono avere la trasparenza: con anche una sola di queste l'animazione si fa con l'alfa */
var IMG_ALPHA_EXT = /^(png|tif|exr|tga|webp|avif|gif)$/;
function cvImageList(list) {
  list.sort(function (a, b) { return natCmp(fso.GetFileName(a), fso.GetFileName(b)); });
  var ext = "", same = true, alphaHint = false, i;
  for (i = 0; i < list.length; i++) {
    var e = fso.GetExtensionName(list[i]).toLowerCase().replace("jpeg", "jpg").replace("jfif", "jpg").replace("tiff", "tif");
    if (IMG_ALPHA_EXT.test(e)) alphaHint = true;
    if (!ext) ext = e; else if (e !== ext) same = false;
  }
  if (!IMG2_EXT.test(ext)) same = false;
  cv.listErr = "";
  var dir = DIR_TMP + "\\imgs_" + newToken(), ff = findTool("ffmpeg.exe");
  if (!same && !ff) { cv.listErr = T("Immagini di formati diversi: serve ffmpeg per unirle. Premi \u00abInstalla / aggiorna componenti\u00bb."); return null; }
  try { ensureDir(DIR_TMP); ensureDir(dir); } catch (e0) { return null; }
  var outExt = same ? ext : "png", pad = function (n) { var t = String(n); while (t.length < 5) t = "0" + t; return t; };
  var fail = function (why) { cv.listErr = why; try { fso.DeleteFolder(dir, true); } catch (xd) {} return null; };
  for (i = 0; i < list.length; i++) {
    var dst = dir + "\\img_" + pad(i + 1) + "." + outExt;
    try {
      if (same) fso.CopyFile(list[i], dst, true);
      else {
        var src = safePath(list[i]);
        if (!src) return fail(T("Il percorso contiene il simbolo %: rinomina il file o la cartella.") + " " + list[i]);
        sh.Run('"' + EXE_CMD + '" /d /s /c ""' + ff + '" -hide_banner -loglevel error -y -i "' + src + '" -frames:v 1 "' + dst + '""', 0, true);
      }
    } catch (e1) {}
    if (!fso.FileExists(dst)) return fail(T("Immagine non leggibile: {0}", list[i]));
  }
  var sq = seqInfo(dir + "\\img_" + pad(1) + "." + outExt);
  if (!sq) return fail("");
  sq.list = list.length; sq.key = "imgs|" + list.join("|").toLowerCase();
  sq.label = fso.GetFileName(list[0]) + " \u2026 " + fso.GetFileName(list[list.length - 1]);
  sq.outName = fso.GetBaseName(list[0]);
  sq.srcDir = fso.GetParentFolderName(list[0]);   /* \u00abNella stessa cartella\u00bb = accanto agli originali, non nella copia temporanea */
  sq.alphaHint = alphaHint;
  return sq;
}
/* fromFolder: percorsi (in minuscolo) presi da una cartella intera: solo li' si riconoscono le sequenze numerate.
   File scelti uno per uno: due o piu' immagini = esattamente quelle, in ordine di nome; una sola immagine = immagine
   singola (oppure la sua sequenza, se e' un fotogramma numerato). */
function cvAddPaths(paths, quiet, fromFolder) {
  var added = 0, skipped = 0, seqs = 0, seen = {}, cache = {}, i;
  fromFolder = fromFolder || {};
  var singles = [], picked = [], used = {};
  for (i = 0; i < paths.length; i++) {
    var ps = String(paths[i]).replace(/^\s+|\s+$/g, "");
    if (!ps || !IMG_IN_EXT.test(ps) || !fso.FileExists(ps)) continue;
    if (fromFolder[ps.toLowerCase()]) { if (!SEQ_EXT.test(ps) || !seqInfo(ps, cache)) singles.push(ps); }
    else picked.push(ps);
  }
  /* tutti i fotogrammi di una sequenza selezionati a mano (Ctrl+A in Esplora file e trascinati): e' quella sequenza,
     senza domanda e senza copiare migliaia di file */
  if (picked.length >= 2) {
    var sq0 = SEQ_EXT.test(picked[0]) ? seqInfo(picked[0], cache) : null, whole = !!sq0 && picked.length === sq0.total;
    for (i = 1; i < picked.length && whole; i++) { var sqi = SEQ_EXT.test(picked[i]) ? seqInfo(picked[i], cache) : null; if (!sqi || sqi.key !== sq0.key) whole = false; }
    if (whole) { for (i = 0; i < picked.length; i++) fromFolder[picked[i].toLowerCase()] = 1; picked = []; }
  }
  var listErr = "";
  var groups = [singles, picked], g, nMany = (singles.length >= 2 ? singles.length : 0) + (picked.length >= 2 ? picked.length : 0);
  /* l'utente decide: un'animazione (un fotogramma per immagine) oppure ogni immagine per conto suo */
  var asAnim = nMany > 0 && window.confirm(T("Hai aggiunto {0} immagini.\n\nOK = un'unica animazione (un fotogramma per immagine, immagini al secondo nella riga).\nAnnulla = immagini separate (clip ferme o file immagine, secondo il formato di uscita).", nMany));
  for (g = 0; g < groups.length && asAnim; g++) {
    if (groups[g].length < 2) continue;
    var sl = cvImageList(groups[g]);
    if (!sl) listErr = T("Animazione non creata, immagini aggiunte separate: {0}", cv.listErr || T("immagini non leggibili"));
    if (sl) {
      for (i = 0; i < groups[g].length; i++) used[groups[g][i].toLowerCase()] = 1;
      cv.items.push({ id: cv.nextId++, kind: "seq", seq: sl, path: sl.first, title: T("{0} immagini singole", sl.list) + "  (" + sl.label + ")", name: "", status: "wait", info: null, rate: 0 });
      added++; seqs++;
    }
  }
  for (i = 0; i < cv.items.length; i++) { if (cv.items[i].path) seen[cv.items[i].path.toLowerCase()] = 1; if (cv.items[i].seq) seen[cv.items[i].seq.key] = 1; }
  for (i = 0; i < paths.length; i++) {
    var p = String(paths[i]).replace(/^\s+|\s+$/g, "");
    if (!p || used[p.toLowerCase()]) continue;
    if (!fso.FileExists(p) || cv.items.length >= MAX_ITEMS) { skipped++; continue; }
    /* sequenza numerata della cartella: solo per i file presi da una cartella o per UN fotogramma scelto da solo */
    var sq = SEQ_EXT.test(p) && (fromFolder[p.toLowerCase()] || picked.length < 2) ? seqInfo(p, cache) : null;
    if (sq) {
      if (seen[sq.key]) continue;                 /* altri fotogrammi della stessa sequenza */
      seen[sq.key] = 1;
      cv.items.push({ id: cv.nextId++, kind: "seq", seq: sq, path: sq.first, title: sq.label + "  (" + sq.count + " fotogrammi)", name: "", status: "wait", info: null });
      added++; seqs++;
      continue;
    }
    if (seen[p.toLowerCase()]) { skipped++; continue; }
    seen[p.toLowerCase()] = 1;
    /* immagine singola: clip ferma (uscita video) o conversione (uscita immagine). PNG/WebP animati: vedi cvProbe */
    cv.items.push({ id: cv.nextId++, kind: IMG_IN_EXT.test(p) ? "img" : "file", path: p, title: fso.GetFileName(p), name: "", status: "wait", info: null });
    added++;
  }
  /* analisi immediata se i file sono pochi, altrimenti alla conversione */
  if (added && added <= 15) for (i = cv.items.length - added; i < cv.items.length; i++) if (isLocalFixed(cv.items[i].path)) cvProbe(cv.items[i]);
  cvRender(); cvCheck();
  if (added) showMsg(added + (added === 1 ? " elemento aggiunto" : " elementi aggiunti") + (seqs ? " (" + seqs + (seqs === 1 ? " sequenza di immagini" : " sequenze di immagini") + ")" : "") + (skipped ? " — " + skipped + " doppi o non trovati" : "") + "." + (listErr ? "\n" + listErr : ""), listErr ? "err" : "info");
  else if (skipped) showMsg("Nessun file nuovo aggiunto (" + skipped + " doppi o non trovati)." + (listErr ? "\n" + listErr : ""), "err");
  else if (listErr) showMsg(listErr, "err");
}
/* analisi di un elemento: per le sequenze leggo il primo fotogramma e calcolo la durata dagli FPS scelti */
function cvSeqFpsChanged() {
  var f = parseFloat($("cvSeqFps").value) || 25, i;
  for (i = 0; i < cv.items.length; i++) { var it = cv.items[i]; if (it.kind === "seq" && it.info && it.info.ok) { it.info.fps = cvRate(it); it.info.dur = it.seq.count / it.info.fps; } else if (it.kind === "img" && it.info && it.info.ok) it.info.fps = f; }
  cvRender(); cvCheck();
}
function cvProbe(it) {
  it.info = probeFile(it.path);
  /* GIF di un fotogramma solo (un logo): e' un'immagine, non una clip da 0,04 s */
  if (it.kind === "file" && it.info.ok && it.info.codec === "gif" && it.info.frames === 1) it.kind = "img";
  if (it.kind === "img" && it.info.ok) {
    if (/^(apng|webp_anim)$/.test(it.info.codec) || it.info.dur > 0.5) it.kind = "file";   /* PNG/WebP animato: e' gia' un video */
    else { it.info.fps = parseFloat($("cvSeqFps").value) || 25; it.info.dur = cvStill(it); it.info.audio = false; it.info.img = true; }
  }
  if (it.kind === "seq" && it.info.ok) {
    var f = cvRate(it);
    it.info.fps = f; it.info.dur = it.seq.count / f; it.info.seq = true; it.info.audio = false;
    /* animazione di immagini: basta UNA immagine con trasparenza vera (non solo la prima). Si guardano i pixel di tutte,
       non l'estensione: PNG opachi su green screen lasciano libero il chroma key. Nel dubbio l'alfa resta. */
    if (it.seq.list && it.seq.alphaHint) {
      var sp = safePath(it.seq.pattern);
      it.info.alpha = sp ? hasRealAlpha(sp, false, Math.min(it.seq.count, 300)) : true;
    }
  }
  return it.info;
}

/* finestra di scelta file multipla (Windows Forms via PowerShell, nessun dato utente nella riga di comando) */
function cvAddFiles() {
  if (state.busy) return;
  ensureDir(DIR_TMP);
  var ps = SYSDIR + "\\WindowsPowerShell\\v1.0\\powershell.exe";
  var script = DIR_TMP + "\\pick_" + newToken() + ".ps1", out = DIR_TMP + "\\pick_" + newToken() + ".txt";
  var code = [
    "Add-Type -AssemblyName System.Windows.Forms",
    "$f = New-Object System.Windows.Forms.Form",
    "$f.TopMost = $true; $f.ShowInTaskbar = $false; $f.Opacity = 0; $f.StartPosition = 'CenterScreen'",
    "$f.Show(); $f.Activate()",
    "$d = New-Object System.Windows.Forms.OpenFileDialog",
    "$d.Multiselect = $true",
    "$d.Title = '" + TX("Scegli i file da convertire").replace(/'/g, "''") + "'",
    "$d.Filter = '" + TX("Video, animazioni e sequenze").replace(/['|]/g, "") + "|*.mp4;*.m4v;*.mov;*.qt;*.mkv;*.webm;*.avi;*.wmv;*.flv;*.mpg;*.mpeg;*.m2ts;*.mts;*.ts;*.3gp;*.ogv;*.gif;*.apng;*.png;*.mxf;*.dv;*.vob;*.f4v;*.asf;*.tif;*.tiff;*.exr;*.jpg;*.jpeg;*.jfif;*.dpx;*.tga;*.bmp;*.webp;*.avif|" + TX("Tutti i file").replace(/['|]/g, "") + "|*.*'",
    "if ($d.ShowDialog($f) -eq [System.Windows.Forms.DialogResult]::OK) { [IO.File]::WriteAllLines('" + out.replace(/'/g, "''") + "', $d.FileNames, [Text.Encoding]::Unicode) }",
    "$f.Close()"
  ].join("\r\n");
  try {
    writeUtf8(script, code);
    if (!fso.FileExists(ps)) throw new Error("PowerShell non trovato");
    /* -Command + iex: non soggetto ai criteri di esecuzione (che possono bloccare -File) */
    sh.Run('"' + ps + '" -NoProfile -STA -WindowStyle Hidden -Command "iex ([IO.File]::ReadAllText(\'' + script.replace(/'/g, "''") + '\'))"', 0, true);
  } catch (e) { showMsg("Impossibile aprire la finestra di scelta: " + (e.message || e), "err"); tryDelete(script); return; }
  tryDelete(script);
  if (!fso.FileExists(out)) return;   /* annullato */
  var list = readUtf8(out).split(/\r?\n/); tryDelete(out);
  cvAddPaths(list);
}
function cvAddFolder() {
  if (state.busy) return;
  try {
    var f = new ActiveXObject("Shell.Application").BrowseForFolder(0, TX("Scegli la cartella con i video da convertire"), 0x51, 0);
    if (!f || !f.Self || !f.Self.Path || !fso.FolderExists(f.Self.Path)) return;
    var list = [], ff = {}, e = new Enumerator(fso.GetFolder(f.Self.Path).Files);
    for (; !e.atEnd(); e.moveNext()) if (MEDIA_EXT.test(e.item().Name) || IMG_IN_EXT.test(e.item().Name)) { list.push(e.item().Path); ff[String(e.item().Path).toLowerCase()] = 1; }
    if (!list.length) { showMsg("Nessun video o sequenza di immagini in quella cartella.", "err"); return; }
    cvAddPaths(list, false, ff);
  } catch (x) { showMsg("Impossibile leggere la cartella: " + (x.message || x), "err"); }
}
function cvAddLink() {
  if (state.busy) return;
  var u = cleanUrl($("cvLink").value);
  if (!u) { showMsg("Incolla un link valido (https://...).", "err"); return; }
  for (var i = 0; i < cv.items.length; i++) if (cv.items[i].url === u) { showMsg("Link già in lista.", "err"); return; }
  cv.items.push({ id: cv.nextId++, kind: "link", url: u, path: "", title: u, name: "", status: "wait", info: null, imgLink: isImageUrl(u) });
  $("cvLink").value = "";
  cvRender(); cvCheck();
}
function cvClear() { if (state.busy) return; cv.items = []; cvRender(); cvCheck(); $("msg").style.display = "none"; }
function cvRemove(id) {
  if (state.busy) return;
  for (var i = 0; i < cv.items.length; i++) if (cv.items[i].id === id) { cv.items.splice(i, 1); break; }
  cvRender(); cvCheck();
}
function cvNumberAll() {
  if (state.busy || !cv.items.length) return;
  var base = cleanName($("cvBaseName").value).replace(/%/g, "");
  if (!base) { showMsg("Scrivi prima un nome comune (es. Logo).", "err"); return; }
  var w = Math.max(2, String(cv.items.length).length);
  for (var i = 0; i < cv.items.length; i++) { var n = String(i + 1); while (n.length < w) n = "0" + n; cv.items[i].name = cv.items.length === 1 ? base : base + " " + n; }
  cvRender();
}
function cvRender() {
  var box = $("cvQueue");
  while (box.firstChild) box.removeChild(box.firstChild);
  if (!cv.items.length) {
    var e = document.createElement("div"); e.className = "empty";
    e.innerText = TX("Nessun file. Usa + File, + Cartella, Incolla file, un link Drive, oppure trascina qui file e cartelle.");
    box.appendChild(e);
  }
  for (var i = 0; i < cv.items.length; i++) box.appendChild(cvRow(cv.items[i], i));
  $("cvCount").innerText = T("{0} file", cv.items.length);
}
function cvRow(it, idx) {
  var row = document.createElement("div"); row.className = "item";
  var num = document.createElement("div"); num.className = "num"; num.innerText = idx + 1;
  var body = document.createElement("div"); body.className = "body";
  var ttl = document.createElement("div"); ttl.className = "ttl"; ttl.innerText = it.title; ttl.title = it.path || it.url;
  var name = document.createElement("input"); name.className = "name lockable"; name.type = "text";
  name.placeholder = "Nome del file (vuoto = nome originale)"; name.value = it.name; name.maxLength = MAX_NAME_LEN; name.disabled = state.busy;
  name.onchange = function () { it.name = cleanName(this.value).replace(/%/g, ""); this.value = it.name; };
  var inf = document.createElement("div"); inf.className = "info";
  if (it.info && it.info.ok && it.info.alpha) {
    var y = document.createElement("span"); y.className = "yes"; y.innerText = TX("✔ trasparenza  ");
    inf.appendChild(y);
  }
  if (it.kind === "seq" && it.seq && it.seq.list) {
    var rl = document.createElement("span"); rl.className = "stilllbl"; rl.innerText = TX("Immagini al secondo") + " ";
    var rd = document.createElement("input"); rd.type = "text"; rd.className = "still lockable"; rd.maxLength = 5; rd.disabled = state.busy;
    rd.value = String(cvRate(it)).replace(".", ","); rd.title = TX("Quante immagini al secondo (da 0,1 a 60). Gli FPS del video si scelgono a parte.");
    rd.onchange = function () {
      var v = parseFloat(String(this.value).replace(",", "."));
      it.rate = v >= 0.1 && v <= 60 ? Math.round(v * 100) / 100 : 0;
      if (it.info && it.info.ok) { it.info.fps = cvRate(it); it.info.dur = it.seq.count / it.info.fps; }
      cvRender(); cvCheck();
    };
    inf.appendChild(rl); inf.appendChild(rd); inf.appendChild(document.createTextNode("  \u00b7  "));
  }
  if (it.kind === "img" && !cvSingleOut(it, cvSpec())) {
    /* immagine singola con uscita video: durata della clip ferma, per ogni immagine */
    var sl = document.createElement("span"); sl.className = "stilllbl"; sl.innerText = TX("Clip ferma") + " ";
    var sd = document.createElement("input"); sd.type = "text"; sd.className = "still lockable"; sd.maxLength = 6; sd.disabled = state.busy;
    sd.value = String(cvStill(it)).replace(".", ","); sd.title = TX("Durata della clip ferma in secondi (da 0,1 a 3600)");
    sd.onchange = function () {
      var v = parseFloat(String(this.value).replace(",", "."));
      it.still = v >= 0.1 && v <= 3600 ? Math.round(v * 10) / 10 : 5;
      if (it.info && it.info.ok) it.info.dur = it.still;
      cvRender(); cvCheck();
    };
    inf.appendChild(sl); inf.appendChild(sd); inf.appendChild(document.createTextNode(" s  ·  "));
  }
  inf.appendChild(document.createTextNode(infoText(it)));
  inf.title = infoText(it);
  body.appendChild(ttl); body.appendChild(name); body.appendChild(inf);
  var b = BADGE[it.status] || BADGE.wait;
  var badge = document.createElement("span"); badge.className = "badge " + b[1]; badge.innerText = T(b[0]);
  if (it.error) badge.title = TX(it.error);
  var del = document.createElement("button"); del.className = "del lockable"; del.innerHTML = "&times;"; del.title = TX("Rimuovi"); del.disabled = state.busy;
  del.onclick = function () { cvRemove(it.id); };
  var pv = document.createElement("button"); pv.className = "pv lockable"; pv.innerHTML = "&#9680;"; pv.title = TX("Anteprima del risultato su scacchiera"); pv.disabled = state.busy || !it.path;
  pv.onclick = function () { cvPreview(it); };
  row.appendChild(num); row.appendChild(body); row.appendChild(badge); row.appendChild(pv); row.appendChild(del);
  it.badgeEl = badge;
  return row;
}

/* ---------- opzioni ---------- */
function cvCheck() {
  var key = $("cvKey").value, custom = key === "custom", fmt = $("cvFmt").value, Fs = cvSpec();
  cvFillAudio();
  $("cvKeyColorCol").style.display = custom ? "block" : "none";
  $("cvTolCol").style.display = key !== "none" ? "block" : "none";
  $("cvCanvasWHCol").style.display = $("cvCanvas").value === "custom" ? "block" : "none";
  var col = custom ? hexColor($("cvKeyColor").value) : KEY_COLORS[key];
  $("cvSwatch").style.display = key !== "none" ? "block" : "none";
  if (col) $("cvSwatch").style.backgroundColor = "#" + col;
  var w = [], nAlpha = 0, nSeq = 0, nImg = 0, nAud = 0, nMulti = 0, nAnim = 0, nExr = 0, i;
  for (i = 0; i < cv.items.length; i++) {
    var x = cv.items[i].info;
    if (cv.items[i].kind === "seq") nSeq++;
    if (cv.items[i].kind === "img") nImg++;
    if (cv.items[i].seq && cv.items[i].seq.list) nAnim++;
    if ((x && x.codec === "exr") || /\.exr$/i.test(String(cv.items[i].path || ""))) nExr++;
    if (x && x.alpha) nAlpha++;
    if (x && x.audio) { nAud++; if (x.astreams && x.astreams.length > 1) nMulti++; }
  }
  var tr = cvTrim(), canv = cvCanvasWH();
  if (tr.err) w.push(tr.err);
  if (canv && canv.err) w.push(canv.err);
  if (custom && !col) w.push("Colore non valido: scrivilo come #RRGGBB (es. #00FF00).");
  else if (key !== "none" && nAlpha) w.push(nAlpha + (nAlpha === 1 ? " file \u00e8 gi\u00e0 trasparente" : " file sono gi\u00e0 trasparenti") + ": su quei file lo sfondo da rimuovere viene ignorato, per non rovinare la loro trasparenza.");
  if ($("cvPremult").checked) w.push("Premoltiplicato: usalo solo se il file \u00e8 stato esportato \u00abPremoltiplicato (con nero)\u00bb. Con alfa \u00abDiretto/Straight\u00bb lascialo spento.");
  if (Fs.remux && (nImg || nAnim)) w.push("Il cambio contenitore non si applica alle immagini: scegli un altro formato.");
  if (nExr && Fs.seq !== "exr" && !cvHasFilter("zscale")) w.push("Il tuo ffmpeg non ha il filtro zscale: i file EXR (lineari) uscirebbero troppo scuri. Premi «Installa / aggiorna componenti».");  if (Fs.remux) {
    if (key !== "none" || canv || $("cvLoop").value !== "1" || $("cvBounce").checked) w.push("Nel cambio contenitore chroma key, tela, ripetizioni e avanti-indietro non si applicano: scegli un formato normale.");
    if (tr.from || tr.to) w.push("Nel cambio contenitore il taglio parte dal fotogramma chiave pi\u00f9 vicino (pu\u00f2 anticipare di qualche frame).");
    if (Fs.remux === "mp4" && nAlpha) w.push("L'MP4 non ha il canale alfa: " + nAlpha + (nAlpha === 1 ? " file trasparente verr\u00e0 convertito" : " file trasparenti verranno convertiti") + " in H.264 appiattito su nero. Il cambio in MOV invece mantiene la trasparenza.");
  } else if (!Fs.alpha && (nAlpha || key !== "none")) w.push("Il formato " + Fs.name + " non ha il canale alfa: " + (nAlpha ? nAlpha + (nAlpha === 1 ? " file trasparente verr\u00e0 appiattito" : " file trasparenti verranno appiattiti") : "lo sfondo rimosso verr\u00e0 appiattito") + " su nero. Per tenere la trasparenza scegli un formato \u00abCon trasparenza\u00bb.");
  if (!Fs.remux && canv && !canv.err && canv.mode === "fit" && !Fs.alpha) w.push("Tela con bordi: questo formato non ha trasparenza, i bordi saranno neri.");
  if (Fs.aud === "none" && nAud && !Fs.seq) w.push(Fs.name + " non contiene audio: l'audio dei file viene tolto.");
  if (Fs.seq && nAud) w.push("Le sequenze di immagini non hanno audio: l'audio dei file viene tolto.");
  if ($("cvBounce").checked || $("cvLoop").value !== "1") {
    for (i = 0; i < cv.items.length; i++) { var it = cv.items[i]; if (it.info && it.info.ok) { var m = cvMemCheck(cvChain(it, Fs, false)); if (m) { w.push((it.name || it.title) + ": " + m); break; } } }
  }
  var mEnc = cvMissingEnc();
  if (mEnc.length) w.unshift(Fs.gpu ? "La scheda video non risulta pi\u00f9 disponibile per " + Fs.name + ": scegli un altro formato." : "Il tuo ffmpeg non ha il codec " + encNames(mEnc) + ": premi \u00abInstalla / aggiorna componenti\u00bb.");
  if (Fs.seq === "exr" && !cvHasFilter("zscale")) w.unshift("Il tuo ffmpeg non ha il filtro zscale (serve all'EXR lineare): premi \u00abInstalla / aggiorna componenti\u00bb.");
  var note = { gif: "GIF: al massimo 15 fotogrammi al secondo e 480p se non scegli altro; trasparenza a 1 bit (pixel pieni o vuoti), senza audio. Per bordi morbidi usa WebP o APNG.",
               webpanim: "WebP animato: trasparenza morbida, molto pi\u00f9 leggero della GIF, si apre in tutti i browser. Senza audio.",
               apng: "APNG: PNG animato senza perdita con trasparenza morbida (browser, Discord, Telegram). File pi\u00f9 pesanti del WebP.",
               hapalpha: "HAP Alpha: per Resolume, TouchDesigner, MadMapper, millumin e ledwall. Decodifica leggerissima, file grandi.",
               hapq: "HAP Q: qualit\u00e0 superiore ad HAP, senza alfa. Per software live e ledwall.", hap: "HAP: il pi\u00f9 leggero da riprodurre, senza alfa. Per software live e ledwall.",
               cfhd: "CineForm: intermedio da montaggio (Premiere, After Effects, Resolve) con alfa a 12 bit, pi\u00f9 leggero di ProRes 4444.",
               seqpng: "Sequenza PNG: un'immagine per fotogramma in una cartella, alfa a 8 bit, senza perdita.",
               seqtiff: "Sequenza TIFF: un'immagine per fotogramma (compressione senza perdita), alfa a 8 bit.",
               imgpng: "Immagine PNG: un file senza perdita con trasparenza a 8 bit.", imgtiff: "Immagine TIFF: un file senza perdita (compressione deflate) con trasparenza.",
               imgwebp: "Immagine WebP: file leggero con trasparenza morbida, per il web.", imgjpg: "Immagine JPG: file leggero e compatibile ovunque, senza trasparenza (lo sfondo trasparente diventa bianco).",
               seqexr: "Sequenza EXR: mezza precisione, colori convertiti in lineare e alfa premoltiplicato come si aspettano Nuke, After Effects e Resolve.",
               remuxmp4: "Cambio contenitore: video e audio vengono copiati senza perdita quando sono compatibili (H.264, H.265, AAC...). Il resto viene ricodificato. Qualit\u00e0, risoluzione e FPS non si applicano.",
               remuxmov: "Cambio contenitore: video e audio copiati senza perdita se compatibili (H.264, H.265, ProRes, AAC...), il resto ricodificato. Qualit\u00e0, risoluzione e FPS non si applicano.",
               vthevcalpha: "HEVC con alfa: il formato trasparente di Apple (Final Cut, Motion, Safari, iPhone). Codificato dal chip del Mac: veloce e leggero.",
               vth264: "Usa il chip video del Mac: molto pi\u00f9 veloce del normale H.264, a parit\u00e0 di peso la qualit\u00e0 \u00e8 un po' inferiore.",
               vthevc: "Usa il chip video del Mac: molto pi\u00f9 veloce del normale H.265, a parit\u00e0 di peso la qualit\u00e0 \u00e8 un po' inferiore.",
               qtrle: "Animazione e PNG sono senza perdita: file molto grandi, ideali per il montaggio.", pngmov: "Animazione e PNG sono senza perdita: file molto grandi, ideali per il montaggio." }[fmt] ||
             (Fs.gpu ? "Codifica con la scheda video " + (HW.vendor[Fs.gpu] || "") + ": molto pi\u00f9 veloce, a parit\u00e0 di peso la qualit\u00e0 \u00e8 un po' inferiore." : "") ||
             (Fs.prof ? "ProRes: la qualit\u00e0 dipende dal profilo scelto (il menu Qualit\u00e0 non si applica). Audio non compresso." : "");
  if (!note && !Fs.alpha) note = Fs.name + ": nessuna trasparenza nel file di uscita. Per mantenerla scegli un formato \u00abCon trasparenza\u00bb.";
  if (Fs.still && cv.items.length > nImg) note = (note ? note + " " : "") + "Dai video e dalle sequenze viene salvato un solo fotogramma: quello all'inizio del taglio (o il primo).";
  if (nImg && !Fs.still && !Fs.seq) note = (note ? note + " " : "") + "Immagini singole: diventano una clip ferma (durata nella riga di ogni immagine).";
  var nList = 0; for (i = 0; i < cv.items.length; i++) if (cv.items[i].seq && cv.items[i].seq.list) nList++;
  if (nList && !Fs.seq && !Fs.still) note = (note ? note + " " : "") + ($("cvFps").value === "orig" && !/^(gif|webpanim|apng)$/.test(fmt) ? "Animazioni di immagini: immagini al secondo nella riga, video a " + $("cvSeqFps").value.replace(".", ",") + " fps (o di pi\u00f9 se le immagini sono pi\u00f9 veloci)." : "Animazioni di immagini: immagini al secondo nella riga di ogni animazione.");
  if (nImg && Fs.seq) note = (note ? note + " " : "") + "Un'immagine singola esce come un solo file, non come cartella.";
  if (nSeq) note = (note ? note + " " : "") + nSeq + (nSeq === 1 ? " sequenza" : " sequenze") + " a " + $("cvSeqFps").value.replace(".", ",") + " fps.";
  if (nMulti && $("cvAllTracks").checked && Fs.aud !== "none") note = (note ? note + " " : "") + "Tracce audio multiple: verranno mantenute tutte.";
  $("cvOkLine").innerText = TX(note || "I file gi\u00e0 trasparenti (ProRes 4444, Animazione, PNG, GIF, WebM con alfa) mantengono SEMPRE la trasparenza.");
  $("cvOkLine").className = note ? "hint" : "okline";
  $("cvAlphaWarn").innerText = w.join("\n");
  $("cvAlphaWarn").style.display = w.length ? "block" : "none";
  if (!state.busy) { $("goConv").innerText = cvGoLabel(); goFit($("goConv")); }
  var folderMode = $("cvOutMode").value === "folder";
  $("cvFolderRow").style.display = folderMode ? "flex" : "none";
  $("cvFolderPath").innerText = cv.folder; $("cvFolderPath").title = cv.folder;
}
/* filtri disponibili in ffmpeg (letti una volta) */
var filtCache = null;
function cvHasFilter(name) {
  if (!filtCache) {
    var ff = findTool("ffmpeg.exe"); if (!ff) return true;
    var out = DIR_TMP + "\\filt_" + newToken() + ".txt", t = "";
    ensureDir(DIR_TMP);
    try { sh.Run('"' + EXE_CMD + '" /d /v:off /s /c ""' + ff + '" -hide_banner -filters > "' + out + '" 2>&1"', 0, true); t = readTail(out, 200000); } catch (e) {}
    tryDelete(out);
    if (!/\sscale\s/.test(t)) return true;               /* lettura fallita: non blocco nulla */
    filtCache = t;
  }
  return new RegExp("\\s" + name + "\\s").test(filtCache);
}
function cvPickFolder() {
  if (state.busy) return;
  try {
    var f = new ActiveXObject("Shell.Application").BrowseForFolder(0, TX("Dove salvare i video convertiti"), 0x51, 0);
    if (f && f.Self && f.Self.Path && fso.FolderExists(f.Self.Path)) { cv.folder = f.Self.Path; cvCheck(); saveSettings(); }
  } catch (e) {}
}

/* =====================================================================
   CONVERTITORE v5: formati, catena filtri, audio, sequenze, GPU, preset
   ===================================================================== */
/* formati di uscita: estensione, trasparenza, codificatori necessari, famiglia audio */
var CVF = {
  webm:           { ext: ".webm", alpha: true,  name: "WebM",               enc: ["libvpx-vp9"], aud: "opus" },
  prores:         { ext: ".mov",  alpha: true,  name: "MOV ProRes 4444",    enc: ["prores_ks"], prof: "4444", aud: "pcm" },
  prores4444xq:   { ext: ".mov",  alpha: true,  name: "MOV ProRes 4444 XQ", enc: ["prores_ks"], prof: "4444xq", aud: "pcm" },
  qtrle:          { ext: ".mov",  alpha: true,  name: "MOV Animazione",     enc: ["qtrle"], aud: "pcm" },
  pngmov:         { ext: ".mov",  alpha: true,  name: "MOV PNG",            enc: ["png"], aud: "pcm" },
  cfhd:           { ext: ".mov",  alpha: true,  name: "MOV CineForm",       enc: ["cfhd"], aud: "pcm" },
  hapalpha:       { ext: ".mov",  alpha: true,  name: "MOV HAP Alpha",      enc: ["hap"], hap: "hap_alpha", aud: "pcm" },
  hapq:           { ext: ".mov",  alpha: false, name: "MOV HAP Q",          enc: ["hap"], hap: "hap_q", aud: "pcm" },
  hap:            { ext: ".mov",  alpha: false, name: "MOV HAP",            enc: ["hap"], hap: "hap", aud: "pcm" },
  webpanim:       { ext: ".webp", alpha: true,  name: "WebP animato",       enc: ["libwebp_anim"], aud: "none" },
  apng:           { ext: ".png",  alpha: true,  name: "APNG animato",       enc: ["apng"], aud: "none" },
  gif:            { ext: ".gif",  alpha: true,  name: "GIF",                enc: ["gif"], aud: "none" },
  seqpng:         { ext: "",      alpha: true,  name: "Sequenza PNG",       enc: ["png"], seq: "png", aud: "none" },
  seqtiff:        { ext: "",      alpha: true,  name: "Sequenza TIFF",      enc: ["tiff"], seq: "tif", aud: "none" },
  seqexr:         { ext: "",      alpha: true,  name: "Sequenza EXR",       enc: ["exr"], seq: "exr", aud: "none" },
  /* immagine singola: un file solo (dai video e dalle sequenze il fotogramma all'inizio del taglio) */
  imgpng:         { ext: ".png",  alpha: true,  name: "Immagine PNG",       enc: ["png"], still: "png", aud: "none" },
  imgwebp:        { ext: ".webp", alpha: true,  name: "Immagine WebP",      enc: ["libwebp"], still: "webp", aud: "none" },
  imgtiff:        { ext: ".tif",  alpha: true,  name: "Immagine TIFF",      enc: ["tiff"], still: "tiff", aud: "none" },
  imgjpg:         { ext: ".jpg",  alpha: false, name: "Immagine JPG",       enc: ["mjpeg"], still: "jpg", aud: "none" },
  mp4h264:        { ext: ".mp4",  alpha: false, name: "MP4 H.264",          enc: ["libx264"], aud: "aac" },
  mp4h265:        { ext: ".mp4",  alpha: false, name: "MP4 H.265",          enc: ["libx265"], aud: "aac" },
  movh264:        { ext: ".mov",  alpha: false, name: "MOV H.264",          enc: ["libx264"], aud: "aac" },
  gpuh264:        { ext: ".mp4",  alpha: false, name: "MP4 H.264 GPU",      enc: [], gpu: "h264", aud: "aac" },
  gpuhevc:        { ext: ".mp4",  alpha: false, name: "MP4 H.265 GPU",      enc: [], gpu: "hevc", aud: "aac" },
  gpuav1:         { ext: ".mp4",  alpha: false, name: "MP4 AV1 GPU",        enc: [], gpu: "av1", aud: "aac" },
  prores422hq:    { ext: ".mov",  alpha: false, name: "MOV ProRes 422 HQ",  enc: ["prores_ks"], prof: "hq", aud: "pcm" },
  prores422:      { ext: ".mov",  alpha: false, name: "MOV ProRes 422",     enc: ["prores_ks"], prof: "standard", aud: "pcm" },
  prores422lt:    { ext: ".mov",  alpha: false, name: "MOV ProRes 422 LT",  enc: ["prores_ks"], prof: "lt", aud: "pcm" },
  prores422proxy: { ext: ".mov",  alpha: false, name: "MOV ProRes 422 Proxy", enc: ["prores_ks"], prof: "proxy", aud: "pcm" },
  remuxmp4:       { ext: ".mp4",  alpha: false, name: "MP4 (cambio contenitore)", enc: [], remux: "mp4", aud: "copy" },
  remuxmov:       { ext: ".mov",  alpha: false, name: "MOV (cambio contenitore)", enc: [], remux: "mov", aud: "copy" },
  /* solo Mac: codificatori hardware VideoToolbox (le voci di menu le aggiunge la versione Mac) */
  vthevcalpha:    { ext: ".mov",  alpha: true,  name: "MOV HEVC + alfa (Apple)", enc: ["hevc_videotoolbox"], vt: "hevc", aud: "aac" },
  vth264:         { ext: ".mp4",  alpha: false, name: "MP4 H.264 veloce (chip Mac)", enc: ["h264_videotoolbox"], vt: "h264", aud: "aac" },
  vthevc:         { ext: ".mp4",  alpha: false, name: "MP4 H.265 veloce (chip Mac)", enc: ["hevc_videotoolbox"], vt: "hevc", aud: "aac" }
};
var VT_BPP = { "15": 0.22, "24": 0.13, "31": 0.08, "38": 0.045 };
var X264_CRF = { "15": 16, "24": 19, "31": 23, "38": 28 }, X265_CRF = { "15": 18, "24": 22, "31": 26, "38": 30 }, X26_PRESET = { "4": "veryfast", "2": "medium", "1": "slow" };
var GPU_Q = { "15": 19, "24": 23, "31": 27, "38": 31 }, WEBP_Q = { "15": 95, "24": 85, "31": 75, "38": 60 };
var CFHD_Q = { "15": "film3+", "24": "film2", "31": "high", "38": "medium" };
/* codec copiabili senza ricodifica nei due contenitori */
var REMUX_OK = {
  mp4: { v: /^(h264|hevc|av1|vp9|mpeg4)$/, a: /^(aac|mp3|opus|ac3|eac3|alac|flac)$/ },
  mov: { v: /^(h264|hevc|prores|mpeg4|mjpeg|qtrle|png|hap|cfhd)$/, a: /^(aac|mp3|alac|ac3|pcm_s16le|pcm_s24le|pcm_s16be|pcm_s24be)$/ }
};
var AUD_MENU = {
  pcm: [["pcm24", "PCM 24 bit (consigliato)"], ["pcm16", "PCM 16 bit"], ["none", "Nessun audio"]],
  lossy: [["320k", "320 kbps"], ["256k", "256 kbps"], ["192k", "192 kbps"], ["160k", "160 kbps"], ["128k", "128 kbps"], ["96k", "96 kbps"], ["none", "Nessun audio"]],
  none: [["none", "Nessuno (formato senza audio)"]]
};
var AUD_DEFAULT = { pcm: "pcm24", lossy: "192k", none: "none" };
var SEQ_EXT = /\.(png|tif|tiff|exr|jpg|jpeg|dpx|tga|bmp|webp)$/i;
/* immagini accettate come immagine singola (le sequenze numerate restano solo SEQ_EXT) */
var IMG_IN_EXT = /\.(png|tif|tiff|exr|jpg|jpeg|jfif|dpx|tga|bmp|webp|avif)$/i;
function cvStill(it) { return it.still > 0 ? it.still : 5; }
/* fotogrammi al secondo in ingresso: le animazioni di immagini singole hanno il loro valore (nella riga),
   le sequenze numerate seguono «FPS delle sequenze» */
/* immagini al secondo: per le foto scelte una per una quelle della riga (2 se non cambiate: 5 foto = 2,5 s), per le sequenze numerate gli FPS delle sequenze */
function cvRate(it) { return it.seq && it.seq.list ? (it.rate > 0 ? it.rate : 2) : (parseFloat($("cvSeqFps").value) || 25); }
/* uscita = UN file immagine: formati «Immagine singola», oppure una sequenza con in ingresso un'immagine sola */
function cvSingleOut(it, F) { return !!F.still || (!!F.seq && it.kind === "img"); }

function cvSpec() { return CVF[$("cvFmt").value] || CVF.webm; }
function cvAudFamily(F) { return F.aud === "pcm" ? "pcm" : (F.aud === "none" ? "none" : "lossy"); }
/* menu Audio coerente con il formato: PCM per i formati da montaggio, bitrate per quelli compressi */
function cvFillAudio(keep) {
  var fam = cvAudFamily(cvSpec()), sel = $("cvAudio"), want = keep !== undefined ? keep : sel.value, ok = false, i, list = AUD_MENU[fam];
  /* cambiando famiglia (es. da WebP senza audio a MP4) riparto dal valore consigliato, non da "Nessun audio" */
  if (keep === undefined && cv.audFam && cv.audFam !== fam) want = AUD_DEFAULT[fam];
  cv.audFam = fam;
  for (i = 0; i < list.length; i++) if (list[i][0] === want) ok = true;
  fillSelect(sel, list, ok ? want : AUD_DEFAULT[fam]);
}
function cvEncodersOk() { return !cvMissingEnc().length; }
function cvMissingEnc() {
  var F = cvSpec(), need = F.enc.slice(0), fam = cvAudFamily(F);
  if (F.gpu) { if (!HW.enc[F.gpu]) return [F.gpu + "_gpu"]; need.push(HW.enc[F.gpu]); }
  if ($("cvAudio").value !== "none") { if (F.aud === "opus") need.push("libopus"); else if (F.aud === "aac") need.push("aac"); else if (fam === "pcm") need.push($("cvAudio").value === "pcm16" ? "pcm_s16le" : "pcm_s24le"); }
  return missingEncoders(need);
}

/* ---------- tempi: "1:02.5", "62,5", "0:01:02" -> secondi ---------- */
function parseTime(t) {
  t = String(t || "").replace(/^\s+|\s+$/g, "").replace(",", ".");
  if (!t) return null;
  if (!/^\d+(:\d+){0,2}(\.\d+)?$/.test(t)) return NaN;
  var p = t.split(":"), s = 0, i;
  for (i = 0; i < p.length; i++) s = s * 60 + parseFloat(p[i]);
  return s;
}
/* intervallo di taglio scelto (secondi) e validita' */
function cvTrim() {
  var a = parseTime($("cvFrom").value), b = parseTime($("cvTo").value), r = { from: 0, to: 0, err: "" };
  if (a !== null && isNaN(a)) r.err = "Inizio del taglio non valido: scrivi ad esempio 0:02.5 oppure 2.5";
  else if (b !== null && isNaN(b)) r.err = "Fine del taglio non valida: scrivi ad esempio 0:10 oppure 10";
  else { r.from = a || 0; r.to = b || 0; if (r.to && r.to <= r.from) r.err = "La fine del taglio deve venire dopo l'inizio."; }
  return r;
}
/* tela scelta: {w, h, mode} oppure null */
function cvCanvasWH() {
  var c = $("cvCanvas").value, m;
  if (!c) return null;
  if (c === "custom") {
    var w = parseInt($("cvCanvasW").value, 10), h = parseInt($("cvCanvasH").value, 10);
    if (!(w >= 16 && h >= 16 && w <= 8192 && h <= 8192)) return { err: "Tela personalizzata non valida: larghezza e altezza tra 16 e 8192." };
    return { w: w - w % 2, h: h - h % 2, mode: $("cvCanvasMode").value };
  }
  m = c.match(/^(\d+)x(\d+)$/);
  return m ? { w: +m[1], h: +m[2], mode: $("cvCanvasMode").value } : null;
}

/* ---------- accelerazione GPU (Windows): ogni codificatore viene PROVATO davvero ----------
   Stesso metodo dei progetti open source (Jellyfin, HandBrake): un encoder compilato in ffmpeg
   non basta, serve la scheda e il driver giusti. Il risultato si salva e si rifa' solo se ffmpeg cambia. */
var HW = { enc: {}, vendor: {}, state: "idle", key: "" };
var HW_CAND = [["nvenc", "NVIDIA"], ["qsv", "Intel"], ["amf", "AMD"]];
var HW_CODECS = ["h264", "hevc", "av1"];
var HW_LABEL = { h264: "MP4 H.264 veloce", hevc: "MP4 H.265 veloce", av1: "MP4 AV1 veloce" };
function hwKey(ffmpeg) { try { var f = fso.GetFile(ffmpeg); return ffmpeg + "|" + f.Size + "|" + (+new Date(f.DateLastModified)); } catch (e) { return ffmpeg; } }
function hwApply() {
  var sel = $("cvFmt"), i, c, ref = null;
  for (i = sel.options.length - 1; i >= 0; i--) if (/^gpu/.test(sel.options[i].value)) sel.remove(i);
  for (i = 0; i < sel.options.length; i++) if (sel.options[i].value === "mp4h265") ref = sel.options[i];
  if (!ref) return;
  for (i = HW_CODECS.length - 1; i >= 0; i--) {
    c = HW_CODECS[i];
    if (!HW.enc[c]) continue;
    var o = document.createElement("option"); o.value = "gpu" + c; o.text = TX(HW_LABEL[c]) + T(" (scheda {0})", HW.vendor[c]);
    ref.parentNode.insertBefore(o, ref.nextSibling);
    CVF["gpu" + c].name = HW_LABEL[c].replace(" veloce", "") + " " + HW.vendor[c];
  }
  if (cv.pendingFmt) { setSelect(sel, cv.pendingFmt); if (sel.value === cv.pendingFmt) cv.pendingFmt = ""; }
  cvFillAudio(); cvCheck();
}
function hwParse(txt) {
  var r = {}, v = {}, lines = String(txt).split(/\r?\n/), i, m;
  for (i = 0; i < lines.length; i++) {
    m = lines[i].match(/^HWOK (\w+)_(nvenc|qsv|amf)$/);
    if (!m) continue;
    var codec = m[1] === "h264" ? "h264" : (m[1] === "hevc" ? "hevc" : (m[1] === "av1" ? "av1" : ""));
    if (!codec || r[codec]) continue;
    for (var k = 0; k < HW_CAND.length; k++) if (HW_CAND[k][0] === m[2]) { r[codec] = m[1] + "_" + m[2]; v[codec] = HW_CAND[k][1]; }
  }
  return { enc: r, vendor: v };
}
/* avvio in sottofondo: nessun blocco dell'interfaccia (script cmd con esito su file) */
function hwDetect(force) {
  if (!EXE_CMD || !fso.FileExists(EXE_CMD) || window.DCVT_MAC) return;
  var ffmpeg = findTool("ffmpeg.exe");
  if (!ffmpeg || HW.state === "run") return;
  var key = hwKey(ffmpeg);
  if (!force && cv.hwSaved && cv.hwSaved.key === key) { HW.enc = cv.hwSaved.enc; HW.vendor = cv.hwSaved.vendor; HW.key = key; HW.state = "done"; hwApply(); return; }
  var have = ffmpegEncoders(), tests = [], i, j;
  for (i = 0; i < HW_CODECS.length; i++) for (j = 0; j < HW_CAND.length; j++) {
    var e = HW_CODECS[i] + "_" + HW_CAND[j][0];
    if (have && !have[e]) continue;
    tests.push('"' + ffmpeg + '" -hide_banner -nostdin -v error -f lavfi -i color=c=black:s=320x240:r=25 -frames:v 5 -c:v ' + e + ' -f null - >nul 2>&1 && echo HWOK ' + e);
  }
  ensureDir(DIR_TMP);
  var t = newToken(), bat = DIR_TMP + "\\hw_" + t + ".cmd", out = DIR_TMP + "\\hw_" + t + ".txt";
  try { writeAscii(bat, "@echo off\r\n" + tests.join("\r\n") + "\r\necho HWFINE\r\n"); } catch (x) { return; }
  HW.state = "run";
  try { sh.Run('"' + EXE_CMD + '" /d /c ""' + bat + '" > "' + out + '" 2>&1"', 0, false); } catch (x2) { HW.state = "idle"; return; }
  var t0 = new Date().getTime();
  var timer = setInterval(function () {
    var txt = readTail(out, 8000);
    if (/HWFINE/.test(txt) || new Date().getTime() - t0 > 90000) {
      clearInterval(timer);
      var r = hwParse(txt);
      HW.enc = r.enc; HW.vendor = r.vendor; HW.key = key; HW.state = "done";
      cv.hwSaved = { key: key, enc: r.enc, vendor: r.vendor };
      tryDelete(bat); tryDelete(out);
      hwApply(); saveSettings();
    }
  }, 700);
}
function hwSerialize() {
  if (!cv.hwSaved) return "";
  var p = [], c;
  for (c in cv.hwSaved.enc) if (cv.hwSaved.enc.hasOwnProperty(c)) p.push(c + ":" + cv.hwSaved.enc[c] + ":" + cv.hwSaved.vendor[c]);
  return encodeURIComponent(cv.hwSaved.key) + "|" + p.join(",");
}
function hwUnserialize(s) {
  var i = String(s || "").indexOf("|");
  if (i < 0) return null;
  var r = { key: decodeURIComponent(s.substring(0, i)), enc: {}, vendor: {} }, parts = s.substring(i + 1).split(","), k;
  for (k = 0; k < parts.length; k++) { var q = parts[k].split(":"); if (q.length === 3 && /^\w+$/.test(q[1])) { r.enc[q[0]] = q[1]; r.vendor[q[0]] = q[2]; } }
  return r;
}
/* parametri del codificatore GPU scelto */
function gpuArgs(enc, crf) {
  var q = GPU_Q[crf] || 23;
  if (/_nvenc$/.test(enc)) return ["-c:v " + enc, "-preset p5", "-tune hq", "-rc vbr", "-cq " + q, "-b:v 0"];
  if (/_qsv$/.test(enc)) return ["-c:v " + enc, "-preset medium", "-global_quality " + q];
  return ["-c:v " + enc, "-quality quality", "-rc cqp", "-qp_i " + q, "-qp_p " + q];
}

/* ---------- sequenze di immagini ---------- */
/* da un fotogramma ricostruisce tutta la sequenza nella sua cartella */
function seqInfo(p, cache) {
  var name = fso.GetFileName(p), m = name.match(/^(.*?)(\d+)(\.[A-Za-z0-9]+)$/);
  if (!m || !SEQ_EXT.test(name)) return null;
  var dir = fso.GetParentFolderName(p), pre = m[1], ext = m[3], key = (dir + "|" + pre + "|" + ext).toLowerCase();
  if (cache && cache[key] !== undefined) return cache[key];
  var nums = {}, lens = {}, cnt = 0, min = -1, i, e;
  try {
    e = new Enumerator(fso.GetFolder(dir).Files);
    for (; !e.atEnd(); e.moveNext()) {
      var n2 = e.item().Name, mm = n2.match(/^(.*?)(\d+)(\.[A-Za-z0-9]+)$/);
      if (!mm || mm[1].toLowerCase() !== pre.toLowerCase() || mm[3].toLowerCase() !== ext.toLowerCase()) continue;
      var v = parseInt(mm[2], 10);
      nums[v] = 1; lens[mm[2].length] = (lens[mm[2].length] || 0) + 1; cnt++;
      if (min < 0 || v < min) min = v;
    }
  } catch (x) { return null; }
  var res = null;
  if (cnt >= 2) {
    var L = 0, nl = 0, l; for (l in lens) if (lens.hasOwnProperty(l)) { nl++; L = +l; }
    var padded = nl === 1, contig = 0;
    for (i = min; nums[i]; i++) contig++;
    var first = String(min); if (padded) while (first.length < L) first = "0" + first;
    res = { dir: dir, prefix: pre, ext: ext, start: min, count: contig, total: cnt, key: key,
            pattern: dir + "\\" + pre.replace(/%/g, "%%") + (padded ? "%0" + L + "d" : "%d") + ext,
            first: dir + "\\" + pre + first + ext, label: pre + (padded ? new Array(L + 1).join("#") : "#") + ext };
  }
  if (cache) cache[key] = res;
  return res;
}

/* formato di lavoro per scala e bordi: non scendere sotto la precisione dell'uscita
   (PNG/Animazione/APNG senza perdita in RGB, ProRes e CineForm a 12 bit, EXR in virgola mobile).
   rgb: per gli altri formati RGB 8 bit invece di YUV 4:4:4 (le animazioni di immagini lo usavano gia') */
function cvWorkFmt(fmt, alpha, rgb) {
  if (fmt === "seqexr") return alpha ? "gbrapf32le" : "gbrpf32le";
  if (/^prores/.test(fmt) || fmt === "cfhd") return alpha ? "yuva444p12le" : "yuv444p12le";
  if (rgb || /^(qtrle|pngmov|apng|seqpng|seqtiff|imgpng|imgtiff|hapalpha|hapq|hap|gif)$/.test(fmt)) return alpha ? "rgba" : "rgb24";
  return alpha ? "yuva444p" : "yuv444p";
}
/* immagine ferma che il lettore di immagini di ffmpeg non sa ripetere (-loop): la ripete un filtro */
function cvLoopByFilter(it) { return it.kind === "img" && /\.(avif|gif)$/i.test(String(it.path || "")); }
/* ---------- catena dei filtri video (conversione e anteprima usano la stessa) ---------- */
function cvChain(it, F, forPreview) {
  var x = it.info, fmt = $("cvFmt").value, vf = [], key = $("cvKey").value;
  var col = key === "custom" ? hexColor($("cvKeyColor").value) : KEY_COLORS[key];
  var useKey = key !== "none" && col && !x.alpha;            /* mai il chroma key su file gia' trasparenti */
  var canvas = cvCanvasWH(); if (canvas && canvas.err) canvas = null;
  var alpha = F.alpha && (x.alpha || useKey || (canvas && canvas.mode === "fit") || $("cvAlphaForce").checked);
  if (!forPreview && cvLoopByFilter(it) && !cvSingleOut(it, F)) {
    var sr = parseFloat($("cvSeqFps").value) || 25;
    vf.push("loop=loop=-1:size=1:start=0", "setpts=N/" + sr + "/TB", "fps=" + sr, "trim=duration=" + cvStill(it));
  }
  if (it.kind === "seq" && x.w && x.h) {
    /* immagini di misure diverse (animazioni di immagini, foto numerate verticali e orizzontali): scala e bordi
       trasparenti alla misura della prima, mai stirate. Le animazioni di immagini restano a misure pari come prima */
    var lw = it.seq.list ? x.w + (x.w % 2) : x.w, lh = it.seq.list ? x.h + (x.h % 2) : x.h;
    /* EXR in ingresso: in virgola mobile finche' non e' convertito da lineare a sRGB (8 bit lineari = ombre a gradini) */
    vf.push("scale=" + lw + ":" + lh + ":force_original_aspect_ratio=decrease,format=" + (x.codec === "exr" ? "gbrapf32le" : cvWorkFmt(fmt, true, true)) + ",pad=" + lw + ":" + lh + ":(ow-iw)/2:(oh-ih)/2:color=black@0:eval=frame");   /* eval=frame: centrata anche se cambia misura */
  }
  if (x.alpha && ($("cvPremult").checked || x.codec === "exr")) vf.push("unpremultiply=inplace=1");   /* l'EXR e' premoltiplicato per convenzione */
  /* EXR: i valori sono lineari, per tutti gli altri formati li porto in sRGB (prima lo faceva -apply_trc, tolto da ffmpeg) */
  if (x.codec === "exr") vf.push("zscale=tin=linear:t=iec61966-2-1:npl=100", "format=" + (x.alpha ? "gbrapf32le" : "gbrpf32le"));   /* resta RGB: la conversione in YUV la fa dopo il format finale */
  if (useKey) {
    var tol = $("cvTol").value;
    if (key === "black" || key === "white") vf.push("colorkey=0x" + col + ":" + tol + ":0.08");
    else vf.push("chromakey=0x" + col + ":" + tol + ":0.08");
    if (key === "green") vf.push("despill=type=green"); else if (key === "blue") vf.push("despill=type=blue");
  }
  /* formato senza alfa con sorgente trasparente: appiattisco su nero in modo corretto (bordi puliti) */
  /* JPG (immagine): su bianco come nel downloader, 255 - (255 - c) * alfa; i video restano su nero */
  if (!F.alpha && (x.alpha || useKey)) { if (fmt === "imgjpg") vf.push("format=rgba", "negate", "premultiply=inplace=1", "negate"); else vf.push("format=yuva444p", "premultiply=inplace=1"); }
  var fps = $("cvFps").value, ofps = fps !== "orig" ? +fps : (x.fps > 0 && x.fps < 241 ? x.fps : 25);
  /* GIF: 15 fps per i video; le sequenze e le immagini singole tengono i loro FPS (un fotogramma per immagine) */
  /* (una GIF o un APNG a 10 fps resta a 10: salire a 15 duplicherebbe i fotogrammi) */
  if (!forPreview) { if (fps !== "orig") vf.push("fps=" + fps); else if (fmt === "gif" && !(it.kind === "seq") && !(it.kind === "file" && x.fps > 0 && x.fps <= 15)) { vf.push("fps=15"); ofps = 15; } }
  if (it.seq && it.seq.list && fps === "orig" && !F.seq && !F.still && !/^(gif|webpanim|apng)$/.test(fmt)) {
    var vfps = parseFloat($("cvSeqFps").value) || 25;
    if (vfps > ofps) { if (!forPreview) vf.push("fps=" + vfps); ofps = vfps; }
  }
  var W = x.w, Hh = x.h;
  if (canvas) {
    if (canvas.mode === "fill") vf.push("scale=" + canvas.w + ":" + canvas.h + ":force_original_aspect_ratio=increase:flags=lanczos", "crop=" + canvas.w + ":" + canvas.h);
    else {
      vf.push("scale=" + canvas.w + ":" + canvas.h + ":force_original_aspect_ratio=decrease:flags=lanczos");
      vf.push("format=" + cvWorkFmt(fmt, alpha, false), "pad=" + canvas.w + ":" + canvas.h + ":(ow-iw)/2:(oh-ih)/2:color=black" + (alpha ? "@0" : ""));
    }
    W = canvas.w; Hh = canvas.h;
  } else {
    var H = $("cvRes").value, shortSide = Math.min(x.w, x.h);
    if (H === "orig" && fmt === "gif" && shortSide > 480) H = "480";                  /* GIF: oltre 480p diventa enorme */
    if (H !== "orig" && shortSide > parseInt(H, 10)) {
      vf.push((x.w >= x.h ? "scale=-2:" + H : "scale=" + H + ":-2") + ":flags=lanczos");
      var r = parseInt(H, 10) / shortSide; W = Math.round(x.w * r); Hh = Math.round(x.h * r);
    } else if (/^(webm|mp4h264|mp4h265|movh264|vt|gpu|webpanim)/.test(fmt)) vf.push("scale=trunc(iw/2)*2:trunc(ih/2)*2");   /* 4:2:0 vuole dimensioni pari */
  }
  if (F.hap) vf.push("scale=trunc(iw/4)*4:trunc(ih/4)*4");                     /* HAP: multipli di 4 */
  if (fmt === "cfhd") vf.push("scale=trunc(iw/16)*16:trunc(ih/2)*2");          /* CineForm: larghezza multipla di 16 */
  var one = cvSingleOut(it, F), tr = it.kind === "img" ? { from: 0, to: 0, err: "" } : cvTrim();
  var seg = (tr.to || x.dur) - tr.from, loops = one ? 1 : (parseInt($("cvLoop").value, 10) || 1), bounce = !one && $("cvBounce").checked;
  if (!(seg > 0)) seg = x.dur || 0;
  /* avanti-indietro senza fotogrammi doppi: tolgo il primo dell'andata e il primo del ritorno,
     cosi' ne' la svolta ne' la giunzione del loop ripetono un fotogramma */
  if (!forPreview && bounce) vf.push("split[dfa][dfb];[dfa]trim=start_frame=1,setpts=PTS-STARTPTS[dff];[dfb]reverse,trim=start_frame=1,setpts=PTS-STARTPTS[dfr];[dff][dfr]concat=n=2:v=1:a=0");
  var frames = Math.ceil(seg * ofps * (bounce ? 2 : 1)) + 4;
  if (!forPreview && loops > 1) vf.push("loop=loop=" + (loops - 1) + ":size=" + Math.min(32767, frames) + ":start=0");
  return { vf: vf, alpha: alpha, useKey: useKey, w: W, h: Hh, fps: ofps, seg: seg, loops: loops, bounce: bounce, frames: frames, trim: tr };
