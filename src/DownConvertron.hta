.0 L678.0 150.0 L656.0 196.0 L504.0 196.0 L482.0 150.0 Z" fill="url(#szTHelm)" stroke="#07080b" stroke-width="2.4"/><path d="M484.0 112.0 L485.2 97.3 L488.7 83.0 L494.5 69.3 L502.3 56.7 L512.1 45.5 L523.6 36.0 L536.4 28.2 L550.3 22.6 L565.0 19.2 L580.0 18.0 L595.0 19.2 L609.7 22.6 L623.6 28.2 L636.4 36.0 L647.9 45.5 L657.7 56.7 L665.5 69.3 L671.3 83.0 L674.8 97.3 L676.0 112.0 L678.0 150.0 L656.0 196.0 L504.0 196.0 L482.0 150.0 Z" fill="url(#szTGrime)" opacity=".95"/><path d="M500 78 Q580 34 660 78 L664 132 L496 132 Z" fill="#05070a" stroke="#07080b" stroke-width="2"/><path d="M510 50 Q580 18 650 50" fill="none" stroke="#e6edf7" stroke-width="2" opacity=".55"/><circle cx="490" cy="150" r="9" fill="url(#szTAmber)"/><circle cx="490" cy="150" r="4" fill="#fff1c9"/><circle cx="670" cy="150" r="9" fill="url(#szTAmber)"/><circle cx="670" cy="150" r="4" fill="#fff1c9"/><g fill="#06070a" stroke="#5d6372" stroke-width=".6"><rect x="542" y="152" width="76" height="5" rx="2.5"/><rect x="542" y="162" width="76" height="5" rx="2.5"/><rect x="542" y="172" width="76" height="5" rx="2.5"/></g><path d="M48 92 L144 92 L156 104 L156 196 L144 208 L48 208 L36 196 L36 104 Z" fill="#05070a" stroke="#07080b" stroke-width="2.2"/><path d="M944 96 L1112 96 L1122 106 L1122 198 L1112 208 L944 208 L934 198 L934 106 Z" fill="#05070a" stroke="#07080b" stroke-width="2.2"/><path d="M160 212 L1000 212 L1000 806 L160 806 Z" fill="#0d1016" stroke="#07080b" stroke-width="3"/></svg>
    <img class="iconlcd" alt="" src="data:image/png;base64,">
    <div class="lcd visor">
      <span class="lcd-tag">MECHA v7.0</span><span class="led" title="Lavoro in corso"></span>
      <div class="lcd-title">DOWNCONVERTRON</div>
      <div class="lcd-sub" id="tickBox"><span class="marquee" id="tick">SISTEMI ONLINE</span></div>
    </div>
    <div class="sysrow"><span id="sysYt" class="sys wait act" onclick="sysClick('yt')"><i></i>REATTORE</span><span id="sysLink" class="sys wait act" onclick="sysClick('link')"><i></i>LINK</span><span id="sysEnc" class="sys wait act" onclick="sysClick('enc')"><i></i>ENCODER</span><span id="sysComp" class="sys wait" onclick="sysClick('comp')"><i></i>COMPONENTI</span></div>
    <div class="langslot" id="langSlot"><button data-l="it" onclick="setLang('it')" title="Italiano">IT</button><button data-l="en" onclick="setLang('en')" title="English">EN</button><button data-l="zh" onclick="setLang('zh')" title="中文（简体）">中文</button></div>
  </div>
  <div class="mid">
    <img class="armimg l" alt="" src="data:image/png;base64,">
    <img class="armimg r" alt="" src="data:image/png;base64,">
    <div class="plate"></div>
    <div id="torso">
  <div class="tabs">
    <button id="tabBtnDl" class="tab on" onclick="showTab('dl')">&#8595;&nbsp; Scarica da link</button>
    <button id="tabBtnCv" class="tab" onclick="showTab('cv')">&#8635;&nbsp; Converti video</button>
  </div>

  <div id="tabDl" class="cols">
  <div class="colA">
  <!-- 1. LINK -->
  <div class="card">
    <h2>1 &middot; Link</h2>
    <div class="addrow">
      <input id="urlIn" class="inp lockable" type="text" placeholder="Incolla uno o pi&ugrave; link e premi Invio">
      <button class="btn lockable" onclick="addFromInput()">Aggiungi</button>
    </div>
    <div class="tools">
      <button class="btn sm lockable" onclick="addFromClipboard()">Incolla dagli appunti</button>
      <button class="btn sm lockable" onclick="importTxt()">Importa da .txt</button>
      <button class="btn sm lockable" onclick="clearQueue()">Svuota lista</button>
      <input id="fileIn" type="file" accept=".txt" style="display:none" onchange="onFilePicked(this)">
      <input id="exeIn" type="file" accept=".exe" style="display:none" onchange="onExePicked(this)">
    </div>
    <div class="hint">
      Schede del browser: copia tutti i link con un'estensione come <b>Copy All URLs</b> e premi <b>Incolla dagli appunti</b>.
      In un .txt puoi scrivere <b>link | nome file</b> per nominare ogni video.
    </div>

    <div id="queue" class="queue"></div>
    <div class="qfoot">
      <span id="qcount">0 link</span>
      <span class="addrow" style="width:58%">
        <input id="baseName" class="inp lockable" type="text" placeholder="Nome comune (es. Vacanze)" style="height:32px;font-size:12.5px">
        <button class="btn sm lockable" onclick="numberAll()">Numera tutti</button>
      </span>
    </div>
  </div>
  <!-- 3. CARTELLA E AVVIO -->
  <div class="card">
    <h2>3 &middot; Salva in</h2>
    <div class="folder">
      <div id="folderPath" class="path"></div>
      <button class="btn lockable" onclick="pickFolder()">Cambia</button>
    </div>
    <div style="margin-top:14px"><button id="go" class="go" onclick="onGo()">Scarica</button></div>
  </div>
  </div>
  <div class="colB">
  <!-- 2. FORMATO -->
  <div class="card" id="fmtCard">
    <h2>2 &middot; Video e audio</h2> <span class="dimnote">Non si applica alle immagini</span>
    <div class="seg">
      <button id="bVideo" class="on lockable" onclick="setMode('video')">Video</button>
      <button id="bAudio" class="lockable" onclick="setMode('audio')">Solo audio</button>
    </div>

    <div id="videoOpts">
      <div class="row">
        <div class="col">
          <label class="lbl" for="quality">Qualit&agrave;</label>
          <select id="quality" class="lockable" onchange="checkCombo()">
            <option value="best">Massima disponibile</option>
            <option value="4320">8K (4320p)</option>
            <option value="2160">4K (2160p)</option>
            <option value="1440">2K (1440p)</option>
            <option value="1080">Full HD (1080p)</option>
            <option value="720">HD (720p)</option>
            <option value="480">480p</option>
            <option value="360">360p</option>
          </select>
        </div>
        <div class="col" id="codecCol">
          <label class="lbl" for="codec">Codec</label>
          <select id="codec" class="lockable" onchange="checkCombo()"></select>
        </div>
        <div class="col">
          <label class="lbl" for="container">File</label>
          <select id="container" class="lockable" onchange="fillVideoSelects(); checkCombo()">
            <option value="mp4">MP4</option>
            <option value="mkv">MKV</option>
            <option value="webm">WebM</option>
            <option value="mov">MOV (QuickTime)</option>
            <option value="avi">AVI</option>
            <option value="gif">GIF animata</option>
          </select>
        </div>
      </div>
      <div id="comboWarn" class="warn">Con H.264 YouTube arriva di solito al massimo a 1080p: per 2K/4K/8K scegli Automatico, VP9 o AV1.</div>
      <div id="fmtWarn" class="warn"></div>
      <div id="webmWarn" class="warn">WebM usa solo VP9/AV1 + Opus: H.264 non &egrave; compatibile e viene ignorato. Se un video non esiste in WebM viene convertito (pi&ugrave; lento). La copertina non si pu&ograve; inserire in un WebM.</div>
    </div>

    <div id="audioOpts" style="display:none">
      <div class="row">
        <div class="col">
          <label class="lbl" for="afmt">Formato audio</label>
          <select id="afmt" class="lockable" onchange="fillAudioSelects(); checkCombo()">
            <option value="mp3">MP3</option>
            <option value="m4a">M4A (AAC)</option>
            <option value="opus">Opus</option>
            <option value="vorbis">Vorbis (OGG)</option>
            <option value="webm">WebM (Opus originale, senza conversione)</option>
            <option value="best">Originale (nessuna conversione)</option>
            <option value="flac">FLAC (senza perdita)</option>
            <option value="wav">WAV</option>
          </select>
        </div>
        <div class="col" id="aqCol">
          <label class="lbl" for="aq" id="aqLbl">Bitrate / qualit&agrave;</label>
          <select id="aq" class="lockable" onchange="checkCombo()"></select>
        </div>
      </div>
      <div class="row" id="aProcRow">
        <div class="col">
          <label class="lbl" for="aRate">Frequenza</label>
          <select id="aRate" class="lockable" onchange="checkCombo()"></select>
        </div>
        <div class="col">
          <label class="lbl" for="aChan">Canali</label>
          <select id="aChan" class="lockable" onchange="checkCombo()">
            <option value="">Originali</option>
            <option value="2">Stereo</option>
            <option value="1">Mono</option>
          </select>
        </div>
      </div>
      <div id="aProcNote" class="hint" style="display:none">Con &laquo;Originale&raquo; e &laquo;WebM&raquo; l'audio viene copiato cos&igrave; com'&egrave;: bitrate, frequenza, canali e volume non si applicano.</div>
      <div id="aModeNote" class="hint" style="display:none"></div>
      <div id="aEncWarn" class="warn"></div>
    </div>

    <div class="row" id="audioCommonRow">
      <div class="col" id="vAudioCol">
        <label class="lbl" for="vAudio">Audio nel video</label>
        <select id="vAudio" class="lockable" onchange="checkCombo()"></select>
      </div>
      <div class="col">
        <label class="lbl" for="aLang">Lingua audio</label>
        <select id="aLang" class="lockable">
          <option value="">Originale</option>
          <option value="it">Italiano</option>
          <option value="en">Inglese</option>
          <option value="es">Spagnolo</option>
          <option value="fr">Francese</option>
          <option value="de">Tedesco</option>
          <option value="pt">Portoghese</option>
          <option value="ja">Giapponese</option>
        </select>
      </div>
    </div>

    <div class="checks">
      <label><input type="checkbox" id="optPlaylist" class="lockable">Scarica intere playlist</label>
      <label><input type="checkbox" id="optSubs" class="lockable">Sottotitoli (it, en)</label>
      <label><input type="checkbox" id="optThumb" class="lockable" checked>Copertina nel file</label>
      <label><input type="checkbox" id="optMeta" class="lockable" checked>Metadati (titolo, autore)</label>
      <label><input type="checkbox" id="optArchive" class="lockable">Salta quelli gi&agrave; scaricati</label>
      <label><input type="checkbox" id="optCookies" class="lockable" onchange="checkCombo()">Usa login di Firefox</label>
      <label><input type="checkbox" id="optChapters" class="lockable">Dividi per capitoli</label>
      <label id="normLbl"><input type="checkbox" id="optNorm" class="lockable">Volume uniforme</label>
    </div>
    <div id="cookieWarn" class="warn">Serve solo per video con limite di et&agrave; o privati: i link vengono aperti con il tuo account Firefox, quindi usalo solo con liste di cui ti fidi. Non viene ricordato alla riapertura.</div>
  </div>
  <!-- 2b. IMMAGINI: impostazioni separate dal video -->
  <div class="card" id="imgCard">
    <h2>2b &middot; Immagini</h2>
    <div class="imgrow">
      <label class="lbl" for="imgDef">Formato delle immagini</label>
      <select id="imgDef" class="lockable" onchange="imgDefChanged()">
        <option value="">Originale (file del server, senza ricodifica)</option>
        <option value="png">PNG (con alfa)</option>
        <option value="webp">WebP (con alfa)</option>
        <option value="jpg">JPG (trasparenza su bianco)</option>
      </select>
    </div>
    <div class="hint">Le immagini si scaricano a parte, senza yt-dlp: qualit&agrave;, codec e opzioni di &laquo;Video e audio&raquo; non le toccano. Il formato vale per le immagini in lista e si pu&ograve; cambiare anche riga per riga.</div>
  </div>
  </div>
  </div>

  <!-- ===================== CONVERTITORE ===================== -->
  <div id="tabCv" class="cols" style="display:none">
  <div class="colA">
  <div class="card">
    <h2>1 &middot; File da convertire</h2>
    <div class="tools" style="margin-top:0">
      <button class="btn sm lockable" onclick="cvAddFiles()">+ File</button>
      <button class="btn sm lockable" onclick="cvAddFolder()">+ Cartella</button>
      <button class="btn sm lockable" onclick="cvPasteFiles()" title="Copia i file in Esplora file / Finder (Ctrl+C) e incollali qui (anche Ctrl+V)">Incolla file</button>
      <button class="btn sm lockable" onclick="cvClear()">Svuota</button>
    </div>
    <div class="addrow" style="margin-top:4px">
      <input id="cvLink" class="inp lockable" type="text" placeholder="Link Google Drive (o altro link) da scaricare e convertire">
      <button class="btn lockable" onclick="cvAddLink()">Aggiungi link</button>
    </div>
    <div class="hint">
      <b>Google Drive sul PC</b>: i file sono in <b>G:\Il mio Drive</b>. <b>Link Drive</b>: condiviso con &laquo;Chiunque abbia il link&raquo;.
      Anche <b>sequenze</b> PNG/TIFF/EXR/JPG e <b>trascinamento</b> di file e cartelle.
    </div>
    <div id="cvQueue" class="queue"></div>
    <div class="qfoot">
      <span id="cvCount">0 file</span>
      <span class="addrow" style="width:58%">
        <input id="cvBaseName" class="inp lockable" type="text" placeholder="Nome comune (es. Logo)" style="height:32px;font-size:12.5px">
        <button class="btn sm lockable" onclick="cvNumberAll()">Numera tutti</button>
      </span>
    </div>
  </div>
  <div class="card">
    <h2>3 &middot; Salva in</h2>
    <div class="row" style="margin-top:0">
      <div class="col">
        <select id="cvOutMode" class="lockable" onchange="cvCheck()">
          <option value="same">Nella stessa cartella del file originale</option>
          <option value="folder">In una cartella a scelta</option>
        </select>
      </div>
    </div>
    <div class="folder" id="cvFolderRow" style="margin-top:10px;display:none">
      <div id="cvFolderPath" class="path"></div>
      <button class="btn lockable" onclick="cvPickFolder()">Cambia</button>
    </div>
    <div style="margin-top:14px"><button id="goConv" class="go" onclick="onGoConv()">Converti in WebM</button></div>
  </div>
  </div>
  <div class="colB">
  <div class="card">
    <h2>2 &middot; Formato e ritocchi</h2>
    <div class="presetrow">
      <select id="cvPreset" class="lockable" onchange="cvPresetPick()" title="Preset: impostazioni salvate con un nome"></select>
      <input id="cvPresetName" class="inp lockable" type="text" maxlength="40" placeholder="Nome nuovo preset">
      <button class="btn sm lockable" onclick="cvPresetSave()">Salva</button>
      <button class="btn sm lockable" onclick="cvPresetDelete()">Elimina</button>
    </div>
    <div class="seg subseg">
      <button id="cvPgFmt" class="on" onclick="cvPage('fmt')">Formato</button>
      <button id="cvPgAlpha" onclick="cvPage('alpha')">Trasparenza</button>
      <button id="cvPgEdit" onclick="cvPage('edit')">Ritocchi</button>
    </div>
    <div id="cvPaneFmt" class="pane">
      <div class="row" style="margin-top:8px">
        <div class="col">
          <label class="lbl" for="cvFmt">Formato di uscita</label>
        <select id="cvFmt" class="lockable" onchange="cvRender(); cvCheck()">
          <optgroup label="Con trasparenza (alfa)">
            <option value="webm">WebM VP9 + alfa (web)</option>
            <option value="prores">MOV ProRes 4444 + alfa</option>
            <option value="prores4444xq">MOV ProRes 4444 XQ + alfa</option>
            <option value="qtrle">MOV Animazione + alfa (senza perdita)</option>
            <option value="pngmov">MOV PNG + alfa (senza perdita)</option>
            <option value="cfhd">MOV CineForm + alfa (montaggio, 12 bit)</option>
            <option value="hapalpha">MOV HAP Alpha (live, ledwall)</option>
            <option value="webpanim">WebP animato + alfa (web, leggero)</option>
            <option value="apng">APNG animato + alfa (senza perdita)</option>
            <option value="gif">GIF animata (alfa a 1 bit)</option>
          </optgroup>
          <optgroup label="Sequenze di immagini (cartella)">
            <option value="seqpng">Sequenza PNG + alfa</option>
            <option value="seqtiff">Sequenza TIFF + alfa</option>
            <option value="seqexr">Sequenza EXR + alfa (lineare, compositing)</option>
          </optgroup>
          <optgroup label="Immagine singola (file)">
            <option value="imgpng">PNG + alfa (senza perdita)</option>
            <option value="imgwebp">WebP + alfa (leggero)</option>
            <option value="imgtiff">TIFF + alfa (senza perdita)</option>
            <option value="imgjpg">JPG (senza alfa)</option>
          </optgroup>
          <optgroup label="Senza trasparenza">
            <option value="mp4h264">MP4 H.264 (compatibile ovunque)</option>
            <option value="mp4h265">MP4 H.265 / HEVC (pi&ugrave; leggero)</option>
            <option value="movh264">MOV H.264 (Apple, Final Cut)</option>
            <option value="prores422hq">MOV ProRes 422 HQ</option>
            <option value="prores422">MOV ProRes 422</option>
            <option value="prores422lt">MOV ProRes 422 LT</option>
            <option value="prores422proxy">MOV ProRes 422 Proxy</option>
            <option value="hapq">MOV HAP Q (live, ledwall)</option>
            <option value="hap">MOV HAP (live, il pi&ugrave; leggero)</option>
          </optgroup>
          <optgroup label="Solo cambio contenitore (istantaneo)">
            <option value="remuxmp4">MP4 &larr; da MOV/MKV senza ricodifica</option>
            <option value="remuxmov">MOV &larr; da MP4/MKV senza ricodifica</option>
          </optgroup>
        </select>
        </div>
      </div>
      <div class="row">
        <div class="col">
          <label class="lbl" for="cvCrf">Qualit&agrave;</label>
        <select id="cvCrf" class="lockable">
          <option value="15">Massima (file grande)</option>
          <option value="24" selected>Alta</option>
          <option value="31">Bilanciata</option>
          <option value="38">Leggera (web)</option>
        </select>
        </div>
        <div class="col">
          <label class="lbl" for="cvSpeed">Velocit&agrave;</label>
        <select id="cvSpeed" class="lockable">
          <option value="4">Veloce</option>
          <option value="2" selected>Bilanciata</option>
          <option value="1">Lenta (qualit&agrave; migliore)</option>
        </select>
        </div>
        <div class="col">
          <label class="lbl" for="cvRes">Risoluzione</label>
        <select id="cvRes" class="lockable">
          <option value="orig">Originale</option>
          <option value="2160">Max 4K</option>
          <option value="1440">Max 1440p</option>
          <option value="1080">Max 1080p</option>
          <option value="720">Max 720p</option>
          <option value="480">Max 480p</option>
        </select>
        </div>
      </div>
      <div class="row">
        <div class="col">
          <label class="lbl" for="cvFps">FPS</label>
        <select id="cvFps" class="lockable">
          <option value="orig">Originali</option>
          <option value="60">60</option>
          <option value="30">30</option>
          <option value="25">25</option>
          <option value="24">24</option>
        </select>
        </div>
        <div class="col">
          <label class="lbl" for="cvAudio">Audio</label>
          <select id="cvAudio" class="lockable"></select>
        </div>
        <div class="col">
          <label class="lbl" for="cvSeqFps">FPS delle sequenze</label>
          <select id="cvSeqFps" class="lockable" onchange="cvSeqFpsChanged()">
            <option value="23.976">23,976</option><option value="24">24</option><option value="25" selected>25</option>
            <option value="29.97">29,97</option><option value="30">30</option><option value="50">50</option><option value="60">60</option>
          </select>
        </div>
      </div>
      <div class="checks" style="margin-top:6px">
        <label style="width:100%"><input type="checkbox" id="cvAllTracks" class="lockable" checked>Tutte le tracce audio (non solo la prima), canali originali</label>
      </div>
    </div>
    <div id="cvPaneAlpha" class="pane" style="display:none">
      <div class="checks" style="margin-top:8px">
        <label style="width:100%"><input type="checkbox" id="cvAlphaForce" class="lockable" onchange="cvCheck()"><b>Forza il canale alfa</b> anche sui video opachi (di solito non serve)</label>
        <label style="width:100%"><input type="checkbox" id="cvPremult" class="lockable" onchange="cvCheck()">Alfa premoltiplicato (MOV da After Effects/Premiere &laquo;Premoltiplicato&raquo;: toglie l'alone scuro sui bordi)</label>
      </div>
    <div class="row">
      <div class="col">
        <label class="lbl" for="cvKey">Sfondo da rendere trasparente</label>
        <div class="keyrow">
          <select id="cvKey" class="lockable" onchange="cvCheck()">
            <option value="none">Nessuno (mantieni l'originale)</option>
            <option value="green">Verde (green screen)</option>
            <option value="blue">Blu (blue screen)</option>
            <option value="black">Nero</option>
            <option value="white">Bianco</option>
            <option value="custom">Colore personalizzato</option>
          </select>
          <div id="cvSwatch" class="swatch" style="display:none"></div>
        </div>
      </div>
      <div class="col" id="cvKeyColorCol" style="display:none;flex:0 0 120px">
        <label class="lbl" for="cvKeyColor">Colore (#RRGGBB)</label>
        <input id="cvKeyColor" class="inp lockable" type="text" value="#00FF00" maxlength="7" onchange="cvCheck()" onkeyup="cvCheck()">
      </div>
      <div class="col" id="cvTolCol" style="display:none;flex:0 0 130px">
        <label class="lbl" for="cvTol">Tolleranza</label>
        <select id="cvTol" class="lockable">
          <option value="0.10">Bassa</option>
          <option value="0.18" selected>Media</option>
          <option value="0.28">Alta</option>
        </select>
      </div>
    </div>
    </div>
    <div id="cvPaneEdit" class="pane" style="display:none">
      <div class="row" style="margin-top:8px">
        <div class="col">
          <label class="lbl" for="cvFrom">Taglia da</label>
          <input id="cvFrom" class="inp lockable" type="text" placeholder="inizio (es. 0:02.5)" onchange="cvCheck()" onkeyup="cvCheck()">
        </div>
        <div class="col">
          <label class="lbl" for="cvTo">a</label>
          <input id="cvTo" class="inp lockable" type="text" placeholder="fine (es. 0:10)" onchange="cvCheck()" onkeyup="cvCheck()">
        </div>
        <div class="col">
          <label class="lbl" for="cvLoop">Ripetizioni</label>
          <select id="cvLoop" class="lockable" onchange="cvCheck()">
            <option value="1">1 volta</option><option value="2">2 volte</option><option value="3">3 volte</option><option value="4">4 volte</option><option value="5">5 volte</option><option value="10">10 volte</option>
          </select>
        </div>
      </div>
      <div class="checks" style="margin-top:6px">
        <label style="width:100%"><input type="checkbox" id="cvBounce" class="lockable" onchange="cvCheck()"><b>Avanti-indietro</b> (boomerang: la clip torna al punto di partenza, ideale per i loop)</label>
      </div>
      <div class="row">
        <div class="col">
          <label class="lbl" for="cvCanvas">Tela</label>
          <select id="cvCanvas" class="lockable" onchange="cvCheck()">
            <option value="">Nessuna (misura del video)</option>
            <option value="1920x1080">1920&times;1080 orizzontale</option>
            <option value="1080x1920">1080&times;1920 verticale (storie)</option>
            <option value="1080x1080">1080&times;1080 quadrato</option>
            <option value="1080x1350">1080&times;1350 post 4:5</option>
            <option value="3840x2160">3840&times;2160 4K</option>
            <option value="1280x720">1280&times;720</option>
            <option value="custom">Personalizzata&hellip;</option>
          </select>
        </div>
        <div class="col" id="cvCanvasWHCol" style="display:none;flex:0 0 112px">
          <label class="lbl" for="cvCanvasW">Larg &times; Alt</label>
          <div class="addrow"><input id="cvCanvasW" class="inp lockable" type="text" maxlength="5" value="1920" style="padding:0 4px;text-align:center" onkeyup="cvCheck()"><input id="cvCanvasH" class="inp lockable" type="text" maxlength="5" value="1080" style="padding:0 4px;text-align:center;margin-left:4px" onkeyup="cvCheck()"></div>
        </div>
        <div class="col">
          <label class="lbl" for="cvCanvasMode">Adattamento</label>
          <select id="cvCanvasMode" class="lockable" onchange="cvCheck()">
            <option value="fit">Intero, bordi trasparenti</option>
            <option value="fill">Riempi, ritaglia i bordi</option>
          </select>
        </div>
      </div>
      <div class="row">
        <div class="col">
          <label class="lbl" for="cvLoud">Volume (normalizzazione)</label>
          <select id="cvLoud" class="lockable">
            <option value="">Originale</option>
            <option value="-14">-14 LUFS (YouTube, Spotify, social)</option>
            <option value="-16">-16 LUFS (podcast, web)</option>
            <option value="-23">-23 LUFS (EBU R128, TV)</option>
          </select>
        </div>
      </div>
    </div>
    <div id="cvOkLine" class="okline">I file gi&agrave; trasparenti (ProRes 4444, Animazione, PNG, GIF, WebM con alfa) mantengono SEMPRE la trasparenza.</div>
    <div id="cvAlphaWarn" class="warn"></div>
  </div>
  </div>
  </div>

  <div id="status" class="status" style="margin:0 0 10px">
    <div id="overall" class="overall"></div>
    <div class="bar"><div id="fill" class="fill"></div></div>
    <div class="meta"><span id="pct"></span><span id="spd"></span></div>
    <div id="file" class="file"></div>
  </div>
  <div id="msg" class="msg" style="margin:0 0 14px"></div>

  <div class="hazard"></div>
  <div class="foot">
    <button class="btn sm" onclick="openFolder()">Apri cartella</button>
    <button id="compBtn" class="btn sm lockable" onclick="installComponents()">Installa / aggiorna componenti</button>
    <button class="btn sm" onclick="debugReport()">Report debug</button>
    <button class="btn sm" onclick="extInstall()" title="Installa l'estensione che manda qui i link delle schede aperte">Estensione Chrome</button>
    <span class="credit">DownConvertron v7.0 &middot; designed by <b>Welsho</b></span>
  </div>
    </div>
  </div>
  <div class="bottom">
