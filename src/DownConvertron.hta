.vn/(?:(?:pgr|cgr))/[^/?#]+/(?:\\\\w+)(?:\\\\.html|\\\\?))\",\"\"],[\"zingmp3\",\"^(?:https?://(?:mp3\\\\.zing|zingmp3)\\\\.vn/(?:(?:cgr|top-podcast|podcast-new))/?(?:[#?]|$))\",\"\"],[\"zingmp3\",\"^(?:https?://(?:mp3\\\\.zing|zingmp3)\\\\.vn/(?:[^/]+)/(?:bai-hat|single|album|video|song)/?(?:[?#]|$))\",\"\"],[\"zingmp3\",\"^(?:https?://(?:mp3\\\\.zing|zingmp3)\\\\.vn/(?:(?:zing-chart-tuan))/[^/?#]+/(?:\\\\w+)(?:\\\\.html|\\\\?))\",\"\"],[\"zoom\",\"^(?:https?://(?:[^.]+\\\\.)?zoom\\\\.us/clips/share/(?:[\\\\w.-]+))\",\"\"],[\"zoom\",\"^(?:(?:https?://(?:[^.]+\\\\.)?zoom\\\\.us/)rec(?:ording)?/(?:play|share)/(?:[\\\\w.-]+))\",\"\"],[\"Zype\",\"^(?:https?://player\\\\.zype\\\\.com/embed/(?:[\\\\da-fA-F]+)\\\\.(?:js|json|html)\\\\?.*?(?:access_token|(?:ap[ip]|player)_key)=[^&]+)\",\"\"]];\n","testi.js":"/* DownConvertron - testi dell'estensione (generato da tools/ext_texts.py). Copyright (C) 2026 Daniele Moretti (Welsho) - GPL-3.0-or-later */\nvar DCVT_TESTI = {\n\"it\": {\n\"apri\": \"Apri DownConvertron\",\n\"comeScaricare\": \"Video e audio: come scaricarli\",\n\"mApp\": \"Come nell'app\",\n\"mVideo\": \"Video\",\n\"mAudio\": \"Solo audio\",\n\"qualita\": \"Qualit\\u00e0\",\n\"qBest\": \"Massima\",\n\"file\": \"File\",\n\"cMov\": \"MOV (montaggio)\",\n\"formato\": \"Formato\",\n\"aMp3\": \"MP3 320 kbps\",\n\"aMp3v\": \"MP3 qualit\\u00e0 alta (VBR)\",\n\"aM4a\": \"M4A AAC 256 kbps\",\n\"aWav\": \"WAV 16 bit (montaggio)\",\n\"aFlac\": \"FLAC senza perdita\",\n\"notaApp\": \"Usa formato e qualit\\u00e0 gi\\u00e0 scelti in DownConvertron.\",\n\"tutteFinestre\": \"Tutte le finestre\",\n\"usaTitoli\": \"Titolo della scheda come nome file\",\n\"apriDopo\": \"Apri DownConvertron dopo l'invio\",\n\"schede\": \"Schede aperte\",\n\"pagina\": \"Link nella pagina\",\n\"tuttiNessuno\": \"Tutti / nessuno\",\n\"nessunaScheda\": \"Nessuna scheda di un sito supportato.\",\n\"nessunLink\": \"Nessun link di un sito supportato in questa pagina.\",\n\"trovati\": \"{0} link trovati \\u00b7 {1} siti conosciuti\",\n\"invia\": \"Metti in lista ({0})\",\n\"avvia\": \"Scarica subito ({0})\",\n\"nessunoScelto\": \"Nessun link scelto\",\n\"notaInizio\": \"\\u00abMetti in lista\\u00bb manda i link a DownConvertron e il download lo avvii tu; con Video o Solo audio, \\u00abScarica subito\\u00bb lo fa partire da solo.\",\n\"inviati\": \"{0} link mandati a DownConvertron ({1}). Controlla la lista e premi Scarica.\",\n\"avviati\": \"{0} link mandati a DownConvertron ({1}): il download parte da solo.\",\n\"erroreAppunti\": \"Non riesco a scrivere negli appunti: {0}\",\n\"apertura\": \"Apro DownConvertron...\",\n\"aperturaProto\": \"Apro DownConvertron... Chrome pu\\u00f2 chiederti il permesso: scegli \\u00abApri\\u00bb (e \\u00absempre\\u00bb per non vederlo pi\\u00f9). Se non si apre, apri una volta DownConvertron a mano: poi il logo la apre e la porta davanti.\",\n\"logAperto\": \"popup aperto: {0} schede, {1} link nella pagina\",\n\"logInviati\": \"inviati {0} link, modalit\\u00e0 {1}\",\n\"logPagina\": \"pagina protetta, link della pagina non letti: {0}\",\n\"logApri\": \"richiesta apertura app\",\n\"logAvviata\": \"app aperta dal ponte\",\n\"logDavanti\": \"app gi\\u00e0 aperta: portata in primo piano\",\n\"logNonDavanti\": \"Windows non l'ha messa in primo piano\",\n\"logRiserva\": \"ponte non disponibile ({0}): uso il collegamento downconvertron://\",\n\"immagini\": \"Immagini nella pagina\",\n\"nessunaImg\": \"Nessuna immagine grande in questa pagina.\",\n\"salvaDownload\": \"Salva nei Download\",\n\"nomeImg\": \"immagine\",\n\"fmtImg\": \"Formato nell'app\",\n\"fmtImgTt\": \"Formato delle immagini inviate all'app (separato dal video). \\u00abSalva nei Download\\u00bb salva sempre il file originale.\",\n\"fOrig\": \"Originale\",\n\"fJpg\": \"JPG (trasparenza su bianco)\",\n\"nonImmagine\": \"non \\u00e8 un'immagine (pagina web)\",\n\"nonRiuscite\": \"{0} non riuscite: {1}\",\n\"kCanale\": \"canale\",\n\"kDiretta\": \"diretta\",\n\"kPagina\": \"pagina\",\n\"avvisoSchede\": \"{0} schede non sono un video singolo (canale, diretta o pagina del sito) e partono non spuntate: un canale scarica tutti i suoi video, una diretta registra finch\\u00e9 non la fermi.\",\n\"avvisoImmagini\": \"Mostrate le prime {0} di {1} immagini.\",\n\"img\": \"Immagine\",\n\"scaricate\": \"{0} immagini in download nella cartella Download/DownConvertron.\",\n\"logScaricate\": \"download rapido di {0} immagini\",\n\"usaLogin\": \"Usa il mio login\",\n\"usaLoginTt\": \"Per i video con limite di et\\u00e0, privati o per abbonati: con l'interruttore acceso, a ogni invio l'estensione passa all'app i cookie di Chrome dei siti inviati. L'app li usa solo se il sito chiede l'accesso e li cancella a fine lavoro. Acceso di base.\",\n\"loginNegato\": \"Permesso dei cookie mancante: in chrome://extensions ricarica l'estensione DownConvertron (\\u21bb). I link partono senza login.\",\n\"loginNessuno\": \"nessun login di Chrome per questi siti\",\n\"loginInviato\": \"login di Chrome passato all'app per {0} siti ({1} cookie)\",\n\"loginNoApp\": \"Login non passato: apri una volta DownConvertron 7.0 (registra il ponte con Chrome), poi rimanda. Dettaglio: {0}\",\n\"loginServe\": \"{0} link chiedono l'accesso al sito (limite di et\\u00e0, privati o per abbonati)\",\n\"loginServeNota\": \"Entra nel sito con Chrome, poi premi il pulsante: passo all'app il tuo login di Chrome solo per questi link e l'app lo cancella a fine lavoro.\",\n\"loginRiprova\": \"Riprova con il mio login\",\n\"loginRiprovato\": \"{0} link rimandati all'app con il tuo login di Chrome: il download riparte da solo.\",\n\"loginNessunoNota\": \"Chrome non ha un login per questi siti: entra nel sito con Chrome, poi riprova.\",\n\"conLogin\": \" (con login)\",\n\"erroreDownload\": \"Download non riuscito: {0}\"\n},\n\"en\": {\n\"apri\": \"Open DownConvertron\",\n\"comeScaricare\": \"Video and audio: how to download\",\n\"mApp\": \"As in the app\",\n\"mVideo\": \"Video\",\n\"mAudio\": \"Audio only\",\n\"qualita\": \"Quality\",\n\"qBest\": \"Best\",\n\"file\": \"File\",\n\"cMov\": \"MOV (editing)\",\n\"formato\": \"Format\",\n\"aMp3\": \"MP3 320 kbps\",\n\"aMp3v\": \"MP3 high quality (VBR)\",\n\"aM4a\": \"M4A AAC 256 kbps\",\n\"aWav\": \"WAV 16-bit (editing)\",\n\"aFlac\": \"FLAC lossless\",\n\"notaApp\": \"Uses the format and quality already set in DownConvertron.\",\n\"tutteFinestre\": \"All windows\",\n\"usaTitoli\": \"Tab title as file name\",\n\"apriDopo\": \"Open DownConvertron after sending\",\n\"schede\": \"Open tabs\",\n\"pagina\": \"Links on this page\",\n\"tuttiNessuno\": \"All / none\",\n\"nessunaScheda\": \"No tab from a supported site.\",\n\"nessunLink\": \"No links to supported sites on this page.\",\n\"trovati\": \"{0} links found \\u00b7 {1} known sites\",\n\"invia\": \"Add to list ({0})\",\n\"avvia\": \"Download now ({0})\",\n\"nessunoScelto\": \"No link selected\",\n\"notaInizio\": \"\\u201cAdd to list\\u201d sends the links to DownConvertron and you start the download; with Video or Audio only, \\u201cDownload now\\u201d starts it by itself.\",\n\"inviati\": \"{0} links sent to DownConvertron ({1}). Check the list and press Download.\",\n\"avviati\": \"{0} links sent to DownConvertron ({1}): the download starts by itself.\",\n\"erroreAppunti\": \"Cannot write to the clipboard: {0}\",\n\"apertura\": \"Opening DownConvertron...\",\n\"aperturaProto\": \"Opening DownConvertron... Chrome may ask for permission: choose \\u201cOpen\\u201d (and \\u201calways\\u201d to skip it next time). If it does not open, open DownConvertron once by hand: then the logo opens it and brings it to the front.\",\n\"logAperto\": \"popup opened: {0} tabs, {1} links on the page\",\n\"logInviati\": \"sent {0} links, mode {1}\",\n\"logPagina\": \"protected page, page links not read: {0}\",\n\"logApri\": \"app open requested\",\n\"logAvviata\": \"app opened by the bridge\",\n\"logDavanti\": \"app already open: brought to the front\",\n\"logNonDavanti\": \"Windows did not bring it to the front\",\n\"logRiserva\": \"bridge not available ({0}): using the downconvertron:// link\",\n\"immagini\": \"Images on this page\",\n\"nessunaImg\": \"No large images on this page.\",\n\"salvaDownload\": \"Save to Downloads\",\n\"nomeImg\": \"image\",\n\"fmtImg\": \"Format in the app\",\n\"fmtImgTt\": \"Format of the images sent to the app (separate from video). \\u00abSave to Downloads\\u00bb always saves the original file.\",\n\"fOrig\": \"Original\",\n\"fJpg\": \"JPG (transparency on white)\",\n\"nonImmagine\": \"not an image (web page)\",\n\"nonRiuscite\": \"{0} failed: {1}\",\n\"kCanale\": \"channel\",\n\"kDiretta\": \"live\",\n\"kPagina\": \"page\",\n\"avvisoSchede\": \"{0} tabs are not a single video (channel, live stream or site page) and start unchecked: a channel downloads all its videos, a live stream records until you stop it.\",\n\"avvisoImmagini\": \"Showing the first {0} of {1} images.\",\n\"img\": \"Image\",\n\"scaricate\": \"{0} images downloading to the Downloads/DownConvertron folder.\",\n\"logScaricate\": \"quick download of {0} images\",\n\"usaLogin\": \"Use my login\",\n\"usaLoginTt\": \"For age-restricted, private or members-only videos: when on, each time you send links the extension gives the app the Chrome cookies of those sites. The app uses them only if the site asks you to sign in and deletes them when the job ends. On by default.\",\n\"loginNegato\": \"Cookie permission missing: reload the DownConvertron extension in chrome://extensions (\\u21bb). Links are sent without login.\",\n\"loginNessuno\": \"no Chrome login for these sites\",\n\"loginInviato\": \"Chrome login passed to the app for {0} sites ({1} cookies)\",\n\"loginNoApp\": \"Login not passed: open DownConvertron 7.0 once (it registers the bridge with Chrome), then send again. Details: {0}\",\n\"loginServe\": \"{0} links require signing in to the site (age-restricted, private or members-only)\",\n\"loginServeNota\": \"Sign in to the site in Chrome, then press the