/* EXT_FILES_FINE */
var EXT_MARK = "#DCVT-LINKS", EXT_MARK_OLD = "#DLTFM-LINKS v1";   /* il vecchio formato della 5.0 resta accettato */
function extDir() { return DIR_APP + "\\chrome-extension"; }
/* scrive un file binario (icone) dal base64: PowerShell su Windows, Node sul Mac */
function extWriteBinary(path, b64) {
  /* veloce: decodifica con MSXML e scrittura con ADODB (niente PowerShell); se non va, PowerShell */
  try {
    var xd = new ActiveXObject("MSXML2.DOMDocument"), el = xd.createElement("b");
    el.dataType = "bin.base64"; el.text = b64;
    var st = new ActiveXObject("ADODB.Stream");
    st.Type = 1; st.Open(); st.Write(el.nodeTypedValue); st.SaveToFile(path, 2); st.Close();
    if (fso.FileExists(path)) return;
  } catch (e0) {}
  var tmp = DIR_TMP + "\\b64_" + newToken() + ".txt", ps = SYSDIR + "\\WindowsPowerShell\\v1.0\\powershell.exe";
  writeAscii(tmp, b64);
  try { sh.Run('"' + ps + '" -NoProfile -WindowStyle Hidden -Command "[IO.File]::WriteAllBytes(\'' + path.replace(/'/g, "''") + '\', [Convert]::FromBase64String([IO.File]::ReadAllText(\'' + tmp.replace(/'/g, "''") + '\')))"', 0, true); } catch (e) {}
  tryDelete(tmp);
}
function extWriteFiles() {
  var d = extDir(), n, ok = 0;
  ensureDir(DIR_APP); ensureDir(d); ensureDir(DIR_TMP);
  for (n in EXT_FILES) if (EXT_FILES.hasOwnProperty(n)) {
    var v = EXT_FILES[n];
    if (v.indexOf("b64:") === 0) extWriteBinary(d + "\\" + n, v.substring(4)); else writeAscii(d + "\\" + n, v);
    if (fso.FileExists(d + "\\" + n)) ok++;
  }
  extWriteLang();
  return ok;
}
/* ---------- stato dell'estensione Chrome (spia COMPONENTI) ----------
   1. la cartella dell'estensione e' sempre pronta e alla versione dell'app (anche usando solo l'HTA)
   2. installata davvero? Chrome scrive il percorso delle estensioni caricate nelle preferenze di ogni
      profilo (Preferences / Secure Preferences): le leggo, senza modificarle */
var EXTCHK = { st: "", at: 0, ver: "", prof: "" };
function chromeUserData() {
  return window.DCVT_MAC ? env("%USERPROFILE%") + "/Library/Application Support/Google/Chrome" : env("%LOCALAPPDATA%") + "\\Google\\Chrome\\User Data";
}
function extFolderVersion() {
  try { var m = /"version"\s*:\s*"([\d.]+)"/.exec(readUtf8(extDir() + "\\manifest.json")); return m ? m[1] : ""; } catch (e) { return ""; }
}
/* file della cartella diversi da quelli dentro l'app (lingua.js no: dipende dalla lingua scelta) */
function extFilesStale() {
  var d = extDir(), n;
  for (n in EXT_FILES) if (EXT_FILES.hasOwnProperty(n)) {
    if (n === "lingua.js") continue;
    if (!fso.FileExists(d + "\\" + n)) return true;
    if (EXT_FILES[n].indexOf("b64:") !== 0) { try { if (readUtf8(d + "\\" + n) !== EXT_FILES[n]) return true; } catch (e) { return true; } }
  }
  return false;
}
function extPrepare() {
  var v = extFolderVersion();
  if (v === APP_VER && !extFilesStale()) return true;
  try {
    var n = extWriteFiles();
    logEvent("app", v === APP_VER ? T("Cartella dell'estensione Chrome aggiornata con i file nuovi di questa versione: ricaricala in Chrome (spia COMPONENTI).")
      : v ? T("Cartella dell'estensione Chrome aggiornata alla {0} (era {1}).", APP_VER, v) : T("Cartella dell'estensione Chrome pronta: {0}", extDir()));
    return n > 0;
  } catch (e) { DEBUG_ERRORS.push("extPrepare: " + (e.message || e)); return false; }
}
function extCheck(force) {
  var now = new Date().getTime();
  if (!force && now - EXTCHK.at < 20000) return;
  EXTCHK.at = now; EXTCHK.prof = "";
  var ud = chromeUserData(), prev = EXTCHK.st;
  try {
    if (!fso.FolderExists(ud)) EXTCHK.st = "nochrome";
    else {
      EXTCHK.ver = extFolderVersion();
      var needle = extDir().toLowerCase().replace(/\\/g, "\\\\"), found = "", idOk = false, e = new Enumerator(fso.GetFolder(ud).SubFolders);
      /* tutti i profili: basta che uno abbia l'estensione con l'ID di questa versione (dalla chiave del manifest) */
      for (; !e.atEnd() && !idOk; e.moveNext()) {
        var nm = e.item().Name;
        if (nm !== "Default" && !/^Profile \d+$/.test(nm)) continue;
        var fl = ["Secure Preferences", "Preferences"];
        for (var i = 0; i < fl.length && !idOk; i++) {
          var f = ud + "\\" + nm + "\\" + fl[i];
          try {
            if (!fso.FileExists(f)) continue;
            var txt = readUtf8(f).toLowerCase();
            if (txt.indexOf(needle) >= 0) { if (!found) found = nm; var ix = txt.indexOf('"' + EXT_ID + '"'), blk = ix >= 0 ? txt.substring(ix, ix + 30000) : "";
              /* manifest di questa versione: ponte e cookie sono permessi fissi (prima i cookie erano facoltativi) */
              if (blk.indexOf('"nativemessaging"') >= 0 && blk.indexOf('"cookies"') >= 0) { idOk = true; found = nm; } }
          } catch (x) {}
        }
      }
      EXTCHK.prof = found;
      EXTCHK.st = !found ? "missing" : (EXTCHK.ver !== APP_VER || !idOk ? "old" : "ok");
    }
  } catch (e2) { EXTCHK.st = "missing"; DEBUG_ERRORS.push("extCheck: " + (e2.message || e2)); }
  if (prev !== EXTCHK.st) try { sysRender(); } catch (e3) {}
}
/* l'estensione parla la lingua dell'app: lingua.js viene riscritto anche quando cambi lingua */
function extWriteLang() {
  try { if (fso.FolderExists(extDir())) writeAscii(extDir() + "\\lingua.js", "/* scritto da DownConvertron */\nvar DCVT_LANG = \"" + LANG + "\";\n"); } catch (e) {}
}
/* apre la pagina Estensioni di Chrome (se Chrome e' installato) */
/* Chrome non apre gli indirizzi chrome:// passati da un altro programma (per sicurezza mostra solo
   una scheda vuota). Allora: apro una finestra nuova su una paginetta locale con un titolo unico,
   la porto in primo piano (solo lei, per titolo: le altre schede non vengono toccate) e scrivo
   l'indirizzo nella barra come faresti tu. Se non riesce, la paginetta spiega cosa scrivere. */
var EXT_URL = "chrome://extensions/", EXT_TITLE = "DCVT-ESTENSIONE", EXT_GO = { tries: 0 };
function extChromeExe() {
  var c = [env("%ProgramW6432%") + "\\Google\\Chrome\\Application\\chrome.exe", progFiles() + "\\Google\\Chrome\\Application\\chrome.exe",
           env("%ProgramFiles(x86)%") + "\\Google\\Chrome\\Application\\chrome.exe", env("%LOCALAPPDATA%") + "\\Google\\Chrome\\Application\\chrome.exe"], i;
  for (i = 0; i < c.length; i++) { try { if (fso.FileExists(c[i])) return c[i]; } catch (e) {} }
  return "";
}
function extOpenChrome() {
  var exe = extChromeExe();
  if (!exe) return false;
  var page = DIR_APP + "\\apri-estensioni.html";
  try {
    writeAscii(page, "<!DOCTYPE html><html><head><meta charset='utf-8'><title>" + EXT_TITLE + "</title></head>" +
      "<body style='background:#0d1013;color:#c8ffd6;font:16px Segoe UI,Arial,sans-serif;padding:40px'>" +
      "<h2 style='color:#39ff6a'>DownConvertron - estensione Chrome</h2>" +
      "<p>Sto aprendo la pagina <b>Estensioni</b>... Se tra un secondo sei ancora qui, clicca nella barra degli indirizzi, scrivi " +
      "<b style='color:#f2c230'>chrome://extensions</b> e premi Invio.</p></body></html>");
    sh.Run('"' + exe + '" --new-window "' + page + '"', 1, false);
  } catch (e) { return false; }
  EXT_GO.tries = 0;
  setTimeout(extGoExtensions, 1200);
  return true;
}
function extGoExtensions() {
  var ok = false;
  try { ok = sh.AppActivate(EXT_TITLE); } catch (e) {}
  if (!ok) { if (++EXT_GO.tries < 10) setTimeout(extGoExtensions, 500); else extOpenFolder(); return; }
  setTimeout(function () {
    /* i tasti vanno alla finestra in primo piano: se e' ancora l'app, non scrivo niente (resta la paginetta con le istruzioni) */
    var mine = false;
    try { mine = document.hasFocus ? document.hasFocus() : false; } catch (x) {}
    try { if (!mine && sh.AppActivate(EXT_TITLE)) { sh.SendKeys("^l"); sh.SendKeys(EXT_URL + "{DEL}{ENTER}"); } else if (mine) DEBUG_ERRORS.push("estensione: Chrome non in primo piano, pagina Estensioni da aprire a mano"); } catch (e) { DEBUG_ERRORS.push("estensione: " + (e.message || e)); }
    setTimeout(extOpenFolder, 900);          /* la cartella da trascinare arriva dopo, accanto a Chrome */
  }, 400);
}
function extOpenFolder() {
  try { window.clipboardData.setData("Text", extDir()); } catch (e) {}   /* pronto per «Carica estensione non pacchettizzata» */
  revealInFolder(extDir());
}
/* apre la cartella che contiene p con p gia' selezionata (da trascinare intera). Sul Mac: mac.js */
function revealInFolder(p) {
  try { sh.Run('"' + EXE_EXPLORER + '" /select,"' + p + '"', 1, false); }
  catch (e) { try { sh.Run('"' + EXE_EXPLORER + '" "' + fso.GetParentFolderName(p) + '"', 1, false); } catch (e2) {} }
}
function extInstall() {
  var n = 0, tot = 0, k;
  for (k in EXT_FILES) if (EXT_FILES.hasOwnProperty(k)) tot++;
  try { n = extWriteFiles(); } catch (e) { showMsg("Impossibile preparare l'estensione: " + (e.message || e), "err"); return; }
  if (n < tot) { showMsg("Estensione preparata solo in parte (" + n + " di " + tot + " file) in " + extDir() + ". Premi «Report debug».", "err"); return; }
  var chrome = extOpenChrome();
  if (!chrome) extOpenFolder();
  /* testi in frasi intere (anche con un po' di HTML), cosi' si traducono bene */
  infoShow("Estensione Chrome",
    T("<b>Una volta sola</b>, nella pagina <b>Estensioni</b> di Chrome") + " " +
    (chrome ? (window.DCVT_MAC ? T("(si apre da sola; la prima volta il Mac chiede il permesso di controllare Chrome: premi OK)")
                               : T("(si apre da sola tra un istante; se non compare scrivi <b>chrome://extensions</b> nella barra degli indirizzi)"))
            : T("(Chrome non trovato: aprilo e scrivi <b>chrome://extensions</b> nella barra degli indirizzi)")) + ":" +
    "<ol><li>" + T("attiva <b>Modalit&agrave; sviluppatore</b> in alto a destra;") + "</li>" +
    "<li>" + T("trascina dentro la pagina la cartella <b>chrome-extension</b> (si apre accanto la cartella che la contiene, con <b>chrome-extension</b> gi&agrave; selezionata: trascinala intera, senza entrarci), oppure premi <b>Carica estensione non pacchettizzata</b>: il percorso &egrave; gi&agrave; negli appunti:") + " " +
    (window.DCVT_MAC ? T("premi Cmd+Shift+G, incolla con Cmd+V, Invio, poi <b>Seleziona</b>:") : T("incollalo con Ctrl+V nella barra in alto, Invio, poi <b>Seleziona cartella</b>:")) +
    "<div class='path' id='extPath'></div></li>" +
    "<li>" + T("fissa l'icona: pezzo di puzzle in alto a destra &rarr; puntina accanto a <b>DownConvertron</b>.") + "</li></ol>" +
    (EXTCHK.st === "old" ? "<p>" + T("<b>Hai gi&agrave; una DownConvertron in Chrome:</b> prima premi <b>Rimuovi</b> su quella vecchia, poi caricala di nuovo come sopra. Questa versione ha un nuovo identificativo (serve a «Usa il mio login»).") + "</p>" : "") +
    T("<b>Come si usa:</b> clicca l'icona, scegli <b>Video</b> o <b>Solo audio</b> (o lascia le impostazioni dell'app), spunta i link e premi <b>Metti in lista</b> (li scarichi qui con <b>Scarica</b>) oppure, con Video o Solo audio, <b>Scarica subito</b> (il download parte da solo). Il logo dell'estensione apre DownConvertron.") + " " +
    T("L'estensione riconosce gli oltre 1.700 siti di yt-dlp; legge le schede solo quando la apri e non invia nulla in rete.") +
    "<div style='margin-top:10px'><button class='btn sm' onclick='extCopyPath()'>" + T("Copia il percorso della cartella") + "</button></div>");
  $("extPath").innerText = extDir();
}
function extCopyPath() { try { window.clipboardData.setData("Text", extDir()); showMsg("Percorso copiato: incollalo nella finestra di Chrome.", "ok"); } catch (e) {} }
function infoShow(title, html) { $("infoTitle").innerText = TX(title); $("infoBody").innerHTML = html; $("infoBox").style.display = "block"; }
function infoClose() { $("infoBox").style.display = "none"; }
/* ---------- estensione Chrome: ricezione (formato v2) ----------
   Le righe che iniziano con # sono intestazioni: versione e lingua dell'estensione, modalita' scelta
   nella mini interfaccia (video / solo audio / come nell'app), qualita', file, e il registro dell'estensione.
   Il resto sono link (eventualmente "link | nome file"). L'app mette i link in lista e applica le
   impostazioni: il download lo avvii tu con Scarica. */
var EXTST = { lastAt: "", ver: "", pending: [], taken: "" };   /* pending: invii presi dagli appunti e non ancora aggiunti */
var EXT_VIDEO_Q = { best: 1, "4320": 1, "2160": 1, "1440": 1, "1080": 1, "720": 1, "480": 1, "360": 1 };
var EXT_CONT = { mp4: 1, mkv: 1, webm: 1, mov: 1 };
var EXT_AUDIO = { mp3: 1, m4a: 1, opus: 1, wav: 1, flac: 1, best: 1 };
/* "7.0" < "10.0" come numeri, non come testo */
function verLess(a, b) {
  var x = String(a).split("."), y = String(b).split("."), i;
  for (i = 0; i < Math.max(x.length, y.length); i++) { var p = parseInt(x[i], 10) || 0, q = parseInt(y[i], 10) || 0; if (p !== q) return p < q; }
  return false;
}
function extPoll() {
  try { ckTick(); } catch (eck) {}
  var t = "";
  try { t = window.clipboardData.getData("Text") || ""; } catch (e) { t = ""; }
  var mark = t.indexOf(EXT_MARK) === 0 ? EXT_MARK : (t.indexOf(EXT_MARK_OLD) === 0 ? EXT_MARK_OLD : "");
  /* appunti occupati: se setData non riesce, il prossimo controllo ritrova lo stesso testo e non va rimesso in coda */
  var again = mark && t === EXTST.taken;
  if (!mark) EXTST.taken = "";
  if (mark) {
    /* preso SUBITO dagli appunti, anche durante un download: se poi l'utente copia altro, l'invio non si perde */
    if (!again) { EXTST.taken = t; EXTST.pending.push(t); }
    var plain = t.substring(mark.length).split(/\r?\n/), keep = [], k;
    for (k = 1; k < plain.length; k++) { var pl = plain[k].replace(/^#img=/, ""); if (/\S/.test(pl) && !/^#\w+=/.test(pl)) keep.push(pl); }
    try { window.clipboardData.setData("Text", keep.join("\r\n")); } catch (e2) {}   /* niente doppioni: tolgo marcatura e intestazioni (riprova se prima non e' riuscito) */
    if (state.busy && !again) logEvent("ext", T("Link ricevuti dall'estensione Chrome: li aggiungo appena finisce il lavoro in corso."), "info", true);
  }
  if (state.busy || !EXTST.pending.length) return;
  t = EXTST.pending.shift();
  mark = t.indexOf(EXT_MARK) === 0 ? EXT_MARK : EXT_MARK_OLD;
  var rest = t.substring(mark.length), lines = rest.split(/\r?\n/), head = {}, logs = [], links = [], imgs = [], i, m;
  for (i = 1; i < lines.length; i++) {                     /* la riga 0 e' il resto della marcatura ("v2") */
    var l = lines[i];
    if ((m = /^#(\w+)=(.*)$/.exec(l))) {
      if (m[1] === "log") logs.push(m[2]);
      else if (m[1] === "img") imgs.push(m[2]);            /* immagine scelta nell'estensione (anche senza estensione nell'URL) */
      else head[m[1]] = m[2];
    }
    else if (/\S/.test(l)) links.push(l);
  }
  EXTST.lastAt = logTime().substring(0, 5); EXTST.ver = head.ext || (mark === EXT_MARK_OLD ? "5.0" : "?");
  for (i = 0; i < logs.length; i++) logEvent("ext", logs[i]);
  if (state.tab !== "dl") showTab("dl");
  /* link e immagini in un colpo solo, UN messaggio di riepilogo (prima: un messaggio per gruppo, anche come falso errore) */
  EXT_CK = /^[a-z0-9]{16,64}$/.test(head.cookies || "") ? head.cookies : "";
  if (EXT_CK && !fso.FileExists(ckDir() + (window.DCVT_MAC ? "/" : "\\") + EXT_CK + ".txt")) { logEvent("ext", T("Login dell'estensione non trovato: i link si scaricano senza."), "warn"); EXT_CK = ""; }
  else if (EXT_CK && head.login === "retry") logEvent("ext", T("Riprova con il login di Chrome: lo uso subito per questi link, poi lo cancello."));
  else if (EXT_CK) logEvent("ext", T("Login di Chrome ricevuto: lo uso solo se un sito chiede l'accesso, poi lo cancello."));
  if (EXT_CK) CK_SEEN[EXT_CK] = true;
  var ckNow = EXT_CKNOW = !!EXT_CK && head.login === "retry";
  if (ckNow) tryDelete(loginFile());
  var r1 = links.length ? parseText(links.join("\n"), false, true) : { added: 0, skipped: 0, pending: 0 };
  /* pagina delle immagini (Referer): solo un indirizzo http(s) semplice, ripulito come i link */
  IMG_REF = head.ref && /^https?:\/\/[\x21-\x7e]+$/i.test(head.ref) ? cleanUrl(head.ref) : "";
  var r2 = imgs.length ? parseText(imgs.join("\n"), true, true) : { added: 0, skipped: 0, pending: 0 };
  IMG_REF = ""; EXT_CK = ""; EXT_CKNOW = false;
  ckSweep();   /* login arrivato ma nessuna riga lo usa (link gia' scaricati o doppi): via subito */
  var added = r1.added + r2.added, pending = r1.pending + r2.pending, skipped = r1.skipped + r2.skipped - pending;
  /* impostazioni separate: quelle video/audio cambiano solo se arrivano video, il formato delle immagini solo se arrivano immagini */
  var vidNew = r1.added + r1.pending, imgNew = r2.added + r2.pending;
  var applied = vidNew ? extApplyMode(head) : "";
  if (imgNew && head.imgfmt !== undefined && /^(png|webp|jpg)?$/.test(head.imgfmt)) {
    setSelect($("imgDef"), head.imgfmt); imgDefChanged();
    applied += (applied ? " • " : "") + T("Immagini {0}", $("imgDef").value ? $("imgDef").value.toUpperCase() : T("Originale"));
  }
  /* «Scarica subito»: con i video serve una modalita' Video o Solo audio; le sole immagini partono comunque */
  var start = (head.start === "1" && (vidNew ? extApplyOk(head) : imgNew > 0)) || (ckNow && vidNew + imgNew > 0);
  logEvent("ext", T("Estensione {0}: {1} link ricevuti, {2} nuovi in lista{3}.", EXTST.ver, links.length + imgs.length, added, applied ? " • " + applied : ""), added || pending ? "ok" : "warn", true);
  if (EXTST.ver !== "?" && verLess(EXTST.ver, APP_VER)) logEvent("ext", T("L'estensione Chrome e' alla versione {0}: premi «Estensione Chrome» per aggiornarla alla {1}.", EXTST.ver, APP_VER), "warn", true);
  if (start) {
    /* «Scarica subito» nell'estensione: parto da solo (startQueue fa gli stessi controlli del pulsante Scarica),
       anche se i link erano gia' in lista ma non ancora scaricati */
    logEvent("ext", T("Download avviato dall'estensione Chrome."), "info", true);
    setTimeout(function () { if (!state.busy) startQueue(); }, 300);
  }
  else if (added) showMsg(T("{0} link ricevuti dall'estensione Chrome{1}: controlla e premi Scarica quando vuoi.", added, applied ? " (" + applied + ")" : "") + (skipped > 0 ? " " + T("({0} già in lista o non validi)", skipped) : ""), "ok");
  else if (pending) showMsg(T("I {0} link ricevuti sono già in lista e non ancora scaricati: premi Scarica quando vuoi.", pending), "info");
  else showMsg(T("Nessun link nuovo dall'estensione Chrome: {0} già in lista o non validi.", links.length + imgs.length), "info");
  /* altri invii arrivati nel frattempo */
  if (EXTST.pending.length) setTimeout(extPoll, 200);
}
/* impostazioni rapide scelte nell'estensione: restituisce la descrizione di cosa ho cambiato */
/* impostazioni base: codec e audio automatici, frequenza e canali originali (cosi' non resta, per esempio,
   un «Nessun audio» scelto prima nell'app). Le altre opzioni (sottotitoli, copertina...) restano come sono. */
function extApplyOk(h) { return h.mode === "video" || h.mode === "audio"; }
function extApplyMode(h) {
  if (h.mode === "video") {
    setMode("video");
    if (EXT_VIDEO_Q[h.quality]) setSelect($("quality"), h.quality);
    if (EXT_CONT[h.container]) setSelect($("container"), h.container);
    fillVideoSelects("auto", "auto");
    checkCombo();
    return T("Video {0} {1}", $("container").value.toUpperCase(), $("quality").options[$("quality").selectedIndex].text);
  }
  if (h.mode === "audio") {
    setMode("audio");
    if (EXT_AUDIO[h.afmt]) setSelect($("afmt"), h.afmt);
    fillAudioSelects(h.aq !== undefined ? h.aq : "", "");
    setSelect($("aChan"), "");
    checkCombo();
    return T("Solo audio {0} {1}", $("afmt").options[$("afmt").selectedIndex].text, $("aq").options[$("aq").selectedIndex].text);
  }
  return "";
}

/* ---------- apertura dall'estensione: protocollo downconvertron:// ----------
   Windows: registrato per il tuo utente (HKCU, niente amministratore) e puntato a QUESTA app;
   Chrome chiede la prima volta se aprire DownConvertron. Mac: lo registra l'app stessa.
   Il collegamento passa da un lanciatore invisibile (windows/apri.js, incorporato da tools/embed.py):
   se l'app e' gia' aperta la riporta in primo piano (anche se ridotta a icona) invece di aprirne un'altra. */
var APRI_JS = "/* DownConvertron - lanciatore del collegamento downconvertron:// (logo e invio dell'estensione Chrome).\n   Se l'app e' gia' aperta la porta in primo piano: i link li legge da sola dagli appunti.\n   Altrimenti la avvia. Gira con wscript //B: nessuna finestra.\n   Argomenti: percorso dell'HTA, link downconvertron://\n   Copyright (C) 2026 Daniele Moretti (Welsho) - GPL-3.0-or-later */\nvar sh = new ActiveXObject(\"WScript.Shell\"), A = WScript.Arguments;\nvar hta = A.length > 0 ? A(0) : \"\", url = A.length > 1 ? A(1) : \"\";\n\n/* processo di DownConvertron gia' aperto (mshta a 32 o 64 bit, installata o no): 0 se non c'e' */\nfunction running() {\n  try {\n    var wmi = GetObject(\"winmgmts:{impersonationLevel=impersonate}!\\\\\\\\.\\\\root\\\\cimv2\");\n    var e = new Enumerator(wmi.ExecQuery(\"SELECT ProcessId, CommandLine FROM Win32_Process WHERE Name = 'mshta.exe'\"));\n    for (; !e.atEnd(); e.moveNext()) {\n      var cl = String(e.item().CommandLine || \"\");\n      if (/[\\\\\\/\"]DownConvertron[^\\\\\\/\"]*\\.hta/i.test(cl)) return e.item().ProcessId;\n    }\n  } catch (x) {}\n  return 0;\n}\n/* lo stesso mshta del doppio clic sui file .hta, cosi' \"una sola istanza\" vale anche dopo */\nfunction mshta() {\n  var def = sh.ExpandEnvironmentStrings(\"%SystemRoot%\") + \"\\\\System32\\\\mshta.exe\", c = \"\", m;\n  try { c = String(sh.RegRead(\"HKCR\\\\htafile\\\\shell\\\\open\\\\command\\\\\")); } catch (x) {}\n  m = /^\\s*\"([^\"]*mshta\\.exe)\"/i.exec(c) || /^\\s*(\\S*mshta\\.exe)/i.exec(c);\n  return m ? sh.ExpandEnvironmentStrings(m[1]) : def;\n}\n\n/* base64 di una stringa in UTF-16LE (per powershell -EncodedCommand: niente problemi di virgolette) */\nfunction b64u16(s) {\n  var K = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\", b = [], o = \"\", i, n;\n  for (i = 0; i < s.length; i++) { n = s.charCodeAt(i); b.push(n & 255, n >> 8); }\n  for (i = 0; i < b.length; i += 3) {\n    n = (b[i] << 16) | ((b[i + 1] || 0) << 8) | (b[i + 2] || 0);\n    o += K.charAt(n >> 18 & 63) + K.charAt(n >> 12 & 63) + (i + 1 < b.length ? K.charAt(n >> 6 & 63) : \"=\") + (i + 2 < b.length ? K.charAt(n & 63) : \"=\");\n  }\n  return o;\n}\n/* AppActivate non ripristina una finestra ridotta a icona (lo fa ShowWindowAsync) e Windows spesso gli nega il primo\n   piano: SetForegroundWindow con Alt premuto (PowerShell nascosto) lo ottiene */\nfunction restore(pid) {\n  var ps = sh.ExpandEnvironmentStrings(\"%SystemRoot%\") + \"\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\";\n  var code = \"$h = (Get-Process -Id \" + pid + \").MainWindowHandle; if ($h -ne 0) { \" +\n    \"$w = Add-Type -Name W -Namespace DCVT -PassThru -MemberDefinition '[DllImport(\\\"user32.dll\\\")] public static extern bool IsIconic(IntPtr h); [DllImport(\\\"user32.dll\\\")] public static extern bool ShowWindowAsync(IntPtr h, int c); \" +\n    \"[DllImport(\\\"user32.dll\\\")] public static extern bool SetForegroundWindow(IntPtr h); [DllImport(\\\"user32.dll\\\")] public static extern void keybd_event(byte v, byte s, uint f, UIntPtr e);'; \" +\n    \"if ($w::IsIconic($h)) { [void]$w::ShowWindowAsync($h, 9) }; \" +\n    \"$w::keybd_event(0x12, 0, 0, [UIntPtr]::Zero); [void]$w::SetForegroundWindow($h); $w::keybd_event(0x12, 0, 2, [UIntPtr]::Zero) }\";\n  try { sh.Run('\"' + ps + '\" -NoProfile -NonInteractive -WindowStyle Hidden -EncodedCommand ' + b64u16(code), 0, true); } catch (x) {}\n}\n\nvar pid = running();\nif (pid) {\n  /* prima subito in primo piano (finestra aperta: nessuna attesa), poi il ripristino se era ridotta a icona:\n     AppActivate risponde \"riuscito\" anche su una finestra ridotta, senza riaprirla */\n  sh.AppActivate(pid);\n  restore(pid);\n  if (!sh.AppActivate(pid)) { WScript.Sleep(300); sh.AppActivate(pid); }\n} else if (hta) {\n  sh.Run('\"' + mshta() + '\" \"' + hta + '\"' + (url ? ' \"' + url + '\"' : \"\"), 1, false);\n}\n";
function protoRegister() {
  if (window.DCVT_MAC) return;
  try {
    var hta = htaPath(), key = "HKCU\\Software\\Classes\\downconvertron\\";
    if (!hta) return;
    var apri = DIR_APP + "\\apri.js", old = "";
    ensureDir(DIR_APP);
    try { if (fso.FileExists(apri)) old = readUtf8(apri); } catch (e0) {}
    if (old !== APRI_JS) writeAscii(apri, APRI_JS);
    var cmd = '"' + SYS + '\\System32\\wscript.exe" //B //nologo "' + apri + '" "' + hta + '" "%1"', cur = "";
    try { cur = sh.RegRead(key + "shell\\open\\command\\"); } catch (e) {}
    if (cur === cmd) return;
    sh.RegWrite(key, "URL:DownConvertron", "REG_SZ");
    sh.RegWrite(key + "URL Protocol", "", "REG_SZ");
    var ico = fso.GetParentFolderName(hta) + "\\DownConvertron.ico";
    if (fso.FileExists(ico)) sh.RegWrite(key + "DefaultIcon\\", ico, "REG_SZ");
    sh.RegWrite(key + "shell\\open\\command\\", cmd, "REG_SZ");
    logEvent("app", T("Collegamento con l'estensione Chrome registrato (downconvertron://)."));
  } catch (e2) { DEBUG_ERRORS.push("protocollo: " + (e2.message || e2)); }
}
/* percorso di questa HTA: dalla riga di comando di mshta, altrimenti dall'indirizzo della pagina */
function htaApp() { try { return document.getElementById("app") || window.app || null; } catch (e) { return null; } }
function htaPath() {
  var A = htaApp(), cl = "", m;
  try { cl = String(A && A.commandLine || ""); } catch (e) {}
  m = /^\s*"([^"]+\.hta)"/i.exec(cl) || /^\s*(\S+\.hta)/i.exec(cl);
  if (m) return m[1];
  try { var p = decodeURIComponent(String(location.pathname || "")).replace(/^\/+/, "").replace(/\//g, "\\"); if (/^[a-z]:\\.+\.hta$/i.test(p)) return p; } catch (e2) {}
  return "";
}
/* aperta da un link downconvertron:// (logo dell'estensione o invio dei link) */
function protoArgs(cl) {
  var m = /downconvertron:\/\/([^\s"]*)/i.exec(String(cl || ""));
  if (!m) return;
  var q = m[1], v = /[?&]ext=([\d.]+)/.exec(q);
  if (v) EXTST.ver = v[1];
  logEvent("ext", /^send/.test(q) ? T("App aperta dall'estensione Chrome per ricevere i link.") : T("App aperta dal logo dell'estensione Chrome."), "info", true);
  setTimeout(extPoll, 300);
}

/* ---------- lingue: italiano (sorgente), inglese, cinese semplificato ----------
   T("testo italiano {0}", valore) cerca la traduzione nella lingua scelta; se manca resta l'italiano.
   I testi fissi della pagina (etichette, pulsanti, suggerimenti) vengono tradotti da i18nApply(). */
var LANG = "it", LANGS = ["it", "en", "zh"];
/* I18N_INIZIO (generato da tools/embed.py da i18n/strings.json) */
var I18N = {"en":{"(Chrome non trovato: aprilo e scrivi <b>chrome://extensions<\/b> nella barra degli indirizzi)":"(Chrome not found: open it and type <b>chrome://extensions<\/b> in the address bar)","(boomerang: la clip torna al punto di partenza, ideale per i loop)":"(boomerang: the clip returns to its starting point, ideal for loops)","(codec mancanti:":"(missing codecs:","(con canale alfa)":"(with alpha channel)","(controllo aggiornamenti)":"(checking for updates)","(copia senza perdita)":"(lossless copy)","(costante)":"(constant)","(gi\u00e0 all'ultima versione)":"(already at the latest version)","(installato/aggiornato)":"(installed/updated)","(installazione)":"(installation)","(interrotta:":"(interrupted:","(mancano ancora i codec":"(codecs still missing","(non verificato: interrotto)":"(not verified: interrupted)","(per rifarli con altre impostazioni sposta o rinomina i file vecchi).":"(to redo them with other settings move or rename the old files).","(presente, ma winget ha dato errore":"(present, but winget gave error","(scheda {0})":"(card {0})","(si apre da sola tra un istante; se non compare scrivi <b>chrome://extensions<\/b> nella barra degli indirizzi)":"(it opens by itself in a moment; if it does not appear type <b>chrome://extensions<\/b> in the address bar)","(si apre da sola; la prima volta il Mac chiede il permesso di controllare Chrome: premi OK)":"(it opens by itself; the first time the Mac asks permission to control Chrome: press OK)","(winget codice":"(winget code","({0} doppi o non validi ignorati)":"({0} duplicates or invalid ignored)","({0} gi\u00e0 in lista o non validi)":"({0} already in the list or invalid)","): niente Homebrew, niente password, circa 150 MB.\nPuoi interrompere con lo stesso pulsante.\n\nContinuare?":"): no Homebrew, no password, about 150 MB.\nYou can stop it with the same button.\n\nContinue?","+ Cartella":"+ Folder","+ File":"+ Files",", uscita":", output","-14 LUFS (YouTube, Spotify, social)":"-14 LUFS (YouTube, Spotify, social)","-16 LUFS (podcast, web)":"-16 LUFS (podcast, web)","-23 LUFS (EBU R128, TV)":"-23 LUFS (EBU R128, TV)",". In un .txt puoi scrivere":". In a .txt you can write","0 file":"0 files","0 link":"0 links","1 link aggiunto":"1 link added","1 volta":"1 time","1 \u00b7 File da convertire":"1 \u00b7 Files to convert","1 \u00b7 Link":"1 \u00b7 Links","10 volte":"10 times","1080\u00d71080 quadrato":"1080\u00d71080 square","1080\u00d71350 post 4:5":"1080\u00d71350 4:5 post","1080\u00d71920 verticale (storie)":"1080\u00d71920 vertical (stories)","16 bit":"16-bit","1920\u00d71080 orizzontale":"1920\u00d71080 landscape","2 volte":"2 times","2 \u00b7 Formato":"2 \u00b7 Format","2 \u00b7 Formato e ritocchi":"2 \u00b7 Format and touch-ups","2 \u00b7 Video e audio":"2 \u00b7 Video and audio","24 bit":"24-bit","2b \u00b7 Immagini":"2b \u00b7 Images","3 volte":"3 times","3 \u00b7 Salva in":"3 \u00b7 Save to","32 bit":"32-bit","32 bit virgola mobile":"32-bit floating point","4 volte":"4 times","5 volte":"5 times",": condiviso con \u00abChiunque abbia il link\u00bb. Anche":": shared with \u00abAnyone with the link\u00bb. Also",": i file sono in":": files are in",": molto pi\u00f9 veloce, a parit\u00e0 di peso la qualit\u00e0 \u00e8 un po' inferiore.":": much faster, at the same size the quality is a bit lower.",": nel Finder sotto":": in the Finder under",": nessuna trasparenza nel file di uscita. Per mantenerla scegli un formato \u00abCon trasparenza\u00bb.":": no transparency in the output file. To keep it choose a \u00abWith transparency\u00bb format.",": premi \u00abInstalla / aggiorna componenti\u00bb (installa la versione completa).":": press \u00abInstall / update components\u00bb (installs the full version).",": premi \u00abInstalla / aggiorna componenti\u00bb.":": press \u00abInstall / update components\u00bb.",": scegli un altro formato.":": choose another format.",": su quei file lo sfondo da rimuovere viene ignorato, per non rovinare la loro trasparenza.":": on those files the background to remove is ignored, so as not to spoil their transparency.","<b>Come si usa:<\/b> clicca l'icona, scegli <b>Video<\/b> o <b>Solo audio<\/b> (o lascia le impostazioni dell'app), spunta i link e premi <b>Metti in lista<\/b> (li scarichi qui con <b>Scarica<\/b>) oppure, con Video o Solo audio, <b>Scarica subito<\/b> (il download parte da solo). Il logo dell'estensione apre DownConvertron.":"<b>How to use it:<\/b> click the icon, choose <b>Video<\/b> or <b>Audio only<\/b> (or keep the app settings), tick the links and press <b>Add to list<\/b> (you download them here with <b>Download<\/b>) or, with Video or Audio only, <b>Download now<\/b> (the download starts by itself). The extension logo opens DownConvertron.","<b>Google Drive sul Mac<\/b>: nel Finder sotto <b>Google Drive<\/b>.":"<b>Google Drive on Mac<\/b>: in the Finder under <b>Google Drive<\/b>.","<b>Hai gi&agrave; una DownConvertron in Chrome:<\/b> prima premi <b>Rimuovi<\/b> su quella vecchia, poi caricala di nuovo come sopra. Questa versione ha un nuovo identificativo (serve a \u00abUsa il mio login\u00bb).":"<b>You already have a DownConvertron in Chrome:<\/b> first press <b>Remove<\/b> on the old one, then load it again as above. This version has a new ID (needed for \u00abUse my login\u00bb).","<b>Una volta sola<\/b>, nella pagina <b>Estensioni<\/b> di Chrome":"<b>Only once<\/b>, on the Chrome <b>Extensions<\/b> page","AAC (massima compatibilit\u00e0)":"AAC (maximum compatibility)","APNG animato":"Animated APNG","APNG animato + alfa (senza perdita)":"Animated APNG + alpha (lossless)","APNG: PNG animato senza perdita con trasparenza morbida (browser, Discord, Telegram). File pi\u00f9 pesanti del WebP.":"APNG: lossless animated PNG with soft transparency (browsers, Discord, Telegram). Heavier files than WebP.","APP":"APP","AVI: formato vecchio, per lettori e programmi datati. Video H.264 copiato senza perdita (fino a 1080p su YouTube), audio convertito in MP3. Niente copertina; i sottotitoli restano file a parte.":"AVI: old format, for dated players and programs. H.264 video copied losslessly (up to 1080p on YouTube), audio converted to MP3. No cover; subtitles stay separate files.","Accesso negato (errore {0}): il sito non lascia scaricare l'immagine da fuori. Prova a mandarla con l'estensione Chrome dalla pagina in cui si trova.":"Access denied (error {0}): the site does not allow downloading the image from outside. Try sending it with the Chrome extension from the page it is on.","Adattamento":"Fit","Aggiungi":"Add","Aggiungi almeno un file o un link.":"Add at least one file or link.","Aggiungi almeno un link.":"Add at least one link.","Aggiungi link":"Add link","Alcuni elementi della playlist non sono stati scaricati:":"Some items of the playlist were not downloaded:","Alfa premoltiplicato (MOV da After Effects/Premiere \u00abPremoltiplicato\u00bb: toglie l'alone scuro sui bordi)":"Premultiplied alpha (MOV from After Effects/Premiere \u00abPremultiplied\u00bb: removes the dark halo on edges)","Alta":"High","Animazione":"Animation","Animazione e PNG sono senza perdita: file molto grandi, ideali per il montaggio.":"Animation and PNG are lossless: very large files, ideal for editing.","Animazione non creata, immagini aggiunte separate: {0}":"Animation not created, images added separately: {0}","Animazioni di immagini: immagini al secondo nella riga di ogni animazione.":"Image animations: images per second in the row of each animation.","Animazioni di immagini: immagini al secondo nella riga, video a":"Image animations: images per second in the row, video at","Annulla":"Cancel","Annulla installazione":"Cancel installation","Annullamento...":"Cancelling...","Annullato":"Cancelled","Anteprima del risultato su scacchiera":"Preview of the result on a checkerboard","Anteprima non disponibile:":"Preview not available:","Anteprima non riuscita:":"Preview failed:","Anteprima: {0}":"Preview: {0}","App aperta dal logo dell'estensione Chrome.":"App opened from the Chrome extension logo.","App aperta dall'estensione Chrome per ricevere i link.":"App opened by the Chrome extension to receive the links.","Apri cartella":"Open folder","Attendi la fine del lavoro in corso, poi riprova.":"Wait for the current job to finish, then try again.","Attendi la fine del lavoro in corso, poi trascina di nuovo.":"Wait for the current job to finish, then drag again.","Attendi la fine del lavoro in corso.":"Wait for the current job to finish.","Audio":"Audio","Audio nel video":"Audio in the video","Automatica (16 bit)":"Automatic (16-bit)","Automatica (VBR migliore)":"Automatic (best VBR)","Automatica (originale se gi\u00e0 AAC)":"Automatic (original if already AAC)","Automatica (originale se gi\u00e0 Opus)":"Automatic (original if already Opus)","Automatica (qualit\u00e0 alta)":"Automatic (high quality)","Automatico (VP9)":"Automatic (VP9)","Automatico (migliore)":"Automatic (best)","Avanti-indietro":"Forward-backward","Avanti-indietro e ripetizioni tengono in memoria tutta la clip (circa":"Forward-backward and repeats keep the whole clip in memory (about","Avvio":"Start","Avviso: il JPG non ha trasparenza, le parti trasparenti di {0} sono diventate bianche.":"Warning: JPG has no transparency, the transparent parts of {0} became white.","Avviso: {0} era un'immagine animata; in {1} resta solo il primo fotogramma (per tenerla animata scegli WebP o Originale).":"Warning: {0} was an animated image; in {1} only the first frame remains (to keep it animated choose WebP or Original).","Bassa":"Low","Bianco":"White","Bilanciata":"Balanced","Bitrate / qualit\u00e0":"Bitrate / quality","Blu (blue screen)":"Blue (blue screen)","C'\u00e8 un lavoro in corso: chiudendo verr\u00e0 annullato.":"A job is running: closing will cancel it.","CHROME: ULTIMO INVIO ALLE {0}":"CHROME: LAST SENT AT {0}","COMPONENTI":"COMPONENTS","COMPONENTI: Google Chrome non trovato. Installa Chrome, poi clic qui per aggiungere l'estensione.":"COMPONENTS: Google Chrome not found. Install Chrome, then click here to add the extension.","COMPONENTI: controllo l'estensione Chrome...":"COMPONENTS: checking the Chrome extension...","COMPONENTI: da sistemare {0}. Clic per installare / aggiornare tutto.":"COMPONENTS: to fix {0}. Click to install / update everything.","COMPONENTI: estensione Chrome da aggiornare alla {0}. Clic per aggiornarla.":"COMPONENTS: Chrome extension needs updating to {0}. Click to update it.","COMPONENTI: estensione Chrome non installata. Clic per installarla.":"COMPONENTS: Chrome extension not installed. Click to install it.","COMPONENTI: estensione Chrome {0} installata ({1}). Clic per reinstallarla.":"COMPONENTS: Chrome extension {0} installed ({1}). Click to reinstall it.","COMPONENTI: tutto a posto. Clic per controllare gli aggiornamenti di yt-dlp, ffmpeg e Deno.":"COMPONENTS: all good. Click to check for updates of yt-dlp, ffmpeg and Deno.","CONVERTITORE":"CONVERTER","CONVERTITORE: {0} FILE IN LISTA":"CONVERTER: {0} FILES IN THE LIST","COPIA":"COPY","Cambia":"Change","Cambio contenitore: video e audio copiati senza perdita se compatibili (H.264, H.265, ProRes, AAC...), il resto ricodificato. Qualit\u00e0, risoluzione e FPS non si applicano.":"Container change: video and audio copied losslessly if compatible (H.264, H.265, ProRes, AAC...), the rest re-encoded. Quality, resolution and FPS do not apply.","Cambio contenitore: video e audio vengono copiati senza perdita quando sono compatibili (H.264, H.265, AAC...). Il resto viene ricodificato. Qualit\u00e0, risoluzione e FPS non si applicano.":"Container change: video and audio are copied losslessly when compatible (H.264, H.265, AAC...). The rest is re-encoded. Quality, resolution and FPS do not apply.","Canali":"Channels","Cartella dell'estensione Chrome aggiornata alla {0} (era {1}).":"Chrome extension folder updated to {0} (was {1}).","Cartella dell'estensione Chrome aggiornata con i file nuovi di questa versione: ricaricala in Chrome (spia COMPONENTI).":"Chrome extension folder updated with this version's new files: reload it in Chrome (COMPONENTS light).","Cartella dell'estensione Chrome pronta: {0}":"Chrome extension folder ready: {0}","Cartella di destinazione inesistente:":"Destination folder does not exist:","Chiudi":"Close","CineForm: intermedio da montaggio (Premiere, After Effects, Resolve) con alfa a 12 bit, pi\u00f9 leggero di ProRes 4444.":"CineForm: editing intermediate (Premiere, After Effects, Resolve) with 12-bit alpha, lighter than ProRes 4444.","Clip ferma":"Still clip","Clip troppo lunga per ripetizioni o avanti-indietro (max circa 32.000 fotogrammi): accorciala con il taglio.":"Clip too long for repeats or forward-backward (max about 32,000 frames): shorten it with the trim.","Codec":"Codec","Codifica con la scheda video":"Encoding with the graphics card","Collegamento con l'estensione Chrome registrato (downconvertron://).":"Link with the Chrome extension registered (downconvertron://).","Colore (#RRGGBB)":"Color (#RRGGBB)","Colore dello sfondo non valido: usa #RRGGBB.":"Invalid background color: use #RRGGBB.","Colore non valido: scrivilo come #RRGGBB (es. #00FF00).":"Invalid color: write it as #RRGGBB (e.g. #00FF00).","Colore personalizzato":"Custom color","Completato":"Completed","Componente {0} di {1}":"Component {0} of {1}","Componenti mancanti":"Components missing","Componenti presenti":"Components present","Componenti presenti:":"Components present:","Componenti pronti":"Components ready","Componenti pronti:":"Components ready:","Componenti: avvio dello scaricamento...":"Components: starting the download...","Componenti: avvio di winget...":"Components: starting winget...","Compositing \u00b7 Sequenza EXR":"Compositing \u00b7 EXR sequence","Con H.264 YouTube arriva di solito al massimo a 1080p: per 2K/4K/8K scegli Automatico, VP9 o AV1.":"With H.264 YouTube usually tops out at 1080p: for 2K/4K/8K choose Automatic, VP9 or AV1.","Con trasparenza (alfa)":"With transparency (alpha)","Con \u00abOriginale\u00bb e \u00abWebM\u00bb l'audio viene copiato cos\u00ec com'\u00e8: bitrate, frequenza, canali e volume non si applicano.":"With \u00abOriginal\u00bb and \u00abWebM\u00bb the audio is copied as is: bitrate, sample rate, channels and volume do not apply.","Connessione sicura non riuscita (certificato del sito non valido).":"Secure connection failed (the site's certificate is not valid).","Conversione annullata. I file non completati restano in lista.":"Conversion cancelled. Unfinished files stay in the list.","Conversione in {0} non riuscita ({1}).":"Conversion to {0} failed ({1}).","Converti in":"Convert to","Converti in WebM":"Convert to WebM","Converto l'immagine in {0}...":"Converting the image to {0}...","Copertina nel file":"Cover in the file","Copia i file in Esplora file / Finder (Ctrl+C) e incollali qui (anche Ctrl+V)":"Copy the files in File Explorer / Finder (Ctrl+C) and paste them here (also Ctrl+V)","Copia il percorso della cartella":"Copy the folder path","Copy All URLs":"Copy All URLs","DOWNLOAD DA LINK":"DOWNLOAD FROM LINK","Da scaricare dal link, poi convertire":"To be downloaded from the link, then converted","Dai video e dalle sequenze viene salvato un solo fotogramma: quello all'inizio del taglio (o il primo).":"From videos and sequences a single frame is saved: the one at the trim start (or the first).","Diretta fermata: il file incompleto \u00ab{0}\u00bb resta nella cartella.":"Live stream stopped: the incomplete file \u00ab{0}\u00bb stays in the folder.","Diretta fermata: nessun file registrato.":"Live stream stopped: no file recorded.","Diretta fermata: salvato \u00ab{0}\u00bb (si apre con VLC; per montarlo convertilo nel Convertitore).":"Live stream stopped: saved \u00ab{0}\u00bb (opens in VLC; to edit it, convert it in the Converter).","Dividi per capitoli":"Split by chapters","Dove salvare i video convertiti":"Where to save the converted videos","DownConvertron scaricher\u00e0 le ultime versioni ufficiali per Apple Silicon:":"DownConvertron will download the latest official versions for Apple Silicon:","DownConvertron user\u00e0 winget, dalla sorgente ufficiale \u00abwinget\u00bb di Microsoft, per:":"DownConvertron will use winget, from Microsoft's official \u00abwinget\u00bb source, to:","DownConvertron v7.0 \u00b7 designed by":"DownConvertron v7.0 \u00b7 designed by","DownConvertron {0} avviata. Cartella dati: {1}":"DownConvertron {0} started. Data folder: {1}","Download annullato. I link non completati restano in lista: premi Scarica per riprendere. Eventuali file .part nella cartella sono parziali.":"Download cancelled. Unfinished links stay in the list: press Download to resume. Any .part files in the folder are partial.","Download avviato dall'estensione Chrome.":"Download started from the Chrome extension.","Download non riuscito (il file \u00e8 condiviso con \u00abChiunque abbia il link\u00bb?)":"Download failed (is the file shared with \u00abAnyone with the link\u00bb?)","Durata della clip ferma in secondi (da 0,1 a 3600)":"Still clip length in seconds (0.1 to 3600)","ENCODER":"ENCODER","ENCODER GPU {0}: {1}":"GPU ENCODER {0}: {1}","ENCODER: a ffmpeg mancano i codec {0}. Clic per installare la versione completa.":"ENCODER: ffmpeg lacks the codecs {0}. Click to install the full version.","ENCODER: ffmpeg o ffprobe mancano. Clic per installarli.":"ENCODER: ffmpeg or ffprobe are missing. Click to install them.","ENCODER: ffmpeg pronto con tutti i codec. Clic per controllare gli aggiornamenti.":"ENCODER: ffmpeg ready with all codecs. Click to check for updates.","ERRORI":"ERRORS","ESTENSIONE":"EXTENSION","Elemento {0} di {1}":"Item {0} of {1}","Elimina":"Delete","Eliminare il preset \u00ab":"Delete the preset \u00ab","Errore":"Error","Errore interno (riga":"Internal error (line","Errore sconosciuto. Ultime righe:":"Unknown error. Last lines:","Esiste gi\u00e0 un preset \u00ab":"A preset \u00ab","Estensione Chrome":"Chrome extension","Estensione preparata solo in parte (":"Extension prepared only partly (","Estensione {0}: {1} link ricevuti, {2} nuovi in lista{3}.":"Extension {0}: {1} links received, {2} new in the list{3}.","FLAC (senza perdita)":"FLAC (lossless)","FPS delle sequenze":"Sequence FPS","Fatto":"Done","Fatto!":"Done!","File":"File","File non leggibile":"Unreadable file","File non leggibile da ffmpeg.":"File not readable by ffmpeg.","File troppo grande (massimo 5 MB).":"File too large (5 MB maximum).","File {0} di {1}":"File {0} of {1}","Fine del taglio non valida: scrivi ad esempio 0:10 oppure 10":"Invalid trim end: write for example 0:10 or 10","Formato":"Format","Formato audio":"Audio format","Formato dell'immagine: Originale salva il file cos\u00ec com'\u00e8 sul server, senza ricodifica.":"Image format: Original saves the file exactly as it is on the server, without re-encoding.","Formato delle immagini":"Image format","Formato di uscita":"Output format","Forza il canale alfa":"Force the alpha channel","Fotogramma a":"Frame at","Francese":"French","Frequenza":"Sample rate","Full HD (1080p)":"Full HD (1080p)","G:\\Il mio Drive":"G:\\My Drive","GB a questa risoluzione): accorciala con il taglio o riduci la risoluzione.":"GB at this resolution): shorten it with the trim or reduce the resolution.","GIF (solo immagini)":"GIF (images only)","GIF animata":"Animated GIF","GIF animata (alfa a 1 bit)":"Animated GIF (1-bit alpha)","GIF: al massimo 15 fotogrammi al secondo e 480p se non scegli altro; trasparenza a 1 bit (pixel pieni o vuoti), senza audio. Per bordi morbidi usa WebP o APNG.":"GIF: at most 15 frames per second and 480p unless you choose otherwise; 1-bit transparency (pixels fully on or off), no audio. For soft edges use WebP or APNG.","GIF: solo immagini, a 15 fotogrammi al secondo, senza audio. Adatta a clip brevi: oltre 480p diventa enorme.":"GIF: images only, 15 frames per second, no audio. Good for short clips: above 480p it gets huge.","Giapponese":"Japanese","Gi\u00e0 presente nella cartella (o nell'archivio): non riscaricato. Per rifarlo con altre impostazioni sposta o rinomina il file vecchio.":"Already in the folder (or in the archive): not downloaded again. To redo it with other settings move or rename the old file.","Gi\u00e0 presente: {0}":"Already present: {0}","Gi\u00e0 scaricato in precedenza: saltato":"Already downloaded before: skipped","Gli appunti sono vuoti o non contengono testo.":"The clipboard is empty or contains no text.","Google Drive sul Mac":"Google Drive on the Mac","Google Drive sul PC":"Google Drive on the PC","H.264 (copiato senza perdita)":"H.264 (copied losslessly)","H.264 (massima compatibilit\u00e0)":"H.264 (maximum compatibility)","H.264 del chip Mac":"H.264 of the Mac chip","HAP Alpha: per Resolume, TouchDesigner, MadMapper, millumin e ledwall. Decodifica leggerissima, file grandi.":"HAP Alpha: for Resolume, TouchDesigner, MadMapper, Millumin and LED walls. Very light decoding, large files.","HAP Q: qualit\u00e0 superiore ad HAP, senza alfa. Per software live e ledwall.":"HAP Q: higher quality than HAP, no alpha. For live software and LED walls.","HAP: il pi\u00f9 leggero da riprodurre, senza alfa. Per software live e ledwall.":"HAP: the lightest to play, no alpha. For live software and LED walls.","HD (720p)":"HD (720p)","HEVC con alfa: il formato trasparente di Apple (Final Cut, Motion, Safari, iPhone). Codificato dal chip del Mac: veloce e leggero.":"HEVC with alpha: Apple's transparent format (Final Cut, Motion, Safari, iPhone). Encoded by the Mac chip: fast and light.","HEVC del chip Mac":"HEVC of the Mac chip","Hai aggiunto {0} immagini.\n\nOK = un'unica animazione (un fotogramma per immagine, immagini al secondo nella riga).\nAnnulla = immagini separate (clip ferme o file immagine, secondo il formato di uscita).":"You added {0} images.\n\nOK = one single animation (one frame per image, images per second in the row).\nCancel = separate images (still clips or image files, depending on the output format).","I file gi\u00e0 trasparenti (ProRes 4444, Animazione, PNG, GIF, WebM con alfa) mantengono SEMPRE la trasparenza.":"Already transparent files (ProRes 4444, Animation, PNG, GIF, WebM with alpha) ALWAYS keep their transparency.","I programmi ci sono e funzionano, ma un aggiornamento non \u00e8 andato a buon fine: puoi riprovare pi\u00f9 tardi.":"The programs are there and work, but an update did not succeed: you can try again later.","I {0} link ricevuti sono gi\u00e0 in lista e non ancora scaricati: premi Scarica quando vuoi.":"The {0} links received are already in the list and not yet downloaded: press Download when you want.","Il cambio contenitore non si applica alle immagini: scegli un altro formato.":"Container change does not apply to images: choose another format.","Il formato":"The format","Il formato scelto non ha trasparenza: lo sfondo esce pieno.":"The chosen format has no transparency: the background comes out solid.","Il link non porta a un'immagine (il server ha risposto con una pagina web o un file sconosciuto).":"The link does not lead to an image (the server answered with a web page or an unknown file).","Il percorso contiene il simbolo %: rinomina il file o la cartella.":"The path contains the % symbol: rename the file or folder.","Il processo non \u00e8 partito (bloccato da antivirus o criteri di sistema?).":"The process did not start (blocked by antivirus or system policies?).","Il ricevitore del trascinamento non parte su questo PC (dettagli nel Report debug): usa \u00ab+ File\u00bb oppure copia i file in Esplora file e premi \u00abIncolla file\u00bb.":"The drag receiver does not start on this PC (details in the Debug report): use \u00ab+ Files\u00bb or copy the files in File Explorer and press \u00abPaste files\u00bb.","Il ricevitore del trascinamento si stava avviando: trascina di nuovo i file.":"The drag receiver was starting: drag the files again.","Il server ha risposto con l'errore {0}.":"The server responded with error {0}.","Il server non risponde (tempo scaduto).":"The server is not responding (timed out).","Il tuo ffmpeg non ha il codec":"Your ffmpeg lacks the codec","Il tuo ffmpeg non ha il codec WebP: immagine non convertita.":"Your ffmpeg has no WebP codec: image not converted.","Il tuo ffmpeg non ha il filtro zscale (serve all'EXR lineare): premi \u00abInstalla / aggiorna componenti\u00bb.":"Your ffmpeg lacks the zscale filter (needed for linear EXR): press \u00abInstall / update components\u00bb.","Il tuo ffmpeg non ha il filtro zscale: i file EXR (lineari) uscirebbero troppo scuri. Premi \u00abInstalla / aggiorna componenti\u00bb.":"Your ffmpeg lacks the zscale filter: EXR files (linear) would come out too dark. Press \u00abInstall / update components\u00bb.","Immagine JPG":"JPG image","Immagine JPG: file leggero e compatibile ovunque, senza trasparenza (lo sfondo trasparente diventa bianco).":"JPG image: a light file that works everywhere, without transparency (transparent background becomes white).","Immagine PNG":"PNG image","Immagine PNG: un file senza perdita con trasparenza a 8 bit.":"PNG image: one lossless file with 8-bit transparency.","Immagine TIFF":"TIFF image","Immagine TIFF: un file senza perdita (compressione deflate) con trasparenza.":"TIFF image: one lossless file (deflate compression) with transparency.","Immagine WebP":"WebP image","Immagine WebP: file leggero con trasparenza morbida, per il web.":"WebP image: a light file with soft transparency, for the web.","Immagine non leggibile: {0}":"Unreadable image: {0}","Immagine non scaricata (link scaduto o protetto?).":"Image not downloaded (expired or protected link?).","Immagine non trovata (errore 404): il link \u00e8 scaduto o sbagliato.":"Image not found (error 404): the link has expired or is wrong.","Immagine singola (file)":"Single image (file)","Immagini al secondo":"Images per second","Immagini di formati diversi: serve ffmpeg per unirle. Premi \u00abInstalla / aggiorna componenti\u00bb.":"Images in different formats: ffmpeg is needed to join them. Press \u00abInstall / update components\u00bb.","Immagini singole: diventano una clip ferma (durata nella riga di ogni immagine).":"Single images: they become a still clip (length in each image row).","Immagini {0}":"Images {0}","Importa da .txt":"Import .txt","Impossibile aprire la finestra di scelta:":"Cannot open the selection window:","Impossibile avviare":"Cannot start","Impossibile avviare il processo.":"Cannot start the process.","Impossibile creare il file di log:":"Cannot create the log file:","Impossibile creare la cartella dei fotogrammi:":"Cannot create the frames folder:","Impossibile leggere gli appunti:":"Cannot read the clipboard:","Impossibile leggere il file scelto.":"Cannot read the selected file.","Impossibile leggere la cartella:":"Cannot read the folder:","Impossibile preparare i file temporanei (":"Cannot prepare the temporary files (","Impossibile preparare il download dell'immagine: {0}":"Cannot prepare the image download: {0}","Impossibile preparare il download:":"Cannot prepare the download:","Impossibile preparare l'estensione:":"Cannot prepare the extension:","Impossibile preparare lo scaricamento:":"Cannot prepare the download:","Impossibile salvare il risultato:":"Cannot save the result:","Impossibile salvare l'immagine:":"Cannot save the image:","Impossibile salvare l'immagine: {0}":"Cannot save the image: {0}","In attesa":"Waiting","In corso":"Running","In preparazione...":"Preparing...","In una cartella a scelta":"In a folder of your choice","Incolla dagli appunti":"Paste from clipboard","Incolla file":"Paste files","Incolla un link valido (https://...).":"Paste a valid link (https://...).","Incolla uno o pi\u00f9 link e premi Invio":"Paste one or more links and press Enter","Inglese":"English","Inizio del taglio non valido: scrivi ad esempio 0:02.5 oppure 2.5":"Invalid trim start: write for example 0:02.5 or 2.5","Installa / aggiorna componenti":"Install / update components","Installa l'estensione che manda qui i link delle schede aperte":"Install the extension that sends the links of your open tabs here","Installazione annullata.":"Installation cancelled.","Installazione componenti...":"Installing components...","Installazione interrotta dopo 15 minuti senza risposta da winget (forse \u00e8 in corso un'altra installazione o un aggiornamento di Windows).":"Installation stopped after 15 minutes without an answer from winget (maybe another installation or a Windows update is running).","Installazione non completa:":"Installation not complete:","Intero, bordi trasparenti":"Whole, transparent borders","Italiano":"Italian","JPG (senza alfa)":"JPG (no alpha)","JPG (trasparenza su bianco)":"JPG (transparency on white)","L'MP4 non ha il canale alfa:":"MP4 has no alpha channel:","L'estensione Chrome e' alla versione {0}: premi \u00abEstensione Chrome\u00bb per aggiornarla alla {1}.":"The Chrome extension is at version {0}: press \u00abChrome extension\u00bb to update it to {1}.","L'estensione riconosce gli oltre 1.700 siti di yt-dlp; legge le schede solo quando la apri e non invia nulla in rete.":"The extension recognizes the 1,700+ sites of yt-dlp; it reads the tabs only when you open it and sends nothing over the network.","L'installazione dei componenti \u00e8 in corso: se chiudi continuer\u00e0 in background, ma non vedrai l'esito.":"Components are being installed: if you close it will continue in the background, but you will not see the result.","LINGUA: {0}":"LANGUAGE: {0}","LINK":"LINK","LINK OFFLINE":"LINK OFFLINE","LINK ONLINE":"LINK ONLINE","LINK: Deno manca (serve per leggere YouTube). Clic per installarlo.":"LINK: Deno is missing (needed to read YouTube). Click to install it.","LINK: Deno presente e connessione attiva. Clic per controllare gli aggiornamenti.":"LINK: Deno present and connection active. Click to check for updates.","LINK: controllo la connessione...":"LINK: checking the connection...","LINK: nessuna connessione a internet. Clic per riprovare.":"LINK: no internet connection. Click to try again.","LISTA: {0} LINK IN ATTESA":"LIST: {0} LINKS WAITING","La cartella di destinazione non esiste pi\u00f9: scegline un'altra.":"The destination folder no longer exists: choose another one.","La cartella di destinazione non esiste: scegline un'altra.":"The destination folder does not exist: choose another one.","La fine del taglio deve venire dopo l'inizio.":"The trim end must come after the start.","La scheda video non risulta pi\u00f9 disponibile per":"The graphics card is no longer available for","Larg \u00d7 Alt":"W \u00d7 H","Lavoro in corso":"Work in progress","Le immagini si scaricano a parte, senza yt-dlp: qualit\u00e0, codec e opzioni di \u00abVideo e audio\u00bb non le toccano. Il formato vale per le immagini in lista e si pu\u00f2 cambiare anche riga per riga.":"Images are downloaded separately, without yt-dlp: quality, codec and options of \u00abVideo and audio\u00bb do not affect them. The format applies to the images in the list and can also be changed row by row.","Le sequenze di immagini non hanno audio: l'audio dei file viene tolto.":"Image sequences have no audio: the audio of the files is removed.","Le zone a scacchi saranno trasparenti nel file finale.":"Checkered areas will be transparent in the final file.","Leggera (web)":"Light (web)","Lenta (qualit\u00e0 migliore)":"Slow (better quality)","Lingua audio":"Audio language","Lingua audio \u00ab":"Audio language \u00ab","Lingua: italiano":"Language: English","Link Drive":"Drive link","Link Google Drive (o altro link) da scaricare e convertire":"Google Drive link (or another link) to download and convert","Link gi\u00e0 in lista.":"Link already in the list.","Link non supportato da yt-dlp ma e' un'immagine ({0}): la scarico direttamente.":"Link not supported by yt-dlp but it is an image ({0}): downloading it directly.","Link ricevuti dall'estensione Chrome: li aggiungo appena finisce il lavoro in corso.":"Links received from the Chrome extension: I will add them as soon as the current job finishes.","Live e LED \u00b7 HAP Alpha":"Live and LED \u00b7 HAP Alpha","Login dell'estensione non trovato: i link si scaricano senza.":"Extension login not found: the links are downloaded without it.","Login di Chrome cancellato a fine lavoro.":"Chrome login deleted at the end of the job.","Login di Chrome ricevuto: lo uso solo se un sito chiede l'accesso, poi lo cancello.":"Chrome login received: I use it only if a site asks you to sign in, then I delete it.","Loop avanti-indietro \u00b7 WebM":"Forward-backward loop \u00b7 WebM","M4A (AAC)":"M4A (AAC)","MANCANO COMPONENTI:":"MISSING COMPONENTS:","MECHA v7.0":"MECHA v7.0","MOV (QuickTime)":"MOV (QuickTime)","MOV (cambio contenitore)":"MOV (container change)","MOV Animazione":"MOV Animation","MOV Animazione + alfa (senza perdita)":"MOV Animation + alpha (lossless)","MOV CineForm + alfa (montaggio, 12 bit)":"MOV CineForm + alpha (editing, 12-bit)","MOV H.264 (Apple, Final Cut)":"MOV H.264 (Apple, Final Cut)","MOV HAP (live, il pi\u00f9 leggero)":"MOV HAP (live, the lightest)","MOV HAP Alpha (live, ledwall)":"MOV HAP Alpha (live, LED walls)","MOV HAP Q (live, ledwall)":"MOV HAP Q (live, LED walls)","MOV HEVC + alfa (Apple)":"MOV HEVC + alpha (Apple)","MOV HEVC + alfa (Apple, chip Mac)":"MOV HEVC + alpha (Apple, Mac chip)","MOV PNG + alfa (senza perdita)":"MOV PNG + alpha (lossless)","MOV ProRes 422":"MOV ProRes 422","MOV ProRes 422 HQ":"MOV ProRes 422 HQ","MOV ProRes 422 LT":"MOV ProRes 422 LT","MOV ProRes 422 Proxy":"MOV ProRes 422 Proxy","MOV ProRes 4444 + alfa":"MOV ProRes 4444 + alpha","MOV ProRes 4444 XQ + alfa":"MOV ProRes 4444 XQ + alpha","MOV \u2190 da MP4/MKV senza ricodifica":"MOV \u2190 from MP4/MKV without re-encoding","MOV: H.264 + AAC copiati senza perdita (su YouTube l'H.264 arriva al massimo a 1080p). Se un video non esiste in H.264 viene convertito (pi\u00f9 lento). I sottotitoli restano file a parte.":"MOV: H.264 + AAC copied losslessly (on YouTube H.264 goes up to 1080p). If a video is not available in H.264 it gets converted (slower). Subtitles stay separate files.","MP3 (lo standard dell'AVI)":"MP3 (the AVI standard)","MP4 (cambio contenitore)":"MP4 (container change)","MP4 AV1 veloce":"MP4 AV1 fast","MP4 H.264 (compatibile ovunque)":"MP4 H.264 (plays everywhere)","MP4 H.264 veloce":"MP4 H.264 fast","MP4 H.264 veloce (chip Mac)":"MP4 H.264 fast (Mac chip)","MP4 H.265 / HEVC (pi\u00f9 leggero)":"MP4 H.265 / HEVC (lighter)","MP4 H.265 veloce":"MP4 H.265 fast","MP4 H.265 veloce (chip Mac)":"MP4 H.265 fast (Mac chip)","MP4 \u2190 da MOV/MKV senza ricodifica":"MP4 \u2190 from MOV/MKV without re-encoding","Mancano:":"Missing:","Massima (file grande)":"Maximum (large file)","Massima disponibile":"Best available","Max 1080p":"Max 1080p","Max 1440p":"Max 1440p","Max 480p":"Max 480p","Max 4K":"Max 4K","Max 720p":"Max 720p","Media":"Medium","Metadati (titolo, autore)":"Metadata (title, author)","Migliore (automatico)":"Best (automatic)","Mono":"Mono","Montaggio con alfa \u00b7 ProRes 4444":"Editing with alpha \u00b7 ProRes 4444","Montaggio leggero \u00b7 ProRes 422 Proxy":"Light editing \u00b7 ProRes 422 Proxy","NON DISPONIBILE":"NOT AVAILABLE","NON trovato":"NOT found","Negli appunti non ci sono file: selezionali in Esplora file, premi Ctrl+C e poi \u00abIncolla file\u00bb.":"No files in the clipboard: select them in File Explorer, press Ctrl+C and then \u00abPaste files\u00bb.","Negli appunti non ci sono file: selezionali nel Finder, premi Cmd+C e poi \u00abIncolla file\u00bb.":"No files in the clipboard: select them in the Finder, press Cmd+C and then \u00abPaste files\u00bb.","Nel cambio contenitore chroma key, tela, ripetizioni e avanti-indietro non si applicano: scegli un formato normale.":"When changing container, chroma key, canvas, repeats and forward-backward do not apply: choose a normal format.","Nel cambio contenitore il taglio parte dal fotogramma chiave pi\u00f9 vicino (pu\u00f2 anticipare di qualche frame).":"When changing container the trim starts from 