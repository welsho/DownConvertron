b\u201c\u5b89\u88c5 / \u66f4\u65b0\u7ec4\u4ef6\u201d\u3002","yt-dlp, ffmpeg e Deno sono installati: controlla gli aggiornamenti":"yt-dlp\u3001ffmpeg \u548c Deno \u5df2\u5b89\u88c5\uff1a\u68c0\u67e5\u66f4\u65b0","{0} file":"{0} \u4e2a\u6587\u4ef6","{0} immagini singole":"{0} \u5f20\u5355\u72ec\u56fe\u7247","{0} link":"{0} \u4e2a\u94fe\u63a5","{0} link aggiunti":"\u5df2\u6dfb\u52a0 {0} \u4e2a\u94fe\u63a5","{0} link chiedono l'accesso al sito: entra nel sito con Chrome, apri l'estensione DownConvertron e premi \u00abRiprova con il mio login\u00bb.":"{0} \u4e2a\u94fe\u63a5\u9700\u8981\u767b\u5f55\u7f51\u7ad9\uff1a\u5148\u5728 Chrome \u4e2d\u767b\u5f55\u8be5\u7f51\u7ad9\uff0c\u7136\u540e\u6253\u5f00 DownConvertron \u6269\u5c55\u5e76\u70b9\u51fb\u201c\u7528\u6211\u7684\u767b\u5f55\u91cd\u8bd5\u201d\u3002","{0} link ricevuti dall'estensione Chrome{1}: controlla e premi Scarica quando vuoi.":"\u5df2\u4ece Chrome \u6269\u5c55\u6536\u5230 {0} \u4e2a\u94fe\u63a5{1}\uff1a\u68c0\u67e5\u540e\u968f\u65f6\u70b9\u51fb\u201c\u4e0b\u8f7d\u201d\u3002","{0}: il sito chiede l'accesso, riprovo con il login di Chrome mandato dall'estensione.":"{0}\uff1a\u7f51\u7ad9\u8981\u6c42\u767b\u5f55\uff0c\u6b63\u5728\u7528\u6269\u5c55\u53d1\u9001\u7684 Chrome \u767b\u5f55\u4fe1\u606f\u91cd\u8bd5\u3002","\u00b7 (HEVC: se era \u00abHEVC con alfa\u00bb Apple la trasparenza potrebbe non essere letta: esporta in ProRes 4444)":"\u00b7\uff08HEVC\uff1a\u82e5\u662f Apple \u7684\u201c\u5e26\u900f\u660e HEVC\u201d\uff0c\u900f\u660e\u53ef\u80fd\u65e0\u6cd5\u8bfb\u53d6\uff1a\u8bf7\u5bfc\u51fa\u4e3a ProRes 4444\uff09","\u00b7 HDR: i colori potrebbero risultare pi\u00f9 spenti":"\u00b7 HDR\uff1a\u989c\u8272\u53ef\u80fd\u504f\u6697\u6de1","\u00b7 audio":"\u00b7 \u97f3\u9891","\u00bb non disponibile: \u00e8 stata scaricata la traccia originale.":"\u201d\u4e0d\u53ef\u7528\uff1a\u5df2\u4e0b\u8f7d\u539f\u59cb\u97f3\u8f68\u3002","\u00bb salvato.":"\u201d\u5df2\u4fdd\u5b58\u3002","\u00bb: sostituirlo con le impostazioni attuali?":"\u201d\uff1a\u7528\u5f53\u524d\u8bbe\u7f6e\u66ff\u6362\u5417\uff1f","\u00e8 troppo vecchio e ha falle di sicurezza note. Premi \u00abInstalla / aggiorna componenti\u00bb.":"\u7248\u672c\u592a\u65e7\uff0c\u5b58\u5728\u5df2\u77e5\u5b89\u5168\u6f0f\u6d1e\u3002\u8bf7\u70b9\u51fb\u201c\u5b89\u88c5 / \u66f4\u65b0\u7ec4\u4ef6\u201d\u3002","\u2014 mancano i codec":"\u2014 \u7f3a\u5c11\u7f16\u7801\u5668","\u2022 aggiornare":"\u2022 \u66f4\u65b0","\u2022 installare":"\u2022 \u5b89\u88c5","\u2192 Accesso negato da Twitch: VOD riservato agli abbonati, privato o rimosso. Se sei abbonato, entra su Twitch con Chrome e rimanda il link dall'estensione DownConvertron (oppure entra con Firefox e attiva \u00abUsa login di Firefox\u00bb).":"\u2192 Twitch \u62d2\u7edd\u8bbf\u95ee\uff1a\u8be5 VOD \u4ec5\u9650\u8ba2\u9605\u8005\u3001\u79c1\u5bc6\u6216\u5df2\u5220\u9664\u3002\u5982\u679c\u4f60\u662f\u8ba2\u9605\u8005\uff0c\u8bf7\u5728 Chrome \u4e2d\u767b\u5f55 Twitch\uff0c\u7136\u540e\u4ece DownConvertron \u6269\u5c55\u91cd\u65b0\u53d1\u9001\u94fe\u63a5\uff08\u6216\u7528 Firefox \u767b\u5f55\u5e76\u6253\u5f00\u201c\u4f7f\u7528 Firefox \u767b\u5f55\u201d\uff09\u3002","\u2192 Accesso negato da YouTube: premi \u00abInstalla / aggiorna componenti\u00bb e riprova.":"\u2192 YouTube \u62d2\u7edd\u8bbf\u95ee\uff1a\u70b9\u51fb\u201c\u5b89\u88c5 / \u66f4\u65b0\u7ec4\u4ef6\u201d\u540e\u91cd\u8bd5\u3002","\u2192 Accesso negato dal sito (403): il contenuto potrebbe essere privato o richiedere l'accesso. Entra nel sito con Chrome e rimanda il link dall'estensione DownConvertron, oppure premi \u00abInstalla / aggiorna componenti\u00bb.":"\u2192 \u7f51\u7ad9\u62d2\u7edd\u8bbf\u95ee (403)\uff1a\u5185\u5bb9\u53ef\u80fd\u662f\u79c1\u5bc6\u7684\u6216\u9700\u8981\u767b\u5f55\u3002\u8bf7\u5728 Chrome \u4e2d\u767b\u5f55\u8be5\u7f51\u7ad9\uff0c\u7136\u540e\u4ece DownConvertron \u6269\u5c55\u91cd\u65b0\u53d1\u9001\u94fe\u63a5\uff0c\u6216\u70b9\u51fb\u201c\u5b89\u88c5 / \u66f4\u65b0\u7ec4\u4ef6\u201d\u3002","\u2192 Il sito chiede l'accesso: entra nel sito con Chrome, apri l'estensione DownConvertron e premi \u00abRiprova con il mio login\u00bb (oppure entra con Firefox e attiva \u00abUsa login di Firefox\u00bb).":"\u2192 \u7f51\u7ad9\u8981\u6c42\u767b\u5f55\uff1a\u5148\u5728 Chrome \u4e2d\u767b\u5f55\u8be5\u7f51\u7ad9\uff0c\u7136\u540e\u6253\u5f00 DownConvertron \u6269\u5c55\u5e76\u70b9\u51fb\u201c\u7528\u6211\u7684\u767b\u5f55\u91cd\u8bd5\u201d\uff08\u6216\u7528 Firefox \u767b\u5f55\u5e76\u6253\u5f00\u201c\u4f7f\u7528 Firefox \u767b\u5f55\u201d\uff09\u3002","\u2192 Il video non contiene la traccia richiesta.":"\u2192 \u89c6\u9891\u4e0d\u542b\u6240\u9700\u7684\u97f3\u8f68\u3002","\u2192 Manca ffmpeg: premi \u00abInstalla / aggiorna componenti\u00bb, poi riprova.":"\u2192 \u7f3a\u5c11 ffmpeg\uff1a\u70b9\u51fb\u201c\u5b89\u88c5 / \u66f4\u65b0\u7ec4\u4ef6\u201d\uff0c\u7136\u540e\u91cd\u8bd5\u3002","\u2192 Premi \u00abInstalla / aggiorna componenti\u00bb (installa Deno e aggiorna yt-dlp), poi riprova.":"\u2192 \u70b9\u51fb\u201c\u5b89\u88c5 / \u66f4\u65b0\u7ec4\u4ef6\u201d\uff08\u5b89\u88c5 Deno \u5e76\u66f4\u65b0 yt-dlp\uff09\uff0c\u7136\u540e\u91cd\u8bd5\u3002","\u2192 Sito o link non supportato.":"\u2192 \u4e0d\u652f\u6301\u8be5\u7f51\u7ad9\u6216\u94fe\u63a5\u3002","\u2192 ffmpeg non \u00e8 riuscito a creare questo formato con queste impostazioni: prova qualit\u00e0/codec \u00abAutomatico\u00bb o un altro formato. Se si ripete premi \u00abReport debug\u00bb.":"\u2192 ffmpeg \u65e0\u6cd5\u7528\u8fd9\u4e9b\u8bbe\u7f6e\u751f\u6210\u8be5\u683c\u5f0f\uff1a\u8bd5\u8bd5\u201c\u81ea\u52a8\u201d\u753b\u8d28/\u7f16\u7801\u6216\u6362\u4e00\u79cd\u683c\u5f0f\u3002\u82e5\u518d\u6b21\u51fa\u73b0\u8bf7\u70b9\u51fb\u201c\u8c03\u8bd5\u62a5\u544a\u201d\u3002","\u2192 yt-dlp troppo vecchio per queste opzioni: premi \u00abInstalla / aggiorna componenti\u00bb.":"\u2192 yt-dlp \u7248\u672c\u592a\u65e7\uff0c\u4e0d\u652f\u6301\u8fd9\u4e9b\u9009\u9879\uff1a\u70b9\u51fb\u201c\u5b89\u88c5 / \u66f4\u65b0\u7ec4\u4ef6\u201d\u3002","\u2193 Scarica da link":"\u2193 \u4ece\u94fe\u63a5\u4e0b\u8f7d","\u21bb Converti video":"\u21bb \u8f6c\u6362\u89c6\u9891","\u2714 trasparenza":"\u2714 \u900f\u660e","Login di Chrome non pi\u00f9 usato: cancellato.":"Chrome \u767b\u5f55\u4fe1\u606f\u5df2\u4e0d\u518d\u4f7f\u7528\uff1a\u5df2\u5220\u9664\u3002"}};
/* I18N_FINE */
function T(s) {
  var d = I18N[LANG], r = s, i, k;
  if (LANG !== "it" && d) { k = String(s).replace(/^\s+|\s+$/g, ""); if (d[s]) r = d[s]; else if (k && d[k]) r = String(s).replace(k, d[k]); }
  for (i = 1; i < arguments.length; i++) r = r.split("{" + (i - 1) + "}").join(String(arguments[i]));
  return r;
}
/* testo composto (messaggi con nomi, numeri, percorsi): prima la frase intera, poi i pezzi lunghi
   conosciuti dentro la frase (i pezzi corti solo come frase intera, per non toccare nomi di file) */
var I18N_FRAG = {};
function TX(s) {
  if (LANG === "it" || s === undefined || s === null) return s;
  s = String(s);
  var d = I18N[LANG], k = s.replace(/^\s+|\s+$/g, "");
  if (!k) return s;
  if (d[k]) return s.replace(k, d[k]);
  var fr = I18N_FRAG[LANG], i;
  if (!fr) {
    fr = [];
    for (var key in d) if (d.hasOwnProperty(key) && key.length >= 10 && key.indexOf("{") < 0) fr.push(key);
    fr.sort(function (a, b) { return b.length - a.length; });
    I18N_FRAG[LANG] = fr;
  }
  for (i = 0; i < fr.length; i++) if (s.indexOf(fr[i]) >= 0) s = s.split(fr[i]).join(d[fr[i]]);
  return s;
}
/* testi fissi della pagina: letti una volta all'avvio (in italiano), riscritti a ogni cambio di lingua */
var I18N_NODES = null;
function i18nScan() {
  I18N_NODES = [];
  var walk = function (el) {
    for (var n = el.firstChild; n; n = n.nextSibling) {
      if (n.nodeType === 3) { if (/[A-Za-z\u00c0-\u00ff]{2}/.test(n.nodeValue)) I18N_NODES.push([n, null, n.nodeValue]); }
      else if (n.nodeType === 1) {
        var tg = String(n.tagName).toLowerCase();
        if (tg === "script" || tg === "style" || tg === "svg" || n.id === "langSlot") continue;
        if (n.getAttribute && n.getAttribute("title")) I18N_NODES.push([n, "title", n.getAttribute("title")]);
        if (n.getAttribute && n.getAttribute("placeholder")) I18N_NODES.push([n, "placeholder", n.getAttribute("placeholder")]);
        if (tg === "optgroup" && n.getAttribute("label")) I18N_NODES.push([n, "label", n.getAttribute("label")]);   /* gruppi dei menu */
        walk(n);
      }
    }
  };
  walk(document.body);
}
function i18nText(orig) {
  var k = orig.replace(/\s+/g, " ").replace(/^\s+|\s+$/g, "");
  if (!k || LANG === "it") return orig;
  var t = TX(k);
  if (t === k) return orig;
  return (/^\s/.test(orig) ? " " : "") + t + (/\s$/.test(orig) ? " " : "");
}
function i18nApply() {
  if (!I18N_NODES) i18nScan();
  for (var i = 0; i < I18N_NODES.length; i++) {
    var r = I18N_NODES[i];
    try { if (r[1]) r[0].setAttribute(r[1], i18nText(r[2])); else r[0].nodeValue = i18nText(r[2]); } catch (e) {}
  }
  var bs = $("langSlot") ? $("langSlot").getElementsByTagName("button") : [];
  for (i = 0; i < bs.length; i++) bs[i].className = bs[i].getAttribute("data-l") === LANG ? "on" : "";
  try { document.documentElement.lang = LANG === "zh" ? "zh-CN" : LANG; } catch (e2) {}
}
function langDefault() {
  var l = String(navigator.userLanguage || navigator.language || navigator.browserLanguage || "it").toLowerCase();
  return l.indexOf("zh") === 0 ? "zh" : l.indexOf("it") === 0 ? "it" : "en";
}
/* cambio di lingua immediato: testi fissi, menu, liste, spie, registro, estensione Chrome */
function setLang(l) {
  if (l !== "it" && l !== "en" && l !== "zh") l = "it";
  LANG = l;
  i18nApply();
  try {
    fillAudioSelects($("aq").value, $("aRate").value);
    fillVideoSelects($("codec").value, $("vAudio").value);
    cvFillAudio($("cvAudio").value);
    cvPresetFill($("cvPreset").value);
    hwApply();
    renderQueue(); cvRender(); checkCombo(); cvCheck(); refreshCompButton();
    if (!state.busy) setBusy(false);
    sysRender(); logTabs(); logRender(); logHeadFit();
    if (state.tab) showTab(state.tab);
  } catch (e) { DEBUG_ERRORS.push("setLang: " + (e.message || e)); }
  extWriteLang();
  saveSettings();
  logEvent("app", T("Lingua: italiano"), "info", true);
  fitToScreen(false);
}

/* ---------- registro: lo schermo sotto i piedi del mecha ----------
   Tutto quello che succede: messaggi dell'app, link e impostazioni arrivati dall'estensione Chrome,
   righe di yt-dlp / ffmpeg / winget (senza le righe di avanzamento). Filtri, copia e salvataggio. */
var LOG = { all: [], filter: "all", max: 3000, shown: 0, errs: 0 };
var LOG_TAG = { app: "APP", ext: "CHROME", tool: "TOOL" };
function pad2(n) { return (n < 10 ? "0" : "") + n; }
function logTime() { var d = new Date(); return pad2(d.getHours()) + ":" + pad2(d.getMinutes()) + ":" + pad2(d.getSeconds()); }
function logEvent(cat, text, level, notice) {
  text = String(text == null ? "" : text).replace(/\s+$/, "");
  if (!text) return;
  var e = { t: logTime(), c: cat || "app", l: level || "info", x: text };
  LOG.all.push(e);
  if (LOG.all.length > LOG.max) LOG.all.shift();
  if (e.l === "err" && LOG.filter !== "err") { LOG.errs++; logTabs(); }
  if (logMatch(e)) logAppend(e);
  if (notice) { try { tickerNotice(text); } catch (x) {} }
}
function logMatch(e) { var f = LOG.filter; return f === "all" || (f === "err" ? (e.l === "err" || e.l === "warn") : e.c === f); }
function logLine(e) {
  var d = document.createElement("div"), t = document.createElement("span"), c = document.createElement("span");
  d.className = "lg " + e.c + (e.l !== "info" ? " " + e.l : "");
  t.className = "t"; t.innerText = e.t;
  c.className = "c"; c.innerText = LOG_TAG[e.c] || String(e.c).toUpperCase();
  d.appendChild(t); d.appendChild(c); d.appendChild(document.createTextNode(e.c === "tool" ? e.x : TX(e.x)));
  return d;
}
function logAppend(e) {
  var b = $("logBody");
  if (!b) return;
  var stick = b.scrollTop + b.clientHeight >= b.scrollHeight - 30;
  if (b.firstChild && b.firstChild.className === "logempty") b.innerHTML = "";
  b.appendChild(logLine(e)); LOG.shown++;
  while (LOG.shown > 500 && b.firstChild) { b.removeChild(b.firstChild); LOG.shown--; }
  if (stick) b.scrollTop = b.scrollHeight;
}
function logRender() {
  var b = $("logBody"), list = [], i;
  if (!b) return;
  b.innerHTML = ""; LOG.shown = 0;
  for (i = LOG.all.length - 1; i >= 0 && list.length < 500; i--) if (logMatch(LOG.all[i])) list.unshift(LOG.all[i]);
  for (i = 0; i < list.length; i++) { b.appendChild(logLine(list[i])); LOG.shown++; }
  if (!list.length) { var d = document.createElement("div"); d.className = "logempty"; d.innerText = T("Nessuna voce in questa sezione."); b.appendChild(d); }
  b.scrollTop = b.scrollHeight;
}
function logFilter(f) { LOG.filter = f; if (f === "err") LOG.errs = 0; logTabs(); logRender(); }
function logTabs() {
  var bs = $("logTabs").getElementsByTagName("button"), i;
  for (i = 0; i < bs.length; i++) {
    var f = bs[i].getAttribute("data-f");
    bs[i].className = f === LOG.filter ? "on" : "";
    if (f === "err") bs[i].innerHTML = T("ERRORI") + (LOG.errs ? " <b>" + LOG.errs + "</b>" : "");
  }
  try { logHeadFit(); } catch (e) {}
}
function logText() {
  var r = [], i, e;
  for (i = 0; i < LOG.all.length; i++) { e = LOG.all[i]; r.push(e.t + " [" + (LOG_TAG[e.c] || e.c) + "]" + (e.l !== "info" ? " (" + e.l + ")" : "") + " " + (e.c === "tool" ? e.x : TX(e.x))); }
  return r.join("\r\n");
}
function logCopy() {
  try { window.clipboardData.setData("Text", logText()); showMsg(T("Registro copiato negli appunti ({0} righe).", LOG.all.length), "ok"); }
  catch (e) { showMsg(T("Non riesco a copiare il registro: {0}", e.message || e), "err"); }
}
function logSave() {
  var d = new Date(), name = "registro_" + d.getFullYear() + pad2(d.getMonth() + 1) + pad2(d.getDate()) + "_" + pad2(d.getHours()) + pad2(d.getMinutes()) + pad2(d.getSeconds()) + ".txt";
  var p = DIR_APP + "\\" + name;
  try { writeUtf8(p, "DownConvertron v" + APP_VER + " - " + T("registro") + "\r\n" + logText() + "\r\n"); showMsg(T("Registro salvato: {0}", p), "ok"); }
  catch (e) { showMsg(T("Non riesco a salvare il registro: {0}", e.message || e), "err"); }
}
function logClear() { LOG.all = []; LOG.errs = 0; logTabs(); logRender(); }
/* righe degli strumenti: tengo quelle che spiegano qualcosa, salto l'avanzamento */
function logToolLine(l) {
  if (!l || (state.token && l.indexOf(state.token) === 0)) return;
  var t = l.substring(l.lastIndexOf("\r") + 1).replace(/[\x00-\x08\x0b-\x1f\x7f]/g, "").replace(/^\s+|\s+$/g, "");
  if (!t || !/[A-Za-z0-9\u4e00-\u9fff]{2}/.test(t)) return;
  if (/^\[download\]\s+[\d.]+%/.test(t)) return;
  if (/^(frame|fps|stream_\d+_\d+_q|bitrate|total_size|out_time\w*|dup_frames|drop_frames|speed|progress)=/.test(t)) return;
  if (/^[\u2580-\u259f\-\\|\/ ]+[\d.]+\s*(KB|MB|GB|%)/.test(t)) return;          /* barre di winget */
  logEvent("tool", t.length > 400 ? t.substring(0, 400) + "\u2026" : t, /^ERROR|\berror\b:/i.test(t) ? "err" : (/^WARNING/.test(t) ? "warn" : "info"));
}
/* lo schermo occupa lo spazio sotto i piedi; se lo spazio non c'e', fitToScreen rimpicciolisce il mecha quanto basta */
var LOG_MIN = 128;
function logLayout() {
  var scr = $("logScreen"), page = $("page"), root = $("root");
  if (!scr || !page || !root) return;
  var vh = page.clientHeight || document.documentElement.clientHeight, rh = root.getBoundingClientRect().height;
  var h = Math.max(LOG_MIN, Math.floor(vh - rh - 6));
  scr.style.width = Math.round(820 * ZOOM) + "px";
  scr.style.height = h + "px";
  logHeadFit();
}
function logHeadFit() {
  var tt = $("logTtl"), tabs = $("logTabs");
  if (!tt || !tabs) return;
  tt.style.display = ""; tt.innerText = T("REGISTRO DI SISTEMA");
  if (tabs.scrollWidth > tabs.clientWidth + 1) tt.innerText = T("REGISTRO");
  if (tabs.scrollWidth > tabs.clientWidth + 1) tt.style.display = "none";
}

/* ---------- spie del secondo schermo: stato reale dei componenti ----------
   REATTORE = yt-dlp (rosso se manca, non parte o ha piu' di YT_MAX_AGE giorni: YouTube cambia spesso)
   LINK     = Deno + connessione (servono per leggere YouTube)
   ENCODER  = ffmpeg + ffprobe con tutti i codec
   COMPONENTI = riassunto; clic su una spia = installa / aggiorna quella parte */
var YT_MAX_AGE = 60;
var SYSST = { ytv: "", ytPath: "", net: null, netAt: 0, last: {} };
function ytAgeDays(v) {
  var m = /^(\d{4})\.(\d{2})\.(\d{2})/.exec(v || "");
  if (!m) return -1;
  return Math.floor((new Date().getTime() - new Date(+m[1], +m[2] - 1, +m[3]).getTime()) / 86400000);
}
function sysYtVersion(force) {
  var p = findTool("yt-dlp.exe");
  if (!p) { SYSST.ytv = ""; SYSST.ytPath = ""; return; }
  if (!force && SYSST.ytPath === p && SYSST.ytv) return;
  SYSST.ytPath = p;
  SYSST.ytv = readVersion(p) || "?";
  if (SYSST.ytv !== "?") state.version = SYSST.ytv;
}
function sysEval() {
  var cs = componentState(), by = {}, r = {}, bad = [], i;
  for (i = 0; i < cs.length; i++) by[cs[i].c.exe] = cs[i];
  var y = by["yt-dlp.exe"], f = by["ffmpeg.exe"], d = by["deno.exe"];
  if (!y.path) r.yt = ["bad", T("REATTORE: yt-dlp manca. Clic per installarlo.")];
  else if (!SYSST.ytv) r.yt = ["wait", T("REATTORE: controllo la versione di yt-dlp...")];
  else if (SYSST.ytv === "?") r.yt = ["bad", T("REATTORE: yt-dlp non parte. Clic per reinstallarlo.")];
  else {
    var age = ytAgeDays(SYSST.ytv);
    if (SYSST.ytv < MIN_YTDLP || age > YT_MAX_AGE) r.yt = ["bad", T("REATTORE: yt-dlp {0} da aggiornare ({1} giorni). Clic per aggiornarlo.", SYSST.ytv, age)];
    else r.yt = ["ok", T("REATTORE: yt-dlp {0}, aggiornato ({1} giorni). Clic per controllare gli aggiornamenti.", SYSST.ytv, age)];
  }
  if (!d.path) r.link = ["bad", T("LINK: Deno manca (serve per leggere YouTube). Clic per installarlo.")];
  else if (SYSST.net === false) r.link = ["bad", T("LINK: nessuna connessione a internet. Clic per riprovare.")];
  else if (SYSST.net === null) r.link = ["wait", T("LINK: controllo la connessione...")];
  else r.link = ["ok", T("LINK: Deno presente e connessione attiva. Clic per controllare gli aggiornamenti.")];
  if (!f.path) r.enc = ["bad", T("ENCODER: ffmpeg o ffprobe mancano. Clic per installarli.")];
  else if (f.incomplete && f.incomplete.length) r.enc = ["bad", T("ENCODER: a ffmpeg mancano i codec {0}. Clic per installare la versione completa.", encNames(f.incomplete))];
  else r.enc = ["ok", T("ENCODER: ffmpeg pronto con tutti i codec. Clic per controllare gli aggiornamenti.")];
  /* COMPONENTI: l'estensione Chrome (installata davvero in Chrome e alla versione dell'app) */
  if (!EXTCHK.st) r.comp = ["wait", T("COMPONENTI: controllo l'estensione Chrome...")];
  else if (EXTCHK.st === "nochrome") r.comp = ["bad", T("COMPONENTI: Google Chrome non trovato. Installa Chrome, poi clic qui per aggiungere l'estensione.")];
  else if (EXTCHK.st === "missing") r.comp = ["bad", T("COMPONENTI: estensione Chrome non installata. Clic per installarla.")];
  else if (EXTCHK.st === "old") r.comp = ["bad", T("COMPONENTI: estensione Chrome da aggiornare alla {0}. Clic per aggiornarla.", APP_VER)];
  else r.comp = ["ok", T("COMPONENTI: estensione Chrome {0} installata ({1}). Clic per reinstallarla.", EXTCHK.ver, EXTCHK.prof)];
  return r;
}
function sysRender() {
  var r, keys = ["yt", "link", "enc", "comp"], ids = ["sysYt", "sysLink", "sysEnc", "sysComp"], i;
  try { r = sysEval(); } catch (e) { DEBUG_ERRORS.push("sysEval: " + (e.message || e)); return; }
  for (i = 0; i < keys.length; i++) {
    var el = $(ids[i]), v = r[keys[i]];
    if (!el) continue;
    el.className = "sys" + (v[0] === "bad" ? " bad" : v[0] === "wait" ? " wait" : "") + (keys[i] !== "comp" ? " act" : "");
    el.title = v[1];
    if (SYSST.last[keys[i]] !== v[0] && v[0] !== "wait") logEvent("app", v[1].replace(/\s*(Clic|Click|\u70b9\u51fb).*$/, ""), v[0] === "bad" ? "warn" : "ok", v[0] === "bad");
    SYSST.last[keys[i]] = v[0];
  }
}
function sysClick(k) {
  if (state.busy) { showMsg(T("Attendi la fine del lavoro in corso, poi riprova."), "info"); return; }
  if (k === "link" && SYSST.net === false && findTool("deno.exe")) { showMsg(T("Nessuna connessione a internet: controllo di nuovo..."), "info"); sysNet(); return; }
  if (k === "comp") { extInstall(); return; }
  installComponents(k === "yt" ? ["yt-dlp"] : k === "link" ? ["Deno"] : ["ffmpeg"]);
}
/* connessione: richiesta leggera a YouTube, in background (sul Mac la sostituisce mac.js) */
function sysNet() {
  var done = false, x = null;
  var fin = function (ok) { if (done) return; done = true; var was = SYSST.net; SYSST.net = ok; SYSST.netAt = new Date().getTime(); if (was !== ok) sysRender(); };
  try {
    x = new ActiveXObject("MSXML2.XMLHTTP");
    x.open("GET", "https://www.youtube.com/generate_204?dcvt=" + new Date().getTime(), true);
    x.onreadystatechange = function () { if (x.readyState === 4) { var s = 0; try { s = x.status; } catch (e) {} fin(s > 0 && s < 12000); } };
    x.send();
  } catch (e) { fin(false); }
  setTimeout(function () { if (!done) { try { x.abort(); } catch (e) {} fin(false); } }, 12000);
}
function sysStart() {
  sysRender();
  setTimeout(function () { try { extPrepare(); extCheck(true); } catch (e) {} }, 3500);
  setTimeout(function () { try { sysYtVersion(false); } catch (e) {} sysRender(); }, 2500);
  sysNet();
  setInterval(function () { if (!state.busy) sysNet(); }, 5 * 60 * 1000);
}

/* ---------- messaggi di stato in alternanza con le frasi del display ---------- */
function statusNotices() {
  var r = [], n = 0, i;
  try {
    var rs = sysEval(), bad = 0;
    for (var k in rs) if (rs[k][0] === "bad") bad++;
    r.push(bad ? T("SPIE: {0} DA SISTEMARE", bad) : T("SPIE: TUTTO VERDE"));
    if (SYSST.ytv && SYSST.ytv !== "?") r.push(T("REATTORE yt-dlp {0}", SYSST.ytv));
    r.push(SYSST.net === false ? T("LINK OFFLINE") : T("LINK ONLINE"));
    var g = [], vend = "";
    for (var c in HW.enc) if (HW.enc[c]) { g.push(c.toUpperCase()); vend = HW.vendor[c] || vend; }
    if (g.length) r.push(T("ENCODER GPU {0}: {1}", vend.toUpperCase(), g.join(" ")));
  } catch (e) {}
  for (i = 0; i < state.items.length; i++) if (state.items[i].status === "wait") n++;
  if (n) r.push(T("LISTA: {0} LINK IN ATTESA", n));
  if (cv.items.length) r.push(T("CONVERTITORE: {0} FILE IN LISTA", cv.items.length));
  if (EXTST.lastAt) r.push(T("CHROME: ULTIMO INVIO ALLE {0}", EXTST.lastAt));
  r.push(T("LINGUA: {0}", LANG.toUpperCase()));
  return r;
}

/* ---------- componenti esterni (winget, sorgente ufficiale) ----------
   Installa quello che manca e aggiorna quello che c'e'. Nessun dato dell'utente nella riga di comando:
   solo id di pacchetto fissi e il percorso di winget. */
var COMPONENTS = [
  { id: "yt-dlp.yt-dlp", exe: "yt-dlp.exe", name: "yt-dlp", why: "scarica i video" },
  { id: "yt-dlp.FFmpeg", exe: "ffmpeg.exe", name: "ffmpeg", why: "unisce audio e video e converte (VP9, Opus, ProRes)" },
  { id: "DenoLand.Deno", exe: "deno.exe", name: "Deno", why: "serve a yt-dlp per leggere YouTube" }
];
function componentState() {
  var out = [], i;
  for (i = 0; i < COMPONENTS.length; i++) {
    var c = COMPONENTS[i], p = findTool(c.exe), inc = [];
    if (p && c.exe === "ffmpeg.exe" && !findTool("ffprobe.exe")) p = "";
    if (p && c.exe === "ffmpeg.exe") inc = missingEncoders(ENC_ALL);   /* codec audio e video necessari */
    out.push({ c: c, path: p, incomplete: inc });
  }
  return out;
}
function refreshCompButton() {
  var st = componentState(), miss = [], i;
  for (i = 0; i < st.length; i++) {
    if (!st[i].path) miss.push(st[i].c.name);
    else if (st[i].incomplete && st[i].incomplete.length) miss.push(st[i].c.name + " (codec mancanti: " + encNames(st[i].incomplete) + ")");
  }
  var b = $("compBtn");
  b.innerText = TX("Installa / aggiorna componenti");
  b.className = "btn sm lockable" + (miss.length ? " attn" : "");
  b.title = TX(miss.length ? "Mancano: " + miss.join(", ") : "yt-dlp, ffmpeg e Deno sono installati: controlla gli aggiornamenti");
  return miss;
}
function installComponents(only) {
  if (state.busy) { if (state.job === "setup") cancel(); return false; }
  var want = function (c) { if (!only || !only.length) return true; for (var w = 0; w < only.length; w++) if (only[w] === c.name) return true; return false; };
  $("msg").style.display = "none";
  if (!fso.FileExists(EXE_WINGET)) {
    showMsg("Su questo PC manca winget (\u00abProgramma di installazione app\u00bb di Microsoft). Si apre ora la pagina ufficiale https://aka.ms/getwinget: installalo, poi premi di nuovo \u00abInstalla / aggiorna componenti\u00bb.", "err");
    try { sh.Run('"' + EXE_EXPLORER + '" "https://aka.ms/getwinget"', 1, false); } catch (e) {}
    return false;
  }
  var st = componentState(), lines = [], i;
  for (i = 0; i < st.length; i++) if (want(st[i].c)) lines.push((st[i].path && !(st[i].incomplete && st[i].incomplete.length) ? "\u2022 aggiornare   " : "\u2022 installare   ") + st[i].c.name + "  (" + st[i].c.why + ")" + (st[i].incomplete && st[i].incomplete.length ? "  \u2014 mancano i codec " + encNames(st[i].incomplete) : ""));
  if (!confirmT("DownConvertron user\u00e0 winget, dalla sorgente ufficiale \u00abwinget\u00bb di Microsoft, per:\n\n" + lines.join("\n") +
      "\n\nVerranno accettate automaticamente le condizioni d'uso dei pacchetti e della sorgente winget.\nL'installazione \u00e8 per il tuo utente quando il pacchetto lo consente. Pu\u00f2 richiedere qualche minuto e, raramente, Windows pu\u00f2 chiedere un permesso.\nPuoi interromperla con lo stesso pulsante.\n\nContinuare?")) return false;
  ensureDir(DIR_TMP);
  cleanupTmp();
  state.files = jobFiles("setup");
  state.current = null; state.setupStep = 0; state.setupRes = {}; state.setupCode = {}; state.setupLast = {}; state.cancelled = false; state.setupTimeout = false;
  var parts = [];
  for (i = 0; i < st.length; i++) {
    if (!want(st[i].c)) continue;
    /* "upgrade" solo per le copie gestite da winget; una copia esterna (scelta a mano, altro installer) va installata */
    var managed = /\\WinGet\\(Links|Packages)\\/i.test(st[i].path) && !(st[i].incomplete && st[i].incomplete.length), verb = managed ? "upgrade" : "install", n = i + 1;
    var base = '"' + EXE_WINGET + '" ' + verb + " --id " + st[i].c.id + " -e --source winget --silent --accept-source-agreements --accept-package-agreements --disable-interactivity";
    var cmdw = verb === "install" ? "(" + base + " --scope user || " + base + ")" : base;
    parts.push("echo SVSTEP " + n + " " + st[i].c.name + " " + verb);
    /* %^errorlevel% + call: legge il codice di uscita reale di winget (anche negativo) */
    parts.push(cmdw + " && (echo SVEXIT " + n + " OK 0) || (call echo SVEXIT " + n + " KO %^errorlevel%)");
  }
  state.setupVerb = st;
  setBusy(true, "setup");
  /* il pulsante resta attivo per poter annullare */
  var cb = $("compBtn"); cb.disabled = false; cb.className = "btn sm"; cb.innerText = TX("Annulla installazione");
  showStatus();
  $("overall").innerText = TX("Componenti: avvio di winget..."); $("fill").style.width = "0%"; $("pct").innerText = ""; $("spd").innerText = ""; $("file").innerText = "";
  state.killProc = "cmd.exe"; state.killTag = baseName(state.files.log);
  runCommand("(" + parts.join(" & ") + " & ver > nul)");
  return true;
}
function setupLine(l) {
  var tail = l.substring(l.lastIndexOf("\r") + 1);
  var m = tail.match(/^SVSTEP (\d) (\S+) (\w+)/);
  if (m) {
    state.setupStep = +m[1];
    $("overall").innerText = T("Componente {0} di {1}", m[1], COMPONENTS.length) + "  \u2022  " + m[2] + (m[3] === "install" ? T(" (installazione)") : T(" (controllo aggiornamenti)"));
    $("fill").style.width = Math.round((+m[1] - 1) / COMPONENTS.length * 100) + "%";
    return "";
  }
  m = tail.match(/^SVEXIT (\d) (OK|KO) ?(-?\d+)?/);
  if (m) { state.setupRes[+m[1]] = m[2]; state.setupCode[+m[1]] = m[3] ? parseInt(m[3], 10) : null; $("fill").style.width = Math.round(+m[1] / COMPONENTS.length * 100) + "%"; return ""; }
  /* winget scrive barre di avanzamento con \r e caratteri grafici: mostro l'ultima frase leggibile */
  var seg = l.split("\r"), t = "", i;
  for (i = seg.length - 1; i >= 0 && !t; i--) { var c = seg[i].replace(/[^\x20-\x7e]/g, "").replace(/^\s+|\s+$/g, ""); if (/[A-Za-z]{3}/.test(c)) t = c; }
  if (t) { $("file").innerText = t.substring(0, 150); if (state.setupStep) state.setupLast[state.setupStep] = t; }
  return "";
}
var WINGET_NO_UPDATE = -1978335189;   /* 0x8A15002B: nessun aggiornamento disponibile */
function hexCode(c) { return "0x" + ((c >>> 0).toString(16).toUpperCase()); }
function setupDone() {
  setBusy(false);
  cv.encOk = null; encCache = null;        /* ffmpeg potrebbe essere cambiato */
  /* dopo l'installazione preferisco le copie di winget: svuoto la cache (la scelta manuale resta solo se serve) */
  var oldYt = toolCache["yt-dlp.exe"]; toolCache = {}; filtCache = null;
  setTimeout(function () { try { hwDetect(true); } catch (e) {} }, 500);
  if (!findTool("yt-dlp.exe") && oldYt && fso.FileExists(oldYt)) toolCache["yt-dlp.exe"] = oldYt;
  var st = componentState(), lines = [], bad = 0, warn = 0, i;
  for (i = 0; i < st.length; i++) {
    var n = i + 1, ok = !!st[i].path, res = state.setupRes[n], code = state.setupCode[n], note = "";
    if (ok && st[i].c.exe === "yt-dlp.exe") { var v = readVersion(st[i].path); if (v) note = " " + v; }
    if (!ok) {
      bad++;
      note = " NON trovato" + (res === "KO" && code !== null && code !== undefined ? " (winget codice " + hexCode(code) + ")" : "") + (state.setupLast[n] ? "  \u2014 " + state.setupLast[n].substring(0, 110) : "");
    } else if (st[i].incomplete && st[i].incomplete.length) { bad++; note += "  (mancano ancora i codec " + encNames(st[i].incomplete) + ")"; }
    else if (res === "OK") note += "  (installato/aggiornato)";
    else if (res === "KO" && code === WINGET_NO_UPDATE) note += "  (gi\u00e0 all'ultima versione)";
    else if (res === "KO") { warn++; note += "  (presente, ma winget ha dato errore " + (code !== null && code !== undefined ? hexCode(code) : "") + ")"; }
    else if (state.cancelled) note += "  (non verificato: interrotto)";
    lines.push((ok ? "\u2714 " : "\u2716 ") + st[i].c.name + note);
  }
  refreshCompButton();
  saveSettings();
  try { sysYtVersion(true); SYSST.net = null; sysRender(); sysNet(); } catch (e3) {}
  $("pct").innerText = ""; $("spd").innerText = "";
  var head = state.setupTimeout ? "Installazione interrotta dopo 15 minuti senza risposta da winget (forse \u00e8 in corso un'altra installazione o un aggiornamento di Windows).\n"
           : (state.cancelled ? "Installazione annullata.\n" : "");
  if (!bad && !warn && !state.cancelled) {
    $("fill").style.width = "100%"; $("overall").innerText = TX("Componenti pronti");
    showMsg("Componenti pronti:\n" + lines.join("\n") + "\n\nSe un download non parte subito, chiudi e riapri DownConvertron.", "ok");
  } else if (!bad) {
    $("overall").innerText = TX("Componenti presenti");
    showMsg(head + "Componenti presenti:\n" + lines.join("\n") + (warn ? "\n\nI programmi ci sono e funzionano, ma un aggiornamento non \u00e8 andato a buon fine: puoi riprovare pi\u00f9 tardi." : ""), "info");
  } else {
    $("overall").innerText = TX("Componenti mancanti");
    showMsg(head + "Installazione non completa:\n" + lines.join("\n") + "\n\nRiprova; se continua, premi \u00abReport debug\u00bb e incollami il testo.", "err");
  }
  state.cancelled = false;
  cleanupTmp();
}

/* ---------- display della testa: DOWNCONVERTRON fisso, sotto frasi a caso alternate agli avvisi ---------- */
var PHRASES = ["Deh pefforza!", "Si va a letto.", "Puzzo!", "Avete mai cacato nel puzzo?", "\u00c8 l'ora dello sbusto!", "Sei bravo a parole, ma con i pugni come te la cavi?", "Darion, ma cosa fai?", "\u00c8 vero, \u00e8 vero.", "Voglio caricarlo!", "Mi mancano.", "Babidi.", "Ciao brotheroni!", "Dariong", "Frogs!", "Bravo Ema!", "Lo fanno.", "Tocca.", "Denso.", "Bimbi.", "Mia madre / mio padre / mio fratello / mia sorella.", "D'altronde.", "Fantasista.", "Una golem.", "Ha detto demente.", "Perffoooorza!", "Calmo Dario.", "Non vi conviene dire cringe.", "Sono siciliano.", "E vomito anche l'anima.", "Se non \u00e8 cos\u00ec non lo voglio.", "A te per forza si balla.", "Oss.", "L'imperatore di Pontedera.", "La cashcata!"];
var ticker = { bag: [], notices: [], next: "phrase", x: 0, timer: null, last: "" };
function nextPhrase() {
  if (!ticker.bag.length) {                          /* sacchetto: tutte le frasi prima di ripeterne una */
    for (var i = 0; i < PHRASES.length; i++) ticker.bag.push(PHRASES[i]);
    for (var j = ticker.bag.length - 1; j > 0; j--) { var k = Math.floor(Math.random() * (j + 1)), t = ticker.bag[j]; ticker.bag[j] = ticker.bag[k]; ticker.bag[k] = t; }
    if (ticker.bag.length > 1 && ticker.bag[ticker.bag.length - 1] === ticker.last) ticker.bag.unshift(ticker.bag.pop());
  }
  ticker.last = ticker.bag.pop();
  return ticker.last;
}
function shortText(t) { t = String(t || "").split("\n")[0].replace(/\s+/g, " ").replace(/^\s+|\s+$/g, ""); return t.length > 90 ? t.substring(0, 88) + "\u2026" : t; }
function tickerNotice(t) { t = shortText(t); if (!t) return; if (ticker.notices.length > 4) ticker.notices.shift(); ticker.notices.push(t); }
function liveNotice() {
  /* priorit\u00e0: avvisi recenti, poi lo stato del lavoro in corso, poi lo stato del sistema */
  if (ticker.notices.length) return ticker.notices.shift();
  if (state.busy) {
    var a = $("overall").innerText, b = $("pct").innerText;
    return shortText((a || "Lavoro in corso") + (b ? "  " + b : ""));
  }
  try { var miss = []; var cs = componentState(); for (var i = 0; i < cs.length; i++) if (!cs[i].path) miss.push(cs[i].c.name); if (miss.length) return "MANCANO COMPONENTI: " + miss.join(", "); } catch (e) {}
  var idle = [T("SISTEMI ONLINE"), T("PRONTO \u2022 {0}", state.tab === "cv" ? T("CONVERTITORE") : T("DOWNLOAD DA LINK")), "designed by Welsho"].concat(statusNotices());
  return idle[Math.floor(Math.random() * idle.length)];
}
function tickerShow() {
  var el = $("tick"), box = $("tickBox");
  var isPhrase = ticker.next === "phrase";
  el.className = "marquee " + (isPhrase ? "phrase" : "notice");
  el.innerText = isPhrase ? nextPhrase() : "\u25C6 " + TX(liveNotice());
  ticker.next = isPhrase ? "notice" : "phrase";
  ticker.x = box.offsetWidth || 140;
  el.style.left = ticker.x + "px";
}
function tickerStep() {
  try {
    var el = $("tick");
    ticker.x -= 1;
    if (ticker.x < -(el.offsetWidth || 0) - 4) tickerShow();
    else el.style.left = ticker.x + "px";
  } catch (e) {}
}
function startTicker() { if (ticker.timer) return; tickerShow(); ticker.timer = setInterval(tickerStep, 28); }

/* ---------- tutto in un'altezza di schermo ----------
   Misura l'altezza della scheda pi\u00f9 lunga e rimpicciolisce il mecha (zoom) quanto basta,
   senza scendere sotto il minimo leggibile: oltre quello resta un breve scorrimento. Lo spazio del riquadro di
   avanzamento e' gia' contato a riposo (prima, durante un download, tagliava il registro sotto i piedi). */
var ZOOM = 1, fitTimer = null, SUIT_W = 1160;
/* minimo leggibile: 0,65 (portatili 1366x768 e 1600x900 in una schermata); mshta lavora in pixel reali anche al 125% */
function dpiRatio() { try { if (screen.deviceXDPI && screen.logicalXDPI) return screen.deviceXDPI / screen.logicalXDPI; } catch (e) {} return window.devicePixelRatio || 1; }
var MIN_ZOOM = 0.65;
/* riquadro di avanzamento visibile: il registro sotto i piedi si accorcia dello spazio gia' riservato */
function showStatus() { $("status").style.display = "block"; layoutRefresh(); }
/* dopo un riquadro che compare: il registro si accorcia; se nemmeno cosi' ci sta (messaggio lungo, schermo basso)
   torna la barra di scorrimento invece di tagliare il registro */
function layoutRefresh() {
  try {
    logLayout();
    var page = $("page"), rb = $("root").getBoundingClientRect().bottom;
    if (rb + LOG_MIN + 6 > (page.clientHeight || document.documentElement.clientHeight) + 1) page.style.overflowY = "";
  } catch (e) {}
}
function fitToScreen(first) {
  var root = $("root"), page = $("page"), cur = state.tab === "cv" ? "cv" : "dl", need = 0;
  try {
    root.style.zoom = 1;
    /* misure senza la barra di scorrimento: a zoom 1 il mecha e' piu' alto della finestra e la barra
       toglierebbe 17 px alla larghezza (zoom 0,797 con minimo 0,8 nel report reale) */
    page.style.overflowY = "hidden";
    /* spazio riservato al riquadro di avanzamento e a un messaggio di una riga, anche se ora sono nascosti */
    var st = $("status"), stHid = st.style.display !== "block", mg = $("msg"), mgHid = mg.style.display !== "block", mgDisp = mg.style.display, mgTxt = mg.innerText;
    if (stHid) st.style.display = "block";
    if (mgHid) { mg.innerText = "X"; mg.style.display = "block"; }
    showTab("dl"); need = root.offsetHeight;
    showTab("cv"); need = Math.max(need, root.offsetHeight);
    showTab(cur);
    if (stHid) st.style.display = "";
    if (mgHid) { mg.style.display = mgDisp; mg.innerText = mgTxt; }
    var vh = page.clientHeight || document.documentElement.clientHeight, vw = page.clientWidth || document.documentElement.clientWidth;
    page.style.overflowY = "";
    if (first) {
      vw = screen.availWidth - 40;
      /* all'avvio la finestra non ha ancora l'altezza dello schermo (738 px invece di 1033 nella prova): misuro dallo schermo */
      var chromeH = 0;
      try { chromeH = (window.outerHeight || 0) - (document.documentElement.clientHeight || 0); } catch (xh) {}
      if (!(chromeH > 0 && chromeH < 150)) chromeH = 47;
      vh = Math.max(vh, screen.availHeight - chromeH);
    }
    ZOOM = Math.min((vw - 4) / SUIT_W, Math.max(MIN_ZOOM, Math.min(1, (vh - 10 - LOG_MIN) / need)));   /* sotto i piedi resta lo schermo del registro */
    /* fermo al minimo e ancora piu' alto della finestra: la barra di scorrimento torna e toglie 17 px alla larghezza */
    if (need * ZOOM > vh - 10 - LOG_MIN + 1) ZOOM = Math.min(ZOOM, (vw - 4 - 17) / SUIT_W);
    root.style.zoom = ZOOM;
    /* tutto dentro la finestra: niente barra. In mshta l'area di scorrimento ignora lo zoom (85 px vuoti da scorrere
       a riposo, provato), quindi la tolgo quando il mecha ci sta davvero */
    page.style.overflowY = need * ZOOM > vh - 10 - LOG_MIN + 1 ? "" : "hidden";
    if (first) {
      /* larghezza della finestra = larghezza del mecha + barra di scorrimento e bordi */
      var extra = 0;
      try { extra = (window.outerWidth || 0) - (document.documentElement.clientWidth || 0); } catch (x) {}
      if (!(extra > 0 && extra < 80)) extra = 40;
      var Wn = Math.min(screen.availWidth, Math.round(SUIT_W * ZOOM) + extra + 18);
      window.resizeTo(Wn, screen.availHeight);
      window.moveTo(Math.max(0, Math.round((screen.availWidth - Wn) / 2)), 0);
    }
  } catch (e) { try { page.style.overflowY = ""; if (stHid) st.style.display = ""; if (mgHid) { mg.style.display = mgDisp; mg.innerText = mgTxt; } } catch (x2) {} DEBUG_ERRORS.push("fitToScreen: " + (e.message || e)); }
  try { logLayout(); } catch (e2) {}
}

/* ---------- avvio ---------- */
function appInit() {
  /* cartella corrente sicura: niente programmi pescati da Download o dalla cartella dell'HTA */
  try { sh.CurrentDirectory = SYS + "\\System32"; } catch (e) {}
  /* testi della pagina letti in italiano prima di ogni altra modifica; lingua: impostazioni, altrimenti quella del sistema */
  try { i18nScan(); } catch (e) {}
  LANG = langDefault();
  /* finestra alta quanto lo schermo; il mecha si adatta in fitToScreen() */
  try { window.moveTo(0, 0); window.resizeTo(Math.min(screen.availWidth, 1200), screen.availHeight); } catch (e) {}
  ensureDir(DIR_APP); ensureDir(DIR_TMP);
  /* impostazioni, preset e archivio delle versioni precedenti (DownLTransFMecchazzi, Mecchazzi, Scarica Video) */
  var olds = [DIR_APP_OLD, DIR_APP_OLDER, DIR_APP_OLDEST], oi;
  for (oi = 0; oi < olds.length; oi++) {
    try { if (!fso.FileExists(FILE_SETTINGS) && fso.FileExists(olds[oi] + "\\impostazioni.ini")) fso.CopyFile(olds[oi] + "\\impostazioni.ini", FILE_SETTINGS, true); } catch (e) {}
    try { if (!fso.FileExists(FILE_ARCHIVE) && fso.FileExists(olds[oi] + "\\archivio.txt")) fso.CopyFile(olds[oi] + "\\archivio.txt", FILE_ARCHIVE, true); } catch (e2) {}
  }
  cleanupTmp();
  try { var tf = new Enumerator(fso.GetFolder(DIR_TMP).SubFolders); for (; !tf.atEnd(); tf.moveNext()) if (/^imgs_SVW/.test(tf.item().Name)) { try { tf.item().Delete(true); } catch (y) {} } } catch (e3) {}
  fillAudioSelects();
  fillVideoSelects();
  cvFillAudio();
  loadSettings();
  try { i18nApply(); fillAudioSelects($("aq").value, $("aRate").value); fillVideoSelects($("codec").value, $("vAudio").value); cvFillAudio($("cvAudio").value); } catch (e) {}
  cvPresetFill("");
  setTimeout(function () { try { dropHelperStart(); } catch (e) { DEBUG_ERRORS.push("ricevitore: " + (e.message || e)); } }, 400);
  $("folderPath").innerText = state.folder; $("folderPath").title = state.folder;
  checkCombo();
  renderQueue();
  cvRender(); cvCheck();
  showTab(state.tab === "cv" ? "cv" : "dl");
  logRender();
  logEvent("app", T("DownConvertron {0} avviata. Cartella dati: {1}", APP_VER, DIR_APP));
  fitToScreen(true);
  startTicker();
  try { protoRegister(); } catch (e) {}
  try { nmhRegister(); } catch (e) { DEBUG_ERRORS.push("ponte login: " + (e.message || e)); }
  try { ckCleanup(true); } catch (e) {}
  try { var A0 = htaApp(); if (A0) protoArgs(A0.commandLine); } catch (e) {}
  setTimeout(function () { try { sysStart(); } catch (e) { DEBUG_ERRORS.push("spie: " + (e.message || e)); } }, 300);
  /* controllo componenti all'avvio: se manca qualcosa lo dico subito */
  setTimeout(function () {
    try {
      var miss = refreshCompButton();
      if (miss.length && !state.busy) showMsg(T("Per funzionare DownConvertron ha bisogno di: {0}.", miss.join(", ")) + "\n" + T("Premi \u00abInstalla / aggiorna componenti\u00bb in basso (una volta sola)."), "info");
      checkCombo();
    } catch (e) { DEBUG_ERRORS.push("controllo componenti: " + (e.message || e)); }
  }, 200);
  window.onresize = function () { if (fitTimer) clearTimeout(fitTimer); fitTimer = setTimeout(function () { fitToScreen(false); }, 250); };
  $("cvLink").onkeydown = function (e) { e = e || window.event; if (e.keyCode === 13) cvAddLink(); };
  $("cvPresetName").onkeydown = function (e) { e = e || window.event; if (e.keyCode === 13) cvPresetSave(); };
  /* Ctrl+V (Cmd+V sul Mac) nella scheda Converti, fuori dai campi di testo: incolla i file copiati */
  document.onkeydown = function (e) {
    e = e || window.event;
    var tg = e.target || e.srcElement, tag = tg && tg.tagName ? tg.tagName.toLowerCase() : "";
    if (e.keyCode === 27 && $("pvBox").style.display === "block") { pvClose(); return false; }
    if (e.keyCode === 27 && $("infoBox").style.display === "block") { infoClose(); return false; }
    if (state.tab === "cv" && (e.ctrlKey || e.metaKey) && e.keyCode === 86 && tag !== "input" && tag !== "textarea" && tag !== "select") { cvPasteFiles(); return false; }
  };
  /* accelerazione GPU: rilevata in sottofondo dopo l'avvio */
  setTimeout(function () { try { hwDetect(false); } catch (e) { DEBUG_ERRORS.push("GPU: " + (e.message || e)); } }, 1500);
  /* link mandati dall'estensione Chrome: controllo leggero degli appunti */
  setInterval(function () { try { extPoll(); } catch (e) {} }, 1500);
  window.onfocus = function () { try { extPoll(); } catch (e) {} try { extCheck(false); } catch (e2) {} };
  $("urlIn").onkeydown = function (e) { e = e || window.event; if (e.keyCode === 13) addFromInput(); };
  $("urlIn").focus();
}
if (!window.DCVT_DEFER_INIT) appInit();
</script>
</body>
</html>
