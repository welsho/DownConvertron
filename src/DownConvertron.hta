<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="author" content="Daniele Moretti (Welsho)">
<title>DownConvertron</title>
<hta:application id="app" applicationname="DownConvertron" version="7.0" icon="DownConvertron.ico" border="thin"
  maximizebutton="no" innerborder="no" scroll="no" singleinstance="yes" selection="yes" contextmenu="yes">
<style>

  /* ===== Skin mecha industriale (Welsho - Daniele Moretti) - CSS compatibile IE11/mshta, nessuna variabile CSS =====
     Telaio cromato e piastre con border-image a 9 sezioni: spigoli tagliati, pistoni, bulloni. */
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; height: 100%; }
  body {
    font-family: Bahnschrift, "DIN Alternate", "Segoe UI", "Helvetica Neue", Tahoma, Arial, sans-serif; font-size: 12.5px; color: #d3dbe0; overflow: hidden;
    background-color: #030504;
    background-image: linear-gradient(rgba(57,255,106,0.035) 1px, rgba(0,0,0,0) 1px), linear-gradient(90deg, rgba(57,255,106,0.035) 1px, rgba(0,0,0,0) 1px), radial-gradient(ellipse at 50% 0%, #1a2a20 0%, #050806 55%, #000000 100%);
    background-size: 22px 22px, 22px 22px, 100% 100%;
    scrollbar-face-color: #3d434a; scrollbar-track-color: #0a0c0d; scrollbar-arrow-color: #39ff6a;
    scrollbar-highlight-color: #8d969e; scrollbar-shadow-color: #050607; scrollbar-3dlight-color: #5b636b; scrollbar-darkshadow-color: #000000;
  }

  .lcd {
    position: relative; overflow: hidden; border-radius: 6px; border: 2px solid #11331a;
    background-color: #021006;
    background-image: linear-gradient(rgba(57,255,106,0.08) 1px, rgba(0,0,0,0) 1px), linear-gradient(90deg, rgba(57,255,106,0.08) 1px, rgba(0,0,0,0) 1px);
    background-size: 12px 12px; box-shadow: inset 0 0 14px rgba(0,0,0,0.95), 0 0 0 1px #050607, 0 1px 0 #8d969e;
    color: #39ff6a; font-family: "Lucida Console", Consolas, Menlo, "Courier New", monospace; text-shadow: 0 0 6px rgba(57,255,106,0.75);
  }
  .lcd-title { font-size: 21px; font-weight: bold; letter-spacing: 4px; white-space: nowrap; margin-top: 4px; }
  .lcd-sub { overflow: hidden; white-space: nowrap; color: #9dffb6; font-size: 10.5px; margin-top: 6px; text-align: left; }
  .marquee { display: inline-block; padding-left: 100%; animation: mq 18s linear infinite; }
  @keyframes mq { from { transform: translateX(0); } to { transform: translateX(-100%); } }
  .lcd-tag { position: absolute; left: 8px; top: 4px; font-size: 10px; color: #ff8a1f; letter-spacing: 1px; text-shadow: 0 0 5px rgba(255,138,31,0.8); }
  .led { position: absolute; right: 8px; top: 6px; width: 9px; height: 9px; border-radius: 50%; background: #10301a; box-shadow: inset 0 1px 2px rgba(0,0,0,0.8); }
  .locked .led { background: #ff8a1f; box-shadow: 0 0 8px #ff8a1f; animation: blink 0.8s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0.3; } }
  .sys { display: block; height: 16px; margin-bottom: 5px; border-radius: 9px; border: 1px solid #050607; background: linear-gradient(180deg, #4b525a, #23272c); font-size: 9.5px; font-weight: bold; letter-spacing: 1px; color: #9aa6ae; text-align: center; line-height: 16px; text-shadow: 0 -1px 0 #000; }
  .sys:last-child { margin-bottom: 0; }
  .sys i { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #39ff6a; box-shadow: 0 0 5px #39ff6a; margin-right: 5px; vertical-align: 0; }
  .locked .sys.act i { background: #ff8a1f; box-shadow: 0 0 6px #ff8a1f; animation: blink 0.6s steps(2) infinite; }

  /* schede: pillole */
  .tabs { display: flex; padding: 5px; margin: 0 4px 12px; border-radius: 24px; background: linear-gradient(180deg, #0c0e10, #2a2f35); border: 1px solid #050607; box-shadow: inset 0 2px 5px rgba(0,0,0,0.8), 0 1px 0 #6f7780; }
  .tab {
    flex: 1; height: 36px; border-radius: 18px; border: 1px solid #050607; cursor: pointer; font-family: inherit; font-size: 13px; font-weight: bold; letter-spacing: 0.5px;
    color: #c9d2d8; text-shadow: 0 -1px 0 #000;
    background: linear-gradient(180deg, #8a939b 0%, #555d65 45%, #3a4047 55%, #2c3136 100%); box-shadow: inset 0 1px 0 rgba(255,255,255,0.45);
  }
  .tab + .tab { margin-left: 6px; }
  .tab.on { color: #ffffff; text-shadow: 0 -1px 0 #4a0610; background: linear-gradient(180deg, #ff6f80 0%, #d42a40 45%, #b3182e 55%, #7d0d1e 100%); box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), 0 0 10px rgba(255,40,70,0.35); }

  /* moduli: piastre corazzate */
  .card {
    position: relative; padding: 10px 12px 12px; margin: 0 0 12px;
    border-style: solid; border-width: 12px; border-color: #3d434a; border-image: url(data:image/png;base64,) 24 stretch;
    background-color: #2a2f35; background-clip: padding-box; background-image: linear-gradient(180deg, #343a41 0%, #262a2f 100%);
  }
  .card h2 {
    display: inline-block; margin: 0 0 12px; padding: 3px 12px 3px 34px; font-size: 11.5px; font-weight: bold; letter-spacing: 2px; text-transform: uppercase;
    color: #39ff6a; text-shadow: 0 0 6px rgba(57,255,106,0.6); border: 1px solid #050607; border-radius: 3px 12px 3px 12px;
    background-color: #0b0f0c; background-image: repeating-linear-gradient(45deg, #f2c230 0px, #f2c230 5px, #141414 5px, #141414 10px);
    background-size: 24px 100%; background-repeat: no-repeat; box-shadow: inset 0 0 6px rgba(0,0,0,0.9);
  }
  .lbl { display: block; font-size: 10.5px; font-weight: bold; color: #93a1aa; margin-bottom: 5px; text-transform: uppercase; letter-spacing: 1px; }

  /* campi = mini display a fosfori */
  .inp, select {
    width: 100%; height: 32px; padding: 6px 10px; font-family: "Segoe UI", "Helvetica Neue", Tahoma, sans-serif; font-size: 12.5px; color: #c8ffd6; outline: none;
    background-color: #030a05; border: 1px solid #1f5a2b; border-radius: 7px; box-shadow: inset 0 2px 5px rgba(0,0,0,0.9), 0 1px 0 #5b636b;
  }
  .inp:focus, select:focus { border-color: #39ff6a; box-shadow: inset 0 2px 5px rgba(0,0,0,0.9), 0 0 6px rgba(57,255,106,0.5); }
  .inp:-ms-input-placeholder, .name:-ms-input-placeholder { color: #4f7a5a; }
  .inp::placeholder, .name::placeholder { color: #4f7a5a; }
  select::-ms-expand { background: #1f5a2b; color: #c8ffd6; border: 0; }
  select option { background: #030a05; color: #c8ffd6; }

  .row { display: flex; margin-top: 12px; }
  .col { flex: 1; min-width: 0; }
  .col + .col { margin-left: 10px; }
  .addrow { display: flex; }
  .addrow .inp { flex: 1; }

  /* pulsanti a pillola cromati */
  .btn {
    height: 32px; padding: 0 14px; border-radius: 16px; cursor: pointer; white-space: nowrap; font-family: inherit; font-size: 12px; font-weight: bold; letter-spacing: 0.3px;
    color: #e6edf0; text-shadow: 0 -1px 0 #000; border: 1px solid #050607;
    background: linear-gradient(180deg, #9aa3ab 0%, #626a72 42%, #3d434a 58%, #2a2f35 100%); box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), 0 2px 3px rgba(0,0,0,0.6);
  }
  .btn:hover { color: #39ff6a; box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), 0 0 8px rgba(57,255,106,0.45); }
  .btn:active { background: linear-gradient(180deg, #2a2f35, #5b636b); }
  .btn.sm { height: 28px; padding: 0 11px; font-size: 11.5px; }
  .btn[disabled] { opacity: 0.5; cursor: default; }
  .addrow .btn { margin-left: 8px; }
  .tools { display: flex; flex-wrap: wrap; margin-top: 10px; }
  .tools .btn { margin: 0 8px 6px 0; }
  .hint { font-size: 11.5px; color: #9aa8b0; margin-top: 4px; line-height: 1.5; }
  .hint b { color: #f2c230; }

  /* playlist LCD */
  .queue {
    margin-top: 10px; max-height: 230px; overflow-y: auto; border-radius: 6px; border: 2px solid #11331a; background-color: #021006;
    background-image: linear-gradient(rgba(57,255,106,0.06) 1px, rgba(0,0,0,0) 1px), linear-gradient(90deg, rgba(57,255,106,0.06) 1px, rgba(0,0,0,0) 1px); background-size: 14px 14px;
    box-shadow: inset 0 0 14px rgba(0,0,0,0.95), 0 0 0 1px #050607, 0 1px 0 #6f7780; font-family: "Lucida Console", Consolas, Menlo, monospace;
  }
  .empty { padding: 16px; text-align: center; color: #39ff6a; font-size: 11.5px; text-shadow: 0 0 5px rgba(57,255,106,0.6); }
  .item { display: flex; align-items: center; padding: 7px 9px; border-bottom: 1px solid #0d2a15; }
  .item:last-child { border-bottom: 0; }
  .num { width: 26px; color: #39ff6a; font-size: 12px; flex-shrink: 0; text-shadow: 0 0 5px rgba(57,255,106,0.7); }
  .body { flex: 1; min-width: 0; }
  .url, .ttl { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 4px; }
  .url { font-size: 11px; color: #7fdc97; }
  .ttl { font-size: 12px; color: #c8ffd6; }
  .name { width: 100%; height: 26px; padding: 4px 8px; font-size: 12px; font-family: "Segoe UI", "Helvetica Neue", Tahoma, sans-serif; color: #eafff0; outline: none; background: #000000; border: 1px solid #1f5a2b; border-radius: 5px; }
  .name:focus { border-color: #39ff6a; }
  .dimnote { display: none; margin-left: 6px; font-size: 10.5px; color: #f2c230; }
  .card.dim .dimnote { display: inline; }
  .card.dim .seg, .card.dim .row, .card.dim .checks, .card.dim .warn { opacity: 0.45; }
  .imgrow { display: flex; align-items: center; }
  .imgrow .lbl { margin: 0 8px 0 0; white-space: nowrap; }
  .imgrow select { flex: 1; min-width: 0; }
  .item .ifmt { flex: 0 0 auto; width: 92px; height: 26px; margin-left: 6px; align-self: flex-end; font-size: 11.5px; color: #eafff0; background: #000000; border: 1px solid #1f5a2b; border-radius: 5px; }
  .info { font-size: 11px; color: #6f9a7b; margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .info .still { width: 44px; height: 18px; padding: 0 4px; font-size: 11px; text-align: right; color: #eafff0; background: #000000; border: 1px solid #1f5a2b; border-radius: 4px; vertical-align: middle; }
  .info .stilllbl { color: #f2c230; }
  .info .yes { color: #39ff6a; font-weight: bold; text-shadow: 0 0 5px rgba(57,255,106,0.6); }
  .badge { margin-left: 8px; font-size: 10px; padding: 3px 8px; border-radius: 10px; white-space: nowrap; flex-shrink: 0; font-family: Bahnschrift, "DIN Alternate", "Helvetica Neue", Tahoma, sans-serif; font-weight: bold; text-transform: uppercase; letter-spacing: 0.6px; background: #0b0f0c; color: #6f9a7b; border: 1px solid #1f3a26; }
  .badge.run { color: #ff8a1f; border-color: #6b3a00; text-shadow: 0 0 5px rgba(255,138,31,0.8); }
  .badge.ok { color: #39ff6a; border-color: #1f6b33; text-shadow: 0 0 5px rgba(57,255,106,0.7); }
  .badge.part { color: #f2c230; border-color: #6b5a00; }
  .badge.err { color: #ffffff; background: #b3182e; border-color: #ff5a6e; }
  .del { margin-left: 6px; width: 24px; height: 24px; border-radius: 50%; border: 1px solid #050607; cursor: pointer; font-size: 14px; line-height: 20px; flex-shrink: 0; color: #ff6f80; background: linear-gradient(180deg, #6f7780, #2a2f35); }
  .del:hover { background: linear-gradient(180deg, #ff6f80, #7d0d1e); color: #ffffff; }
  .qfoot { display: flex; justify-content: space-between; align-items: center; margin-top: 8px; font-size: 11.5px; color: #93a1aa; font-weight: bold; }

  .seg { display: flex; padding: 4px; border-radius: 20px; height: 38px; background: linear-gradient(180deg, #0c0e10, #2a2f35); border: 1px solid #050607; box-shadow: inset 0 2px 4px rgba(0,0,0,0.8), 0 1px 0 #6f7780; }
  .seg button { flex: 1; border: 1px solid #050607; border-radius: 15px; cursor: pointer; font-family: inherit; font-size: 12.5px; font-weight: bold; color: #c9d2d8; text-shadow: 0 -1px 0 #000; background: linear-gradient(180deg, #8a939b 0%, #555d65 45%, #3a4047 55%, #2c3136 100%); }
  .seg button + button { margin-left: 4px; }
  .seg button.on { color: #ffffff; text-shadow: 0 -1px 0 #4a0610; background: linear-gradient(180deg, #ff6f80 0%, #d42a40 45%, #b3182e 55%, #7d0d1e 100%); }

  .checks { display: flex; flex-wrap: wrap; margin-top: 12px; }
  .checks label { width: 50%; font-size: 12px; color: #d3dbe0; padding: 4px 0; cursor: pointer; }
  .checks input { vertical-align: middle; margin: 0 6px 0 0; }
  .warn { font-size: 11.5px; color: #f2c230; margin-top: 6px; display: none; font-weight: bold; }
  /* ---------- trascinamento: il mecha si gira e apre la botola tra le gambe ---------- */
  .dropov { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 900; overflow: hidden;
            background: #020407; background-image: radial-gradient(ellipse at 50% 78%, rgba(57,255,106,0.16) 0%, rgba(2,4,7,0) 45%), radial-gradient(ellipse at 50% 30%, #141a26 0%, #020407 72%);
            animation: dzfade 0.18s ease-out; }
  /* rotazione fluida sull'asse centrale: il fronte gira fino a 90 gradi, poi entra il retro (60 fps del browser) */
  .dropface { position: absolute; left: 8px; right: 8px; top: 8px; bottom: 8px; transform-origin: 50% 50%; }
  .dropface .shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: #000; opacity: 0; }
  .dropface.front { opacity: 0; }
  .dropov.turnin .front { animation: dzFrontOut 0.8s linear forwards; }
  .dropov.turnin .front .shade { animation: dzShadeOut 0.8s linear forwards; }
  .dropov.turnin .back { animation: dzBackIn 0.8s linear forwards; }
  .dropov.turnin .back .shade { animation: dzShadeIn 0.8s linear forwards; }
  .dropov.out { animation: dzfadeout 0.24s ease-in 0.5s forwards; }
  .dropov.out .back { animation: dzBackOut 0.6s linear forwards; }
  .dropov.out .front { animation: dzFrontIn 0.6s linear forwards; }
  .dropov.out .back .shade { animation: dzShadeOut 0.6s linear forwards; }
  @keyframes dzfade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes dzfadeout { from { opacity: 1; } to { opacity: 0; } }
  @keyframes dzFrontOut { 0% { opacity: 1; transform: perspective(1800px) rotateY(0deg); animation-timing-function: ease-in; }
                          49.5% { opacity: 1; transform: perspective(1800px) rotateY(89deg); animation-timing-function: linear; }
                          50%, 100% { opacity: 0; transform: perspective(1800px) rotateY(90deg); } }
  @keyframes dzBackIn { 0%, 50% { opacity: 0; transform: perspective(1800px) rotateY(-90deg); animation-timing-function: linear; }
                        50.5% { opacity: 1; transform: perspective(1800px) rotateY(-89deg); animation-timing-function: ease-out; }
                        100% { opacity: 1; transform: perspective(1800px) rotateY(0deg); } }
  @keyframes dzBackOut { 0% { opacity: 1; transform: perspective(1800px) rotateY(0deg); animation-timing-function: ease-in; }
                         49.5% { opacity: 1; transform: perspective(1800px) rotateY(89deg); animation-timing-function: linear; }
                         50%, 100% { opacity: 0; transform: perspective(1800px) rotateY(90deg); } }
  @keyframes dzFrontIn { 0%, 50% { opacity: 0; transform: perspective(1800px) rotateY(-90deg); animation-timing-function: linear; }
                         50.5% { opacity: 1; transform: perspective(1800px) rotateY(-89deg); animation-timing-function: ease-out; }
                         100% { opacity: 1; transform: perspective(1800px) rotateY(0deg); } }
  @keyframes dzShadeOut { 0% { opacity: 0; animation-timing-function: ease-in; } 50%, 100% { opacity: 0.65; } }
  @keyframes dzShadeIn { 0%, 50% { opacity: 0.65; animation-timing-function: ease-out; } 100% { opacity: 0; } }
  #dropMechaF .dzfront { font: bold 64px "Lucida Console", Consolas, monospace; fill: #1f6b35; letter-spacing: 10px; }
  /* anello che segue il puntatore mentre trascini (dove la pagina riceve il trascinamento: Mac e avvio) */
  .dropghost { position: absolute; width: 74px; height: 74px; margin: -37px 0 0 -37px; border-radius: 50%; display: none; z-index: 3;
               border: 3px solid #39ff6a; box-shadow: 0 0 18px rgba(57,255,106,0.85), inset 0 0 14px rgba(57,255,106,0.5); animation: dzpulse 0.5s ease-in-out infinite alternate; }
  .dropghost:after { content: "+"; position: absolute; left: 0; right: 0; top: 13px; text-align: center; font: bold 38px Arial, sans-serif; color: #d6ffe0; text-shadow: 0 0 8px #39ff6a; }
  #dropMecha .dztag { font: bold 11px "Lucida Console", Consolas, monospace; fill: #ff8a1f; letter-spacing: 1px; }
  #dropMecha .dzl1 { font: bold 34px "Lucida Console", Consolas, monospace; fill: #39ff6a; letter-spacing: 3px; }
  #dropMecha .dzl2 { font: bold 17px "Segoe UI", Arial, sans-serif; fill: #9dffb6; }
  #dropMecha .dzlabel { font: bold 13px "Segoe UI", Arial, sans-serif; fill: #7dff9a; letter-spacing: 2px; }
  #dropMecha .dzsten { font: bold 54px "Segoe UI", Arial, sans-serif; fill: #0b0e15; opacity: 0.45; letter-spacing: 4px; }
  #dropMecha .dzcore { animation: dzpulse 1.1s ease-in-out infinite alternate; }
  #dropMecha .dzjet { animation: dzpulse 0.7s ease-in-out infinite alternate; }
  #dzRing { animation: dzpulse 0.8s ease-in-out infinite alternate; }
  #dzGlow { opacity: 0.55; }
  #dropMecha .dzchev { opacity: 0.25; animation: dzchev 1.05s linear infinite; }
  #dropMecha .dzc1 { animation-delay: 0.35s; }
  #dropMecha .dzc2 { animation-delay: 0.7s; }
  @keyframes dzpulse { from { opacity: 0.45; } to { opacity: 1; } }
  @keyframes dzchev { 0% { opacity: 0.15; } 30% { opacity: 1; } 70% { opacity: 0.15; } 100% { opacity: 0.15; } }
  .dropov.hot #dzGlow { opacity: 1; }
  .dropov.hot #dzRing { stroke: #d6ffe0; stroke-width: 6; }
  .dropov.hot #dropMecha .dzlabel { fill: #d6ffe0; }
  .dropov.wait #dzRing, .dropov.wait #dropMecha .dzchev { stroke: #f2c230; fill: #f2c230; }
  .dropov.wait #dropMecha .dzl1 { fill: #f2c230; }
  .dropov.gulp #dzFlash { animation: dzflash 0.5s ease-out; }
  @keyframes dzflash { 0% { opacity: 0; } 25% { opacity: 0.95; } 100% { opacity: 0; } }
  .dropfile { position: absolute; width: 120px; margin-left: -60px; margin-top: -58px; text-align: center; display: none; z-index: 2;
              transition: left 0.7s cubic-bezier(0.5, 0, 0.75, 0.25), top 0.7s cubic-bezier(0.5, 0, 0.75, 0.25), transform 0.7s ease-in, opacity 0.22s ease-in 0.5s; }
  .dropfile.fly { transform: scale(0.1); opacity: 0; }
  .dropfile .dfic { width: 72px; height: 90px; margin: 0 auto; }
  .dropfile .dfic svg { width: 72px; height: 90px; }
  .dropfile .dfname { margin-top: 4px; padding: 2px 6px; border-radius: 8px; background: rgba(3,16,6,0.85); border: 1px solid #0d2a15;
                      color: #c8ffd6; font: bold 11px "Segoe UI", Arial, sans-serif; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pvbox { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 950; background: rgba(0, 0, 0, 0.78); }
  .pvpanel { position: absolute; left: 6%; right: 6%; top: 5%; bottom: 5%; background: #0b1110; border: 2px solid #39ff6a; border-radius: 14px; padding: 12px; box-shadow: 0 0 24px rgba(57,255,106,0.35); }
  .pvhead { display: flex; justify-content: space-between; align-items: center; color: #c8ffd6; font-weight: bold; font-size: 13px; }
  .pvwrap { position: absolute; left: 12px; right: 12px; top: 52px; bottom: 44px; text-align: center; overflow: hidden; border-radius: 8px;
            background-color: #cfcfcf; background-image: linear-gradient(45deg, #9a9a9a 25%, transparent 25%, transparent 75%, #9a9a9a 75%), linear-gradient(45deg, #9a9a9a 25%, transparent 25%, transparent 75%, #9a9a9a 75%);
            background-size: 24px 24px; background-position: 0 0, 12px 12px; }
  .pvwrap img { max-width: 100%; max-height: 100%; position: relative; top: 50%; transform: translateY(-50%); }
  #pvInfo { position: absolute; left: 14px; right: 14px; bottom: 12px; }
  .item .pv { flex: 0 0 auto; width: 26px; height: 26px; margin-left: 6px; border-radius: 13px; border: 1px solid #050607; cursor: pointer; color: #c8ffd6; font-size: 14px; line-height: 20px;
              background: linear-gradient(180deg, #3c4a44, #1c2420); }
  .item .pv:disabled { opacity: 0.4; cursor: default; }
  .infopanel { left: 14%; right: 14%; top: 12%; bottom: auto; }
  .infobody { margin-top: 12px; font-size: 13px; line-height: 1.6; color: #d3dbe0; }
  .infobody ol { margin: 6px 0 10px 18px; padding: 0; }
  .infobody b { color: #f2c230; }
  .infobody .path { margin: 6px 0; }
  .infobody .btn { margin: 4px 6px 0 0; }
  .presetrow { display: flex; margin-bottom: 8px; }
  .presetrow select { flex: 1.3; height: 30px; font-size: 12px; }
  .presetrow .inp { flex: 1; height: 30px; font-size: 12px; margin-left: 6px; }
  .presetrow .btn { margin-left: 6px; }
  .subseg { height: 32px; }
  .subseg button { font-size: 11.5px; }
  .pane { min-height: 186px; }
  .okline { font-size: 11.5px; color: #39ff6a; margin-top: 6px; font-weight: bold; text-shadow: 0 0 5px rgba(57,255,106,0.4); }

  .folder { display: flex; align-items: center; }
  .folder .path {
    flex: 1; min-width: 0; height: 32px; padding: 8px 11px; font-size: 12px; color: #9dffb6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    background: #030a05; border: 1px solid #1f5a2b; border-radius: 7px; box-shadow: inset 0 2px 5px rgba(0,0,0,0.9), 0 1px 0 #5b636b; font-family: "Lucida Console", Consolas, Menlo, monospace;
  }
  .folder .btn { margin-left: 8px; }

  /* pulsante principale: pillola d'armatura rossa con terminali a strisce di pericolo */
  .go {
    width: 100%; height: 48px; border-radius: 24px; border: 1px solid #050607; cursor: pointer; font-family: inherit; font-size: 16px; font-weight: bold; letter-spacing: 2px; text-transform: uppercase;
    color: #ffffff; text-shadow: 0 -1px 0 #4a0610, 0 0 8px rgba(255,120,140,0.5);
    background-image: linear-gradient(180deg, #ff7d8c 0%, #df2c43 44%, #b3182e 56%, #7d0d1e 100%), repeating-linear-gradient(45deg, #f2c230 0px, #f2c230 7px, #141414 7px, #141414 14px);
    background-size: 84% 100%, 100% 100%; background-position: 50% 50%, 0 0; background-repeat: no-repeat, repeat;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.55), inset 0 -2px 4px rgba(0,0,0,0.3), 0 3px 10px rgba(179,24,46,0.5);
  }
  .go:hover { box-shadow: inset 0 1px 0 rgba(255,255,255,0.55), 0 0 14px rgba(255,60,90,0.7); }
  .go.stop { color: #ff8a1f; text-shadow: 0 0 6px rgba(255,138,31,0.8); background-image: linear-gradient(180deg, #6f7780 0%, #3d434a 50%, #22262b 100%), repeating-linear-gradient(45deg, #f2c230 0px, #f2c230 7px, #141414 7px, #141414 14px); }
  .go[disabled] { opacity: 0.45; cursor: default; }

  /* stato: LCD con barra a LED */
  .status { display: none; padding: 10px 12px; border-radius: 6px; border: 2px solid #11331a; background-color: #021006; box-shadow: inset 0 0 14px rgba(0,0,0,0.95), 0 0 0 1px #050607, 0 1px 0 #6f7780; font-family: "Lucida Console", Consolas, Menlo, monospace; }
  .overall { font-size: 12px; color: #c8ffd6; margin-bottom: 7px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bar { height: 12px; border-radius: 2px; overflow: hidden; background: #031a08; border: 1px solid #0d3a18; }
  .fill { height: 100%; width: 0%; background-color: #39ff6a; background-image: repeating-linear-gradient(90deg, #39ff6a 0px, #39ff6a 6px, #052a10 6px, #052a10 8px); box-shadow: 0 0 6px rgba(57,255,106,0.7); }
  .meta { display: flex; justify-content: space-between; font-size: 11.5px; color: #7fdc97; margin-top: 7px; text-shadow: 0 0 4px rgba(57,255,106,0.5); }
  .file { font-size: 11.5px; color: #c8ffd6; margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .msg { font-size: 12px; padding: 10px 12px; border-radius: 6px; display: none; line-height: 1.45; font-weight: bold; white-space: pre-line; font-family: "Lucida Console", Consolas, Menlo, monospace; }
  .msg.ok { background: #031a08; color: #39ff6a; border: 2px solid #1f6b33; text-shadow: 0 0 4px rgba(57,255,106,0.5); }
  .msg.err { background: #24050a; color: #ff7d8c; border: 2px solid #b3182e; }
  .msg.info { background: #071620; color: #8fe3ff; border: 2px solid #1d5b78; }

  /* basamento */
  .hazard { height: 8px; margin: 2px -6px 8px; border-top: 1px solid #050607; border-bottom: 1px solid #050607; background-image: repeating-linear-gradient(45deg, #f2c230 0px, #f2c230 7px, #141414 7px, #141414 14px); }
  .foot { display: flex; align-items: center; margin-top: 2px; }
  .foot .btn { margin-right: 8px; }
  .credit { margin-left: auto; white-space: nowrap; font-size: 10.5px; color: #93a1aa; font-weight: bold; letter-spacing: 0.5px; }
  .credit b { color: #ff6f80; }
  .locked .lockable { opacity: 0.5; }

  .keyrow { display: flex; align-items: center; }
  .swatch { width: 32px; height: 32px; border-radius: 50%; border: 2px solid #050607; margin-left: 8px; flex-shrink: 0; box-shadow: 0 0 0 2px #8d969e, inset 0 2px 4px rgba(0,0,0,0.4); }
  /* ======== v3.5: mecha blu in finestra normale, la pagina scorre ======== */
  html, body { background: #07080b; background-image: radial-gradient(ellipse at 50% 0%, #1a1f2b 0%, #07080b 70%); overflow: hidden; }
  #page { height: 100%; overflow-y: auto; overflow-x: hidden; scrollbar-face-color: #46546f; scrollbar-track-color: #0a0c10; scrollbar-arrow-color: #39ff6a; scrollbar-highlight-color: #93a3c0; scrollbar-shadow-color: #07080b; scrollbar-3dlight-color: #5d6e8f; scrollbar-darkshadow-color: #000000; }
  .wrap { position: relative; width: 1160px; height: auto; margin: 0 auto; padding: 0; border: 0; border-image: none; background: none; }
  svg { overflow: hidden; }                       /* IE11 altrimenti disegna anche fuori dal riquadro */
  .top { position: relative; height: 216px; overflow: hidden; }
  .top svg.suit, .bottom svg.suit { position: absolute; left: 0; top: 0; width: 1160px; display: block; }
  .top svg.suit { height: 216px; }
  .bottom { position: relative; height: 154px; overflow: hidden; }
  .bottom svg.suit { height: 154px; }
  .leg3 .flame { animation: thrust 0.9s ease-in-out infinite alternate; }
  .leg3 .star { animation: twinkle 1.7s ease-in-out infinite alternate; }
  @keyframes thrust { from { opacity: 0.65; } to { opacity: 1; } }
  @keyframes twinkle { from { opacity: 0.35; } to { opacity: 0.95; } }
  .mid { position: relative; min-height: 610px; padding: 0 0 4px; }
  .armimg { position: absolute; top: 0; width: 146px; height: 582px; }
  .armimg.l { left: 0; }
  .armimg.r { right: 0; }
  .plate {
    position: absolute; left: 146px; right: 146px; top: 0; bottom: 0; border-left: 2px solid #07080b; border-right: 2px solid #07080b;
    background-color: #46546f;
    background-image: url(data:image/png;base64,), radial-gradient(8px 18px at 50% 50%, rgba(217,163,255,0.95) 0%, rgba(155,77,255,0.5) 45%, rgba(90,29,158,0) 100%), radial-gradient(8px 18px at 50% 50%, rgba(217,163,255,0.95) 0%, rgba(155,77,255,0.5) 45%, rgba(90,29,158,0) 100%), linear-gradient(90deg, #1c2232 0%, #5d6e8f 6%, #3a4762 50%, #5d6e8f 94%, #1c2232 100%);
    background-size: 128px 128px, 16px 120px, 16px 120px, 100% 100%;
    background-position: 0 0, 0 30px, 100% 30px, 0 0;
    background-repeat: repeat, repeat-y, repeat-y, no-repeat;
  }
  #torso {
    position: relative; width: 832px; margin: 0 auto; padding: 10px 12px 8px; border: 3px solid #07080b; border-top: 0;
    background-color: #1d2129; background-image: repeating-linear-gradient(135deg, rgba(255,255,255,0.022) 0px, rgba(255,255,255,0.022) 2px, rgba(0,0,0,0) 2px, rgba(0,0,0,0) 9px), linear-gradient(180deg, #262b34, #171a20);
    box-shadow: inset 0 0 18px rgba(0,0,0,0.9);
  }
  /* due colonne di moduli */
  .cols { display: flex; align-items: flex-start; }
  .colA, .colB { flex: 1; min-width: 0; }
  .colA { margin-right: 12px; }
  .colB .card:first-child { margin-top: 10px; }        /* leggero sfalsamento: sagoma irregolare */
  .cols .card { margin-left: 0; margin-right: 0; }
  .cols .row { flex-wrap: wrap; margin-right: -10px; }
  .cols .row .col { flex: 1 1 150px; margin: 0 10px 8px 0; }
  .cols .row .col + .col { margin-left: 0; }
  .cols .pane .row .col { flex: 1 1 88px; }
  .cols .row { margin-top: 10px; }
  #torso .queue { max-height: 196px; }
  #torso .card { margin-bottom: 10px; padding: 8px 12px 10px; }
  #torso .card h2 { margin-bottom: 9px; }
  .iconlcd { position: absolute; left: 42px; top: 96px; width: 108px; height: 108px; border-radius: 8px; box-shadow: 0 0 0 2px #07080b, 0 0 14px rgba(57,255,106,0.35); }
  .visor { position: absolute; left: 504px; top: 76px; width: 152px; height: 54px; padding: 13px 6px 0; text-align: center; border-radius: 10px 10px 4px 4px; }
  .visor .lcd-title { font-size: 13px; letter-spacing: 1.4px; margin-top: 2px; }
  .visor .lcd-sub { font-size: 9.5px; margin-top: 3px; text-align: left; }
  .visor .lcd-tag { left: 7px; top: 2px; font-size: 8.5px; }
  .visor .led { right: 7px; top: 4px; width: 7px; height: 7px; }
  .sysrow { position: absolute; left: 942px; top: 120px; width: 180px; right: auto; }
  .sysrow .sys { display: inline-block; width: 84px; height: 20px; margin: 0 4px 8px 0; padding: 0; line-height: 18px; font-size: 8.5px; letter-spacing: 0.4px; white-space: nowrap; overflow: hidden; }
  #torso .foot { flex-wrap: wrap; }
  #torso .credit { width: 100%; margin: 8px 0 0; text-align: center; }
  .btn.attn { color: #1a1200; text-shadow: none; border-color: #6b4a00; background: linear-gradient(180deg, #ffe08a 0%, #f2c230 45%, #d9a21f 55%, #b37d00 100%); animation: attn 1.2s ease-in-out infinite; }
  @keyframes attn { 50% { box-shadow: 0 0 12px rgba(242,194,48,0.9); } }
  .visor .lcd-sub { position: relative; height: 13px; }
  .visor .marquee { position: absolute; left: 0; top: 0; padding-left: 0; animation: none; white-space: nowrap; }
  .visor .marquee.phrase { color: #9dffb6; }
  .visor .marquee.notice { color: #ffb347; text-shadow: 0 0 5px rgba(255,138,31,0.75); }
  /* ---------- spie dei componenti (secondo schermo): verde = ok, rosso = manca / non parte / da aggiornare ---------- */
  .sysrow .sys { cursor: pointer; }
  .sysrow .sys:hover { color: #e8eef2; border-color: #39ff6a; }
  .sysrow .sys.bad { color: #ffb3bd; }
  .sysrow .sys.bad i { background: #ff2d4b; box-shadow: 0 0 7px #ff2d4b; animation: blink 0.9s steps(2) infinite; }
  .sysrow .sys.wait i { background: #6b7378; box-shadow: none; }
  /* ---------- slot della lingua sotto le fessure del casco ---------- */
  .langslot { position: absolute; left: 527px; top: 163px; width: 106px; height: 15px; padding: 1px 2px; border-radius: 4px; background: #05070a;
              border: 1px solid #000; box-shadow: inset 0 1px 3px #000, 0 1px 0 rgba(160,180,210,0.35); white-space: nowrap; text-align: center; font-size: 0; }
  .langslot button { display: inline-block; width: 32px; height: 13px; margin: 0 1px; padding: 0; border: 0; border-radius: 3px; cursor: pointer; vertical-align: top;
                     font: bold 9px "Segoe UI", "Microsoft YaHei", "PingFang SC", Arial, sans-serif; line-height: 13px; color: #4f7a5a; background: #0a140d; }
  .langslot button:hover { color: #c8ffd6; }
  .langslot button.on { color: #031006; background: #39ff6a; box-shadow: 0 0 6px rgba(57,255,106,0.8); }
  /* ---------- schermo di stato sotto i piedi: registro completo di app, estensione e strumenti ---------- */
  .logscr { position: relative; margin: 0 auto; overflow: hidden; }
  .logbez { position: absolute; left: 0; right: 0; top: 0; bottom: 6px; border-radius: 14px; border: 1px solid #050607; padding: 9px 12px 10px;
            background: linear-gradient(180deg, #5d6e8f 0%, #3a4762 30%, #262d3d 100%); box-shadow: inset 0 1px 0 #93a3c0, 0 6px 18px rgba(0,0,0,0.6); }
  .logbez .hz { position: absolute; left: 14px; right: 14px; top: 0; height: 5px; background: repeating-linear-gradient(45deg, #d9a21f 0, #d9a21f 6px, #141414 6px, #141414 12px); border-radius: 0 0 3px 3px; }
  .logbez .rv { position: absolute; width: 6px; height: 6px; border-radius: 50%; background: #b7c0cc; box-shadow: 0 0 0 1px #07080b; }
  .loghead { display: flex; align-items: center; height: 22px; margin: 2px 0 6px; white-space: nowrap; }
  .logttl { flex: 0 0 auto; font: bold 10.5px "Lucida Console", Consolas, Menlo, monospace; color: #ff8a1f; letter-spacing: 1.5px; text-shadow: 0 0 5px rgba(255,138,31,0.7); margin-right: 10px; }
  .logtabs { flex: 1 1 auto; min-width: 0; overflow: hidden; white-space: nowrap; }
  .logbtns { flex: 0 0 auto; margin-left: 10px; padding-left: 10px; border-left: 1px solid #1c2232; }
  .logtabs button, .logbtns button { height: 20px; margin-right: 4px; padding: 0 8px; border-radius: 10px; border: 1px solid #050607; cursor: pointer;
                     font: bold 9.5px Bahnschrift, "Segoe UI", "Microsoft YaHei", Arial, sans-serif; letter-spacing: 0.8px; color: #c9d4e6; background: linear-gradient(180deg, #6b7378, #2a2f35); }
  .logtabs button.on { color: #031006; background: linear-gradient(180deg, #b9ffcb, #39ff6a); box-shadow: 0 0 6px rgba(57,255,106,0.6); }
  .logtabs button b { color: #ff6f80; font-weight: bold; }
  .logbody { position: absolute; left: 12px; right: 12px; top: 39px; bottom: 10px; overflow-y: auto; overflow-x: hidden; padding: 5px 8px; border-radius: 8px;
             background: #020904; border: 1px solid #000; box-shadow: inset 0 0 14px rgba(57,255,106,0.18);
             font: 11px/1.45 "Lucida Console", Consolas, Menlo, "Microsoft YaHei", monospace; color: #8fe6a6;
             scrollbar-face-color: #1f4a2a; scrollbar-track-color: #020904; scrollbar-arrow-color: #39ff6a; scrollbar-shadow-color: #020904; scrollbar-highlight-color: #1f4a2a; scrollbar-3dlight-color: #020904; scrollbar-darkshadow-color: #020904; }
  .lg { white-space: pre-wrap; word-wrap: break-word; }
  .lg .t { color: #2f6b40; }
  .lg .c { display: inline-block; width: 46px; margin: 0 6px; text-align: center; font-weight: bold; border-radius: 3px; }
  .lg.app .c { color: #031006; background: #39ff6a; }
  .lg.ext .c { color: #021018; background: #35d2ff; }
  .lg.tool .c { color: #0d1013; background: #8a939b; }
  .lg.tool { color: #6f8a78; }
  .lg.ok { color: #c8ffd6; }
  .lg.warn { color: #f2c230; }
  .lg.err { color: #ff8a95; }
  .logempty { color: #2f6b40; padding: 6px 2px; }
</style>
</head>
<body>
<div id="page">
<div class="wrap" id="root">
  <div class="top">
<svg class="suit" viewBox="0 0 1160 216" width="100%" height="100%" preserveAspectRatio="none" focusable="false" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"><defs>
 <linearGradient id="szTArm" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#93a3c0"/><stop offset=".18" stop-color="#5d6e8f"/><stop offset=".65" stop-color="#3a4762"/><stop offset="1" stop-color="#1c2232"/></linearGradient>
 <linearGradient id="szTArmH" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#1c2232"/><stop offset=".3" stop-color="#6b7c9d"/><stop offset=".55" stop-color="#46546f"/><stop offset="1" stop-color="#181d2a"/></linearGradient>
 <radialGradient id="szTPad" cx=".42" cy=".3" r=".8"><stop offset="0" stop-color="#a8b6cf"/><stop offset=".35" stop-color="#5f7091"/><stop offset=".8" stop-color="#2e384e"/><stop offset="1" stop-color="#171c28"/></radialGradient>
 <radialGradient id="szTHelm" cx=".45" cy=".25" r=".85"><stop offset="0" stop-color="#b3c0d6"/><stop offset=".4" stop-color="#617294"/><stop offset="1" stop-color="#1d2433"/></radialGradient>
 <linearGradient id="szTGun" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6f737b"/><stop offset=".5" stop-color="#3c3f45"/><stop offset="1" stop-color="#1a1b1e"/></linearGradient>
 <linearGradient id="szTStack" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#16181c"/><stop offset=".35" stop-color="#7a7d84"/><stop offset=".6" stop-color="#3a3d43"/><stop offset="1" stop-color="#0e0f12"/></linearGradient>
 <linearGradient id="szTHose" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#2a1630"/><stop offset=".45" stop-color="#7d4f86"/><stop offset="1" stop-color="#1f1024"/></linearGradient>
 <radialGradient id="szTGlow" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#d9a3ff" stop-opacity=".95"/><stop offset=".45" stop-color="#9b4dff" stop-opacity=".55"/><stop offset="1" stop-color="#5a1d9e" stop-opacity="0"/></radialGradient>
 <radialGradient id="szTAmber" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#fff1c9"/><stop offset=".35" stop-color="#ffb347"/><stop offset="1" stop-color="#ff7a00" stop-opacity="0"/></radialGradient>
 <pattern id="szTHz" width="12" height="12" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="6" height="12" fill="#d9a21f"/><rect x="6" width="6" height="12" fill="#141414"/></pattern>
 <pattern id="szTGrime" width="128" height="128" patternUnits="userSpaceOnUse"><image width="128" height="128" xlink:href="data:image/png;base64,"/></pattern>
