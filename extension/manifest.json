{
  "manifest_version": 3,
  "name": "DownConvertron - Link Grabber",
  "short_name": "DownConvertron",
  "version": "7.0",
  "description": "Collects video links of the 1700+ sites supported by yt-dlp and the images of the page, sends them to DownConvertron or downloads images right away. designed by Welsho",
  "author": "Daniele Moretti (Welsho)",
  "action": { "default_popup": "popup.html", "default_title": "DownConvertron",
              "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" } },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["tabs", "activeTab", "scripting", "clipboardWrite", "downloads"],
  "optional_permissions": ["cookies", "nativeMessaging"],
  "optional_host_permissions": ["<all_urls>"],
  "key": ""
}
